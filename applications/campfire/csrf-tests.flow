// Rails CSRF in Flow: tokens built by an independent Python oracle with
// fixed pads must verify; fresh tokens must round-trip through verification.

test campfire.csrf.valid-token?/rails-global-vector {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh9uwXR47Dkq0rtTU9GSCdJsiUwKl6YBPoJ5r81JkMVDKA")
    => value true
}

test campfire.csrf.valid-token?/rails-form-vector {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/rooms/1/messages#post", "paWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaVjvMaeJhff0h-iyQJ6qMoeajdiCY111YHq30j6g1tfPw")
    => value true
}

test campfire.csrf.valid-token?/rails-boost-vector {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/messages/42/boosts#post", "ZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXp7fH1-f4CBgoOVuXC79pyE6Dlj7KZc6_m5DXDkfQXDfJmoZgg6IPlW-g")
    => value true
}

test campfire.csrf.valid-token?/wrong-identifier {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/rooms/2/messages#post", "paWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaVjvMaeJhff0h-iyQJ6qMoeajdiCY111YHq30j6g1tfPw")
    => value false
}

test campfire.csrf.valid-token?/tampered {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh9uwXR47Dkq0rtTU9GSCdJsiUwKl6YBPoJ5r81JkMVDAA")
    => value false
}

test campfire.csrf.valid-token?/short {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh9")
    => value false
}

test campfire.csrf.decode-secret/wrong-length {
    campfire.csrf.decode-secret("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8")
    => value option.none<Bytes>()
}

test campfire.csrf.form-token/round-trip {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token", campfire.csrf.form-token("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token"))
    => value true
}

test campfire.csrf.form-token/length {
    string.byte-length(campfire.csrf.form-token("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/rooms/1/messages#post"))
    => value 86
}

test campfire.csrf.form-token/fresh-pads {
    campfire.csrf.form-token("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token") == campfire.csrf.form-token("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token")
    => value false
}

test campfire.csrf.session-secret/keeps-valid {
    campfire.csrf.session-secret(option.some<String>("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k"))
    => value csrfSecret.new(value = "qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", fresh = false)
}

test campfire.csrf.session-secret/missing-is-fresh {
    campfire.csrf.session-secret(option.none<String>()).fresh
    => value true
}

test campfire.csrf.session-secret/invalid-is-fresh {
    campfire.csrf.session-secret(option.some<String>("not-a-secret")).fresh
    => value true
}

test campfire.csrf.session-secret/fresh-decodes {
    campfire.csrf.decode-secret(campfire.csrf.session-secret(option.none<String>()).value) == option.none<Bytes>()
    => value false
}

test campfire.csrf.boost-tokens/all-verify {
    campfire.csrf.valid-token?("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/messages/42/boosts#post", campfire.csrf.boost-tokens("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", MessageId.new(42)).fire)
    => value true
}

test campfire.csrf.boost-tokens/distinct-pads {
    campfire.csrf.boost-tokens("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", MessageId.new(42)).thumbs-up == campfire.csrf.boost-tokens("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", MessageId.new(42)).thumbs-up
    => value false
}

test campfire.csrf.digest/known-answer {
    hex.encode(campfire.csrf.digest(bytes.from-utf8("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"), "!real_csrf_token"))
    => value "f7ccc2ac30e78f91ec627d47fef7d322664b912df3305d825ef37624c87fd4f9"
}

test campfire.csrf.mask/known-answer {
    campfire.csrf.mask(bytes.from-utf8("pppppppppppppppppppppppppppppppp"), campfire.csrf.digest(bytes.from-utf8("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"), "!real_csrf_token"))
    => value "cHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHCHvLLcQJf_4ZwSDTeOh6NSFjvhXYNALfIugwZUuA-kiQ"
}

test campfire.csrf.mask/length-mismatch {
    campfire.csrf.mask(bytes.from-utf8("short"), bytes.from-utf8("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"))
    => value ""
}

test campfire.csrf.pad-at/third {
    hex.encode(campfire.csrf.pad-at(bytes.from-utf8("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbcccccccccccccccccccccccccccccccc"), 2))
    => value "6363636363636363636363636363636363636363636363636363636363636363"
}

test campfire.csrf.fresh-secret/decodes {
    campfire.csrf.decode-secret(campfire.csrf.fresh-secret().value) == option.none<Bytes>()
    => value false
}
