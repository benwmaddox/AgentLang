enum HttpRoute {
    room-show
    message-create
    session-new
    session-create
    session-destroy
}

enum HttpFormError {
    invalid-form
    unsupported-media
    unsupported-attachment
    body-too-large
}

record HttpMessageInput {
    client-message-id: Option<String>
    body: Option<String>
}

record HttpLoginInput {
    email-address: Option<String>
    password: Option<String>
}

record HttpLogoutInput {
    push-subscription-endpoint: Option<String>
}

record CampfireHttpRequest {
    route: HttpRoute
    method: RequestMethod
    room-id: RoomId
    now: UtcInstant
    remote-ip: RemoteIp
    user-agent: Option<String>
    base-url: String
    request-is-ssl: Bool
    force-ssl: Bool
    origin: Option<String>
    fetch-site: Option<String>
    session-token: Option<String>
    bot-key: Option<BotKey>
    message-form: Result<Option<HttpMessageInput>, HttpFormError>
    login-form: Result<Option<HttpLoginInput>, HttpFormError>
    logout-form: Result<Option<HttpLogoutInput>, HttpFormError>
    accepts-turbo: Bool
    accepts-html: Bool
    last-room: Option<String>
    browser: BrowserInfo
    csrf-token: Option<String>
}

enum HttpView {
    empty
    room
    append-message
    redirect-root
    redirect-session
    incompatible-browser
    room-not-found
    login-page
    redirect-authenticated
    redirect-first-run
    redirect-signed-out
}

record CampfireHttpResponse {
    status: Int
    view: HttpView
    text: String
    room: Option<RoomRow>
    message: Option<MessageRow>
    refresh-session-token: Option<SessionToken>
    remember-return-to: Bool
    last-room: Option<RoomId>
    new-csrf-token: Option<String>
    body: String
}
