test campfire.ua.lower/kelvin {
    campfire.ua.lower("AppleWebKit")
    => value "applewebkit"
}

test campfire.ua.ruby-space?/classes {
    [campfire.ua.ruby-space?(32), campfire.ua.ruby-space?(11), campfire.ua.ruby-space?(0), campfire.ua.ruby-space?(160)]
    => value [true, true, false, false]
}

test campfire.ua.ruby-spaces/six {
    scan.join(campfire.ua.ruby-spaces(), "|")
    => value " |\t|\n|\u000b|\f|\r"
}

test campfire.ua.digits-dots/members {
    scan.join(campfire.ua.digits-dots(), "")
    => value "0123456789."
}

test campfire.ua.digits-underscores/members {
    scan.join(campfire.ua.digits-underscores(), "")
    => value "0123456789_"
}

test campfire.ua.letter?/ascii-only {
    [campfire.ua.letter?(65), campfire.ua.letter?(122), campfire.ua.letter?(48), campfire.ua.letter?(195)]
    => value [true, true, false, false]
}

test campfire.ua.alnum-dash/members {
    scan.remove-all("ab-Z9_.", campfire.ua.alnum-dash())
    => value "_."
}

test campfire.ua.product-byte?/classes {
    [campfire.ua.product-byte?(65), campfire.ua.product-byte?(47), campfire.ua.product-byte?(9), campfire.ua.product-byte?(-1), campfire.ua.product-byte?(0)]
    => value [true, false, false, false, true]
}

test campfire.ua.strip/both-ends {
    campfire.ua.strip("\u0000 \tMozilla/5.0 x\r\n ")
    => value "Mozilla/5.0 x"
}

test campfire.ua.strip/blank {
    campfire.ua.strip(" \u0000 ")
    => value ""
}

test campfire.ua.ruby-blank?/nbsp-is-not-ruby-space {
    [campfire.ua.ruby-blank?(" \t"), campfire.ua.ruby-blank?(""), campfire.ua.ruby-blank?(" ")]
    => value [true, true, false]
}

test campfire.ua.unicode-blank?/dotnet-whitespace {
    [campfire.ua.unicode-blank?(" 　 "), campfire.ua.unicode-blank?(""), campfire.ua.unicode-blank?("​")]
    => value [true, true, false]
}

test campfire.ua.matched/fields {
    campfire.ua.matched(4, "a", "1", option.none<List<String>>()).product.version
    => value "1"
}

test campfire.ua.with-comment/comment {
    campfire.ua.with-comment("A/1 (x; y; ) B", "A", "1", 3).product.comment
    => value option.some<List<String>>(["x", "y"])
}

test campfire.ua.with-comment/unterminated {
    campfire.ua.with-comment("A/1 (x", "A", "1", 3).consumed
    => value 3
}

test campfire.ua.with-comment/gzip {
    campfire.ua.with-comment("A/1,gzip(gfe) B", "A", "1", 3).consumed
    => value 13
}

test campfire.ua.product-at/name-and-version {
    campfire.ua.product-at("Chrome/120.0, x", 0).product.version
    => value "120.0"
}

test campfire.ua.match-product/quoted {
    match campfire.ua.match-product("'Mozilla/5.0' x") {
        none => "none"
        some found => found.product.name
    }
    => value "Mozilla"
}

test campfire.ua.match-product/quote-before-slash {
    match campfire.ua.match-product("\"'/1.0") {
        none => "none"
        some found => found.product.name
    }
    => value "'"
}

test campfire.ua.match-product/leading-space {
    match campfire.ua.match-product(" Mozilla") {
        none => "none"
        some found => found.product.name
    }
    => value "none"
}

test campfire.ua.collect-step/done {
    campfire.ua.collect-step(userAgentCollect.new(rest = "A/1", products = list.empty<UserAgentProduct>(), done = true), "").rest
    => value "A/1"
}

test campfire.ua.parse/products {
    campfire.ua.parse(option.some<String>("Mozilla/5.0 (X11; Linux) Firefox/121.0")).fold(list.empty<String>(), campfire.ua.test-name)
    => value ["Mozilla", "Firefox"]
}

test campfire.ua.parse/missing-uses-default {
    campfire.ua.parse(option.none<String>()).fold(list.empty<String>(), campfire.ua.test-name)
    => value ["Mozilla"]
}

fn campfire.ua.test-name(names: List<String>, product: UserAgentProduct) -> List<String> {
    list.append(names, product.name)
}

test campfire.ua.test-name/appends {
    campfire.ua.test-name(list.empty<String>(), userAgentProduct.new(name = "A", version = "1", comment = option.none<List<String>>()))
    => value ["A"]
}

test campfire.ua.nth-step/target {
    campfire.ua.name-is?(campfire.ua.nth-step(userAgentNth.new(target = 0, index = 0, found = option.none<UserAgentProduct>()), userAgentProduct.new(name = "A", version = "1", comment = option.none<List<String>>())).found, "A")
    => value true
}

test campfire.ua.nth/second {
    campfire.ua.name-is?(campfire.ua.nth(campfire.ua.parse(option.some<String>("A/1 B/2 C/3")), 1), "B")
    => value true
}

test campfire.ua.first/first {
    campfire.ua.version-of(campfire.ua.first(campfire.ua.parse(option.some<String>("A/1 B/2"))))
    => value option.some<String>("1")
}

test campfire.ua.last-step/replaces {
    campfire.ua.name-is?(campfire.ua.last-step(option.none<UserAgentProduct>(), userAgentProduct.new(name = "B", version = "2", comment = option.none<List<String>>())), "B")
    => value true
}

test campfire.ua.last/last {
    campfire.ua.version-of(campfire.ua.last(campfire.ua.parse(option.some<String>("A/1 B/2"))))
    => value option.some<String>("2")
}

test campfire.ua.name-is?/none {
    campfire.ua.name-is?(option.none<UserAgentProduct>(), "A")
    => value false
}

test campfire.ua.version-is?/match {
    campfire.ua.version-is?(campfire.ua.first(campfire.ua.parse(option.some<String>("NSPlayer/4.1.0.3856"))), "4.1.0.3856")
    => value true
}

test campfire.ua.version-of/none {
    campfire.ua.version-of(option.none<UserAgentProduct>())
    => value option.none<String>()
}

test campfire.ua.comments-of/comments {
    campfire.ua.comments-of(campfire.ua.first(campfire.ua.parse(option.some<String>("A/1 (x; y)"))))
    => value ["x", "y"]
}

test campfire.ua.comment-of/absent {
    campfire.ua.comment-of(campfire.ua.first(campfire.ua.parse(option.some<String>("A/1"))))
    => value option.none<List<String>>()
}

test campfire.ua.named-step/keeps-first {
    campfire.ua.named-step(userAgentNamed.new(lowered = "a", found = option.none<UserAgentProduct>()), userAgentProduct.new(name = "A", version = "1", comment = option.none<List<String>>())).lowered
    => value "a"
}

test campfire.ua.named/ignores-case {
    campfire.ua.version-of(campfire.ua.named(campfire.ua.parse(option.some<String>("A/1 CRIOS/2 crios/3")), "CriOs"))
    => value option.some<String>("2")
}

test campfire.ua.has-named?/missing {
    campfire.ua.has-named?(campfire.ua.parse(option.some<String>("A/1")), "Iron")
    => value false
}

test campfire.ua.exact-step/match {
    campfire.ua.exact-step(userAgentExact.new(name = "Chrome", found = false), userAgentProduct.new(name = "Chrome", version = "1", comment = option.none<List<String>>())).found
    => value true
}

test campfire.ua.has-exact?/case-sensitive {
    [campfire.ua.has-exact?(campfire.ua.parse(option.some<String>("chrome/1")), "Chrome"), campfire.ua.has-exact?(campfire.ua.parse(option.some<String>("Chrome/1")), "Chrome")]
    => value [false, true]
}

test campfire.ua.commented-step/skips-empty {
    campfire.ua.commented-step(option.none<UserAgentProduct>(), userAgentProduct.new(name = "A", version = "1", comment = option.some<List<String>>(list.empty<String>())))
    => value option.none<UserAgentProduct>()
}

test campfire.ua.commented-application?/kinds {
    [campfire.ua.commented-application?(UserAgentKind.chrome()), campfire.ua.commented-application?(UserAgentKind.gecko())]
    => value [true, false]
}

test campfire.ua.application/commented {
    campfire.ua.name-is?(campfire.ua.application(UserAgentKind.webkit(), campfire.ua.parse(option.some<String>("A/1 () B/2 (x)"))), "B")
    => value true
}

test campfire.ua.joined-comment/joined {
    campfire.ua.joined-comment(option.some<List<String>>(["a", "b"]), " ")
    => value "a b"
}

test campfire.ua.comments-step/appends {
    campfire.ua.comments-step(["a"], userAgentProduct.new(name = "A", version = "1", comment = option.some<List<String>>(["b"])))
