test campfire.ua.compare-segment/kinds {
    [campfire.ua.compare-segment(rubyVersionSegment.new(numeric = true, text = "10"), rubyVersionSegment.new(numeric = true, text = "9")), campfire.ua.compare-segment(rubyVersionSegment.new(numeric = false, text = "a"), rubyVersionSegment.new(numeric = true, text = "0"))]
