}

test campfire.ua.compare-segments/six-limit {
    campfire.ua.compare-segments(campfire.ua.version-segments("1.2.3.4.5.6.7"), campfire.ua.version-segments("1.2.3.4.5.6.8"))
    => value 0
}

test campfire.ua.first-order/keeps-first {
    [campfire.ua.first-order(0, -1), campfire.ua.first-order(1, -1)]
    => value [-1, 1]
}

test campfire.browser.version-compare/cases {
    [campfire.browser.version-compare("17.2.1", "17.2"), campfire.browser.version-compare("17.1", "17.2"), campfire.browser.version-compare("1a", "1a"), campfire.browser.version-compare("1a", "0")]
    => value [1, -1, 0, -1]
}

test campfire.browser.version-at-least?/thresholds {
    [campfire.browser.version-at-least?("120.0.6099.109", "120"), campfire.browser.version-at-least?("119.9", "120"), campfire.browser.version-at-least?("17.2", "17.2")]
    => value [true, false, true]
}

test campfire.ua.version-scan-step/digits {
    campfire.ua.version-scan-step(rubyVersionScan.new(source = "017.x", index = 0, segments = list.empty<RubyVersionSegment>(), done = false), "")
    => value rubyVersionScan.new(source = "017.x", index = 3, segments = [rubyVersionSegment.new(numeric = true, text = "17")], done = false)
}

test campfire.ua.version-scan-step/final-letters {
    campfire.ua.version-scan-step(rubyVersionScan.new(source = "1.beta-2", index = 2, segments = list.empty<RubyVersionSegment>(), done = false), "")
    => value rubyVersionScan.new(source = "1.beta-2", index = 2, segments = [rubyVersionSegment.new(numeric = false, text = "beta-2")], done = true)
}

test campfire.ua.version-scan-step/skips-letters-before-end {
    campfire.ua.version-scan-step(rubyVersionScan.new(source = "1a.", index = 1, segments = list.empty<RubyVersionSegment>(), done = false), "").index
    => value 2
}

test campfire.ua.version-scan-step/already-done {
    campfire.ua.version-scan-step(rubyVersionScan.new(source = "1", index = 0, segments = list.empty<RubyVersionSegment>(), done = true), "").index
    => value 0
}

test campfire.ua.scan-version/no-ticks {
    campfire.ua.scan-version(list.empty<String>(), "1.2")
    => value list.empty<RubyVersionSegment>()
}

test campfire.ua.scan-version/ticks {
    campfire.ua.scan-version(["", "", "", ""], "1.2")
    => value [rubyVersionSegment.new(numeric = true, text = "1"), rubyVersionSegment.new(numeric = true, text = "2")]
}

test campfire.ua.version-segments/blank {
    campfire.ua.version-segments(" ")
    => value list.empty<RubyVersionSegment>()
}

test campfire.ua.version-segments/not-comparable {
    campfire.ua.version-segments("v1.0")
    => value [rubyVersionSegment.new(numeric = false, text = "v1.0")]
}

test campfire.ua.compare-segment/numbers {
    [campfire.ua.compare-segment(rubyVersionSegment.new(numeric = true, text = "12"), rubyVersionSegment.new(numeric = true, text = "13")), campfire.ua.compare-segment(rubyVersionSegment.new(numeric = true, text = "9"), rubyVersionSegment.new(numeric = true, text = "10"))]
    => value [-1, -1]
}

test campfire.ua.compare-segment/text-and-number {
    [campfire.ua.compare-segment(rubyVersionSegment.new(numeric = true, text = "1"), rubyVersionSegment.new(numeric = false, text = "a")), campfire.ua.compare-segment(rubyVersionSegment.new(numeric = false, text = "b"), rubyVersionSegment.new(numeric = false, text = "a"))]
    => value [1, 1]
}

test campfire.ua.segment-at/text {
    campfire.ua.segment-at([rubyVersionSegment.new(numeric = false, text = "beta")], 0)
    => value rubyVersionSegment.new(numeric = false, text = "beta")
}

test campfire.ua.segment-pick-step/other-index {
    campfire.ua.segment-pick-step(rubyVersionPick.new(target = 0, index = 1, found = rubyVersionSegment.new(numeric = false, text = "a")), rubyVersionSegment.new(numeric = false, text = "b")).found
    => value rubyVersionSegment.new(numeric = false, text = "a")
}

test campfire.ua.segment-pick-step/text-target {
    campfire.ua.segment-pick-step(rubyVersionPick.new(target = 1, index = 1, found = rubyVersionSegment.new(numeric = true, text = "0")), rubyVersionSegment.new(numeric = false, text = "b")).found
    => value rubyVersionSegment.new(numeric = false, text = "b")
}

test campfire.ua.first-nonzero/empty {
    campfire.ua.first-nonzero(list.empty<Int>())
    => value 0
}

test campfire.ua.first-nonzero/orders {
    campfire.ua.first-nonzero([0, 0, 1, -1])
    => value 1
}

test campfire.ua.search-next/fields {
    campfire.ua.search-next(userAgentSearch.new(source = "s", marker = "m", from = 0, found = option.none<String>(), done = false), 3, option.some<String>("1"), true)
    => value userAgentSearch.new(source = "s", marker = "m", from = 3, found = option.some<String>("1"), done = true)
}

test campfire.ua.ie-msie/needs-space {
    campfire.ua.ie-msie(userAgentSearch.new(source = "MSIEx 9", marker = "MSIE", from = 0, found = option.none<String>(), done = false), 0).from
    => value 4
}

test campfire.ua.ie-rv/version {
    campfire.ua.ie-rv(userAgentSearch.new(source = "rv:11.0)", marker = "MSIE", from = 0, found = option.none<String>(), done = false), 0).found
    => value option.some<String>("11.0")
}

test campfire.ua.strip-byte?/classes {
    [campfire.ua.strip-byte?(0), campfire.ua.strip-byte?(32), campfire.ua.strip-byte?(65)]
    => value [true, true, false]
}

test campfire.ua.strip/one-leading-space {
    campfire.ua.strip(" Chrome/120")
    => value "Chrome/120"
}

test campfire.ua.product-ticks/separators {
    scan.join(campfire.ua.product-ticks("A/1 (x, y)"), "|")
    => value "A/1|(x,|y)|A/1 (x, y)|A/1 (x, y)|A/1 (x, y)|A/1 (x, y)|A/1 (x, y)|A/1 (x| y)|A/1 (x, y|"
}
