fn campfire.server.room-read-route(request: CampfireHttpRequest, user: AuthUser, refresh: Option<SessionToken>, context: CampfireServerContext) -> CampfireHttpResponse {
    effects db.read, db.write, store.read, store.write, response.write
    doc "campfire.http.room-read-route: the room through the user's membership, else the room-show redirect."

    match campfire.rooms.find-for-user(user.id, request.room-id) {
        error failure => campfire.server.response(500, HttpView.empty(), "", refresh)
        ok maybe-room => match maybe-room {
            none => campfire.server.response(302, HttpView.redirect-root(), "Room not found or inaccessible", refresh)
            some room => campfire.server.show-room(request, user, room, refresh, context)
        }
    }
}

test campfire.server.room-read-route/missing-room {
    expect campfire.server.test-fixture() == 0
    let user = authUser.new(id = UserId.new(1), name = "Ann", role = Role.member(), status = AuthUserStatus.active())
    let routed = campfire.server.room-read-route(campfire.server.test-request(option.none<String>()), user, option.none<SessionToken>(), campfire.server.test-context())
    expect routed.status == 200
    let other = campfire.server.room-read-route(campfire.server.test-request(option.none<String>()), authUser.new(id = UserId.new(2), name = "Bo", role = Role.member(), status = AuthUserStatus.active()), option.none<SessionToken>(), campfire.server.test-context())
    expect other.status == 302
}

fn campfire.server.room-read(request: CampfireHttpRequest, context: CampfireServerContext) -> CampfireHttpResponse {
    effects db.read, db.write, store.read, store.write, response.write
    doc "campfire.http.room-read for GET/HEAD room-show: session cookie, bot key, gates, room."

    match request.route {
        room-show => {
            let is-read-method = match request.method {
                get => true
                head => true
                unsafe => false
            }
            if is-read-method {
                match campfire.server.restore-request-session(request, context) {
                    error failure => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
                    ok maybe-session => match maybe-session {
                        none => campfire.server.bot-or-redirect(request)
                        some restored => {
                            let refresh = campfire.server.refresh-token(restored)
                            match campfire.server.authenticated-user(request, restored, refresh) {
                                error response => response
                                ok user => campfire.server.room-read-route(request, user, refresh, context)
                            }
                        }
                    }
                }
            } else {
                campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
            }
        }
        message-create => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
        session-new => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
        session-create => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
        session-destroy => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
    }
}

test campfire.server.room-read/signed-session {
    expect campfire.server.test-fixture() == 0
    let context = campfire.server.test-context()
    let signed = campfire.server.sign-session-token(context.signing-key, "session-token-1", 1791979200000000)
    let shown = campfire.server.room-read(campfire.server.test-request(option.some<String>(signed)), context)
    expect shown.status == 200
    expect shown.refresh-session-token == option.none<SessionToken>()
    let anonymous = campfire.server.room-read(campfire.server.test-request(option.none<String>()), context)
    expect anonymous.status == 302
}

// --------------------------------------------------------------- response

fn campfire.server.contract-valid?(response: CampfireHttpResponse) -> Bool {
    doc "The renderer's response contract (campfire_http_renderer.c al_http_contract_valid) for the views a room read produces."

    let no-route-data = response.room == option.none<RoomRow>() && response.message == option.none<MessageRow>()
    let text-empty = response.text == ""
    let no-last-room = response.last-room == option.none<RoomId>()
    let csrf-ok = response.new-csrf-token == option.none<String>()
    let view-ok = match response.view {
        empty => no-route-data && text-empty && bool.not(response.remember-return-to) && no-last-room
        room => {
            let last-room-ok = match response.room {
                none => false
                some room => match response.last-room {
                    none => true
                    some last => last == room.id
                }
            }
            response.status == 200 && response.message == option.none<MessageRow>() && bool.not(response.remember-return-to) && text-empty && last-room-ok
        }
        redirect-root => response.status == 302 && no-route-data && bool.not(response.remember-return-to) && no-last-room
        redirect-session => response.status == 302 && no-route-data && text-empty && response.remember-return-to && response.refresh-session-token == option.none<SessionToken>() && no-last-room
        incompatible-browser => response.status == 200 && no-route-data && bool.not(response.remember-return-to) && no-last-room && text-empty
        room-not-found => response.status == 200 && no-route-data && bool.not(response.remember-return-to) && no-last-room
        append-message => false
        login-page => false
        redirect-authenticated => false
        redirect-first-run => false
        redirect-signed-out => false
    }
    let body-ok = match response.view {
        empty => response.body == ""
        redirect-root => response.body == ""
        redirect-session => response.body == ""
        room => true
        incompatible-browser => true
        room-not-found => true
        append-message => false
        login-page => false
        redirect-authenticated => false
        redirect-first-run => false
        redirect-signed-out => false
    }
    csrf-ok && view-ok && body-ok
}

test campfire.server.contract-valid?/views {
    expect campfire.server.contract-valid?(campfire.server.unauthenticated())
    expect campfire.server.contract-valid?(campfire.server.response(422, HttpView.empty(), "", option.none<SessionToken>()))
    expect bool.not(campfire.server.contract-valid?(campfire.server.response(200, HttpView.login-page(), "", option.none<SessionToken>())))
}

fn campfire.server.cookie-expiry(now: Int) -> String {
    doc "A permanent cookie's Expires: 20 calendar years after now, RFC 1123."

    match time.add-years(now, 20) {
        none => ""
        some later => match time.rfc1123(later) {
            none => ""
            some text => text
        }
    }
}

test campfire.server.cookie-expiry/twenty-years {
    expect campfire.server.cookie-expiry(1791979200000000) == "Sun, 14 Oct 2046 12:00:00 GMT"
}

fn campfire.server.set-cookie(name: String, value: String, expires: String, http-only: Bool) -> Option<HttpHeader> {
    match cookie.set-cookie(name, value, "/", expires, "Lax", false, http-only) {
        none => option.none<HttpHeader>()
        some text => option.some<HttpHeader>(httpHeader.new(name = "Set-Cookie", value = text))
    }
}

test campfire.server.set-cookie/last-room {
    expect campfire.server.set-cookie("last_room", "4", "", false) == option.some<HttpHeader>(httpHeader.new(name = "Set-Cookie", value = "last_room=4; Path=/; SameSite=Lax"))
}

fn campfire.server.add-cookie(headers: Option<List<HttpHeader>>, header: Option<HttpHeader>) -> Option<List<HttpHeader>> {
    match headers {
        none => option.none<List<HttpHeader>>()
        some existing => match header {
            none => option.none<List<HttpHeader>>()
            some added => option.some<List<HttpHeader>>(list.append(existing, added))
        }
    }
}

test campfire.server.add-cookie/invalid {
    expect campfire.server.add-cookie(option.some<List<HttpHeader>>(list.empty<HttpHeader>()), option.none<HttpHeader>()) == option.none<List<HttpHeader>>()
}

fn campfire.server.response-cookies(response: CampfireHttpResponse, built: ServerRequest, target: String, context: CampfireServerContext) -> Option<List<HttpHeader>> {
    effects random.read
    doc "Set-Cookie headers in the native host's order: _campfire_session (return-to, flash alert; decrypted only then; HttpOnly, session lifetime), session_token (refreshed, signed, permanent, HttpOnly), last_room (permanent). None when a cookie cannot be written."

    let now = UtcInstant.value(built.campfire.now)
    let alert = if response.view == HttpView.redirect-root() { option.some<String>(response.text) } else { option.none<String>() }
    let return-url = if response.remember-return-to { option.some<String>(string.concat(context.base-url, target)) } else { option.none<String>() }
    let mutation = response.remember-return-to || alert != option.none<String>()
    var headers = option.some<List<HttpHeader>>(list.empty<HttpHeader>())
    if mutation {
        let decrypted = match built.session-cookie {
            none => option.none<String>()
            some raw => campfire.server.decrypt-session(context.encryption-key, raw, now)
        }
        let session = match decrypted { none => "{}"; some text => text }
        headers = match campfire.server.mutate-session(session, return-url, alert) {
            none => option.none<List<HttpHeader>>()
            some mutated => campfire.server.add-cookie(headers, campfire.server.set-cookie("_campfire_session", campfire.server.encrypt-session(context.encryption-key, mutated, now), "", true))
        }
    }
    headers = match response.refresh-session-token {
        none => headers
        some token => campfire.server.add-cookie(headers, campfire.server.set-cookie("session_token", campfire.server.sign-session-token(context.signing-key, SessionToken.value(token), now), campfire.server.cookie-expiry(now), true))
    }
    match response.last-room {
        none => headers
        some room-id => campfire.server.add-cookie(headers, campfire.server.set-cookie("last_room", int.to-string(RoomId.value(room-id)), campfire.server.cookie-expiry(now), false))
    }
}

test campfire.server.response-cookies/redirect-session {
    let built = serverRequest.new(campfire = campfire.server.test-request(option.none<String>()), session-cookie = option.none<String>())
    let cookies = campfire.server.response-cookies(campfire.server.unauthenticated(), built, "/rooms/1", campfire.server.test-context())
    expect match cookies { none => false; some headers => campfire.server.header-count(headers, "Set-Cookie") == 1 }
}

fn campfire.server.http-response(response: CampfireHttpResponse, built: ServerRequest, target: String, context: CampfireServerContext) -> HttpResponse {
    effects random.read
    doc "CampfireHttpResponse -> HttpResponse as the native renderer and cookie finalizer do: status, Cache-Control no-store, Content-Type by view, nosniff, Location for redirects, Set-Cookie, body. A response outside the contract is a bare 500."

    if bool.not(campfire.server.contract-valid?(response)) {
        campfire.server.status(500)
    } else {
        match campfire.server.response-cookies(response, built, target, context) {
            none => campfire.server.status(500)
            some cookies => {
                let content-type = if response.view == HttpView.empty() { "text/plain; charset=utf-8" } else { "text/html; charset=utf-8" }
                let base = [
                    httpHeader.new(name = "Cache-Control", value = "no-store"),
                    httpHeader.new(name = "Content-Type", value = content-type),
                    httpHeader.new(name = "X-Content-Type-Options", value = "nosniff")
                ]
                let located = if response.view == HttpView.redirect-root() {
                    list.append(base, httpHeader.new(name = "Location", value = "/"))
                } else if response.view == HttpView.redirect-session() {
                    list.append(base, httpHeader.new(name = "Location", value = "/session/new"))
                } else {
                    base
                }
                // campfire.server.show-room leaves a room body empty when it wrote the page to the response stream.
                httpResponse.new(status = response.status, headers = list.concat(located, cookies), body = response.body, streamed = response.view == HttpView.room() && response.body == "")
            }
        }
    }
}

test campfire.server.http-response/redirect {
    let built = serverRequest.new(campfire = campfire.server.test-request(option.none<String>()), session-cookie = option.none<String>())
    let sent = campfire.server.http-response(campfire.server.unauthenticated(), built, "/rooms/1", campfire.server.test-context())
    expect sent.status == 302
    expect http.header(sent.headers, "Location") == option.some<String>("/session/new")
    expect campfire.server.http-response(campfire.server.response(200, HttpView.login-page(), "", option.none<SessionToken>()), built, "/", campfire.server.test-context()).status == 500
}

// ------------------------------------------------------------------ entry

fn campfire.server.handle(request: HttpRequest, context: CampfireServerContext) -> HttpResponse {
    effects db.read, db.write, store.read, store.write, response.write, random.read
    doc "GET/HEAD /rooms/<id>: transport checks, the room-read chain, then the rendered response with its cookies."

    match campfire.server.request(request, context) {
        error response => response
        ok built => campfire.server.http-response(campfire.server.room-read(built.campfire, context), built, request.target, context)
    }
}

test campfire.server.handle/room-page {
    expect campfire.server.test-fixture() == 0
    let context = campfire.server.test-context()
    let cookie-header = string.concat("session_token=", cookie.escape(campfire.server.sign-session-token(context.signing-key, "session-token-1", 1791979200000000)))
    let request = httpRequest.new(method = "GET", target = "/rooms/1", headers = [httpHeader.new(name = "host", value = "127.0.0.1:13773"), httpHeader.new(name = "cookie", value = cookie-header), httpHeader.new(name = "user-agent", value = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36")], body = bytes.from-utf8(""), remote-ip = "127.0.0.1", now-microseconds = 1791979200000000)
    let sent = campfire.server.handle(request, context)
    expect sent.status == 200
    // Only last_room: no CSRF secret means no _campfire_session rewrite (as the Rust reference).
    expect campfire.server.header-count(sent.headers, "Set-Cookie") == 1
    expect match campfire.server.header-last(sent.headers, "Set-Cookie") { none => false; some value => string.starts-with(value, "last_room=1;") }
    // The page went to the response stream (attached tests have a worker store).
    expect sent.streamed && sent.body == ""
    let page = response.written(0)
    expect string.contains(page, "first message")
    expect bool.not(string.contains(page, "authenticity_token"))
    expect bool.not(string.contains(page, "csrf"))
    // No per-request tokens: the same request renders the same bytes, now from the worker cache.
    expect response.discard(0) == string.byte-length(page)
    expect campfire.server.handle(request, context).streamed
    expect response.written(0) == page
}

// --------------------------------------------------------------- fixtures

fn campfire.server.test-request(session-token: Option<String>) -> CampfireHttpRequest {
    doc "A GET /rooms/1 request for attached tests, from a supported browser at 2026-10-14T12:00:00Z."

    campfireHttpRequest.new(
        route = HttpRoute.room-show(),
        method = RequestMethod.get(),
        room-id = RoomId.new(1),
        now = UtcInstant.new(1791979200000000),
        remote-ip = RemoteIp.new("127.0.0.1"),
        user-agent = option.some<String>("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"),
        base-url = "http://127.0.0.1:13773",
        request-is-ssl = false,
        force-ssl = false,
        origin = option.none<String>(),
        fetch-site = option.none<String>(),
        session-token = session-token,
        bot-key = option.none<BotKey>(),
        message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
        login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
        logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()),
        accepts-turbo = false,
        accepts-html = true,
        last-room = option.none<String>(),
        csrf-token = option.none<String>())
}

test campfire.server.test-request/room {
    expect campfire.server.test-request(option.none<String>()).room-id == RoomId.new(1)
}

