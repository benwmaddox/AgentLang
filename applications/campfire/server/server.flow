    let page = streamedPage.new(written = true, rendered = ["<a>", "<b>"], rendered-keys = ["ka", "kb"])
    expect campfire.server.store-fragments(cache, page) == 2
    expect worker-cache.text(cache, "kb") == option.some<String>("<b>")
}

