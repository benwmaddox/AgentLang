// Campfire on the portable Flow HTTP host (docs/LINUX-SERVER-PLAN.md piece D).
// Entry words for scripts/Build-FlowHttpServer.ps1 -App campfire.server:
// worker-init derives the keys once per worker; handle serves GET/HEAD
// /rooms/<id> exactly as the native host (native_http_host.c) does.
//
// The room-read chain below mirrors campfire.http.room-read (http.flow) word
// for word, threading the worker context to the two steps that need a key:
// signed session_token verification and the creators' avatar tokens. Every
// policy, view, CSRF, user-agent and session-restore word is the shared one.

record CampfireServerContext {
    authority: String
    base-url: String
    encryption-key: Bytes
    signing-key: Bytes
    avatar-key: Bytes
    turbo-key: Bytes
}

fn campfire.server.worker-init(config: List<HttpHeader>) -> CampfireServerContext {
    doc "Derives the Rails cookie keys (authenticated encrypted cookie, 32 bytes; signed cookie, 64 bytes) and the active_record/signed_id key (64 bytes) from secret_key_base once per worker. authority is the Host the server answers to (127.0.0.1:<port>)."

    let secret = http.config(config, "secret_key_base")
    let authority = http.config(config, "authority")
    campfireServerContext.new(
        authority = authority,
        base-url = string.concat("http://", authority),
        encryption-key = campfire.server.rails-key(secret, "authenticated encrypted cookie", 32),
        signing-key = campfire.server.rails-key(secret, "signed cookie", 64),
        avatar-key = campfire.server.rails-key(secret, "active_record/signed_id", 64),
        turbo-key = campfire.server.rails-key(secret, "turbo/signed_stream_verifier_key", 64))
}

test campfire.server.worker-init/keys {
    let context = campfire.server.worker-init([httpHeader.new(name = "secret_key_base", value = "synthetic"), httpHeader.new(name = "authority", value = "127.0.0.1:1")])
    expect context.base-url == "http://127.0.0.1:1"
    expect bytes.length(context.encryption-key) == 32
    expect bytes.length(context.avatar-key) == 64
}

fn campfire.server.test-context() -> CampfireServerContext {
    doc "A worker context for attached tests: a synthetic secret_key_base and authority 127.0.0.1:13773."

    campfire.server.worker-init([httpHeader.new(name = "secret_key_base", value = "synthetic-secret-key-base-for-agentlang-tests-0123456789abcdef"), httpHeader.new(name = "authority", value = "127.0.0.1:13773")])
}

test campfire.server.test-context/authority {
    expect campfire.server.test-context().authority == "127.0.0.1:13773"
}

// ------------------------------------------------------------ route chain

fn campfire.server.response(status: Int, view: HttpView, text: String, refresh: Option<SessionToken>) -> CampfireHttpResponse {
    doc "campfire.http.response: no route data or cookie mutations other than a pending session refresh."

    campfireHttpResponse.new(
        status = status,
        view = view,
        text = text,
        room = option.none<RoomRow>(),
        message = option.none<MessageRow>(),
        refresh-session-token = refresh,
        remember-return-to = false,
        last-room = option.none<RoomId>(),
        new-csrf-token = option.none<String>(),
        body = campfire.views.body(status, view, text))
}

test campfire.server.response/empty {
    expect campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>()).body == ""
}

fn campfire.server.unauthenticated() -> CampfireHttpResponse {
    doc "campfire.http.unauthenticated: the login redirect with a return-to session mutation."

    campfireHttpResponse.new(
        status = 302,
        view = HttpView.redirect-session(),
        text = "",
        room = option.none<RoomRow>(),
        message = option.none<MessageRow>(),
        refresh-session-token = option.none<SessionToken>(),
        remember-return-to = true,
        last-room = option.none<RoomId>(),
        new-csrf-token = option.none<String>(),
        body = "")
}

test campfire.server.unauthenticated/redirect {
    expect campfire.server.unauthenticated().remember-return-to
}

fn campfire.server.refresh-token(restored: RestoredSession) -> Option<SessionToken> {
    if restored.refresh-cookie {
        option.some<SessionToken>(restored.session.token)
    } else {
        option.none<SessionToken>()
    }
}

test campfire.server.refresh-token/due {
    let session = sessionRow.new(id = SessionId.new(1), user-id = UserId.new(2), token = SessionToken.new("t"), ip-address = option.none<RemoteIp>(), user-agent = option.none<String>(), last-active-at = UtcInstant.new(0), created-at = UtcInstant.new(0), updated-at = UtcInstant.new(0))
    expect campfire.server.refresh-token(restoredSession.new(user = option.none<AuthUser>(), session = session, refresh-cookie = true)) == option.some<SessionToken>(SessionToken.new("t"))
    expect campfire.server.refresh-token(restoredSession.new(user = option.none<AuthUser>(), session = session, refresh-cookie = false)) == option.none<SessionToken>()
}

fn campfire.server.authenticated-user(request: CampfireHttpRequest, restored: RestoredSession, refresh: Option<SessionToken>) -> Result<AuthUser, CampfireHttpResponse> {
    doc "campfire.http.authenticated-user: CSRF, browser and current-user gates in order, keeping a pending refresh."

    if campfire.request.forgery-check-passed?(request.method, request.origin, request.fetch-site, request.base-url, true, request.request-is-ssl, request.force-ssl) {
        if campfire.browser.supported?(campfire.browser.from-user-agent(request.user-agent)) {
            match restored.user {
                none => result.error<AuthUser, CampfireHttpResponse>(campfire.server.response(500, HttpView.empty(), "", refresh))
                some user => result.ok<AuthUser, CampfireHttpResponse>(user)
            }
        } else {
            result.error<AuthUser, CampfireHttpResponse>(campfire.server.response(200, HttpView.incompatible-browser(), "", refresh))
        }
    } else {
        result.error<AuthUser, CampfireHttpResponse>(campfire.server.response(422, HttpView.empty(), "", refresh))
    }
}

test campfire.server.authenticated-user/missing-user {
    let request = campfire.server.test-request(option.none<String>())
    let session = sessionRow.new(id = SessionId.new(1), user-id = UserId.new(2), token = SessionToken.new("t"), ip-address = option.none<RemoteIp>(), user-agent = option.none<String>(), last-active-at = UtcInstant.new(0), created-at = UtcInstant.new(0), updated-at = UtcInstant.new(0))
    let outcome = campfire.server.authenticated-user(request, restoredSession.new(user = option.none<AuthUser>(), session = session, refresh-cookie = false), option.none<SessionToken>())
    expect match outcome { ok user => 0; error response => response.status } == 500
}

fn campfire.server.bot-or-redirect(request: CampfireHttpRequest) -> CampfireHttpResponse {
    effects db.read
    doc "campfire.http.bot-or-redirect: an active bot key is forbidden here; anything else redirects to sign-in."

    match request.bot-key {
        none => campfire.server.unauthenticated()
        some key => match campfire.users.authenticate-bot-key(key) {
            error failure => campfire.server.response(500, HttpView.empty(), "", option.none<SessionToken>())
            ok maybe-bot => match maybe-bot {
                none => campfire.server.unauthenticated()
                some bot => campfire.server.response(403, HttpView.empty(), "", option.none<SessionToken>())
            }
        }
    }
}

test campfire.server.bot-or-redirect/no-key {
    expect campfire.server.bot-or-redirect(campfire.server.test-request(option.none<String>())).status == 302
}

fn campfire.server.restore-request-session(request: CampfireHttpRequest, context: CampfireServerContext) -> Result<Option<RestoredSession>, DbError> {
    effects db.read, db.write
    doc "campfire.http.restore-request-session with the worker's signing key."

    let token = match request.session-token {
        none => option.none<SessionToken>()
        some signed => campfire.server.verify-session-token(context.signing-key, signed, request.now)
    }
    match token {
        none => result.ok<Option<RestoredSession>, DbError>(option.none<RestoredSession>())
        some verified => campfire.authentication.restore-session(verified, request.now, option.some<RemoteIp>(request.remote-ip), request.user-agent)
    }
}

test campfire.server.restore-request-session/unsigned {
    let request = campfire.server.test-request(option.some<String>("not-signed"))
    expect campfire.server.restore-request-session(request, campfire.server.test-context()) == result.ok<Option<RestoredSession>, DbError>(option.none<RestoredSession>())
}

fn campfire.server.room-message-error(failure: DbError) -> RoomMessageError {
    match failure {
        unavailable => RoomMessageError.database-unavailable()
        not-found => RoomMessageError.database-not-found()
        constraint-conflict => RoomMessageError.database-constraint-conflict()
        invalid-input => RoomMessageError.database-invalid-input()
    }
}

test campfire.server.room-message-error/mapping {
    expect campfire.server.room-message-error(DbError.not-found()) == RoomMessageError.database-not-found()
}

fn campfire.server.page-for-member(user-id: UserId, room-id: RoomId, context: CampfireServerContext) -> Result<List<MessageWithCreator>, RoomMessageError> {
    effects db.read, db.write
    doc "campfire.messages.page-for-member with the worker's avatar key."

    match campfire.membership.exists?(membershipKey.new(user-id = user-id, room-id = room-id)) {
        error failure => result.error<List<MessageWithCreator>, RoomMessageError>(campfire.server.room-message-error(failure))
        ok is-member => {
            if is-member {
                match campfire.server.last-page-with-creators(room-id, context.avatar-key) {
                    ok messages => result.ok<List<MessageWithCreator>, RoomMessageError>(messages)
                    error failure => result.error<List<MessageWithCreator>, RoomMessageError>(campfire.server.room-message-error(failure))
                }
            } else {
                result.error<List<MessageWithCreator>, RoomMessageError>(RoomMessageError.access-denied())
            }
        }
    }
}

test campfire.server.page-for-member/fixture {
    expect campfire.server.test-fixture() == 0
    let context = campfire.server.test-context()
    let page = campfire.server.page-for-member(UserId.new(1), RoomId.new(1), context)
    expect match page { error failure => -1; ok messages => campfire.server.message-count(messages) } == 2
    expect campfire.server.page-for-member(UserId.new(2), RoomId.new(1), context) == result.error<List<MessageWithCreator>, RoomMessageError>(RoomMessageError.access-denied())
}

fn campfire.server.message-count(messages: List<MessageWithCreator>) -> Int {
    var count = 0
    for message in messages {
        count = count + 1
    }
    count
}

test campfire.server.message-count/empty {
    expect campfire.server.message-count(list.empty<MessageWithCreator>()) == 0
}

// ------------------------------------------------------- fragment cache
//
// Rails renders the room's messages with `render partial: "messages/message",
// collection: @messages, cached: true`, and messages/_message wraps its whole
// body in `cache [ message, "presentation-v3" ]`: one fragment per message
// version, keyed by the template digest, the message id and its updated_at
// cache version, and nothing about the viewer, the creator or the room. On a
// hit Rails evaluates none of the partial. The fragments carry no authenticity
// tokens (forgery protection is by Origin and Sec-Fetch-Site, as in the Rust
// reference), so a cached fragment equals a fresh render. Editing a message or
// adding/removing a boost (Boost belongs_to :message, touch: true) changes
// updated_at and so the key; renaming the creator, changing their avatar or
// renaming the room does not, in Rails as here.

fn campfire.server.message-template-version() -> String {
    doc "Stands in for Rails' template digest of messages/_message and the partials it renders. The cache lives in the server process, so a rebuilt server starts empty; bump this when campfire.views.rails-message changes what it emits within one build."
    "views/messages/_message:flow-3"
}

test campfire.server.message-template-version/template {
    expect string.starts-with(campfire.server.message-template-version(), "views/messages/_message:")
}

fn campfire.server.message-cache-key(message: MessageWithCreator) -> String {
    doc "The Rails key of `cache [ message, presentation-v3 ]` with the record's cache version folded in (the cache keeps the first value per key): <template version>/messages/<id>-<updated_at ms>/presentation-v3."
    campfire.server.fragment-key(MessageId.value(message.id), message.updated-at-ms)
}

fn campfire.server.fragment-key(id: Int, updated-at-ms: Int) -> String {
    doc "campfire.server.message-cache-key from a message id and its updated_at (ms)."
    let record = string.concat(string.concat(string.concat("messages/", int.to-string(id)), "-"), int.to-string(updated-at-ms))
    cache.key([campfire.server.message-template-version(), record, "presentation-v3"])
}

test campfire.server.fragment-key/same-as-message-key {
    expect campfire.server.fragment-key(3, 9) == "views/messages/_message:flow-3/messages/3-9/presentation-v3"
}

test campfire.server.message-cache-key/version {
    let message = messageWithCreator.new(id = MessageId.new(3), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 1772465460123, client-message-id = "c", created-at = "", creator-name = "", creator-bio = "", creator-updated-at = "", creator-avatar-token = "", body = option.none<String>())
    expect campfire.server.message-cache-key(message) == "views/messages/_message:flow-3/messages/3-1772465460123/presentation-v3"
}

// ------------------------------------------------------ worker-store page
//
// With a worker store (--store-mb), the room page is written in order to the
// response stream: the layout head, each message's fragment, the layout tail.
// Fragments live in the worker cache (src/stdlib/worker-cache.flow) under the
// same Rails key as above. As in the Rust reference (Message::last_page, then
// presenter.message() only on a miss), the page first reads just the forty
// ids and updated_at values; creators, bodies and avatar tokens are loaded,
// in one query, only for the messages whose fragment is missing. A hit is
// copied from the store straight to the output. New fragments are stored
// after the page is written, so no put can evict a hit before it is sent.

record PageFrame {
    head: String
    tail: String
}

fn campfire.server.skip-whitespace(text: String, from: Int) -> Int {
    doc "The first index at or after from that is not a space, tab, CR or LF."
    var at = from
    for index in from..string.byte-length(text) {
        let byte = string.byte-at-or(text, index, 0)
        if byte != 32 && byte != 9 && byte != 10 && byte != 13 {
            break
        }
        at = index + 1
    }
    at
}

test campfire.server.skip-whitespace/stops {
    expect campfire.server.skip-whitespace("a\n  b", 1) == 4
    expect campfire.server.skip-whitespace("ab", 2) == 2
}

fn campfire.server.page-frame(chrome: PageChrome) -> PageFrame {
    doc "campfire.views.page with no messages, split where the messages go: after the opening tag of the messages container (the first '\">' after its data-messages-target attribute; attribute values are escaped, so page text cannot end it early) and the whitespace the layout puts before the messages. head ++ messages ++ tail is the page. The layout stays one compile-time-checked template."

    let empty = campfire.views.text(campfire.views.page(chrome, list.empty<Html>()))
    let split = match string.index-of(empty, "data-messages-target=\"messages\"", 0) {
        none => -1
        some at => match string.index-of(empty, "\">", at) {
            none => -1
            some end => campfire.server.skip-whitespace(empty, end + 2)
        }
    }
    if split < 0 {
        pageFrame.new(head = empty, tail = "")
    } else {
        pageFrame.new(
            head = match string.slice(empty, 0, split) { none => ""; some text => text },
            tail = match string.slice(empty, split, string.byte-length(empty) - split) { none => ""; some text => text })
    }
}

test campfire.server.page-frame/joins-to-page {
    let chrome = campfire.views.room-chrome(roomRow.new(id = RoomId.new(1), name = option.some<String>("Lo\">bby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "", updated-at = ""), authUser.new(id = UserId.new(1), name = "Ann", role = Role.member(), status = AuthUserStatus.active()), "http://x")
    let frame = campfire.server.page-frame(chrome)
    expect string.ends-with(frame.head, "/rooms/1/refresh\">\n    \n    \n")
    expect string.starts-with(frame.tail, "</div>")
    expect string.concat(frame.head, string.concat("<p>m</p>", frame.tail)) == campfire.views.text(campfire.views.page(chrome, [html"<p>m</p>"]))
}

fn campfire.server.worker-cache() -> WorkerCache {
    effects store.read, store.write
    doc "The worker cache over the whole worker store; not ready when the host gives no store."
    worker-cache.open(0, store.size())
}

fn campfire.server.find-message(messages: List<MessageWithCreator>, id: Int) -> Option<MessageWithCreator> {
    doc "The message with this id, if loaded."
    var found = option.none<MessageWithCreator>()
    for message in messages {
        if MessageId.value(message.id) == id {
            found = option.some<MessageWithCreator>(message)
            break
        }
    }
    found
}

test campfire.server.find-message/by-id {
    let message = messageWithCreator.new(id = MessageId.new(7), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 0, client-message-id = "c", created-at = "", creator-name = "", creator-bio = "", creator-updated-at = "", creator-avatar-token = "", body = option.none<String>())
    expect campfire.server.find-message([message], 7) == option.some<MessageWithCreator>(message)
    expect campfire.server.find-message([message], 8) == option.none<MessageWithCreator>()
}

fn campfire.server.missing-ids(cache: WorkerCache, keys: List<PageKey>) -> List<Int> {
    effects store.read
    doc "The page's message ids whose fragment is not in the worker cache."
    var missing = list.empty<Int>()
    for key in keys {
        if worker-cache.find(cache, campfire.server.fragment-key(key.id, key.updated-at-ms)) == option.none<CacheEntry>() {
            missing = list.append(missing, key.id)
        }
    }
    missing
}

record StreamedPage {
    written: Bool
    rendered: List<String>
    rendered-keys: List<String>
}

fn campfire.server.boosts-of(boosts: List<BoostView>, message-id: Int) -> List<BoostView> {
    doc "The boosts on one message, in their order."
    var mine = list.empty<BoostView>()
    for boost in boosts {
        if boost.message-id == message-id {
            mine = list.append(mine, boost)
        }
    }
    mine
}

test campfire.server.boosts-of/filters {
    let boost = boostView.new(id = 1, message-id = 5, booster-id = 2, booster-name = "B", booster-avatar-url = "/a", content = "x")
    expect list.count(campfire.server.boosts-of([boost], 5)) == 1
    expect list.count(campfire.server.boosts-of([boost], 6)) == 0
}

fn campfire.server.presentation(message: MessageWithCreator, users: List<MentionUser>) -> Html {
    doc "campfire.presentation.body-with of the message's stored body and the mention users loaded for its page."
    campfire.presentation.body-with(message.body, users)
}

fn campfire.server.page-mention-users(messages: List<MessageWithCreator>, avatar-key: Bytes) -> List<MentionUser> {
    effects db.read
    doc "Every user these messages mention, loaded in one query."
    var ids = list.empty<Int>()
    for message in messages {
        for id in campfire.presentation.mentioned-user-ids(message.body) {
            ids = list.append(ids, id)
        }
    }
    campfire.server.mention-users(ids, avatar-key)
}

test campfire.server.page-mention-users/none {
    expect campfire.server.test-fixture() == 0
    expect list.count(campfire.server.page-mention-users(list.empty<MessageWithCreator>(), bytes.from-utf8("k"))) == 0
}

test campfire.server.presentation/canonical-or-escaped {
    let message = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 0, client-message-id = "c5", created-at = "", creator-name = "", creator-bio = "", creator-updated-at = "", creator-avatar-token = "", body = option.some<String>("<p>hi</p>"))
    expect campfire.views.text(campfire.server.presentation(message, list.empty<MentionUser>())) == "<div class=\"lexxy-content\">\n  <p>hi</p>\n</div>\n"
    let unsafe = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 0, client-message-id = "c5", created-at = "", creator-name = "", creator-bio = "", creator-updated-at = "", creator-avatar-token = "", body = option.some<String>("<script>x</script>"))
    expect campfire.views.text(campfire.server.presentation(unsafe, list.empty<MentionUser>())) == "<div class=\"lexxy-content\">\n  &lt;script&gt;x&lt;/script&gt;\n</div>\n"
    let bell = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 0, client-message-id = "c5", created-at = "", creator-name = "", creator-bio = "", creator-updated-at = "", creator-avatar-token = "", body = option.some<String>("/play bell"))
    expect string.starts-with(campfire.views.text(campfire.server.presentation(bell, list.empty<MentionUser>())), "<div class=\"sound\"")
}

fn campfire.server.render-message(context: MessageContext, message: MessageWithCreator, boosts: List<BoostView>, users: List<MentionUser>) -> String {
    doc "messages/_message with the message's own boosts and its presentation."
    campfire.views.text(campfire.views.rails-message-presented(context, message, campfire.server.boosts-of(boosts, MessageId.value(message.id)), campfire.server.presentation(message, users)))
}

test campfire.server.render-message/boost-markup {
    let message = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(1), creator-id = UserId.new(1), created-at-ms = 0, updated-at-ms = 0, client-message-id = "c5", created-at = "2026-01-01 00:00:00", creator-name = "Ann", creator-bio = "", creator-updated-at = "2026-01-01 00:00:00", creator-avatar-token = "t", body = option.none<String>())
    let context = messageContext.new(room-id = "1", room-name = "Lobby", base-url = "http://x")
    let text = campfire.server.render-message(context, message, [boostView.new(id = 9, message-id = 5, booster-id = 2, booster-name = "Bo", booster-avatar-url = "/users/t2/avatar?v=1", content = "👀")], list.empty<MentionUser>())
    expect string.contains(text, "<div id=\"boost_9\"")
    expect string.contains(text, "class=\"txt-small txt-medium\"")
    expect string.contains(text, "aria-label=\"Bo boosted 👀\"")
}

fn campfire.server.write-messages(cache: WorkerCache, context: MessageContext, keys: List<PageKey>, loaded: List<MessageWithCreator>, boosts: List<BoostView>, users: List<MentionUser>) -> StreamedPage {
    effects store.read, response.write
    doc "Writes each message's fragment to the response stream in page order: a hit straight from the store, a miss rendered from the loaded rows. Returns the rendered fragments and their keys for storing afterwards; written is false when a fragment could not be written."
    var written = true
    var rendered = list.empty<String>()
    var rendered-keys = list.empty<String>()
    for key in keys {
        let cache-key = campfire.server.fragment-key(key.id, key.updated-at-ms)
        if bool.not(worker-cache.write-to-response(cache, cache-key)) {
            let found = campfire.server.find-message(loaded, key.id)
            if found == option.none<MessageWithCreator>() {
                written = false
            } else {
                let text = match found {
                    none => ""
                    some message => campfire.server.render-message(context, message, boosts, users)
                }
                written = written && response.write(text)
                rendered = list.append(rendered, text)
                rendered-keys = list.append(rendered-keys, cache-key)
            }
        }
    }
    streamedPage.new(written = written, rendered = rendered, rendered-keys = rendered-keys)
}

fn campfire.server.store-fragments(cache: WorkerCache, page: StreamedPage) -> Int {
    effects store.read, store.write
    doc "Stores the fragments a page rendered; returns how many were stored."
    var stored = 0
    for key, index in page.rendered-keys {
        let text = match list.get(page.rendered, index) { none => ""; some value => value }
        if worker-cache.put(cache, key, text) {
            stored = stored + 1
        }
    }
    stored
}

fn campfire.server.stream-room-page(chrome: PageChrome, keys: List<PageKey>, cache: WorkerCache, avatar-key: Bytes) -> Result<Int, DbError> {
    effects db.read, store.read, store.write, response.write
    doc "Writes the whole room page to the response stream (head, fragments, tail) and stores the fragments it rendered. Ok holds how many were stored; an error leaves a partial stream that the caller's non-streamed error response drops."

    let missing = campfire.server.missing-ids(cache, keys)
    let loaded-boosts = match campfire.server.boosts-for(missing, avatar-key) {
        error failure => result.error<List<BoostView>, DbError>(failure)
        ok boosts => result.ok<List<BoostView>, DbError>(boosts)
    }
    match campfire.server.messages-by-id(missing, avatar-key) {
        error failure => result.error<Int, DbError>(failure)
        ok loaded => match loaded-boosts {
          error failure => result.error<Int, DbError>(failure)
          ok boosts => {
            let context = messageContext.new(room-id = chrome.room-id, room-name = chrome.room-name, base-url = chrome.base-url)
            let frame = campfire.server.page-frame(chrome)
            let head = response.write(frame.head)
            let page = campfire.server.write-messages(cache, context, keys, loaded, boosts, campfire.server.page-mention-users(loaded, avatar-key))
            let tail = response.write(frame.tail)
            if head && page.written && tail {
                result.ok<Int, DbError>(campfire.server.store-fragments(cache, page))
            } else {
                result.error<Int, DbError>(DbError.unavailable())
            }
          }
        }
    }
}

fn campfire.server.streamed-page-for-member(user-id: UserId, chrome: PageChrome, room-id: RoomId, cache: WorkerCache, context: CampfireServerContext) -> Result<Int, RoomMessageError> {
    effects db.read, db.write, store.read, store.write, response.write
    doc "campfire.server.page-for-member for the worker-store page: membership, then the narrow page and its misses in one deferred transaction, written to the response stream."

    match campfire.membership.exists?(membershipKey.new(user-id = user-id, room-id = room-id)) {
        error failure => result.error<Int, RoomMessageError>(campfire.server.room-message-error(failure))
        ok is-member => {
            if bool.not(is-member) {
                result.error<Int, RoomMessageError>(RoomMessageError.access-denied())
            } else {
                match db.execute("BEGIN DEFERRED", list.empty<DbValue>()) {
                    error failure => result.error<Int, RoomMessageError>(campfire.server.room-message-error(campfire.server.db-error(failure)))
                    ok begun => {
                        let written = match campfire.server.page-keys-query(room-id) {
                            error failure => result.error<Int, DbError>(failure)
                            ok keys => campfire.server.stream-room-page(chrome, keys, cache, context.avatar-key)
                        }
                        match written {
                            error failure => {
                                campfire.server.rollback()
                                result.error<Int, RoomMessageError>(campfire.server.room-message-error(failure))
                            }
                            ok stored => match db.execute("COMMIT", list.empty<DbValue>()) {
                                error failure => {
                                    campfire.server.rollback()
                                    result.error<Int, RoomMessageError>(campfire.server.room-message-error(campfire.server.db-error(failure)))
                                }
                                ok committed => result.ok<Int, RoomMessageError>(stored)
                            }
                        }
                    }
                }
            }
        }
    }
}

// ----------------------------------------------------------- page chrome

fn campfire.server.number-stamp(timestamp: String) -> String {
    doc "Rails Time#to_fs(:number) of a stored UTC timestamp: the digits of 'YYYY-MM-DD HH:MM:SS', any fraction dropped."
    let whole = match string.slice(timestamp, 0, 19) { none => timestamp; some text => text }
    string.replace(string.replace(string.replace(whole, "-", ""), ":", ""), " ", "")
}

test campfire.server.number-stamp/drops-fraction {
    expect campfire.server.number-stamp("2026-01-02 16:00:00.123456") == "20260102160000"
    expect campfire.server.number-stamp("2026-01-01 16:00:00") == "20260101160000"
}

fn campfire.server.room-class(room: RoomRow) -> String {
    doc "The room's Rails STI class, as its GlobalID names it."
    match room.kind {
        open => "Rooms::Open"
        closed => "Rooms::Closed"
        direct => "Rooms::Direct"
    }
}

fn campfire.server.signed-stream-name(turbo-key: Bytes, room: RoomRow) -> String {
    doc "turbo_stream_from @room, :messages: Turbo's signed stream name, a Rails MessageVerifier (strict Base64 of the JSON string '<room GlobalID param>:messages', '--', hex HMAC-SHA256 with the turbo/signed_stream_verifier_key key). The GlobalID param is the unpadded URL-safe Base64 of gid://campfire/<class>/<id>."
    let gid = string.join(["gid://campfire/", campfire.server.room-class(room), "/", int.to-string(RoomId.value(room.id))])
    let name = string.concat(base64.url-encode(bytes.from-utf8(gid)), ":messages")
    let encoded = base64.encode(bytes.from-utf8(json.quote(name)))
    string.join([encoded, "--", hex.encode(crypto.hmac-sha256(turbo-key, bytes.from-utf8(encoded)))])
}

test campfire.server.signed-stream-name/shape {
    let room = roomRow.new(id = RoomId.new(486777696), name = option.some<String>("All Talk"), kind = RoomKind.closed(), creator-id = UserId.new(1), created-at = "", updated-at = "")
    let signed = campfire.server.signed-stream-name(bytes.from-utf8("k"), room)
    expect string.starts-with(signed, "IloybGtPaTh2WTJGdGNHWnBjbVV2VW05dmJYTTZPa05zYjNObFpDODBPRFkzTnpjMk9UWTptZXNzYWdlcyI=--")
    expect string.byte-length(signed) == 84 + 2 + 64
}

fn campfire.server.chrome-stamps(user-id: UserId) -> List<String> {
    effects db.read
    doc "The user's and the account's updated_at (the avatar and logo versions), empty when missing."
    match db.query("SELECT (SELECT updated_at FROM users WHERE id = $userId), (SELECT updated_at FROM accounts ORDER BY id LIMIT 1)", [db.int-param(UserId.value(user-id))]) {
        error failure => ["", ""]
        ok rows => match db.first-row(rows) {
            none => ["", ""]
            some row => [campfire.server.text-or-empty(db.optional-text(row, 0)), campfire.server.text-or-empty(db.optional-text(row, 1))]
        }
    }
}

fn campfire.server.page-chrome(room: RoomRow, user: AuthUser, base-url: String, context: CampfireServerContext) -> PageChrome {
    effects db.read
    doc "campfire.views.room-chrome with the values the layout needs from the database and the worker keys: the account logo version, the current user's fresh avatar path, the room's signed message stream and its loaded_at (room.updated_at in epoch ms)."
    let base = campfire.views.room-chrome(room, user, base-url)
    let stamps = campfire.server.chrome-stamps(user.id)
    let user-stamp = match list.get(stamps, 0) { none => ""; some text => text }
    let account-stamp = match list.get(stamps, 1) { none => ""; some text => text }
    let avatar = if user-stamp == "" { "" } else { string.join(["/users/", campfire.server.avatar-token(context.avatar-key, UserId.value(user.id)), "/avatar?v=", campfire.server.number-stamp(user-stamp)]) }
    let loaded-at = match campfire.server.parse-timestamp(room.updated-at) { none => ""; some micros => int.to-string(micros / 1000) }
    pageChrome.new(
        room-name = base.room-name,
        room-id = base.room-id,
        room-key = base.room-key,
        room-path = base.room-path,
        user-id = base.user-id,
        user-name = base.user-name,
        body-class = base.body-class,
        base-url = base.base-url,
        account-version = if account-stamp == "" { "" } else { campfire.server.number-stamp(account-stamp) },
        user-avatar-url = avatar,
        stream-name = campfire.server.signed-stream-name(context.turbo-key, room),
        loaded-at = loaded-at)
}

fn campfire.server.whole-room-page(chrome: PageChrome, messages: List<MessageWithCreator>, context: CampfireServerContext) -> String {
    effects db.read
    doc "The room page in one piece (no worker store): campfire.views.page around each message with its boosts, loaded in one query."
    var ids = list.empty<Int>()
    for message in messages {
        ids = list.append(ids, MessageId.value(message.id))
    }
    let boosts = match campfire.server.boosts-for(ids, context.avatar-key) { error failure => list.empty<BoostView>(); ok found => found }
    let message-context = messageContext.new(room-id = chrome.room-id, room-name = chrome.room-name, base-url = chrome.base-url)
    let users = campfire.server.page-mention-users(messages, context.avatar-key)
    var rendered = list.empty<Html>()
    for message in messages {
        rendered = list.append(rendered, campfire.views.rails-message-presented(message-context, message, campfire.server.boosts-of(boosts, MessageId.value(message.id)), campfire.server.presentation(message, users)))
    }
    campfire.views.text(campfire.views.page(chrome, rendered))
}

fn campfire.server.show-room(request: CampfireHttpRequest, user: AuthUser, room: RoomRow, refresh: Option<SessionToken>, context: CampfireServerContext) -> CampfireHttpResponse {
    effects db.read, db.write, store.read, store.write, response.write
    doc "campfire.http.show-room: the newest forty messages; last_room is set only when the cookie differs. With a worker store the page is written to the response stream through the worker cache (the response body is then empty); without one it is rendered in one piece."

    let cache = campfire.server.worker-cache()
    let remember-room = match request.last-room {
        none => option.some<RoomId>(room.id)
        some prior => {
            if prior == int.to-string(RoomId.value(room.id)) {
                option.none<RoomId>()
            } else {
                option.some<RoomId>(room.id)
            }
        }
    }
    if cache.ready {
        // The page goes to the response stream; an empty room body marks it streamed.
        match campfire.server.streamed-page-for-member(user.id, campfire.server.page-chrome(room, user, request.base-url, context), room.id, cache, context) {
            error failure => campfire.server.response(500, HttpView.empty(), "", refresh)
            ok stored => campfireHttpResponse.new(
                status = 200,
                view = HttpView.room(),
                text = "",
                room = option.some<RoomRow>(room),
                message = option.none<MessageRow>(),
                refresh-session-token = refresh,
                remember-return-to = false,
                last-room = remember-room,
                new-csrf-token = option.none<String>(),
                body = "")
        }
    } else {
        match campfire.server.page-for-member(user.id, room.id, context) {
            error failure => campfire.server.response(500, HttpView.empty(), "", refresh)
            ok messages => campfireHttpResponse.new(
                status = 200,
                view = HttpView.room(),
                text = "",
                room = option.some<RoomRow>(room),
                message = option.none<MessageRow>(),
                refresh-session-token = refresh,
                remember-return-to = false,
                last-room = remember-room,
                new-csrf-token = option.none<String>(),
                body = campfire.server.whole-room-page(campfire.server.page-chrome(room, user, request.base-url, context), messages, context))
        }
    }
}

test campfire.server.show-room/fixture {
    expect campfire.server.test-fixture() == 0
    let user = authUser.new(id = UserId.new(1), name = "Ann", role = Role.member(), status = AuthUserStatus.active())
    let room = roomRow.new(id = RoomId.new(1), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "2026-01-01 00:00:00", updated-at = "2026-01-01 00:00:00")
    let shown = campfire.server.show-room(campfire.server.test-request(option.none<String>()), user, room, option.none<SessionToken>(), campfire.server.test-context())
    expect shown.status == 200
    expect shown.last-room == option.some<RoomId>(RoomId.new(1))
    expect shown.new-csrf-token == option.none<String>()
    // Attached tests have a worker store, so the page went to the response stream.
    expect shown.body == ""
    let page = response.written(0)
    expect bool.not(string.contains(page, "authenticity_token"))
    expect string.contains(page, "second message")
    // Byte-identical to the one-piece page, cold and then from the worker cache.
    let whole = match campfire.server.page-for-member(user.id, room.id, campfire.server.test-context()) {
        error failure => ""
        ok messages => campfire.server.whole-room-page(campfire.server.page-chrome(room, user, "http://127.0.0.1:13773", campfire.server.test-context()), messages, campfire.server.test-context())
    }
    expect page == whole
    expect response.discard(0) == string.byte-length(whole)
    expect campfire.server.show-room(campfire.server.test-request(option.none<String>()), user, room, option.none<SessionToken>(), campfire.server.test-context()).body == ""
    expect response.written(0) == whole
    expect worker-cache.stats(campfire.server.worker-cache()).entries == 2
}

test campfire.server.worker-cache/ready-in-tests {
    expect campfire.server.worker-cache().ready
}

