    let context = messageContext.new(room-id = "1", room-name = "Lobby", base-url = "http://x")
    let text = campfire.server.render-message(context, message, [boostView.new(id = 9, message-id = 5, booster-id = 2, booster-name = "Bo", booster-bio = "", booster-avatar-url = "/users/t2/avatar?v=1", content = "👀")], campfire.server.no-extras())
    expect string.contains(text, "<div id=\"boost_9\"")
    expect string.contains(text, "class=\"txt-small txt-medium\"")
