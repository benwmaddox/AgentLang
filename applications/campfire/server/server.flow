fn campfire.server.test-get(target: String, extra: List<HttpHeader>) -> HttpRequest {
    doc "A signed-in GET for attached tests (the fixture's session-token-1, a supported browser)."
    let context = campfire.server.test-context()
    let cookie-header = string.concat("session_token=", cookie.escape(campfire.server.sign-session-token(context.signing-key, "session-token-1", 1791979200000000)))
    let headers = [httpHeader.new(name = "host", value = "127.0.0.1:13773"), httpHeader.new(name = "cookie", value = cookie-header), httpHeader.new(name = "user-agent", value = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36")]
    httpRequest.new(method = "GET", target = target, headers = list.concat(headers, extra), body = bytes.from-utf8(""), remote-ip = "127.0.0.1", now-microseconds = 1791979200000000)
}

test campfire.server.test-get/target {
    expect campfire.server.test-get("/rooms/1/messages", list.empty<HttpHeader>()).target == "/rooms/1/messages"
}

test campfire.server.messages-read/page-before {
    expect campfire.server.test-fixture() == 0
    let sent = campfire.server.handle(campfire.server.test-get("/rooms/1/messages?before=2", list.empty<HttpHeader>()), campfire.server.test-context())
    expect sent.status == 200 && bool.not(sent.streamed)
    expect string.starts-with(sent.body, "\n  <div id=\"message_c1\"") && bool.not(string.contains(sent.body, "message_c2"))
    expect http.header(sent.headers, "Cache-Control") == option.some<String>("max-age=0, private, must-revalidate")
    expect match http.header(sent.headers, "ETag") { none => false; some etag => string.starts-with(etag, "W/\"") }
}

test campfire.server.messages-index/statuses {
    expect campfire.server.test-fixture() == 0
    let context = campfire.server.test-context()
    let empty = campfire.server.handle(campfire.server.test-get("/rooms/1/messages?before=1", list.empty<HttpHeader>()), context)
    expect empty.status == 204 && empty.body == "" && http.header(empty.headers, "Cache-Control") == option.some<String>("no-cache")
    expect campfire.server.handle(campfire.server.test-get("/rooms/1/messages?after=99", list.empty<HttpHeader>()), context).status == 404
    expect campfire.server.handle(campfire.server.test-get("/rooms/2/messages", list.empty<HttpHeader>()), context).status == 404
    let last = campfire.server.handle(campfire.server.test-get("/rooms/1/messages", list.empty<HttpHeader>()), context)
    expect last.status == 200 && string.contains(last.body, "message_c2")
    let etag = match http.header(last.headers, "ETag") { none => ""; some value => value }
    let again = campfire.server.handle(campfire.server.test-get("/rooms/1/messages", [httpHeader.new(name = "if-none-match", value = etag)]), context)
    expect again.status == 304 && again.body == "" && http.header(again.headers, "ETag") == option.some<String>(etag)
}
