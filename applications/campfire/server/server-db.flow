// Room-read database operations on the stdlib db API (db.query / db.execute).
// Same SQL text, parameter order, transactions, row validation and error
// mapping as applications/campfire/Native/room_read_adapter.c. Parameters bind
// by first appearance ($now in the refresh UPDATE is one parameter).

record LoadedSession {
    row: SessionRow
    last-active-text: String
}

// db.rows records (report 305): row fields name the result columns in order
// (created_at for created-at); parameter fields name the SQL's $parameters.

record SessionDbRow {
    id: Int
    user-id: Int
    token: String
    ip-address: Option<String>
    user-agent: Option<String>
    last-active-at: String
    created-at: String
    updated-at: String
}

record UserDbRow {
    id: Int
    name: String
    role: Int
    status: Int
}

record RoomDbRow {
    id: Int
    name: Option<String>
    kind: String
    creator-id: Int
    created-at: String
    updated-at: String
}

record PageRow {
    id: Int
    room-id: Int
    creator-id: Int
    created-at-ms: Int
    updated-at-ms: Int
    client-message-id: String
    created-at: String
    creator-name: String
    creator-bio: String
    creator-updated-at: String
    body: Option<String>
}

record BoostDbRow {
    id: Int
    message-id: Int
    booster-id: Int
    content: String
    booster-name: String
    booster-updated-at: String
    booster-bio: String
}

record AttachmentDbRow {
    message-id: Int
    blob-id: Int
    filename: String
    content-type: Option<String>
    width: String
    height: String
}

record MentionDbRow {
    id: Int
    name: String
    bio: String
    updated-at: String
}

record Found {
    found: Bool
}

record ById {
    id: Int
}

record ByToken {
    token: String
}

record ByRoom {
    room-id: Int
}

record ByIds {
    ids: String
}

record UserRoom {
    user-id: Int
    room-id: Int
}

record RoomMessage {
    room-id: Int
    message-id: Int
}

record BotLookup {
    id: String
    token: String
}

record RefreshStep {
    retry: Bool
    outcome: Result<SessionRow, DbError>
}

fn campfire.server.cut(text: String, start: Int, count: Int) -> String {
    match string.slice(text, start, count) {
        none => ""
        some part => part
    }
}

fn campfire.server.digits(text: String, start: Int, count: Int) -> Int {
    doc "The decimal value of count ASCII digits at start, or -1 when any byte is not a digit."

    var value = 0
    var valid = true
    for index in start..start + count {
        let byte = string.byte-at-or(text, index, -1)
        if byte < 48 || byte > 57 {
            valid = false
        } else {
            value = value * 10 + byte - 48
        }
    }
    if valid { value } else { -1 }
}

test campfire.server.digits/values {
    expect campfire.server.digits("x2026-", 1, 4) == 2026
    expect campfire.server.digits("12a4", 0, 4) == -1
    expect campfire.server.digits("12", 1, 2) == -1
}

fn campfire.server.db-error(failure: SqlError) -> DbError {
    doc "SQLite extended result code to the Campfire error tag (room_read_adapter.c sqlite_error_tag)."

    let code = failure.code
    if code == 1811 {
        DbError.unavailable()
    } else if code == 1555 || code == 2067 {
        DbError.constraint-conflict()
    } else if code == 787 {
        DbError.not-found()
    } else if code % 256 == 19 {
        DbError.invalid-input()
    } else {
        DbError.unavailable()
    }
}

test campfire.server.db-error/codes {
    expect campfire.server.db-error(sqlError.new(code = 2067, message = "")) == DbError.constraint-conflict()
    expect campfire.server.db-error(sqlError.new(code = 787, message = "")) == DbError.not-found()
    expect campfire.server.db-error(sqlError.new(code = 1299, message = "")) == DbError.invalid-input()
    expect campfire.server.db-error(sqlError.new(code = 5, message = "")) == DbError.unavailable()
}

fn campfire.server.timestamp-space?(byte: Int) -> Bool {
    doc "The adapter trims bytes that are Unicode whitespace code points below 256."

    (byte >= 9 && byte <= 13) || byte == 32 || byte == 133 || byte == 160
}

fn campfire.server.month-days(year: Int, month: Int) -> Int {
    if month == 2 {
        if (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 { 29 } else { 28 }
    } else if month == 4 || month == 6 || month == 9 || month == 11 {
        30
    } else {
        31
    }
}

fn campfire.server.parse-timestamp(text: String) -> Option<Int> {
    doc "Rails/ISO date-time text to Unix microseconds (room_read_adapter.c try_parse_timestamp): trims whitespace, keeps six fractional digits, accepts Z, ' UTC' or +hh:mm offsets."

    let length = string.byte-length(text)
    var start = 0
    var end = length
    for index in 0..length {
        if bool.not(campfire.server.timestamp-space?(string.byte-at-or(text, index, -1))) {
            break
        }
        start = index + 1
    }
    for step in 0..length {
        if end <= start || bool.not(campfire.server.timestamp-space?(string.byte-at-or(text, end - 1, -1))) {
            break
        }
        end = end - 1
    }
    let year = campfire.server.digits(text, start, 4)
    let month = campfire.server.digits(text, start + 5, 2)
    let day = campfire.server.digits(text, start + 8, 2)
    let hour = campfire.server.digits(text, start + 11, 2)
    let minute = campfire.server.digits(text, start + 14, 2)
    let second = campfire.server.digits(text, start + 17, 2)
    let separator = string.byte-at-or(text, start + 10, -1)
    let shape-ok = end - start >= 19 && string.byte-at-or(text, start + 4, -1) == 45 && string.byte-at-or(text, start + 7, -1) == 45 && (separator == 32 || separator == 84) && string.byte-at-or(text, start + 13, -1) == 58 && string.byte-at-or(text, start + 16, -1) == 58
    let fields-ok = year >= 1 && month >= 1 && month <= 12 && day >= 1 && hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 && second >= 0 && second <= 59
    if bool.not(shape-ok) || bool.not(fields-ok) {
        option.none<Int>()
    } else if day > campfire.server.month-days(year, month) {
        option.none<Int>()
    } else {
        var suffix = start + 19
        var fraction = 0
        var fraction-ok = true
        if suffix < end && string.byte-at-or(text, suffix, -1) == 46 {
            suffix = suffix + 1
            let first-digit = suffix
            for index in first-digit..end {
                let byte = string.byte-at-or(text, index, -1)
                if byte < 48 || byte > 57 {
                    break
                }
                if index - first-digit < 6 {
                    fraction = fraction * 10 + byte - 48
                }
                suffix = index + 1
            }
            let count = suffix - first-digit
            if count == 0 {
                fraction-ok = false
            }
            for pad in count..6 {
                fraction = fraction * 10
            }
        }
        let rest = end - suffix
        let first = string.byte-at-or(text, suffix, -1)
        var offset-minutes = 0
        var offset-ok = true
        if rest == 0 {
            offset-ok = true
        } else if rest == 1 && first == 90 {
            offset-ok = true
        } else if rest == 4 && campfire.server.cut(text, suffix, 4) == " UTC" {
            offset-ok = true
        } else if rest == 6 && (first == 43 || first == 45) && string.byte-at-or(text, suffix + 3, -1) == 58 {
            let offset-hours = campfire.server.digits(text, suffix + 1, 2)
            let offset-mins = campfire.server.digits(text, suffix + 4, 2)
            if offset-hours < 0 || offset-mins < 0 || offset-hours > 14 || offset-mins > 59 || (offset-hours == 14 && offset-mins != 0) {
                offset-ok = false
            } else if first == 45 {
                offset-minutes = 0 - (offset-hours * 60 + offset-mins)
            } else {
                offset-minutes = offset-hours * 60 + offset-mins
            }
        } else {
            offset-ok = false
        }
        if bool.not(fraction-ok) || bool.not(offset-ok) {
            option.none<Int>()
        } else {
            let prior = year - 1
            var days = prior * 365 + prior / 4 - prior / 100 + prior / 400
            for earlier in 1..month {
                days = days + campfire.server.month-days(year, earlier)
            }
            days = days + day - 1
            let local = days * 86400000000 + hour * 3600000000 + minute * 60000000 + second * 1000000 + fraction
            let utc = local - offset-minutes * 60000000
            if utc < 0 || utc > 315537897599999999 {
                option.none<Int>()
            } else {
                option.some<Int>(utc - 62135596800000000)
            }
        }
    }
}

test campfire.server.parse-timestamp/forms {
    expect campfire.server.parse-timestamp("1970-01-01 00:00:00") == option.some<Int>(0)
    expect campfire.server.parse-timestamp("2026-10-14 12:30:05.123456") == option.some<Int>(1791981005123456)
    expect campfire.server.parse-timestamp(" 2026-10-14T12:30:05.1234569Z ") == option.some<Int>(1791981005123456)
    expect campfire.server.parse-timestamp("2026-10-14 12:30:05 UTC") == option.some<Int>(1791981005000000)
    expect campfire.server.parse-timestamp("2026-10-14T14:30:05+02:00") == option.some<Int>(1791981005000000)
    expect campfire.server.parse-timestamp("2024-02-29 00:00:00") == option.some<Int>(1709164800000000)
    expect campfire.server.parse-timestamp("2023-02-29 00:00:00") == option.none<Int>()
    expect campfire.server.parse-timestamp("2026-10-14 12:30:05.") == option.none<Int>()
    expect campfire.server.parse-timestamp("2026-10-14 12:30") == option.none<Int>()
    expect campfire.server.parse-timestamp("2026-10-14 12:30:05+15:00") == option.none<Int>()
}

fn campfire.server.two(value: Int) -> String {
    if value < 10 { string.concat("0", int.to-string(value)) } else { int.to-string(value) }
}

fn campfire.server.format-timestamp(micros: Int) -> String {
    doc "Unix microseconds as 'YYYY-MM-DD HH:MM:SS[.ffffff]' UTC (room_read_adapter.c format_timestamp)."

    var days = micros / 86400000000
    var day-micros = micros % 86400000000
    if day-micros < 0 {
        day-micros = day-micros + 86400000000
        days = days - 1
    }
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    let year = if month <= 2 { yoe + era * 400 + 1 } else { yoe + era * 400 }
    let hour = day-micros / 3600000000
    let minute = day-micros % 3600000000 / 60000000
    let second = day-micros % 60000000 / 1000000
    let fraction = day-micros % 1000000
    let year-text = string.concat(int.to-string(year / 1000 % 10), string.concat(int.to-string(year / 100 % 10), campfire.server.two(year % 100)))
    let base = string.join([year-text, "-", campfire.server.two(month), "-", campfire.server.two(day), " ", campfire.server.two(hour), ":", campfire.server.two(minute), ":", campfire.server.two(second)])
    if fraction == 0 {
        base
    } else {
        let padded = int.to-string(1000000 + fraction)
        string.concat(string.concat(base, "."), campfire.server.cut(padded, 1, 6))
    }
}

test campfire.server.format-timestamp/values {
    expect campfire.server.format-timestamp(0) == "1970-01-01 00:00:00"
    expect campfire.server.format-timestamp(1791981005123456) == "2026-10-14 12:30:05.123456"
    expect campfire.server.format-timestamp(1709164800000001) == "2024-02-29 00:00:00.000001"
    expect campfire.server.format-timestamp(-1) == "1969-12-31 23:59:59.999999"
}

fn campfire.server.optional-text-param(value: Option<String>) -> DbValue {
    match value {
        none => db.null-param()
        some text => db.text-param(text)
    }
}

fn campfire.server.session-row(row: SessionDbRow) -> Option<LoadedSession> {
    doc "Validates a sessions row: the three timestamps parseable."

    match campfire.server.parse-timestamp(row.last-active-at) {
        none => option.none<LoadedSession>()
        some active-at => match campfire.server.parse-timestamp(row.created-at) {
            none => option.none<LoadedSession>()
            some created-at => match campfire.server.parse-timestamp(row.updated-at) {
                none => option.none<LoadedSession>()
                some updated-at => {
                    let ip = match row.ip-address {
                        none => option.none<RemoteIp>()
                        some address => option.some<RemoteIp>(RemoteIp.new(address))
                    }
                    option.some<LoadedSession>(loadedSession.new(
                        row = sessionRow.new(
                            id = SessionId.new(row.id),
                            user-id = UserId.new(row.user-id),
                            token = SessionToken.new(row.token),
                            ip-address = ip,
                            user-agent = row.user-agent,
                            last-active-at = UtcInstant.new(active-at),
                            created-at = UtcInstant.new(created-at),
                            updated-at = UtcInstant.new(updated-at)),
                        last-active-text = row.last-active-at))
                }
            }
        }
    }
}

fn campfire.sessions.find-by-token(token: SessionToken) -> Result<Option<SessionRow>, DbError> {
    effects db.read

    match db.rows<SessionDbRow>("SELECT id, user_id, token, ip_address, user_agent, last_active_at, created_at, updated_at FROM sessions WHERE token = $token LIMIT 1", byToken.new(token = SessionToken.value(token))) {
        error failure => result.error<Option<SessionRow>, DbError>(campfire.server.db-error(failure))
        ok rows => match list.get(rows, 0) {
            none => result.ok<Option<SessionRow>, DbError>(option.none<SessionRow>())
            some row => match campfire.server.session-row(row) {
                none => result.error<Option<SessionRow>, DbError>(DbError.unavailable())
                some loaded => result.ok<Option<SessionRow>, DbError>(option.some<SessionRow>(loaded.row))
            }
        }
    }
}

fn campfire.server.session-by-id(session-id: SessionId) -> Result<Option<LoadedSession>, DbError> {
    effects db.read

    match db.rows<SessionDbRow>("SELECT id, user_id, token, ip_address, user_agent, last_active_at, created_at, updated_at FROM sessions WHERE id = $id LIMIT 1", byId.new(id = SessionId.value(session-id))) {
        error failure => result.error<Option<LoadedSession>, DbError>(campfire.server.db-error(failure))
        ok rows => match list.get(rows, 0) {
            none => result.ok<Option<LoadedSession>, DbError>(option.none<LoadedSession>())
            some row => match campfire.server.session-row(row) {
                none => result.error<Option<LoadedSession>, DbError>(DbError.unavailable())
                some loaded => result.ok<Option<LoadedSession>, DbError>(option.some<LoadedSession>(loaded))
            }
        }
    }
}

fn campfire.server.refresh-step(refresh: SessionRefresh, now-text: String) -> RefreshStep {
    effects db.read, db.write
    doc "One attempt: read the session; when its activity is older than the cutoff, update it guarded by the observed last_active_at text and read it again. Zero changed rows asks for a retry."

    match campfire.server.session-by-id(refresh.session-id) {
        error failure => refreshStep.new(retry = false, outcome = result.error<SessionRow, DbError>(failure))
        ok found => match found {
            none => refreshStep.new(retry = false, outcome = result.error<SessionRow, DbError>(DbError.not-found()))
            some current => {
                if UtcInstant.value(current.row.last-active-at) < UtcInstant.value(refresh.cutoff) {
                    let parameters = [
                        campfire.server.optional-text-param(match refresh.ip-address { none => option.none<String>(); some address => option.some<String>(RemoteIp.value(address)) }),
                        campfire.server.optional-text-param(refresh.user-agent),
                        db.text-param(now-text),
                        db.int-param(SessionId.value(refresh.session-id)),
                        db.text-param(current.last-active-text)
                    ]
                    match db.execute("UPDATE sessions SET ip_address = $ipAddress, user_agent = $userAgent, last_active_at = $now, updated_at = $now WHERE id = $sessionId AND last_active_at = $observedLastActiveAt", parameters) {
                        error failure => refreshStep.new(retry = false, outcome = result.error<SessionRow, DbError>(campfire.server.db-error(failure)))
                        ok changes => {
                            if changes == 0 {
                                refreshStep.new(retry = true, outcome = result.error<SessionRow, DbError>(DbError.unavailable()))
                            } else {
                                match campfire.server.session-by-id(refresh.session-id) {
                                    error failure => refreshStep.new(retry = false, outcome = result.error<SessionRow, DbError>(failure))
                                    ok reread => match reread {
                                        none => refreshStep.new(retry = false, outcome = result.error<SessionRow, DbError>(DbError.not-found()))
                                        some updated => refreshStep.new(retry = false, outcome = result.ok<SessionRow, DbError>(updated.row))
                                    }
                                }
                            }
                        }
                    }
                } else {
                    refreshStep.new(retry = false, outcome = result.ok<SessionRow, DbError>(current.row))
                }
            }
        }
    }
}

fn campfire.server.rollback() -> Bool {
    effects db.write
    match db.execute("ROLLBACK", list.empty<DbValue>()) {
        error failure => false
        ok changes => true
    }
}

fn campfire.sessions.refresh-before(refresh: SessionRefresh) -> Result<SessionRow, DbError> {
    effects db.read, db.write
    doc "Refreshes a session whose activity is older than the cutoff inside BEGIN IMMEDIATE, with up to three guarded attempts."

    if UtcInstant.value(refresh.cutoff) > UtcInstant.value(refresh.now) {
        result.error<SessionRow, DbError>(DbError.invalid-input())
    } else {
        let now-text = campfire.server.format-timestamp(UtcInstant.value(refresh.now))
        match db.execute("BEGIN IMMEDIATE", list.empty<DbValue>()) {
            error failure => result.error<SessionRow, DbError>(campfire.server.db-error(failure))
            ok begun => {
                var outcome = result.error<SessionRow, DbError>(DbError.unavailable())
                var finished = false
                for attempt in 0..3 {
                    if finished {
                        break
                    }
                    let step = campfire.server.refresh-step(refresh, now-text)
                    outcome = step.outcome
                    finished = bool.not(step.retry)
                }
                match outcome {
                    error failure => {
                        campfire.server.rollback()
                        result.error<SessionRow, DbError>(failure)
                    }
                    ok row => match db.execute("COMMIT", list.empty<DbValue>()) {
                        error failure => {
                            campfire.server.rollback()
                            result.error<SessionRow, DbError>(campfire.server.db-error(failure))
                        }
                        ok committed => result.ok<SessionRow, DbError>(row)
                    }
                }
            }
        }
    }
}

fn campfire.server.user-row(row: UserDbRow) -> Option<AuthUser> {
    doc "Validates a users row: role and status in 0..2."

    if row.role < 0 || row.role > 2 || row.status < 0 || row.status > 2 {
        option.none<AuthUser>()
    } else {
        let user-role = if row.role == 0 { Role.member() } else if row.role == 1 { Role.administrator() } else { Role.bot() }
        let user-status = if row.status == 0 { AuthUserStatus.active() } else if row.status == 1 { AuthUserStatus.deactivated() } else { AuthUserStatus.banned() }
        option.some<AuthUser>(authUser.new(id = UserId.new(row.id), name = row.name, role = user-role, status = user-status))
    }
}

fn campfire.server.user-result(outcome: Result<List<UserDbRow>, SqlError>) -> Result<Option<AuthUser>, DbError> {
    match outcome {
        error failure => result.error<Option<AuthUser>, DbError>(campfire.server.db-error(failure))
        ok rows => match list.get(rows, 0) {
            none => result.ok<Option<AuthUser>, DbError>(option.none<AuthUser>())
            some row => match campfire.server.user-row(row) {
                none => result.error<Option<AuthUser>, DbError>(DbError.unavailable())
                some user => result.ok<Option<AuthUser>, DbError>(option.some<AuthUser>(user))
            }
        }
    }
}

fn campfire.users.find-by-id(user-id: UserId) -> Result<Option<AuthUser>, DbError> {
    effects db.read

    campfire.server.user-result(db.rows<UserDbRow>("SELECT id, name, role, status FROM users WHERE id = $id LIMIT 1", byId.new(id = UserId.value(user-id))))
}

fn campfire.users.authenticate-bot-key(key: BotKey) -> Result<Option<AuthUser>, DbError> {
    effects db.read
    doc "Splits '<id>-<token>' at the first dash (the token ends at a second dash) and looks up an active bot with that token."

    let text = BotKey.value(key)
    match string.index-of(text, "-", 0) {
        none => result.ok<Option<AuthUser>, DbError>(option.none<AuthUser>())
        some dash => {
            let after = dash + 1
            let token-end = match string.index-of(text, "-", after) {
                none => string.byte-length(text)
                some second => second
            }
            let id = campfire.server.cut(text, 0, dash)
            let token = campfire.server.cut(text, after, token-end - after)
            campfire.server.user-result(db.rows<UserDbRow>("SELECT id, name, role, status FROM users WHERE status = 0 AND role = 2 AND id = $id AND bot_token = $token LIMIT 1", botLookup.new(id = id, token = token)))
        }
    }
}

fn campfire.server.room-kind(text: String) -> Option<RoomKind> {
    if text == "Rooms::Open" {
        option.some<RoomKind>(RoomKind.open())
    } else if text == "Rooms::Closed" {
        option.some<RoomKind>(RoomKind.closed())
    } else if text == "Rooms::Direct" {
        option.some<RoomKind>(RoomKind.direct())
    } else {
        option.none<RoomKind>()
    }
}

fn campfire.server.room-row(row: RoomDbRow) -> Option<RoomRow> {
    doc "Validates a rooms row: a known room type and parseable timestamps."
    let created-ok = campfire.server.parse-timestamp(row.created-at) != option.none<Int>()
    let updated-ok = campfire.server.parse-timestamp(row.updated-at) != option.none<Int>()
    match campfire.server.room-kind(row.kind) {
        none => option.none<RoomRow>()
        some room-kind => {
            if created-ok && updated-ok {
                option.some<RoomRow>(roomRow.new(
                    id = RoomId.new(row.id),
                    name = row.name,
                    kind = room-kind,
                    creator-id = UserId.new(row.creator-id),
                    created-at = row.created-at,
                    updated-at = row.updated-at))
            } else {
                option.none<RoomRow>()
            }
        }
    }
}

fn campfire.rooms.find-for-user(user-id: UserId, room-id: RoomId) -> Result<Option<RoomRow>, DbError> {
    effects db.read

    match db.rows<RoomDbRow>("SELECT rooms.id, rooms.name, rooms.type AS kind, rooms.creator_id, rooms.created_at, rooms.updated_at FROM rooms INNER JOIN memberships ON rooms.id = memberships.room_id WHERE memberships.user_id = $user_id AND rooms.id = $room_id LIMIT 1", userRoom.new(user-id = UserId.value(user-id), room-id = RoomId.value(room-id))) {
        error failure => result.error<Option<RoomRow>, DbError>(campfire.server.db-error(failure))
        ok rows => match list.get(rows, 0) {
            none => result.ok<Option<RoomRow>, DbError>(option.none<RoomRow>())
            some row => match campfire.server.room-row(row) {
                none => result.error<Option<RoomRow>, DbError>(DbError.unavailable())
                some room => result.ok<Option<RoomRow>, DbError>(option.some<RoomRow>(room))
            }
        }
    }
}

fn campfire.membership.exists?(key: MembershipKey) -> Result<Bool, DbError> {
    effects db.read

    match db.rows<Found>("SELECT EXISTS (SELECT 1 FROM \"memberships\" WHERE \"user_id\" = $user_id AND \"room_id\" = $room_id) AS found", userRoom.new(user-id = UserId.value(key.user-id), room-id = RoomId.value(key.room-id))) {
        error failure => result.error<Bool, DbError>(campfire.server.db-error(failure))
        ok rows => match list.get(rows, 0) {
            none => result.error<Bool, DbError>(DbError.unavailable())
            some row => result.ok<Bool, DbError>(row.found)
        }
    }
}

fn campfire.server.avatar-token(avatar-key: Bytes, user-id: Int) -> String {
    doc "Rails signed_id for user/avatar: unpadded URL-safe Base64 of the JSON envelope, '--', hex HMAC-SHA256 with the derived signed_id key."

    let envelope = string.concat("{\"_rails\":{\"data\":", string.concat(int.to-string(user-id), ",\"pur\":\"user/avatar\"}}"))
    let encoded = base64.url-encode(bytes.from-utf8(envelope))
    string.concat(encoded, string.concat("--", hex.encode(crypto.hmac-sha256(avatar-key, bytes.from-utf8(encoded)))))
}

fn campfire.server.int-or-zero(value: Option<Int>) -> Int {
    match value { none => 0; some number => number }
}

fn campfire.server.text-or-empty(value: Option<String>) -> String {
    match value { none => ""; some text => text }
}

fn campfire.server.page-row-ok?(row: PageRow) -> Bool {
    doc "A page row's two timestamps parse."
    campfire.server.parse-timestamp(row.created-at) != option.none<Int>() && campfire.server.parse-timestamp(row.creator-updated-at) != option.none<Int>()
}

fn campfire.server.message-row(row: PageRow, avatar-token: String) -> MessageWithCreator {
    doc "Maps one page row, with its creator's avatar token."

    messageWithCreator.new(
        id = MessageId.new(row.id),
        room-id = RoomId.new(row.room-id),
        creator-id = UserId.new(row.creator-id),
        created-at-ms = row.created-at-ms,
        updated-at-ms = row.updated-at-ms,
        client-message-id = row.client-message-id,
        created-at = row.created-at,
        creator-name = row.creator-name,
        creator-bio = row.creator-bio,
        creator-updated-at = row.creator-updated-at,
        creator-avatar-token = avatar-token,
        body = row.body)
}

fn campfire.server.known-token(ids: List<Int>, tokens: List<String>, user-id: Int) -> String {
    doc "The token already made for this user on this page (tokens[i] belongs to ids[i]), or empty. A token is never empty."
    var found = ""
    for id, index in ids {
        if id == user-id {
            found = match list.get(tokens, index) { none => ""; some token => token }
            break
        }
    }
    found
}

test campfire.server.known-token/lookup {
    expect campfire.server.known-token([3, 7], ["a", "b"], 7) == "b"
    expect campfire.server.known-token([3, 7], ["a", "b"], 5) == ""
}

fn campfire.server.message-page(rows: List<PageRow>, avatar-key: Bytes) -> Option<List<MessageWithCreator>> {
    doc "Maps the page rows in order; one avatar token per distinct creator on the page (an HMAC each; report 311). Any row whose timestamps do not parse rejects the page."

    var messages = list.empty<MessageWithCreator>()
    var valid = true
    var token-ids = list.empty<Int>()
    var tokens = list.empty<String>()
    for row in rows {
        valid = valid && campfire.server.page-row-ok?(row)
        var token = campfire.server.known-token(token-ids, tokens, row.creator-id)
        if token == "" {
            token = campfire.server.avatar-token(avatar-key, row.creator-id)
            token-ids = list.append(token-ids, row.creator-id)
            tokens = list.append(tokens, token)
        }
        messages = list.append(messages, campfire.server.message-row(row, token))
    }
    if valid {
        option.some<List<MessageWithCreator>>(messages)
    } else {
        option.none<List<MessageWithCreator>>()
    }
}

fn campfire.server.page-query(room-id: RoomId, avatar-key: Bytes) -> Result<List<MessageWithCreator>, DbError> {
    effects db.read

    match db.rows<Found>("SELECT EXISTS (SELECT 1 FROM \"rooms\" WHERE \"id\" = $room_id) AS found", byRoom.new(room-id = RoomId.value(room-id))) {
        error failure => result.error<List<MessageWithCreator>, DbError>(campfire.server.db-error(failure))
        ok exists-rows => {
            let exists = match list.get(exists-rows, 0) { none => false; some row => row.found }
            if bool.not(exists) {
                result.error<List<MessageWithCreator>, DbError>(DbError.not-found())
            } else {
                match db.rows<PageRow>("WITH page AS (SELECT id, ROW_NUMBER() OVER (ORDER BY created_at DESC) AS position FROM messages WHERE room_id = $room_id ORDER BY created_at DESC LIMIT 40) SELECT messages.id, messages.room_id, messages.creator_id, CAST(strftime('%s', messages.created_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.created_at), 4) AS INTEGER) AS created_at_ms, CAST(strftime('%s', messages.updated_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.updated_at), 4) AS INTEGER) AS updated_at_ms, messages.client_message_id, messages.created_at, users.name AS creator_name, COALESCE(users.bio, '') AS creator_bio, users.updated_at AS creator_updated_at, rich_text.body FROM page INNER JOIN messages ON messages.id = page.id INNER JOIN users ON users.id = messages.creator_id LEFT JOIN action_text_rich_texts AS rich_text ON rich_text.record_id = messages.id AND rich_text.record_type = 'Message' AND rich_text.name = 'body' ORDER BY page.position DESC", byRoom.new(room-id = RoomId.value(room-id))) {
                    error failure => result.error<List<MessageWithCreator>, DbError>(campfire.server.db-error(failure))
                    ok rows => match campfire.server.message-page(rows, avatar-key) {
                        none => result.error<List<MessageWithCreator>, DbError>(DbError.unavailable())
                        some messages => result.ok<List<MessageWithCreator>, DbError>(messages)
                    }
                }
            }
        }
    }
}

record PageKey {
    id: Int
    updated-at-ms: Int
}

fn campfire.server.page-keys-around(room-id: RoomId, message-id: Int) -> Result<List<PageKey>, DbError> {
    effects db.read
    doc "messages.page_around(message) for /rooms/<id>/@<message>: the forty before it (created_at <, newest forty, oldest first), the message, the forty after it (created_at >, oldest forty). The last page when the room has no such message (rooms#show's find_by fallback)."

    match db.rows<Found>("SELECT EXISTS (SELECT 1 FROM messages INNER JOIN users ON users.id = messages.creator_id WHERE messages.room_id = $room_id AND messages.id = $message_id) AS found", roomMessage.new(room-id = RoomId.value(room-id), message-id = message-id)) {
        error failure => result.error<List<PageKey>, DbError>(campfire.server.db-error(failure))
        ok found-rows => {
            let found = match list.get(found-rows, 0) { none => false; some row => row.found }
            if bool.not(found) {
                campfire.server.page-keys-query(room-id)
            } else {
                match db.rows<PageKey>("WITH target AS (SELECT id, created_at FROM messages WHERE room_id = $room_id AND id = $message_id), before AS (SELECT messages.id AS id, ROW_NUMBER() OVER (ORDER BY messages.created_at DESC) AS position FROM messages, target WHERE messages.room_id = $room_id AND messages.created_at < target.created_at ORDER BY messages.created_at DESC LIMIT 40), after AS (SELECT messages.id AS id, ROW_NUMBER() OVER (ORDER BY messages.created_at) AS position FROM messages, target WHERE messages.room_id = $room_id AND messages.created_at > target.created_at ORDER BY messages.created_at LIMIT 40), page AS (SELECT id, 0 AS part, -position AS position FROM before UNION ALL SELECT id, 1, 0 FROM target UNION ALL SELECT id, 2, position FROM after) SELECT messages.id, CAST(strftime('%s', messages.updated_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.updated_at), 4) AS INTEGER) AS updated_at_ms FROM page INNER JOIN messages ON messages.id = page.id INNER JOIN users ON users.id = messages.creator_id ORDER BY page.part, page.position", roomMessage.new(room-id = RoomId.value(room-id), message-id = message-id)) {
                    error failure => result.error<List<PageKey>, DbError>(campfire.server.db-error(failure))
                    ok rows => result.ok<List<PageKey>, DbError>(rows)
                }
            }
        }
    }
}

fn campfire.server.page-keys-query(room-id: RoomId) -> Result<List<PageKey>, DbError> {
    effects db.read
    doc "The page's message ids and updated_at (ms), oldest first: the same forty rows as campfire.server.page-query (creator present), without their columns. Like the Rust reference's Message::last_page, it reads only what the fragment keys need."

    match db.rows<Found>("SELECT EXISTS (SELECT 1 FROM \"rooms\" WHERE \"id\" = $room_id) AS found", byRoom.new(room-id = RoomId.value(room-id))) {
        error failure => result.error<List<PageKey>, DbError>(campfire.server.db-error(failure))
        ok exists-rows => {
            let exists = match list.get(exists-rows, 0) { none => false; some row => row.found }
            if bool.not(exists) {
                result.error<List<PageKey>, DbError>(DbError.not-found())
            } else {
                match db.rows<PageKey>("WITH page AS (SELECT id, ROW_NUMBER() OVER (ORDER BY created_at DESC) AS position FROM messages WHERE room_id = $room_id ORDER BY created_at DESC LIMIT 40) SELECT messages.id, CAST(strftime('%s', messages.updated_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.updated_at), 4) AS INTEGER) AS updated_at_ms FROM page INNER JOIN messages ON messages.id = page.id INNER JOIN users ON users.id = messages.creator_id ORDER BY page.position DESC", byRoom.new(room-id = RoomId.value(room-id))) {
                    error failure => result.error<List<PageKey>, DbError>(campfire.server.db-error(failure))
                    ok rows => result.ok<List<PageKey>, DbError>(rows)
                }
            }
        }
    }
}

fn campfire.server.id-list(ids: List<Int>) -> String {
    doc "Ids as a JSON array, for json_each."
    var text = "["
    for id, index in ids {
        if index > 0 {
            text = string.concat(text, ",")
        }
        text = string.concat(text, int.to-string(id))
    }
    string.concat(text, "]")
}

test campfire.server.id-list/json {
    expect campfire.server.id-list([3, 14]) == "[3,14]"
    expect campfire.server.id-list(list.empty<Int>()) == "[]"
}

fn campfire.server.messages-by-id(ids: List<Int>, avatar-key: Bytes) -> Result<List<MessageWithCreator>, DbError> {
    effects db.read
    doc "The page rows (as campfire.server.page-query maps them) of just these message ids, in one query; any order."

    if list.count(ids) == 0 {
        result.ok<List<MessageWithCreator>, DbError>(list.empty<MessageWithCreator>())
    } else {
        match db.rows<PageRow>("SELECT messages.id, messages.room_id, messages.creator_id, CAST(strftime('%s', messages.created_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.created_at), 4) AS INTEGER) AS created_at_ms, CAST(strftime('%s', messages.updated_at) AS INTEGER) * 1000 + CAST(substr(strftime('%f', messages.updated_at), 4) AS INTEGER) AS updated_at_ms, messages.client_message_id, messages.created_at, users.name AS creator_name, COALESCE(users.bio, '') AS creator_bio, users.updated_at AS creator_updated_at, rich_text.body FROM messages INNER JOIN users ON users.id = messages.creator_id LEFT JOIN action_text_rich_texts AS rich_text ON rich_text.record_id = messages.id AND rich_text.record_type = 'Message' AND rich_text.name = 'body' WHERE messages.id IN (SELECT value FROM json_each($ids))", byIds.new(ids = campfire.server.id-list(ids))) {
            error failure => result.error<List<MessageWithCreator>, DbError>(campfire.server.db-error(failure))
            ok rows => match campfire.server.message-page(rows, avatar-key) {
                none => result.error<List<MessageWithCreator>, DbError>(DbError.unavailable())
                some messages => result.ok<List<MessageWithCreator>, DbError>(messages)
            }
        }
    }
}

fn campfire.server.boosts-for(ids: List<Int>, avatar-key: Bytes) -> Result<List<BoostView>, DbError> {
    effects db.read
    doc "message.boosts.ordered (created_at) with each booster, for these message ids, in one query; the booster's fresh avatar path is signed here."

    if list.count(ids) == 0 {
        result.ok<List<BoostView>, DbError>(list.empty<BoostView>())
    } else {
        match db.rows<BoostDbRow>("SELECT boosts.id, boosts.message_id, boosts.booster_id, boosts.content, users.name AS booster_name, users.updated_at AS booster_updated_at, COALESCE(users.bio, '') AS booster_bio FROM boosts INNER JOIN users ON users.id = boosts.booster_id WHERE boosts.message_id IN (SELECT value FROM json_each($ids)) ORDER BY boosts.created_at", byIds.new(ids = campfire.server.id-list(ids))) {
            error failure => result.error<List<BoostView>, DbError>(campfire.server.db-error(failure))
            ok rows => {
                var boosts = list.empty<BoostView>()
                var token-ids = list.empty<Int>()
                var tokens = list.empty<String>()
                for row in rows {
                    let booster = row.booster-id
                    let stamp = row.booster-updated-at
                    // One token per distinct booster (report 311).
                    var token = campfire.server.known-token(token-ids, tokens, booster)
                    if token == "" {
                        token = campfire.server.avatar-token(avatar-key, booster)
                        token-ids = list.append(token-ids, booster)
                        tokens = list.append(tokens, token)
                    }
                    boosts = list.append(boosts, boostView.new(
                        id = row.id,
                        message-id = row.message-id,
                        booster-id = booster,
                        booster-name = row.booster-name,
                        booster-bio = row.booster-bio,
                        booster-avatar-url = campfire.route.avatar-src(token, string.replace(string.replace(string.replace(match string.slice(stamp, 0, 19) { none => stamp; some text => text }, "-", ""), ":", ""), " ", "")),
                        content = row.content))
                }
                result.ok<List<BoostView>, DbError>(boosts)
            }
        }
    }
}

fn campfire.server.storage-token(storage-key: Bytes, data: String, purpose: String) -> String {
    doc "ActiveStorage.verifier.generate(data, purpose:): strict Base64 of the JSON envelope, '--', hex HMAC-SHA1 with the ActiveStorage key. data is already JSON."
    let encoded = base64.encode(bytes.from-utf8(string.join(["{\"_rails\":{\"data\":", data, ",\"pur\":\"", purpose, "\"}}"])))
    string.join([encoded, "--", hex.encode(crypto.hmac-sha1(storage-key, bytes.from-utf8(encoded)))])
}

test campfire.server.storage-token/shape {
    let token = campfire.server.storage-token(bytes.from-utf8("k"), "5", "blob_id")
    expect string.starts-with(token, "eyJfcmFpbHMiOnsiZGF0YSI6NSwicHVyIjoiYmxvYl9pZCJ9fQ==--") && string.byte-length(token) == 52 + 2 + 40
}

fn campfire.server.attachments-for(ids: List<Int>, storage-key: Bytes) -> Result<List<MessageAttachment>, DbError> {
    effects db.read
    doc "The attached file of each of these messages (has_one_attached :attachment), in one query: its blob row, metadata dimensions as SQLite writes the JSON numbers, and the signed blob id and preview variation key."
    if list.count(ids) == 0 {
        result.ok<List<MessageAttachment>, DbError>(list.empty<MessageAttachment>())
    } else {
        match db.rows<AttachmentDbRow>("SELECT a.record_id AS message_id, b.id AS blob_id, b.filename, b.content_type, CASE WHEN json_type(b.metadata, '$.width') IN ('integer', 'real') THEN CAST(json_extract(b.metadata, '$.width') AS TEXT) ELSE '' END AS width, CASE WHEN json_type(b.metadata, '$.height') IN ('integer', 'real') THEN CAST(json_extract(b.metadata, '$.height') AS TEXT) ELSE '' END AS height FROM active_storage_attachments AS a INNER JOIN active_storage_blobs AS b ON b.id = a.blob_id WHERE a.record_type = 'Message' AND a.name = 'attachment' AND a.record_id IN (SELECT value FROM json_each($ids))", byIds.new(ids = campfire.server.id-list(ids))) {
            error failure => result.error<List<MessageAttachment>, DbError>(campfire.server.db-error(failure))
            ok rows => {
                var attachments = list.empty<MessageAttachment>()
                for row in rows {
                    let filename = row.filename
                    let kind = campfire.server.text-or-empty(row.content-type)
                    let variation = campfire.presentation.preview-variation(filename, kind)
                    attachments = list.append(attachments, messageAttachment.new(
                        message-id = row.message-id,
                        filename = filename,
                        content-type = kind,
                        width = row.width,
                        height = row.height,
                        blob-token = campfire.server.storage-token(storage-key, int.to-string(row.blob-id), "blob_id"),
                        preview-token = if variation == "" { "" } else { campfire.server.storage-token(storage-key, variation, "variation") }))
                }
                result.ok<List<MessageAttachment>, DbError>(attachments)
            }
        }
    }
}

fn campfire.server.mention-users(ids: List<Int>, avatar-key: Bytes) -> List<MentionUser> {
    effects db.read
    doc "The users these ids name, as mentions render them (name, bio, fresh avatar path), in one query. Missing users are left out (Rails renders a missing attachable as nothing)."
    if list.count(ids) == 0 {
        list.empty<MentionUser>()
    } else {
        match db.rows<MentionDbRow>("SELECT id, name, COALESCE(bio, '') AS bio, updated_at FROM users WHERE id IN (SELECT value FROM json_each($ids))", byIds.new(ids = campfire.server.id-list(ids))) {
            error failure => list.empty<MentionUser>()
            ok rows => {
                var users = list.empty<MentionUser>()
                for row in rows {
                    let id = row.id
                    let stamp = row.updated-at
                    users = list.append(users, mentionUser.new(
                        id = id,
                        name = row.name,
                        bio = row.bio,
                        avatar-url = campfire.route.avatar-src(campfire.server.avatar-token(avatar-key, id), string.replace(string.replace(string.replace(match string.slice(stamp, 0, 19) { none => stamp; some text => text }, "-", ""), ":", ""), " ", ""))))
                }
                users
            }
        }
    }
}

fn campfire.server.last-page-with-creators(room-id: RoomId, avatar-key: Bytes) -> Result<List<MessageWithCreator>, DbError> {
    effects db.read, db.write
    doc "The room's newest forty messages, oldest first, with creators and avatar tokens, read in one deferred transaction (campfire.messages.last-page-with-creators)."

    match db.execute("BEGIN DEFERRED", list.empty<DbValue>()) {
        error failure => result.error<List<MessageWithCreator>, DbError>(campfire.server.db-error(failure))
        ok begun => match campfire.server.page-query(room-id, avatar-key) {
            error failure => {
                campfire.server.rollback()
                result.error<List<MessageWithCreator>, DbError>(failure)
            }
            ok messages => match db.execute("COMMIT", list.empty<DbValue>()) {
                error failure => {
                    campfire.server.rollback()
                    result.error<List<MessageWithCreator>, DbError>(campfire.server.db-error(failure))
                }
                ok committed => result.ok<List<MessageWithCreator>, DbError>(messages)
            }
        }
    }
}
