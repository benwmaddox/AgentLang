test campfire.sounds.all/count {
    expect list.count(campfire.sounds.all()) == 56
}

fn campfire.sounds.find(name: String) -> Option<Sound> {
    doc "Sound.find_by_name."
    var found = option.none<Sound>()
    for sound in campfire.sounds.all() {
        if sound.name == name {
            found = option.some<Sound>(sound)
            break
        }
    }
    found
}

test campfire.sounds.find/known {
    expect match campfire.sounds.find("bell") { none => ""; some sound => sound.audio } == "/assets/bell-4dd04376.mp3"
    expect campfire.sounds.find("nope") == option.none<Sound>()
}

fn campfire.sounds.command(plain-text: String) -> Option<Sound> {
    doc "Message#sound: the plain-text body is exactly '/play <name>' (name of word characters) for a known sound."
    if bool.not(string.starts-with(plain-text, "/play ")) {
        option.none<Sound>()
    } else {
        let name = match string.slice(plain-text, 6, string.byte-length(plain-text) - 6) { none => ""; some text => text }
        var word = string.byte-length(name) > 0
        for index in 0..string.byte-length(name) {
            let byte = string.byte-at-or(name, index, 0)
            if bool.not((byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95) {
                word = false
            }
        }
        if word { campfire.sounds.find(name) } else { option.none<Sound>() }
    }
}

test campfire.sounds.command/play {
    expect campfire.sounds.command("/play 56k") != option.none<Sound>()
    expect campfire.sounds.command("/play bell!") == option.none<Sound>()
    expect campfire.sounds.command("/play nosuch") == option.none<Sound>()
    expect campfire.sounds.command("play bell") == option.none<Sound>()
}

fn campfire.views.sound(sound: Sound) -> Html {
    effects none
    doc "MessagesHelper#message_sound_presentation: the play button and the sound's image or text."
    let visual = if sound.image == "" { Html.new(sound.text) } else { html"<img width=\"{int.to-string(sound.width)}\" height=\"{int.to-string(sound.height)}\" class=\"align--middle\" src=\"{sound.image}\" />" }
    html"<div class=\"sound\" data-controller=\"sound\" data-action=\"messages:play-&gt;sound#play\" data-sound-url-value=\"{sound.audio}\"><button class=\"btn btn--plain\" data-action=\"sound#play\">🔊</button>{visual}</div>"
}

test campfire.views.sound/rails {
    let bell = match campfire.sounds.find("bell") { none => html""; some sound => campfire.views.sound(sound) }
    expect Html.value(bell) == "<div class=\"sound\" data-controller=\"sound\" data-action=\"messages:play-&gt;sound#play\" data-sound-url-value=\"/assets/bell-4dd04376.mp3\"><button class=\"btn btn--plain\" data-action=\"sound#play\">🔊</button>🔔</div>"
    let modem = match campfire.sounds.find("56k") { none => html""; some sound => campfire.views.sound(sound) }
    expect Html.value(modem) == "<div class=\"sound\" data-controller=\"sound\" data-action=\"messages:play-&gt;sound#play\" data-sound-url-value=\"/assets/56k-67359aa6.mp3\"><button class=\"btn btn--plain\" data-action=\"sound#play\">🔊</button><img width=\"79\" height=\"33\" class=\"align--middle\" src=\"/assets/sounds/56k-1567db5b.webp\" /></div>"
}
