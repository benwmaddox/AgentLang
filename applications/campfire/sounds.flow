// Campfire's built-in sounds (reference app/models/sound.rb) with the digested asset
// paths of the Rails build's asset manifest. Generated by .agentlang/pages-285/sounds.rb
// (56 sounds); regenerate when the reference assets change.

record Sound {
    name: String
    audio: String
    image: String
    width: Int
    height: Int
    text: String
}

