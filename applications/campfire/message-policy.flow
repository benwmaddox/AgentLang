fn user.can-administer?(user: User, creator-id: Option<UserId>, is-new: Bool) -> Bool {
    effects none
    doc "Applies Campfire's administrator, creator, or new-record administration rule."

    if user.role == Role.administrator() {
        true
    } else {
        match creator-id {
            some record-creator-id => {
                if record-creator-id == user.id {
                    true
                } else {
                    is-new
                }
            }
            none => is-new
        }
    }
}

test user.can-administer?/member-self-existing {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.some<UserId>(UserId.new(11)), false)
    => true
}

test user.can-administer?/member-self-new {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.some<UserId>(UserId.new(11)), true)
    => true
}

test user.can-administer?/member-other-existing {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.some<UserId>(UserId.new(22)), false)
    => false
}

test user.can-administer?/member-other-new {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.some<UserId>(UserId.new(22)), true)
    => true
}

test user.can-administer?/member-no-creator-existing {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.none<UserId>(), false)
    => false
}

test user.can-administer?/member-no-creator-new {
    user.can-administer?(user.new(id = UserId.new(11), role = Role.member()), option.none<UserId>(), true)
