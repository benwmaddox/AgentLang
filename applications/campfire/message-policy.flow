fn message.can-administer?(user: User, message: ExistingMessage) -> Bool {
    effects none
    doc "Applies the shared policy to an existing message using its creator ID."

    user.can-administer?(option.some<UserId>(message.creator-id), false)
}

test message.can-administer?/member-own-message {
    message.can-administer?(user.new(id = UserId.new(11), role = Role.member()), existingMessage.new(creator-id = UserId.new(11)))
    => true
}

test message.can-administer?/member-other-message {
    message.can-administer?(user.new(id = UserId.new(11), role = Role.member()), existingMessage.new(creator-id = UserId.new(22)))
    => false
}

test message.can-administer?/administrator-own-message {
    message.can-administer?(user.new(id = UserId.new(11), role = Role.administrator()), existingMessage.new(creator-id = UserId.new(11)))
    => true
}

test message.can-administer?/administrator-other-message {
    message.can-administer?(user.new(id = UserId.new(11), role = Role.administrator()), existingMessage.new(creator-id = UserId.new(22)))
