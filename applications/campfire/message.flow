record MessageContext {
    room-id: String
    room-name: String
    base-url: String
}

record BoostView {
    id: Int
    message-id: Int
    booster-id: Int
    booster-name: String
    booster-bio: String
    booster-avatar-url: String
    content: String
}

record MessageShown {
    emoji: Bool
    actions: Html
}

fn campfire.views.blank?(text: String) -> Bool {
    effects none
    doc "Ruby's blank? for a String, over ASCII whitespace (space, tab, LF, VT, FF, CR)."
    var blank = true
    for index in 0..string.byte-length(text) {
        let byte = string.byte-at-or(text, index, 0)
        if byte != 32 && (byte < 9 || byte > 13) {
            blank = false
            break
        }
    }
    blank
}

test campfire.views.blank?/whitespace {
    expect campfire.views.blank?("") && campfire.views.blank?(" \t\n") && bool.not(campfire.views.blank?(" x"))
}

fn campfire.views.user-title(name: String, bio: String) -> String {
    effects none
    doc "User#title: the name and bio that are not blank, joined by ' – '."
    let has-name = bool.not(campfire.views.blank?(name))
    let has-bio = bool.not(campfire.views.blank?(bio))
    if has-name && has-bio { string.join([name, " – ", bio]) } else if has-name { name } else if has-bio { bio } else { "" }
}

test campfire.views.user-title/blank-bio {
    expect campfire.views.user-title("JZ", "Designer") == "JZ – Designer" && campfire.views.user-title("JZ", " ") == "JZ" && campfire.views.user-title("JZ", "") == "JZ"
}

fn campfire.views.reply-actions() -> Html {
    effects none
    doc "The Reply button _actions shows for a message without an attachment."
    html"""          <button class="btn message__action-btn center full-width" data-action="reply#reply" title="Reply" aria-label="Reply">
            <img class="colorize--black" aria-hidden="true" src="/assets/reply-edb77e33.svg" width="20" height="20" />
</button>
"""
}

test campfire.views.reply-actions/button {
    expect string.contains(campfire.views.text(campfire.views.reply-actions()), "data-action=\"reply#reply\"")
}

fn campfire.views.attachment-actions(download: String, share: String, filename: String) -> Html {
    effects none
    doc "The Download link and Share button _actions shows in place of Reply for a message with an attachment: download is the blob path with disposition=attachment, share the blob path."
    html"""          <a class="btn message__action-btn center full-width hide-in-ios-pwa" title="Download" aria-label="Download" href="{Url.new(download)}">
            <img class="colorize--black" aria-hidden="true" src="/assets/download-04029899.svg" width="20" height="20" />
</a>
          <button class="btn message__action-btn center full-width" data-controller="web-share" data-action="web-share#share" data-web-share-files-value="{share}" data-web-share-title-value="{filename}" title="Share" aria-label="Share">
            <img class="colorize--black" aria-hidden="true" src="/assets/share-bf28da4f.svg" width="20" height="20" />
</button>
"""
}

test campfire.views.attachment-actions/escaped {
    let text = campfire.views.text(campfire.views.attachment-actions("/b/x.txt?disposition=attachment", "/b/x.txt", "a&b.txt"))
    expect string.contains(text, "href=\"/b/x.txt?disposition=attachment\"") && string.contains(text, "data-web-share-title-value=\"a&amp;b.txt\"")
}

fn campfire.views.boost(boost: BoostView) -> Html {
    effects none
    doc "messages/boosts/_boost (inside its `cache boost` block), generated from Campfire's markup. The content span is txt-medium when the content is all emoji."

    let id = int.to-string(boost.id)
    let booster-id = int.to-string(boost.booster-id)
    let message-id = int.to-string(boost.message-id)
    let label = string.join([boost.booster-name, " boosted ", boost.content])
    let span-class = if campfire.emoji.all?(boost.content) { "txt-small txt-medium" } else { "txt-small" }
    let title = campfire.views.user-title(boost.booster-name, boost.booster-bio)
    html"""  <div id="boost_{id}"
      class="boost boost-item flex-inline postion--relative max-width align-center fill-white gap"
      data-controller="boost-delete" data-boost-delete-perform-class="boost--deleting" data-boost-delete-reveal-class="expanded" data-boost-delete-booster-id-value="{booster-id}">
    <figure class="avatar boost__avatar flex-item-no-shrink">
      <a title="{title}" class="btn avatar" data-turbo-frame="_top" href="{campfire.route.user(booster-id)}"><img aria-label="{label}" src="{Url.new(boost.booster-avatar-url)}" width="48" height="48" /></a>
    </figure>

    <span role="button" class="{span-class}" data-action="click-&gt;boost-delete#reveal keydown.enter-&gt;boost-delete#reveal:prevent" data-boost-delete-target="content">{boost.content}</span>

    <form class="button_to" method="post" action="/messages/{message-id}/boosts/{id}"><input type="hidden" name="_method" value="delete" /><button data-action="boost-delete#perform" data-boost-delete-target="button" class="btn btn--negative flex-item-justify-end boost__delete" type="submit">
      <img aria-hidden="true" src="/assets/minus-b31a1093.svg" width="20" height="20" />
      <span class="for-screen-reader">Delete this boost</span>
</button></form>  </div>
  <span id="delete_boost_accessible_label" class="for-screen-reader">Press enter to delete this boost</span>
"""
}

fn campfire.views.rails-message(context: MessageContext, message: MessageWithCreator) -> Html {
    effects none
    doc "campfire.views.rails-message-boosted with no boosts."
    campfire.views.rails-message-boosted(context, message, list.empty<BoostView>())
}

fn campfire.views.rails-message-boosted(context: MessageContext, message: MessageWithCreator, boost-views: List<BoostView>) -> Html {
    effects none
    doc "campfire.views.rails-message-presented with the body escaped as text inside the Action Text layout."
    let body = match message.body {
        none => Html.new("")
        some text => Html.new(text)
    }
    campfire.views.rails-message-presented(context, message, boost-views, campfire.views.rich-text-layout(body))
}

fn campfire.views.rich-text-layout(content: Html) -> Html {
    effects none
    doc "Action Text's layout around rendered rich text (layouts/action_text/contents/_content), as message_presentation returns it for a text message."
    html"<div class=\"lexxy-content\">\n  {content}\n</div>\n"
}

fn campfire.views.rails-message-presented(context: MessageContext, message: MessageWithCreator, boost-views: List<BoostView>, body: Html) -> Html {
    effects none
    doc "campfire.views.rails-message-shown for a message that is not all emoji and has no attachment (the Reply action)."
    campfire.views.rails-message-shown(context, message, boost-views, body, messageShown.new(emoji = false, actions = campfire.views.reply-actions()))
}

fn campfire.views.rails-message-shown(context: MessageContext, message: MessageWithCreator, boost-views: List<BoostView>, body: Html, shown: MessageShown) -> Html {
    effects none
    doc "body is the message's whole presentation, as Rails' message_presentation returns it (the rich-text layout for a text message, the sound markup for a sound). shown says whether the message is all emoji (message--emoji) and holds its primary actions (campfire.views.reply-actions or attachment-actions). One message as Rails renders messages/_message (with _actions, _presentation and the boosts frame), generated from Campfire's markup. Boosts and rich text are later slices: the boost list is empty and the body is escaped text."

    let id = int.to-string(MessageId.value(message.id))
    let creator-id = int.to-string(UserId.value(message.creator-id))
    let created-ms = int.to-string(message.created-at-ms)
    let updated-ms = int.to-string(message.updated-at-ms)
    let iso = string.concat(string.replace(message.created-at, " ", "T"), "Z")
    let stamp = string.replace(string.replace(string.replace(message.creator-updated-at, "-", ""), ":", ""), " ", "")
    let avatar-url = campfire.route.avatar-src(message.creator-avatar-token, stamp)
    let title = campfire.views.user-title(message.creator-name, message.creator-bio)
    let boosts = boost-views.map(campfire.views.boost)
    let emoji-class = if shown.emoji { "message--emoji" } else { "" }
    html"""  <div id="message_{message.client-message-id}" class="message {emoji-class}" data-controller="reply" data-user-id="{creator-id}" data-message-id="{id}" data-message-timestamp="{created-ms}" data-message-updated-at="{updated-ms}" data-sort-value="{created-ms}" data-messages-target="message" data-search-results-target="message" data-refresh-room-target="message" data-reply-composer-outlet="#composer">
    <h2 class="message__day-separator"><time datetime="{iso}" data-local-time-target="date"></time></h2>

    <figure class="avatar message__avatar">
      <a title="{title}" class="btn avatar" data-turbo-frame="_top" href="{campfire.route.user(creator-id)}"><img aria-hidden="true" src="{Url.new(avatar-url)}" width="48" height="48" /></a>
    </figure>

    <turbo-frame id="edit_message_{message.client-message-id}">
      <div class="message__body">
        <div class="message__body-content">
          <div class="message__meta">
            <h3 class="message__heading">
              <span class="message__author" title="{title}">
                <strong data-reply-target="author">{message.creator-name}</strong>
              </span>
              <a target="_top" class="message__permalink" href="{campfire.route.message(context.room-id, id)}"><time class="message__timestamp" datetime="{iso}" data-local-time-target="time"></time></a>
              <span class="message__room">
                <a target="_top" data-reply-target="link" href="{campfire.route.message(context.room-id, id)}">{context.room-name}</a>
              </span>
            </h3>
            
<div class="message__actions" data-controller="soft-keyboard">
  <details class="position-relative" data-controller="popup" data-action="keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside" data-popup-orientation-top-class="popup-orientation-top">
    <summary class="btn message__action-btn message__options-btn">
      <img class="colorize--black" aria-hidden="true" src="/assets/menu-dots-horizontal-f6a5d793.svg" width="20" height="20" />
      <span class="for-screen-reader">Message options</span>
    </summary>

    <div class="message__actions-menu border shadow" data-popup-target="menu">
      <div class="quick-boosts">
          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="👍" />
            <button name="button" type="submit" title="Thumbs up" class="btn message__action-btn" data-emoji="👍">
              <figure class="margin-none boost-character">👍</figure>
              <span class="for-screen-reader">Thumbs up</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="👏" />
            <button name="button" type="submit" title="Clapping" class="btn message__action-btn" data-emoji="👏">
              <figure class="margin-none boost-character">👏</figure>
              <span class="for-screen-reader">Clapping</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="👋" />
            <button name="button" type="submit" title="Waving hand" class="btn message__action-btn" data-emoji="👋">
              <figure class="margin-none boost-character">👋</figure>
              <span class="for-screen-reader">Waving hand</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="💪" />
            <button name="button" type="submit" title="Muscle" class="btn message__action-btn" data-emoji="💪">
              <figure class="margin-none boost-character">💪</figure>
              <span class="for-screen-reader">Muscle</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="❤️" />
            <button name="button" type="submit" title="Red heart" class="btn message__action-btn" data-emoji="❤️">
              <figure class="margin-none boost-character">❤️</figure>
              <span class="for-screen-reader">Red heart</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="😂" />
            <button name="button" type="submit" title="Face with tears of joy" class="btn message__action-btn" data-emoji="😂">
              <figure class="margin-none boost-character">😂</figure>
              <span class="for-screen-reader">Face with tears of joy</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="🎉" />
            <button name="button" type="submit" title="Party popper" class="btn message__action-btn" data-emoji="🎉">
              <figure class="margin-none boost-character">🎉</figure>
              <span class="for-screen-reader">Party popper</span>
</button></form>          <form data-turbo-frame="boosting_message_{message.client-message-id}" data-action="popup#close" action="/messages/{id}/boosts" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="🔥" />
            <button name="button" type="submit" title="Fire" class="btn message__action-btn" data-emoji="🔥">
              <figure class="margin-none boost-character">🔥</figure>
              <span class="for-screen-reader">Fire</span>
</button></form>
        <a class="btn message__action-btn message__boost-btn" data-turbo-frame="new_boost_message_{message.client-message-id}" data-action="soft-keyboard#open popup#close" href="/messages/{id}/boosts/new">
          <img class="colorize--black" aria-hidden="true" src="/assets/boost-4a7bab66.svg" width="20" height="20" />
          <span class="for-screen-reader">New boost</span>
</a>      </div>

      <div class="flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid">
{shown.actions}        <button class="btn message__action-btn center full-width" title="Copy link" aria-label="Copy link" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="{context.base-url}{campfire.route.message(context.room-id, id)}">
          <img class="colorize--black" aria-hidden="true" src="/assets/link-e546a5df.svg" width="20" height="20" />
</button>
        <a class="btn message__action-btn center full-width message__edit-btn" data-turbo-frame="edit_message_{message.client-message-id}" title="Edit" aria-label="Edit" href="/rooms/{context.room-id}/messages/{id}/edit">
          <img class="colorize--black" aria-hidden="true" src="/assets/pencil-cf9d28aa.svg" width="20" height="20" />
</a>      </div>
    </div>
</details></div>

          </div>
          <div id="presentation_message_{message.client-message-id}" dir="auto" data-reply-target="body" data-messages-target="body">
  {body}
</div>

          <turbo-frame id="boosting_message_{message.client-message-id}">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="boosts_message_{message.client-message-id}" data-turbo-streaming-target="container">
      {boosts}
    </div>

    <turbo-frame id="new_boost_message_{message.client-message-id}">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" action="soft-keyboard#open" href="/messages/{id}/boosts/new">
          <img aria-hidden="true" src="/assets/boost-4a7bab66.svg" width="20" height="20" />
          <span class="for-screen-reader">Add a boost</span>
</a>      </div>
</turbo-frame>  </div>
</turbo-frame>
        </div>
      </div>
    </turbo-frame>
</div>
"""
}
