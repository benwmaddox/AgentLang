// Rails' String#all_emoji? (reference lib/rails_ext/string.rb):
//   /\A(\p{Emoji_Presentation}|\p{Extended_Pictographic}|\uFE0F)+\z/u
// The code point ranges come from Ruby 3.4.10 (Unicode 15.0.0, emoji 15.0), the
// interpreter the Rails reference runs on, so Flow classifies exactly as Rails.

fn campfire.emoji.ranges() -> List<Int> {
    doc "Inclusive [first, last] code point pairs matching one atom of all_emoji? (78 ranges, generated by .agentlang/pages-285/emoji.rb)."
    [169, 169, 174, 174, 8252, 8252, 8265, 8265, 8482, 8482, 8505, 8505, 8596, 8601, 8617, 8618, 8986, 8987, 9000, 9000, 9096, 9096, 9167, 9167, 9193, 9203, 9208, 9210, 9410, 9410, 9642, 9643, 9654, 9654, 9664, 9664, 9723, 9726, 9728, 9733, 9735, 9746, 9748, 9861, 9872, 9989, 9992, 10002, 10004, 10004, 10006, 10006, 10013, 10013, 10017, 10017, 10024, 10024, 10035, 10036, 10052, 10052, 10055, 10055, 10060, 10060, 10062, 10062, 10067, 10069, 10071, 10071, 10083, 10087, 10133, 10135, 10145, 10145, 10160, 10160, 10175, 10175, 10548, 10549, 11013, 11015, 11035, 11036, 11088, 11088, 11093, 11093, 12336, 12336, 12349, 12349, 12951, 12951, 12953, 12953, 65039, 65039, 126976, 127231, 127245, 127247, 127279, 127279, 127340, 127345, 127358, 127359, 127374, 127374, 127377, 127386, 127405, 127487, 127489, 127503, 127514, 127514, 127535, 127535, 127538, 127546, 127548, 127551, 127561, 128317, 128326, 128591, 128640, 128767, 128884, 128895, 128981, 129023, 129036, 129039, 129096, 129103, 129114, 129119, 129160, 129167, 129198, 129279, 129292, 129338, 129340, 129349, 129351, 129791, 130048, 131069]
}

test campfire.emoji.ranges/pairs {
    expect list.count(campfire.emoji.ranges()) == 156
}

fn campfire.emoji.code-point?(code: Int, ranges: List<Int>) -> Bool {
    doc "True when the code point is in one of the ranges."
    var found = false
    for value, index in ranges {
        if index % 2 == 0 && code >= value && code <= campfire.emoji.at(ranges, index + 1) {
            found = true
            break
        }
    }
    found
}

test campfire.emoji.code-point?/eyes {
    expect campfire.emoji.code-point?(128064, campfire.emoji.ranges())
    expect bool.not(campfire.emoji.code-point?(65, campfire.emoji.ranges()))
}

fn campfire.emoji.all?(text: String) -> Bool {
    doc "Rails' all_emoji?: at least one code point, each an emoji-presentation or extended-pictographic code point or U+FE0F. Invalid UTF-8 cannot occur (Strings are valid UTF-8)."
    let ranges = campfire.emoji.ranges()
    let length = string.byte-length(text)
    var all = length > 0
    var at = 0
    for step in 0..length {
        if at >= length || bool.not(all) {
            break
        }
        let lead = string.byte-at-or(text, at, 0)
        let size = if lead < 128 { 1 } else if lead < 224 { 2 } else if lead < 240 { 3 } else { 4 }
        var code = if size == 1 { lead } else if size == 2 { lead % 32 } else if size == 3 { lead % 16 } else { lead % 8 }
        for k in 1..size {
            code = code * 64 + string.byte-at-or(text, at + k, 128) % 64
        }
        all = code == 65039 || campfire.emoji.code-point?(code, ranges)
        at = at + size
    }
    all
}

test campfire.emoji.all?/rails {
    expect campfire.emoji.all?("👀")
    expect campfire.emoji.all?("💯🔥")
    expect campfire.emoji.all?("❤️")
    expect bool.not(campfire.emoji.all?(""))
    expect bool.not(campfire.emoji.all?("ok 👀"))
    expect bool.not(campfire.emoji.all?("#"))
}

fn campfire.emoji.at(values: List<Int>, index: Int) -> Int {
    doc "values[index], or -1 when out of range."
    match list.get(values, index) {
        none => -1
        some value => value
    }
}

test campfire.emoji.at/range {
    expect campfire.emoji.at([1, 2], 1) == 2
    expect campfire.emoji.at([1, 2], 2) == -1
}
