// accounts#edit (/account/edit) as Rails renders it. Generated by
// .agentlang/pages-285/make_account_views.py from Rails' page for the snapshot
// administrator; the member view (no admin forms) follows the template and is not
// yet compared with Rails.

record AccountUserRow {
    id: Int
    name: String
    title: String
    avatar-url: String
    administrator: Bool
    banned: Bool
}

fn campfire.views.account-user(user: AccountUserRow, viewer-id: Int, viewer-admin: Bool) -> Html {
    effects none
    doc "accounts/users/_user: the avatar and name, and for an administrator viewing an active user the role switch (not for oneself: disabled) and the remove button (not for oneself); one's own row links to one's settings."
    let id = int.to-string(user.id)
    let name = user.name
    let title = user.title
    let avatar = user.avatar-url
    let banned = if user.banned { "banned" } else { "" }
    let self = user.id == viewer-id
    let role = if user.administrator { "Administrator" } else { "Member" }
    let disabled = if self { " disabled=\"disabled\"" } else { "" }
    let checked = if user.administrator { " checked=\"checked\"" } else { "" }
    // Role inputs: a hidden member value and the administrator checkbox (attribute order as Rails writes them).
    let inputs = html.raw(string.join(["<input name=\"user[role]\"", disabled, " type=\"hidden\" value=\"member\" /><input data-action=\"form#submit\" hidden=\"hidden\" id=\"role_user_", id, "\"", disabled, " type=\"checkbox\" value=\"administrator\"", checked, " name=\"user[role]\" />"]))
    let active = bool.not(user.banned)
    let role-form = if viewer-admin && active { string.concat(campfire.views.text(html"      <form data-controller=\"form\" action=\"/account/users/{id}\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"_method\" value=\"patch\" />\n        <label class=\"btn txt-small flex-item-no-shrink\" for=\"role_user_{id}\">\n          <span class=\"for-screen-reader\">Role: {role}</span>\n          <img aria-hidden=\"true\" src=\"/assets/crown-00d190cb.svg\" width=\"20\" height=\"20\" />\n          {inputs}\n        </label>\n</form>"), "\n") } else { "" }
    let delete = if viewer-admin && active && bool.not(self) { campfire.views.text(html"      <form class=\"button_to\" method=\"post\" action=\"/account/users/{id}\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn txt-small flex-item-no-shrink btn--negative\" data-turbo-confirm=\"Are you sure you want to permanently remove this person from the account? This can’t be undone.\" type=\"submit\">\n        <img aria-hidden=\"true\" src=\"/assets/minus-b31a1093.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Delete {name}</span>\n</button></form>") } else { "" }
    let link = if self { campfire.views.text(html"    <a class=\"btn txt-small flex-item-no-shrink\" target=\"_top\" href=\"/users/me/profile\">\n      <img aria-hidden=\"true\" src=\"/assets/pencil-cf9d28aa.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">My settings</span>\n</a>") } else { "" }
    let actions = html.raw(string.join([role-form, delete, link]))
    html"<li class=\"flex align-center gap margin-none {banned}\">\n  <figure class=\"avatar flex-item-no-shrink\" style=\"--avatar-size: 3.75ch;\">\n    <a title=\"{title}\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/{id}\"><img aria-hidden=\"true\" loading=\"lazy\" src=\"{Url.new(avatar)}\" width=\"48\" height=\"48\" /></a>\n  </figure>\n\n  <div class=\"min-width\">\n    <div class=\"overflow-ellipsis fill-shade\"><strong>{name}</strong></div>\n  </div>\n\n  <hr class=\"separator\" aria-hidden=\"true\">\n\n{actions}</li>\n"
}

test campfire.views.account-user/banned {
    let row = campfire.views.text(campfire.views.account-user(accountUserRow.new(id = 5, name = "M", title = "M", avatar-url = "/a", administrator = false, banned = true), 1, true))
    expect string.starts-with(row, "<li class=\"flex align-center gap margin-none banned\">") && string.ends-with(row, "  <hr class=\"separator\" aria-hidden=\"true\">\n\n</li>\n")
}

fn campfire.views.account-users(administrators: List<Html>, members: List<Html>) -> Html {
    effects none
    doc "The account_users frame's lists: administrators, a separator when both lists have people, members (one page: per_page 500)."
    var out = ""
    for row in administrators {
        out = string.concat(out, campfire.views.text(row))
    }
    out = string.concat(out, "\n\n")
    if list.count(administrators) > 0 && list.count(members) > 0 {
        out = string.concat(out, "          <hr class=\"separator full-width\" style=\"--border-style: solid\">\n")
    }
    out = string.concat(out, "\n        ")
    for row in members {
        out = string.concat(out, campfire.views.text(row))
    }
    // The newline after the members' render (the next-page container line follows).
    html.raw(string.concat(out, "\n"))
}

test campfire.views.account-users/separator {
    expect campfire.views.text(campfire.views.account-users([html.raw("<li>a</li>\n")], list.empty<Html>())) == "<li>a</li>\n\n\n\n        \n"
}

fn campfire.views.account-admin(account-id: String, account-name: String, logo-version: String, restricted: Bool, logo-attached: Bool) -> Html {
    effects none
    doc "accounts/edit's administrator forms: the logo upload, the account name and the must-be-admin-to-create-rooms switch."
    let restrict-next = if restricted { "false" } else { "true" }
    let checkbox = if restricted { html"          <input type=\"checkbox\"\n                class=\"switch__input\"\n                checked\n                data-action=\"change->form#submit\">\n" } else { html"          <input type=\"checkbox\"\n                class=\"switch__input\"\n                \n                data-action=\"change->form#submit\">\n" }
    let logo-delete = if logo-attached { html"      <form class=\"button_to\" method=\"post\" action=\"/account/logo?v={logo-version}\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn btn--negative txt-small avatar__delete-btn\" type=\"submit\">\n          <img aria-hidden=\"true\" src=\"/assets/minus-b31a1093.svg\" width=\"20\" height=\"20\" />\n          <span class=\"for-screen-reader\">Delete logo</span>\n</button></form>\n" } else { html.raw("") }
    html"""    <div class="align-center center avatar__form gap" data-controller="upload-preview">
      <form class="txt--medium" data-controller="form" enctype="multipart/form-data" action="/account.{account-id}" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" />
        <label class="btn input--file">
          <img aria-hidden="true" src="/assets/camera-927323b8.svg" width="20" height="20" />
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
      <form data-controller="form" enctype="multipart/form-data" action="/account.{account-id}" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" />
        <label class="btn avatar input--file account-logo txt-xx-large">
          <img role="presentation" data-upload-preview-target="image" src="/account/logo?v={logo-version}" width="48" height="48" />
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
{logo-delete}    </div>

    <form class="flex flex-column gap" data-controller="form" action="/account.{account-id}" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" />
      <div class="flex align-center gap">
        <details class="position-relative" data-controller="popup" data-action="keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside" data-popup-orientation-top-class="popup-orientation-top"><summary class="btn" tabindex="-1"><img aria-hidden="true" class="color-icon" src="/assets/globe-8c54d23b.svg" width="20" height="20" /><span class="for-screen-reader">Translate</span></summary><div class="language-list-menu shadow" data-popup-target="menu"><dl class="language-list"><dt>🇺🇸</dt><dd class="margin-none">Name this account</dd><dt>🇪🇸</dt><dd class="margin-none">Nombre de esta cuenta</dd><dt>🇫🇷</dt><dd class="margin-none">Nommez ce compte</dd><dt>🇮🇳</dt><dd class="margin-none">इस खाते का नाम दें</dd><dt>🇩🇪</dt><dd class="margin-none">Benennen Sie dieses Konto</dd><dt>🇧🇷</dt><dd class="margin-none">Dê um nome a essa conta</dd><dt>🇯🇵</dt><dd class="margin-none">アカウントに名前を付ける</dd></dl></div></details>

        <label class="flex align-center gap flex-item-grow">
          <input class="input txt-large" autocomplete="off" placeholder="Name this account" autofocus="autofocus" data-action="keydown.enter-&gt;form#submit" type="text" value="{account-name}" name="account[name]" id="account_name" />
        </label>

        <button name="button" type="submit" class="btn btn--reversed center">
          <img aria-hidden="true" src="/assets/check-7897ff7e.svg" width="20" height="20" />
          <span class="for-screen-reader">Save changes</span>
</button>      </div>
</form>
    <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
      <form class="flex align-center gap center" data-controller="form" action="/account.{account-id}" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="put" />
        <div class="flex-item-grow flex align-center gap txt-align-start">
          <img class="colorize--black" aria-hidden="true" src="/assets/crown-00d190cb.svg" width="18" height="18" /> Must be admin to create new rooms
        </div>
        
          <input value="{restrict-next}" type="hidden" name="account[settings][restrict_room_creation_to_administrators]" id="account_settings_restrict_room_creation_to_administrators" />

        <label class="switch">
{checkbox}          <span class="switch__btn round"></span>
          <span class="for-screen-reader">
            Must be admin to create new rooms
          </span>
        </label>

</form>    </div>
"""
}

test campfire.views.account-admin/switch {
    expect string.contains(campfire.views.text(campfire.views.account-admin("1", "A", "2", true, false)), "                checked\n")
}

fn campfire.views.account-member(account-name: String, logo-version: String) -> Html {
    effects none
    doc "accounts/edit for a non-administrator: account_logo_tag and the account name (from the template; not yet compared with Rails)."
    html"    <figure class=\"account-logo avatar txt-xx-large center\"><img alt=\"Account logo\" src=\"/account/logo?v={logo-version}\" width=\"300\" height=\"300\" /></figure>\n    <h1 class=\"flex-item-grow txt-x-large\">{account-name}</h1>\n"
}

test campfire.views.account-member/name {
    expect string.contains(campfire.views.text(campfire.views.account-member("A&B", "1")), ">A&amp;B</h1>")
}

fn campfire.views.account-page(head: Html, body-class: String, back: String, admin-view: Bool, admin: Html, join-url: String, qr: String, users: Html, version: String) -> Html {
    effects none
    doc "accounts#edit inside layouts/application."
    let nav-admin = if admin-view { html"    <div class=\"flex align-center gap flex-item-justify-end\">\n      <a class=\"btn\" style=\"view-transition-name: chat-bots\" href=\"/account/bots\">\n        <img aria-hidden=\"true\" src=\"/assets/bot-8a69692e.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Set up chat bots</span>\n</a>\n      <a class=\"btn\" style=\"view-transition-name: custom-styles\" href=\"/account/custom_styles/edit\">\n        <img aria-hidden=\"true\" src=\"/assets/art-ed709d32.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Custom styles</span>\n</a>    </div>\n" } else { html.raw("") }
    let regenerate = if admin-view { html"      <form class=\"button_to\" method=\"post\" action=\"/account/join_code\"><button class=\"btn btn--regenerate\" type=\"submit\">\n        <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/refresh-249f0509.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Regenerate join link</span>\n</button></form>" } else { html.raw("") }
    let lightbox = campfire.views.lightbox()
    html"""<!DOCTYPE html>
<html>
  <head>
    <title>Account settings</title>

{head}
    
  </head>

  <body class="{body-class}" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
        <div class="flex-item-justify-start">
    <a class="btn" href="/rooms/{back}"><img aria-hidden="true" src="/assets/arrow-left-abe40556.svg" width="20" height="20" /><span class="for-screen-reader">Go Back</span></a>
  </div>

{nav-admin}
    </nav>


    <main id="main-content">
      

<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
{admin}
  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    <div class="flex flex-column align-center gap">

  <label class="flex flex-column gap full-width" style="--row-gap: 0.5em">
    <strong id="invite_label" class="invite-label">Share to invite more people</strong>
    <span class="flex align-center gap input input--actor fill-white">
      <img aria-hidden="true" class="colorize--black" src="/assets/person-add-1432b76b.svg" width="20" height="20" />
      <input type="text" class="input" id="invite_url" value="{join-url}" aria-labelledby="invite_label" readonly>
    </span>
  </label>

  <div class="flex align-center gap">
    <a class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="/qr_code/{qr}" href="/qr_code/{qr}">
      <span class="for-screen-reader">Show join link QR code</span>
      <img aria-hidden="true" class="colorize--black" src="/assets/qr-code-dac3b273.svg" width="20" height="20" />
</a>
    <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="{join-url}">
      <span class="for-screen-reader">Copy join link</span>
      <img aria-hidden="true" class="colorize--black" src="/assets/copy-paste-4c379063.svg" width="20" height="20" />
</button>
    <button class="btn" hidden="hidden" data-controller="web-share" data-action="web-share#share" data-web-share-url-value="{join-url}" data-web-share-text-value="Hit this link to join me in Campfire and start chatting." data-web-share-title-value="Link to join Campfire">
      <span class="for-screen-reader">Share join link</span>
      <img aria-hidden="true" class="colorize--black" src="/assets/share-bf28da4f.svg" width="20" height="20" />
</button>
{regenerate}  </div>
</div>


    <hr class="margin-block separator full-width" style="--border-style: solid">

    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
        {users}        
      </turbo-frame>
    </menu>
  </div>
</section>



      <footer id="footer">
          <div class="txt-align-center center margin-block-double txt-subtle">Campfire&trade; version <span class="version-badge">{version}</span></div>

      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
      
    </aside>

{lightbox}  </body>
</html>
"""
}

test campfire.views.account-page/version {
    expect string.contains(campfire.views.text(campfire.views.account-page(html"<x></x>", "admin", "7", false, html"", "http://h/join/c", "q", html"", "v1")), "<span class=\"version-badge\">v1</span>")
}
