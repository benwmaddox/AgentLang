fn campfire.authentication.restore-session(
    verified-token: SessionToken,
    now: UtcInstant,
    remote-ip: Option<RemoteIp>,
    user-agent: Option<String>
) -> Result<Option<RestoredSession>, DbError> {
    effects db.read, db.write
    doc "Restores an existing session only from a token already verified by the trusted cookie host. A missing session returns none; a found session is refreshed when due before its user is looked up. A missing user remains a restored session with no user, preserving the refresh-cookie directive. User role and status are preserved without filtering. User lookup errors propagate after a due refresh. This function does not verify cookies or establish an HTTP response."

    match campfire.sessions.find-by-token(verified-token) {
        error failure => result.error<Option<RestoredSession>, DbError>(failure)
        ok maybe-session => {
            match maybe-session {
                none => result.ok<Option<RestoredSession>, DbError>(option.none<RestoredSession>())
                some session => {
                    let refresh-cookie = campfire.sessions.refresh-due?(session.last-active-at, now)
                    let session-after-refresh =
                        if refresh-cookie {
                            let cutoff = UtcInstant.new(subtract(UtcInstant.value(now), 3600000000))
                            let refresh = sessionRefresh.new(
                                session-id = session.id,
                                cutoff = cutoff,
                                now = now,
                                ip-address = remote-ip,
                                user-agent = user-agent
                            )
                            campfire.sessions.refresh-before(refresh)
                        } else {
                            result.ok<SessionRow, DbError>(session)
                        }
                    match session-after-refresh {
                        error failure => result.error<Option<RestoredSession>, DbError>(failure)
                        ok current-session => {
                            match campfire.users.find-by-id(current-session.user-id) {
                                error failure => result.error<Option<RestoredSession>, DbError>(failure)
                                ok maybe-user => result.ok<Option<RestoredSession>, DbError>(option.some<RestoredSession>(restoredSession.new(
                                    user = maybe-user,
                                    session = current-session,
                                    refresh-cookie = refresh-cookie
                                )))
                            }
                        }
                    }
                }
            }
        }
    }
}
