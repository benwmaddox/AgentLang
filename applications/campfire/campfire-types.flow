type UserId : Int { }

enum Role {
    member
    administrator
    bot
}

record User {
    id: UserId
    role: Role
}

record ExistingMessage {
    creator-id: UserId
}

type RoomId : Int { }

type MessageId : Int { }

enum RoomKind {
    open
    closed
    direct
}

enum DbError {
    unavailable
    not-found
    constraint-conflict
    invalid-input
}

enum RoomMessageError {
    access-denied
    database-unavailable
    database-not-found
    database-constraint-conflict
    database-invalid-input
}

record RoomRow {
    id: RoomId
    name: Option<String>
    kind: RoomKind
    creator-id: UserId
    created-at: String
    updated-at: String
}

record MembershipKey {
    user-id: UserId
    room-id: RoomId
}

record MessageRow {
    id: MessageId
    room-id: RoomId
    creator-id: UserId
    client-message-id: String
    body: Option<String>
    created-at: String
    updated-at: String
}

record MessageWithCreator {
    id: MessageId
    room-id: RoomId
    creator-id: UserId
    created-at-ms: Int
    updated-at-ms: Int
    client-message-id: String
    created-at: String
    creator-name: String
    creator-bio: String
    creator-updated-at: String
    creator-avatar-token: String
    body: Option<String>
}

record CsrfSecret {
    value: String
    fresh: Bool
}

record BoostTokens {
    thumbs-up: String
    clapping: String
    waving-hand: String
    muscle: String
    red-heart: String
    tears-of-joy: String
    party-popper: String
    fire: String
}

record TokenedMessage {
    message: MessageWithCreator
    boost-tokens: BoostTokens
}

record NewMessage {
    room-id: RoomId
    creator-id: UserId
    client-message-id: Option<String>
    body: Option<String>
}
