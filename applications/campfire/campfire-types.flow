type UserId : Int { }

enum Role {
    case member
    case administrator
    case bot
}

record User {
    field id: UserId
    field role: Role
}

record ExistingMessage {
    field creator-id: UserId
}

type RoomId : Int { }

type MessageId : Int { }

enum RoomKind {
    case open
    case closed
    case direct
}

enum DbError {
    case unavailable
    case not-found
    case constraint-conflict
    case invalid-input
}

enum RoomMessageError {
    case access-denied
    case database-unavailable
    case database-not-found
    case database-constraint-conflict
    case database-invalid-input
}

record RoomRow {
    field id: RoomId
    field name: Option<String>
    field kind: RoomKind
    field creator-id: UserId
    field created-at: String
    field updated-at: String
}

record MembershipKey {
    field user-id: UserId
    field room-id: RoomId
}

record MessageRow {
    field id: MessageId
    field room-id: RoomId
    field creator-id: UserId
    field client-message-id: String
    field body: Option<String>
    field created-at: String
    field updated-at: String
}

record MessageWithCreator {
    field id: MessageId
    field room-id: RoomId
    field creator-id: UserId
    field created-at-ms: Int
    field updated-at-ms: Int
    field client-message-id: String
    field created-at: String
    field creator-name: String
    field creator-bio: String
    field creator-updated-at: String
    field creator-avatar-token: String
    field body: Option<String>
}

record CsrfSecret {
    field value: String
    field fresh: Bool
}

record BoostTokens {
    field thumbs-up: String
    field clapping: String
    field waving-hand: String
    field muscle: String
    field red-heart: String
    field tears-of-joy: String
    field party-popper: String
    field fire: String
}

record TokenedMessage {
    field message: MessageWithCreator
    field boost-tokens: BoostTokens
}

record NewMessage {
    field room-id: RoomId
    field creator-id: UserId
    field client-message-id: Option<String>
    field body: Option<String>
}
