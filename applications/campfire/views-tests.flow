test campfire.views.text/message {
    campfire.views.text(campfire.views.message(messageRow.new(id = MessageId.new(7), room-id = RoomId.new(3), creator-id = UserId.new(1), client-message-id = "c-1", body = option.some<String>("Hi & bye"), created-at = "2026-01-01T00:00:00Z", updated-at = "2026-01-01T00:00:00Z")))
    => value "<div id=\"message_c-1\" class=\"message\" data-message-id=\"7\"><div id=\"presentation_message_c-1\" dir=\"auto\">Hi &amp; bye</div></div>"
}

test campfire.views.message/no-body {
    campfire.views.text(campfire.views.message(messageRow.new(id = MessageId.new(8), room-id = RoomId.new(3), creator-id = UserId.new(1), client-message-id = "c-2", body = option.none<String>(), created-at = "2026-01-01T00:00:00Z", updated-at = "2026-01-01T00:00:00Z")))
    => value "<div id=\"message_c-2\" class=\"message\" data-message-id=\"8\"><div id=\"presentation_message_c-2\" dir=\"auto\"></div></div>"
}

test campfire.views.room/empty {
    campfire.views.text(campfire.views.room(roomRow.new(id = RoomId.new(3), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "2026-01-01T00:00:00Z", updated-at = "2026-01-01T00:00:00Z"), list.empty<MessageRow>()))
    => value "<!doctype html><html><body><h1>Lobby</h1><section id=\"messages\"></section><form method=\"post\" action=\"/rooms/3/messages\"><textarea name=\"message[body]\"></textarea><button type=\"submit\">Send</button></form></body></html>"
}

test campfire.views.room-text/unnamed {
    campfire.views.room-text(roomRow.new(id = RoomId.new(4), name = option.none<String>(), kind = RoomKind.direct(), creator-id = UserId.new(1), created-at = "2026-01-01T00:00:00Z", updated-at = "2026-01-01T00:00:00Z"), list.empty<MessageRow>())
    => value "<!doctype html><html><body><h1></h1><section id=\"messages\"></section><form method=\"post\" action=\"/rooms/4/messages\"><textarea name=\"message[body]\"></textarea><button type=\"submit\">Send</button></form></body></html>"
}

test campfire.views.not-found/escapes {
    campfire.views.text(campfire.views.not-found("Gone & <away>"))
    => value "<!doctype html><html><body><p>Gone &amp; &lt;away&gt;</p></body></html>"
}

test campfire.views.incompatible/fixed {
    campfire.views.text(campfire.views.incompatible())
    => value "<!doctype html><html><body><p>Please upgrade your browser.</p></body></html>"
}

test campfire.views.login/unauthorized {
    campfire.views.text(campfire.views.login(401, "member@example.test"))
    => value "<!doctype html><html><body><p role=\"alert\">Too many requests or unauthorized.</p><form method=\"post\" action=\"/session\"><label for=\"email_address\">Email address</label><input id=\"email_address\" name=\"email_address\" type=\"email\" autocomplete=\"username\" value=\"member@example.test\"><label for=\"password\">Password</label><input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" maxlength=\"72\"><button type=\"submit\">Sign in</button></form></body></html>"
}

test campfire.views.append/one {
    campfire.views.text(campfire.views.append(messageRow.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(1), client-message-id = "c-5", body = option.some<String>("x"), created-at = "a", updated-at = "b")))
    => value "<turbo-stream action=\"append\" target=\"messages\"><template><div id=\"message_c-5\" class=\"message\" data-message-id=\"5\"><div id=\"presentation_message_c-5\" dir=\"auto\">x</div></div></template></turbo-stream>"
}

test campfire.views.body/redirect {
    campfire.views.body(302, HttpView.redirect-root(), "Room not found or inaccessible")
    => value ""
}

test campfire.views.room-chrome/closed-admin {
    campfire.views.room-chrome(roomRow.new(id = RoomId.new(486777696), name = option.some<String>("All Talk"), kind = RoomKind.closed(), creator-id = UserId.new(1), created-at = "a", updated-at = "b"), authUser.new(id = UserId.new(127326141), name = "David", role = Role.administrator(), status = AuthUserStatus.active()), "http://127.0.0.1:13774").room-key
    => value "rooms_closed"
}

test campfire.views.page/layout {
    string.starts-with(campfire.views.text(campfire.views.page(campfire.views.room-chrome(roomRow.new(id = RoomId.new(3), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "a", updated-at = "b"), authUser.new(id = UserId.new(9), name = "Ann & Bo", role = Role.member(), status = AuthUserStatus.active()), "https://chat.test"), list.empty<Html>())), "<!DOCTYPE html>")
    => value true
}

test campfire.views.room-page/escapes-user {
    string.contains(campfire.views.room-page(campfire.views.room-chrome(roomRow.new(id = RoomId.new(3), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "a", updated-at = "b"), authUser.new(id = UserId.new(9), name = "Ann & Bo", role = Role.member(), status = AuthUserStatus.active()), "https://chat.test"), list.empty<MessageRow>()), "<meta name=\"current-user-name\" content=\"Ann &amp; Bo\" />")
    => value true
}

test campfire.views.rails-message/identity {
    string.contains(campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1772465400000, updated-at-ms = 1772465460000, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann & Bo", creator-bio = "Designer", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok--abc", body = option.some<String>("a < b")))), "<div id=\"message_c-5\" class=\"message \" data-controller=\"reply\" data-user-id=\"9\" data-message-id=\"5\" data-message-timestamp=\"1772465400000\" data-message-updated-at=\"1772465460000\" data-sort-value=\"1772465400000\"")
    => value true
}

test campfire.views.rails-message/creator {
    string.contains(campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1772465400000, updated-at-ms = 1772465460000, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann & Bo", creator-bio = "Designer", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok--abc", body = option.some<String>("a < b")))), "<a title=\"Ann &amp; Bo – Designer\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/9\"><img aria-hidden=\"true\" src=\"/users/tok--abc/avatar?v=20260102180000\" width=\"48\" height=\"48\" /></a>")
    => value true
}

test campfire.views.rails-message/time-and-permalink {
    string.contains(campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1772465400000, updated-at-ms = 1772465460000, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann & Bo", creator-bio = "Designer", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok--abc", body = option.some<String>("a < b")))), "<a target=\"_top\" class=\"message__permalink\" href=\"/rooms/3/@5\"><time class=\"message__timestamp\" datetime=\"2026-03-02T15:30:00Z\" data-local-time-target=\"time\"></time></a>")
    => value true
}

test campfire.views.rails-message/escapes-body {
    bool.and(string.contains(campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1772465400000, updated-at-ms = 1772465460000, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann & Bo", creator-bio = "Designer", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok--abc", body = option.some<String>("a < b")))), "a &lt; b"), bool.not(string.contains(campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1772465400000, updated-at-ms = 1772465460000, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann & Bo", creator-bio = "Designer", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok--abc", body = option.some<String>("a < b")))), "a < b")))
    => value true
}

test campfire.views.creator-room-page/doctype {
    string.starts-with(campfire.views.creator-room-page(campfire.views.room-chrome(roomRow.new(id = RoomId.new(3), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "a", updated-at = "b"), authUser.new(id = UserId.new(9), name = "Ann", role = Role.member(), status = AuthUserStatus.active()), "https://chat.test"), list.empty<MessageWithCreator>()), "<!DOCTYPE html>")
    => value true
}

test campfire.views.rails-message/boost-forms-without-tokens {
    let text = campfire.views.text(campfire.views.rails-message(messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test"), messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1, updated-at-ms = 1, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann", creator-bio = "", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok", body = option.none<String>())))
    expect string.contains(text, "action=\"/messages/5/boosts\" accept-charset=\"UTF-8\" method=\"post\">\n            <input type=\"hidden\" name=\"boost[content]\"")
    expect bool.not(string.contains(text, "authenticity_token"))
}

test campfire.views.page/no-csrf-tokens {
    let text = campfire.views.creator-room-page(campfire.views.room-chrome(roomRow.new(id = RoomId.new(3), name = option.some<String>("Lobby"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "a", updated-at = "b"), authUser.new(id = UserId.new(9), name = "Ann", role = Role.member(), status = AuthUserStatus.active()), "https://chat.test"), [messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1, updated-at-ms = 1, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann", creator-bio = "", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok", body = option.none<String>())])
    expect bool.not(string.contains(text, "csrf"))
    expect bool.not(string.contains(text, "authenticity_token"))
    expect string.contains(text, "action=\"/rooms/3/messages\" accept-charset=\"UTF-8\" method=\"post\">\n        <fieldset")
}

test campfire.views.boost/markup {
    let html = campfire.views.text(campfire.views.boost(boostView.new(id = 9, message-id = 5, booster-id = 2, booster-name = "Bo & Co", booster-avatar-url = "/users/t/avatar?v=1", content = "nice")))
    expect string.starts-with(html, "  <div id=\"boost_9\"\n")
    expect string.contains(html, "aria-label=\"Bo &amp; Co boosted nice\"")
    expect string.contains(html, "class=\"txt-small\" data-action")
    expect string.contains(html, "action=\"/messages/5/boosts/9\"")
    expect string.ends-with(html, "Press enter to delete this boost</span>\n")
}

test campfire.views.rails-message-boosted/container {
    let message = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1, updated-at-ms = 1, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann", creator-bio = "", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok", body = option.none<String>())
    let context = messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test")
    let empty = campfire.views.text(campfire.views.rails-message-boosted(context, message, list.empty<BoostView>()))
    expect string.contains(empty, "data-turbo-streaming-target=\"container\">\n      \n    </div>")
    expect string.starts-with(empty, "  <div id=\"message_c-5\"")
    expect string.ends-with(empty, "</turbo-frame>\n</div>\n")
}

test campfire.views.rails-message-presented/body-as-given {
    let message = messageWithCreator.new(id = MessageId.new(5), room-id = RoomId.new(3), creator-id = UserId.new(9), created-at-ms = 1, updated-at-ms = 1, client-message-id = "c-5", created-at = "2026-03-02 15:30:00", creator-name = "Ann", creator-bio = "", creator-updated-at = "2026-01-02 18:00:00", creator-avatar-token = "tok", body = option.some<String>("<p>x</p>"))
    let context = messageContext.new(room-id = "3", room-name = "Lobby", base-url = "https://chat.test")
    expect string.contains(campfire.views.text(campfire.views.rails-message-presented(context, message, list.empty<BoostView>(), html"<p>x</p>")), "<div class=\"lexxy-content\">\n  <p>x</p>\n</div>")
    expect string.contains(campfire.views.text(campfire.views.rails-message-boosted(context, message, list.empty<BoostView>())), "&lt;p&gt;x&lt;/p&gt;")
}
