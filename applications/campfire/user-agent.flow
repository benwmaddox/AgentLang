// Lean User-Agent normalization for Campfire's allow_browser policy.
// Adapted from 37signals' Campfire user_agent.rs at pinned source revision
// 6dae2fd3c1a2dce61ca11beb731bcce2b42b67ad (useragent gem 0.16.11); see
// MIT-LICENSE.37signals.
//
// Only campfire.browser.supported? reads the result, so this port keeps just
// what can change its verdict: the product tokenizer, the gem's kind order
// (an earlier kind such as Edge or iTunes still wins and means "other"), the
// version rules for Safari, Chrome, Firefox, Opera and Internet Explorer, and
// bot detection for those five. The result is canonical: a bot is
// (other, none, bot); any other family is (other, none); otherwise the exact
// family and version. The frozen corpus (user-agent-corpus-tests.flow) pins
// these verdicts against the retired full port.
//
// Case-insensitive comparisons fold with campfire.ua.casefold: ASCII lowering plus
// the Kelvin sign, the one non-ASCII character whose invariant lowercase is ASCII
// (dotted capital I stays non-ASCII), matching .NET ToLowerInvariant for ASCII
// needles.

record UaProduct {
    name: String
    version: String
    comments: List<String>
}

fn campfire.ua.byte(text: String, index: Int) -> Int {
    doc "The byte at index, or -1 past either end."

    string.byte-at-or(text, index, -1)
}

fn campfire.ua.cut(text: String, start: Int, count: Int) -> String {
    doc "A byte slice taken at ASCII delimiters, so it is always a valid String; empty if out of range."

    match string.slice(text, start, count) {
        none => ""
        some piece => piece
    }
}

fn campfire.ua.space?(value: Int) -> Bool {
    doc "Ruby whitespace: space, tab, newline, vertical tab, form feed, carriage return."

    value == 32 || (value >= 9 && value <= 13)
}

fn campfire.ua.strip?(value: Int) -> Bool {
    doc "Bytes Ruby strip removes: whitespace and NUL."

    value == 0 || campfire.ua.space?(value)
}

fn campfire.ua.product-char?(value: Int) -> Bool {
    value >= 0 && value != 47 && bool.not(campfire.ua.space?(value))
}

fn campfire.ua.digit?(value: Int) -> Bool {
    value >= 48 && value <= 57
}

fn campfire.ua.casefold(text: String) -> String {
    doc "Case fold for comparisons with ASCII needles (see the file header)."

    string.to-lower-ascii(string.replace(text, "K", "k"))
}

fn campfire.ua.blank?(text: String) -> Bool {
    doc "True when every byte is Ruby whitespace or NUL (Ruby strip leaves nothing)."

    var blank = true
    for index in 0..string.byte-length(text) {
        if bool.not(campfire.ua.strip?(campfire.ua.byte(text, index))) {
            blank = false
            break
        }
    }
    blank
}

fn campfire.ua.find(text: String, needle: String, from: Int) -> Int {
    doc "Byte offset of needle at or after from, or -1."

    match string.index-of(text, needle, from) {
        none => -1
        some index => index
    }
}

fn campfire.ua.run(text: String, start: Int, underscores: Bool) -> Int {
    doc "Length of the run of ASCII digits and dots (or digits and underscores) starting at start."

    var length = 0
    for index in start..string.byte-length(text) {
        let value = campfire.ua.byte(text, index)
        if campfire.ua.digit?(value) || (bool.not(underscores) && value == 46) || (underscores && value == 95) {
            length = length + 1
        } else {
            break
        }
    }
    length
}

fn campfire.ua.split-comment(text: String) -> List<String> {
    doc "Ruby split on '; ', dropping trailing empty pieces."

    let parts = string.split(text, "; ")
    var keep = 0
    for part, index in parts {
        if string.byte-length(part) > 0 {
            keep = index + 1
        }
    }
    var kept = list.empty<String>()
    for part, index in parts {
        if index >= keep {
            break
        }
        kept = list.append(kept, part)
    }
    kept
}

record UaScan {
    found: Bool
    product: UaProduct
    next: Int
}

record UaTail {
    comments: List<String>
    next: Int
}

fn campfire.ua.quote-count(text: String, position: Int, limit: Int) -> Int {
    doc "Leading single or double quotes at position."

    var quotes = 0
    for index in position..limit {
        let value = campfire.ua.byte(text, index)
        if value == 39 || value == 34 {
            quotes = quotes + 1
        } else {
            break
        }
    }
    quotes
}

fn campfire.ua.run-end(text: String, start: Int, limit: Int, version: Bool) -> Int {
    doc "End of a product-name run (not '/' or space) or, with version, of a version run (not space or ',')."

    var end = start
    for index in start..limit {
        let value = campfire.ua.byte(text, index)
        let stop = if version { campfire.ua.space?(value) || value == 44 } else { bool.not(campfire.ua.product-char?(value)) }
        if stop {
            break
        }
        end = index + 1
    }
    end
}

fn campfire.ua.scan-tail(text: String, index: Int, limit: Int) -> UaTail {
    doc "After a version: ' (comment; parts)' or ',gzip(gfe)'."

    if index + 1 < limit && campfire.ua.space?(campfire.ua.byte(text, index)) && campfire.ua.byte(text, index + 1) == 40 {
        let close = campfire.ua.find(text, ")", index + 2)
        if close >= 0 {
            uaTail.new(comments = campfire.ua.split-comment(campfire.ua.cut(text, index + 2, close - index - 2)), next = close + 1)
        } else {
            uaTail.new(comments = list.empty<String>(), next = index)
        }
    } else if campfire.ua.cut(text, index, 10) == ",gzip(gfe)" {
        uaTail.new(comments = list.empty<String>(), next = index + 10)
    } else {
        uaTail.new(comments = list.empty<String>(), next = index)
    }
}

fn campfire.ua.scan-product(text: String, position: Int, limit: Int) -> UaScan {
    doc "One product at position: optional leading quotes, name, optional /version, then a comment or ',gzip(gfe)'. found is false when no product starts here."

    let quotes = campfire.ua.quote-count(text, position, limit)
    let first = position + quotes
    let start = if first < limit && campfire.ua.product-char?(campfire.ua.byte(text, first)) { first } else if quotes > 0 { first - 1 } else { -1 }
    if start < 0 {
        uaScan.new(found = false, product = uaProduct.new(name = "", version = "", comments = list.empty<String>()), next = position)
    } else {
        let name-end = campfire.ua.run-end(text, start + 1, limit, false)
        let version-start = if name-end < limit && campfire.ua.byte(text, name-end) == 47 { name-end + 1 } else { name-end }
        let version-end = campfire.ua.run-end(text, version-start, limit, true)
        let tail = campfire.ua.scan-tail(text, version-end, limit)
        let product = uaProduct.new(name = campfire.ua.cut(text, start, name-end - start), version = campfire.ua.cut(text, version-start, version-end - version-start), comments = tail.comments)
        uaScan.new(found = true, product = product, next = tail.next)
    }
}

fn campfire.ua.products(text: String) -> List<UaProduct> {
    doc "The gem's product scan: name, optional /version, optional ' (comment; parts)' or ',gzip(gfe)', then Ruby strip of the rest."

    var products = list.empty<UaProduct>()
    var position = 0
    var limit = string.byte-length(text)
    for step in 0..limit + 1 {
        if step > 0 {
            // Ruby strip of the remaining text: leading here, trailing once.
            for leading in position..limit {
                if campfire.ua.strip?(campfire.ua.byte(text, leading)) {
                    position = leading + 1
                } else {
                    break
                }
            }
            if step == 1 {
                let end = limit
                for back in 0..end - position {
                    if campfire.ua.strip?(campfire.ua.byte(text, end - 1 - back)) {
                        limit = end - 1 - back
                    } else {
                        break
                    }
                }
            }
        }
        if position >= limit {
            break
        }
        let scan = campfire.ua.scan-product(text, position, limit)
        if bool.not(scan.found) {
            break
        }
        products = list.append(products, scan.product)
        position = scan.next
    }
    products
}

fn campfire.ua.count(products: List<UaProduct>) -> Int {
    var count = 0
    for product in products {
        count = count + 1
    }
    count
}

fn campfire.ua.at(products: List<UaProduct>, wanted: Int) -> UaProduct {
    doc "The product at wanted, or an empty product."

    var found = uaProduct.new(name = "", version = "", comments = list.empty<String>())
    for product, index in products {
        if index == wanted {
            found = product
            break
        }
    }
    found
}

fn campfire.ua.comment-at(product: UaProduct, wanted: Int) -> String {
    var found = ""
    for comment, index in product.comments {
        if index == wanted {
            found = comment
            break
        }
    }
    found
}

fn campfire.ua.joined(product: UaProduct) -> String {
    doc "The comment parts joined with '; '."

    var joined = ""
    for comment, index in product.comments {
        if index > 0 {
            joined = string.concat(joined, "; ")
        }
        joined = string.concat(joined, comment)
    }
    joined
}

fn campfire.ua.exact?(products: List<UaProduct>, name: String) -> Bool {
    var found = false
    for product in products {
        if product.name == name {
            found = true
            break
        }
    }
    found
}

fn campfire.ua.named(products: List<UaProduct>, folded: String) -> Option<UaProduct> {
    doc "The first product whose case-folded name equals folded (already lowercase)."

    var found = option.none<UaProduct>()
    for product in products {
        if campfire.ua.casefold(product.name) == folded {
            found = option.some<UaProduct>(product)
            break
        }
    }
    found
}

fn campfire.ua.named?(products: List<UaProduct>, folded: String) -> Bool {
    campfire.ua.named(products, folded) != option.none<UaProduct>()
}

fn campfire.ua.named-version(products: List<UaProduct>, folded: String) -> Option<String> {
    match campfire.ua.named(products, folded) {
        none => option.none<String>()
        some product => option.some<String>(product.version)
    }
}

fn campfire.ua.first-commented(products: List<UaProduct>) -> Option<UaProduct> {
    doc "The application product for commented kinds (Chrome, WebKit): the first product with a non-empty comment."

    var found = option.none<UaProduct>()
    for product in products {
        var has = false
        for comment in product.comments {
            has = true
            break
        }
        if has {
            found = option.some<UaProduct>(product)
            break
        }
    }
    found
}

fn campfire.ua.capture-after(value: String, marker: String) -> Option<String> {
    doc "The first non-empty run of digits and dots right after an occurrence of marker."

    var found = option.none<String>()
    var from = 0
    for step in 0..string.byte-length(value) + 1 {
        let at = campfire.ua.find(value, marker, from)
        if at < 0 {
            break
        }
        let start = at + string.byte-length(marker)
        let length = campfire.ua.run(value, start, false)
        if length > 0 {
            found = option.some<String>(campfire.ua.cut(value, start, length))
            break
        }
        from = start
    }
    found
}

fn campfire.ua.trident-rv?(comment: String) -> Bool {
    doc "Internet Explorer 11: 'rv:' after a 'Trident' on the same line."

    var found = false
    var from = 0
    for step in 0..string.byte-length(comment) + 1 {
        let trident = campfire.ua.find(comment, "Trident", from)
        if trident < 0 {
            break
        }
        let start = trident + 7
        let line-end = campfire.ua.find(comment, "\n", start)
        let finish = if line-end < 0 { string.byte-length(comment) } else { line-end }
        let rv = campfire.ua.find(comment, "rv:", start)
        if rv >= start + 1 && rv + 3 <= finish {
            found = true
            break
        }
        from = start
    }
    found
}

fn campfire.ua.ie-version(comment: String) -> String {
    doc "The gem's MSIE / rv: version scan; empty when none."

    var found = ""
    var from = 0
    for step in 0..string.byte-length(comment) + 1 {
        if from >= string.byte-length(comment) {
            break
        }
        let msie = campfire.ua.find(comment, "MSIE", from)
        let rv = campfire.ua.find(comment, "rv:", from)
        if msie >= 0 && (rv < 0 || msie < rv) {
            let after = msie + 4
            if campfire.ua.space?(campfire.ua.byte(comment, after)) {
                let length = campfire.ua.run(comment, after + 1, false)
                if length > 0 {
                    found = campfire.ua.cut(comment, after + 1, length)
                    break
                }
            }
            from = after
        } else {
            if rv < 0 {
                break
            }
            let length = campfire.ua.run(comment, rv + 3, false)
            if length > 0 {
                found = campfire.ua.cut(comment, rv + 3, length)
                break
            }
            from = rv + 3
        }
    }
    found
}

fn campfire.ua.ios-version(value: String) -> Option<String> {
    doc "The digits_and_underscores in 'CPU [iPhone |iPod ]OS <v> like Mac OS X'."

    var found = option.none<String>()
    var from = 0
    for step in 0..string.byte-length(value) + 1 {
        let cpu = campfire.ua.find(value, "CPU ", from)
        if cpu < 0 {
            break
        }
        let start = cpu + 4
        var device = start
        if campfire.ua.cut(value, start, 7) == "iPhone " {
            device = start + 7
        } else {
            if campfire.ua.cut(value, start, 5) == "iPod " {
                device = start + 5
            }
        }
        if campfire.ua.cut(value, device, 3) == "OS " {
            let length = campfire.ua.run(value, device + 3, true)
            if length > 0 && campfire.ua.cut(value, device + 3 + length, 14) == " like Mac OS X" {
                found = option.some<String>(campfire.ua.cut(value, device + 3, length))
                break
            }
        }
        from = start
    }
    found
}

fn campfire.ua.webkit-os(comments: List<String>) -> Option<String> {
    doc "The gem's WebKit OS string (iOS versions normalized to 'iOS x.y'), used for the Android check and the iOS Safari version."

    var count = 0
    var first = ""
    var second = ""
    var third = ""
    var ios-comment = option.none<String>()
    for comment, index in comments {
        count = count + 1
        if index == 0 {
            first = comment
        }
        if index == 1 {
            second = comment
        }
        if index == 2 {
            third = comment
        }
        if ios-comment == option.none<String>() && campfire.ua.ios-version(comment) != option.none<String>() {
            ios-comment = option.some<String>(comment)
        }
    }
    let chosen = if count == 0 {
        option.none<String>()
    } else {
        if string.contains(first, "Windows NT") {
            option.some<String>(first)
        } else {
            if count < 3 || string.contains(second, "Android") {
                if count >= 2 { option.some<String>(second) } else { option.none<String>() }
            } else {
                match ios-comment {
                    some comment => option.some<String>(comment)
                    none => option.some<String>(third)
                }
            }
        }
    }
    match chosen {
        none => option.none<String>()
        some value => match campfire.ua.ios-version(value) {
            some version => option.some<String>(string.concat("iOS ", string.replace(version, "_", ".")))
            none => option.some<String>(value)
        }
    }
}

fn campfire.ua.webkit-comment-version(comment: String) -> Option<String> {
    doc "The build in an 'AppleWebKit/<digits.dots>' comment (prefix compared case-insensitively)."

    let folded = campfire.ua.casefold(comment)
    if string.starts-with(folded, "applewebkit/") {
        let length = campfire.ua.run(folded, 12, false)
        if length > 0 { option.some<String>(campfire.ua.cut(folded, 12, length)) } else { option.none<String>() }
    } else {
        option.none<String>()
    }
}

fn campfire.ua.webkit?(products: List<UaProduct>) -> Bool {
    var found = false
    for product in products {
        if campfire.ua.casefold(product.name) == "applewebkit" {
            found = true
            break
        }
        for comment in product.comments {
            if campfire.ua.webkit-comment-version(comment) != option.none<String>() {
                found = true
                break
            }
        }
        if found {
            break
        }
    }
    found
}

fn campfire.ua.webkit-build-version(build: String) -> String {
    doc "Safari versions of old WebKit builds without a Version product; empty otherwise."

    if build == "85.7" { "1.0" } else if build == "85.8.5" || build == "85.8.2" { "1.0.3" } else if build == "124" { "1.2" } else if build == "125.2" { "1.2.2" } else if build == "125.4" { "1.2.3" } else if build == "125.5.5" || build == "125.5.6" || build == "125.5.7" { "1.2.4" } else if build == "312.1.1" || build == "312.1" { "1.3" } else if build == "312.5" || build == "312.5.1" || build == "312.5.2" { "1.3.1" } else if build == "312.8" || build == "312.8.1" { "1.3.2" } else if build == "412" || build == "412.6" || build == "412.6.2" { "2.0" } else if build == "412.7" { "2.0.1" } else if build == "416.11" || build == "416.12" { "2.0.2" } else if build == "417.9" || build == "418" { "2.0.3" } else if build == "418.8" || build == "418.9" || build == "418.9.1" || build == "419" { "2.0.4" } else if build == "425.13" { "2.2" } else if build == "534.52.7" { "5.1.2" } else { "" }
}

fn campfire.ua.safari-version(products: List<UaProduct>, os: Option<String>) -> String {
    match campfire.ua.named-version(products, "version") {
        some version => version
        none => {
            let ios = match os {
                none => option.none<String>()
                some value => campfire.ua.capture-after(value, "iOS ")
            }
            match ios {
                some version => version
                none => {
                    let named = campfire.ua.named-version(products, "applewebkit")
                    var build = match named {
                        some version => version
                        none => ""
                    }
                    var searching = named == option.none<String>()
                    for product in products {
                        for comment in product.comments {
                            if searching {
                                let candidate = match campfire.ua.webkit-comment-version(comment) {
                                    some version => version
                                    none => ""
                                }
                                if candidate != "" {
                                    build = candidate
                                    searching = false
                                }
                            }
                        }
                    }
                    campfire.ua.webkit-build-version(build)
                }
            }
        }
    }
}

fn campfire.ua.opera-version(products: List<UaProduct>, first: UaProduct) -> String {
    if string.contains(campfire.ua.joined(first), "Opera Mini") {
        var found = ""
        for comment in first.comments {
            let candidate = match campfire.ua.capture-after(comment, "Opera Mini/") {
                some version => version
                none => ""
            }
            if candidate != "" {
                found = candidate
                break
            }
        }
        found
    } else {
        match campfire.ua.named-version(products, "version") {
            some version => version
            none => match campfire.ua.named-version(products, "opr") {
                some version => version
                none => first.version
            }
        }
    }
}

fn campfire.ua.ruby-blank?(text: String) -> Bool {
    var blank = true
    for index in 0..string.byte-length(text) {
        if bool.not(campfire.ua.space?(campfire.ua.byte(text, index))) {
            blank = false
            break
        }
    }
    blank
}

fn campfire.ua.version-or-none(version: String) -> Option<String> {
    doc ".NET IsNullOrWhiteSpace: blank versions (including Unicode spaces) are none."

    var rest = version
    for space in [" ", "\t", "\n", "\u000b", "\f", "\r", "\u001c", "\u001d", "\u001e", "\u001f", "\u0085", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", "　"] {
        rest = string.replace(rest, space, "")
    }
    if string.byte-length(rest) == 0 { option.none<String>() } else { option.some<String>(version) }
}

fn campfire.ua.bot?(products: List<UaProduct>, application: Option<UaProduct>) -> Bool {
    doc "The gem's bot test: no application product, a comment containing 'bot' (any case), a Chrome-Lighthouse product, or an application name containing 'bot'."

    match application {
        none => true
        some app => {
            var bot = string.contains(app.name, "bot") || campfire.ua.named?(products, "chrome-lighthouse")
            for product in products {
                for comment in product.comments {
                    if string.contains(campfire.ua.casefold(comment), "bot") {
                        bot = true
                        break
                    }
                }
                if bot {
                    break
                }
            }
            bot
        }
    }
}

fn campfire.ua.result(products: List<UaProduct>, application: Option<UaProduct>, family: BrowserFamily, version: String) -> BrowserInfo {
    doc "Canonical result for a guarded family: bots collapse to (other, none, bot)."

    if campfire.ua.bot?(products, application) {
        browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = true)
    } else {
        browserInfo.new(family = family, version = campfire.ua.version-or-none(version), is-bot = false)
    }
}

fn campfire.ua.other() -> BrowserInfo {
    browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = false)
}

fn campfire.ua.media-player?(products: List<UaProduct>, first: UaProduct) -> Bool {
    doc "The gem's Windows Media Player, AppleCoreMedia and libavformat kinds (all 'other')."

    let player = campfire.ua.exact?(products, "NSPlayer") || campfire.ua.exact?(products, "Windows-Media-Player") || campfire.ua.exact?(products, "WMFSDK")
    let wmp = player && first.version != "4.1.0.3856" && first.version != "7.10.0.3059" && first.version != "7.0.0.1956"
    let lavf = campfire.ua.exact?(products, "Lavf") || (campfire.ua.exact?(products, "NSPlayer") && first.version == "4.1.0.3856")
    wmp || campfire.ua.exact?(products, "AppleCoreMedia") || lavf
}

fn campfire.ua.chrome-result(products: List<UaProduct>) -> BrowserInfo {
    doc "The Chrome kind: Iron is other; otherwise the CriOS or Chrome version."

    if campfire.ua.named?(products, "iron") {
        campfire.ua.other()
    } else {
        let version = match campfire.ua.named-version(products, "crios") {
            some value => value
            none => match campfire.ua.named-version(products, "chrome") {
                some value => value
                none => ""
            }
        }
        campfire.ua.result(products, campfire.ua.first-commented(products), BrowserFamily.chrome(), version)
    }
}

fn campfire.ua.webkit-result(products: List<UaProduct>, first: UaProduct) -> BrowserInfo {
    doc "The WebKit kind: Android and BlackBerry are other; otherwise Safari."

    let application = campfire.ua.first-commented(products)
    let platform-product = match application {
        none => first
        some app => app
    }
    let os = campfire.ua.webkit-os(platform-product.comments)
    let android = match os {
        none => false
        some value => string.contains(value, "Android")
    }
    // The gem's platform: the first comment, unless it mentions Windows,
    // is BB10 (BlackBerry) or some comment mentions Android.
    let platform = campfire.ua.comment-at(platform-product, 0)
    var mentions-android = false
    for comment in platform-product.comments {
        if string.contains(comment, "Android") {
            mentions-android = true
        }
    }
    let blackberry = bool.not(string.contains(platform, "Windows")) && (platform == "BB10" || (platform == "BlackBerry" && bool.not(mentions-android)))
    if android || blackberry {
        campfire.ua.other()
    } else {
        campfire.ua.result(products, application, BrowserFamily.safari(), campfire.ua.safari-version(products, os))
    }
}

fn campfire.ua.gecko-result(products: List<UaProduct>, first: UaProduct) -> BrowserInfo {
    doc "The Gecko kind (first product Mozilla): Firefox unless PaleMoon comes first in the gem's list; Camino and the rest are other."

    if campfire.ua.named?(products, "palemoon") || bool.not(campfire.ua.named?(products, "firefox")) {
        campfire.ua.other()
    } else {
        let version = match campfire.ua.named-version(products, "firefox") {
            none => first.version
            some value => if campfire.ua.ruby-blank?(value) { first.version } else { value }
        }
        campfire.ua.result(products, option.some<UaProduct>(first), BrowserFamily.firefox(), version)
    }
}

fn campfire.ua.base-result(products: List<UaProduct>, first: UaProduct) -> BrowserInfo {
    doc "The base kind: the first product's name decides the family."

    let folded = campfire.ua.casefold(first.name)
    let application = option.some<UaProduct>(first)
    if folded == "safari" {
        campfire.ua.result(products, application, BrowserFamily.safari(), first.version)
    } else if folded == "chrome" {
        campfire.ua.result(products, application, BrowserFamily.chrome(), first.version)
    } else if folded == "firefox" {
        campfire.ua.result(products, application, BrowserFamily.firefox(), first.version)
    } else if folded == "opera" {
        campfire.ua.result(products, application, BrowserFamily.opera(), first.version)
    } else {
        campfire.ua.other()
    }
}

fn campfire.ua.other-kind?(products: List<UaProduct>, first: UaProduct, count: Int) -> Bool {
    doc "Kinds between Opera and Chrome or WebKit in the gem's order that always mean other: WeChat, Vivaldi."

    var wechat = false
    for product in products {
        if string.contains(campfire.ua.casefold(product.name), "micromessenger") {
            wechat = true
            break
        }
    }
    wechat || campfire.ua.exact?(products, "Vivaldi")
}

fn campfire.ua.console-kind?(products: List<UaProduct>, first: UaProduct, count: Int) -> Bool {
    doc "iTunes, PlayStation and Podcast Addict: kinds after Chrome that always mean other."

    let console = campfire.ua.comment-at(first, 0)
    campfire.ua.exact?(products, "iTunes") || string.contains(console, "PLAYSTATION 3") || string.contains(console, "PlayStation Vita") || string.contains(console, "PlayStation 4") || (count >= 3 && first.name == "Podcast" && campfire.ua.at(products, 1).name == "Addict" && campfire.ua.at(products, 2).name == "-")
}

fn campfire.ua.classify(products: List<UaProduct>, first: UaProduct, last: UaProduct, count: Int) -> BrowserInfo {
    doc "The gem's kinds in order; the first match wins."

    if count == 0 {
        campfire.ua.other()
    } else if last.name == "Edge" {
        campfire.ua.other()
    } else if string.contains(campfire.ua.comment-at(first, 1), "MSIE") || campfire.ua.trident-rv?(campfire.ua.joined(first)) {
        campfire.ua.result(products, option.some<UaProduct>(first), BrowserFamily.internet-explorer(), campfire.ua.ie-version(campfire.ua.joined(first)))
    } else if first.name == "Opera" || last.name == "OPR" {
        campfire.ua.result(products, option.some<UaProduct>(first), BrowserFamily.opera(), campfire.ua.opera-version(products, first))
    } else if campfire.ua.other-kind?(products, first, count) {
        campfire.ua.other()
    } else if campfire.ua.exact?(products, "Chrome") || campfire.ua.exact?(products, "CriOS") {
        campfire.ua.chrome-result(products)
    } else if campfire.ua.console-kind?(products, first, count) {
        campfire.ua.other()
    } else if campfire.ua.webkit?(products) {
        campfire.ua.webkit-result(products, first)
    } else if first.name == "Mozilla" {
        campfire.ua.gecko-result(products, first)
    } else if campfire.ua.media-player?(products, first) {
        campfire.ua.other()
    } else {
        campfire.ua.base-result(products, first)
    }
}

fn campfire.browser.from-user-agent(user-agent: Option<String>) -> BrowserInfo {
    doc "Classifies a User-Agent the way Campfire's allow_browser does, canonicalized to what campfire.browser.supported? reads."

    let raw = match user-agent {
        none => ""
        some value => value
    }
    let text = if campfire.ua.blank?(raw) { "Mozilla/4.0 (compatible)" } else { raw }
    let products = campfire.ua.products(text)
    let count = campfire.ua.count(products)
    campfire.ua.classify(products, campfire.ua.at(products, 0), campfire.ua.at(products, count - 1), count)
}

// Ruby Version#<=> as pinned by the useragent gem: digit runs compare as
// integers (leading zeros dropped), letter runs reaching the end compare as
// text below any integer, at most six segments, and a non-comparable left side
// equals only an identical right side (otherwise it is lower).

record UaSegment {
    integer: Bool
    text: String
}

fn campfire.ua.leading-digits(value: String) -> Int {
    var count = 0
    for index in 0..string.byte-length(value) {
        if campfire.ua.digit?(campfire.ua.byte(value, index)) {
            count = count + 1
        } else {
            break
        }
    }
    count
}

fn campfire.ua.comparable?(value: String) -> Bool {
    doc "Ruby's comparable version: leading digits, then the end or a dot."

    let digits = campfire.ua.leading-digits(value)
    digits > 0 && (digits == string.byte-length(value) || campfire.ua.byte(value, digits) == 46)
}

fn campfire.ua.letter?(value: Int) -> Bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

fn campfire.ua.digit-end(value: String, start: Int) -> Int {
    doc "The end of the ASCII digit run starting at start."

    var end = start
    for index in start..string.byte-length(value) {
        if campfire.ua.digit?(campfire.ua.byte(value, index)) {
            end = index + 1
        } else {
            break
        }
    }
    end
}

fn campfire.ua.word-end(value: String, start: Int) -> Int {
    doc "The end of a letter run continued by letters, digits and dashes (start is the first letter)."

    var end = start + 1
    let from = start + 1
    for index in from..string.byte-length(value) {
        let next = campfire.ua.byte(value, index)
        if campfire.ua.letter?(next) || campfire.ua.digit?(next) || next == 45 {
            end = index + 1
        } else {
            break
        }
    }
    end
}

fn campfire.ua.trim-zeros(digits: String) -> String {
    doc "A digit run without leading zeros; all zeros become '0'."

    var start = string.byte-length(digits)
    for index in 0..string.byte-length(digits) {
        if campfire.ua.byte(digits, index) != 48 {
            start = index
            break
        }
    }
    if start == string.byte-length(digits) { "0" } else { campfire.ua.cut(digits, start, string.byte-length(digits) - start) }
}

fn campfire.ua.segments(value: String) -> List<UaSegment> {
    doc "Ruby Version segments: integer runs, and a trailing letter run as text; a non-comparable string is one text segment."

    var segments = list.empty<UaSegment>()
    let length = string.byte-length(value)
    if campfire.ua.ruby-blank?(value) {
        segments = segments
    } else if campfire.ua.comparable?(value) {
        var index = 0
        for step in 0..length + 1 {
            if index >= length {
                break
            }
            let byte = campfire.ua.byte(value, index)
            if campfire.ua.digit?(byte) {
                let end = campfire.ua.digit-end(value, index)
                segments = list.append(segments, uaSegment.new(integer = true, text = campfire.ua.trim-zeros(campfire.ua.cut(value, index, end - index))))
                index = end
            } else if campfire.ua.letter?(byte) && campfire.ua.word-end(value, index) == length {
                segments = list.append(segments, uaSegment.new(integer = false, text = campfire.ua.cut(value, index, length - index)))
                index = length
            } else {
                index = index + 1
            }
        }
    } else {
        segments = list.append(segments, uaSegment.new(integer = false, text = value))
    }
    segments
}

fn campfire.ua.segment-at(segments: List<UaSegment>, wanted: Int) -> UaSegment {
    var found = uaSegment.new(integer = true, text = "0")
    for segment, index in segments {
        if index == wanted {
            found = segment
            break
        }
    }
    found
}

fn campfire.ua.compare-bytes(left: String, right: String) -> Int {
    doc "Byte-wise ordinal comparison: -1, 0 or 1."

    let left-length = string.byte-length(left)
    let right-length = string.byte-length(right)
    var result = 0
    var index = 0
    for step in 0..left-length + 1 {
        if index >= left-length || index >= right-length {
            break
        }
        let a = campfire.ua.byte(left, index)
        let b = campfire.ua.byte(right, index)
        if a != b {
            result = if a < b { -1 } else { 1 }
            break
        }
        index = index + 1
    }
    if result != 0 {
        result
    } else if left-length == right-length {
        0
    } else if left-length < right-length {
        -1
    } else {
        1
    }
}

fn campfire.ua.compare-segment(left: UaSegment, right: UaSegment) -> Int {
    if left.integer && right.integer {
        let a = string.byte-length(left.text)
        let b = string.byte-length(right.text)
        if a != b {
            if a < b { -1 } else { 1 }
        } else {
            campfire.ua.compare-bytes(left.text, right.text)
        }
    } else if left.integer {
        1
    } else if right.integer {
        -1
    } else {
        campfire.ua.compare-bytes(left.text, right.text)
    }
}

fn campfire.browser.version-compare(left: String, right: String) -> Int {
    doc "The pinned useragent gem Version#<=>, including its asymmetric result for a non-comparable left side and its six-segment limit."

    if campfire.ua.comparable?(left) {
        let left-segments = campfire.ua.segments(left)
        let right-segments = campfire.ua.segments(right)
        var result = 0
        for index in 0..6 {
            result = campfire.ua.compare-segment(campfire.ua.segment-at(left-segments, index), campfire.ua.segment-at(right-segments, index))
            if result != 0 {
                break
            }
        }
        result
    } else if left == right {
        0
    } else {
        -1
    }
}

fn campfire.browser.version-at-least?(version: String, minimum: String) -> Bool {
    doc "True when the pinned Ruby comparison says version is at least minimum."

    campfire.browser.version-compare(version, minimum) >= 0
}
