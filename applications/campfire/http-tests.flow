test-file campfire-http-authenticate {
    override fn campfire.messages.page-for-member(user-id: UserId, room-id: RoomId) -> Result<List<MessageWithCreator>, RoomMessageError> {
        result.ok<List<MessageWithCreator>, RoomMessageError>(list.empty<MessageWithCreator>())
    }

    override fn campfire.csrf.session-secret(candidate: Option<String>) -> CsrfSecret {
        csrfSecret.new(value = "test-csrf-secret", fresh = false)
    }

    override fn campfire.csrf.form-token(secret: String, identifier: String) -> String {
        string.concat("test-token:", identifier)
    }

    override fn campfire.messages.create-for-member(user-id: UserId, room-id: RoomId, client-message-id: Option<String>, body: Option<String>) -> Result<MessageRow, RoomMessageError> {
        result.ok<MessageRow, RoomMessageError>(messageRow.new(id = MessageId.new(1), room-id = RoomId.new(1), creator-id = UserId.new(1), client-message-id = "test", body = option.some<String>("Hello"), created-at = "2026-01-01", updated-at = "2026-01-01"))
    }

    override fn campfire.rooms.find-for-user(user-id: UserId, room-id: RoomId) -> Result<Option<RoomRow>, DbError> {
        if room-id == RoomId.new(404) {
            result.ok<Option<RoomRow>, DbError>(option.none<RoomRow>())
        } else {
            result.ok<Option<RoomRow>, DbError>(option.some<RoomRow>(roomRow.new(id = RoomId.new(1), name = option.some<String>("Main"), kind = RoomKind.open(), creator-id = UserId.new(1), created-at = "2026-01-01", updated-at = "2026-01-01")))
        }
    }

    override fn campfire.browser.supported?(info: BrowserInfo) -> Bool {
        if info.family == BrowserFamily.internet-explorer() { false } else { true }
    }

    override fn campfire.users.authenticate-bot-key(key: BotKey) -> Result<Option<AuthUser>, DbError> {
        if BotKey.value(key) == "active" {
            result.ok<Option<AuthUser>, DbError>(option.some<AuthUser>(authUser.new(id = UserId.new(1), name = "Member", role = Role.member(), status = AuthUserStatus.active())))
        } else {
            result.ok<Option<AuthUser>, DbError>(option.none<AuthUser>())
        }
    }

    override fn campfire.cookies.verify-session-token(signed: String, now: UtcInstant) -> Option<SessionToken> {
        if signed == "invalid" { option.none<SessionToken>() } else { option.some<SessionToken>(SessionToken.new(signed)) }
    }

    override fn campfire.authentication.restore-session(verified-token: SessionToken, now: UtcInstant, remote-ip: Option<RemoteIp>, user-agent: Option<String>) -> Result<Option<RestoredSession>, DbError> {
        if SessionToken.value(verified-token) == "missing-session" {
            result.ok<Option<RestoredSession>, DbError>(option.none<RestoredSession>())
        } else {
            if SessionToken.value(verified-token) == "failure" {
                result.error<Option<RestoredSession>, DbError>(DbError.unavailable())
            } else {
                result.ok<Option<RestoredSession>, DbError>(option.some<RestoredSession>(restoredSession.new(user = option.some<AuthUser>(authUser.new(id = UserId.new(1), name = "Member", role = Role.member(), status = AuthUserStatus.active())), session = sessionRow.new(id = SessionId.new(1), user-id = UserId.new(1), token = SessionToken.new("valid"), ip-address = option.none<RemoteIp>(), user-agent = option.none<String>(), last-active-at = UtcInstant.new(0), created-at = UtcInstant.new(0), updated-at = UtcInstant.new(0)), refresh-cookie = false)))
            }
        }
    }

    override fn campfire.bans.ip-banned?(ip: RemoteIp) -> Result<Bool, DbError> {
        result.ok<Bool, DbError>(RemoteIp.value(ip) == "banned")
    }

    test campfire.http.authenticate/invalid-cookie {
        let response = campfire.http.authenticate(campfireHttpRequest.new(
            route = HttpRoute.room-show(),
            method = RequestMethod.get(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(3600000001),
            remote-ip = RemoteIp.new("allowed"),
            user-agent = option.none<String>(),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("same-origin"),
            session-token = option.some<String>("invalid"),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.some<HttpMessageInput>(httpMessageInput.new(client-message-id = option.none<String>(), body = option.some<String>("Hello")))),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            accepts-html = true,
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 302
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.http.authenticate/missing-session {
        let response = campfire.http.authenticate(campfireHttpRequest.new(
            route = HttpRoute.room-show(),
            method = RequestMethod.get(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(3600000001),
            remote-ip = RemoteIp.new("allowed"),
            user-agent = option.none<String>(),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("same-origin"),
            session-token = option.some<String>("missing-session"),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.some<HttpMessageInput>(httpMessageInput.new(client-message-id = option.none<String>(), body = option.some<String>("Hello")))),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            accepts-html = true,
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 302
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.http.authenticate/database-failure {
        let response = campfire.http.authenticate(campfireHttpRequest.new(
            route = HttpRoute.room-show(),
            method = RequestMethod.get(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(3600000001),
            remote-ip = RemoteIp.new("allowed"),
            user-agent = option.none<String>(),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("same-origin"),
            session-token = option.some<String>("failure"),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.some<HttpMessageInput>(httpMessageInput.new(client-message-id = option.none<String>(), body = option.some<String>("Hello")))),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            accepts-html = true,
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 500
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}

