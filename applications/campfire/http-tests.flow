    test campfire.http.authenticated/csrf-precedes-browser {
        let response = campfire.http.authenticated(campfireHttpRequest.new(
            route = HttpRoute.room-show(),
            method = RequestMethod.unsafe(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(3600000001),
            remote-ip = RemoteIp.new("allowed"),
            user-agent = option.some<String>("Mozilla/5.0 (compatible; MSIE 10.0; Windows NT 6.1; Trident/6.0)"),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("cross-site"),
            session-token = option.some<String>("valid"),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.some<HttpMessageInput>(httpMessageInput.new(client-message-id = option.none<String>(), body = option.some<String>("Hello")))),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            accepts-html = true,
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ), restoredSession.new(user = option.some<AuthUser>(authUser.new(id = UserId.new(1), name = "Member", role = Role.member(), status = AuthUserStatus.active())), session = sessionRow.new(id = SessionId.new(1), user-id = UserId.new(1), token = SessionToken.new("valid"), ip-address = option.none<RemoteIp>(), user-agent = option.none<String>(), last-active-at = UtcInstant.new(0), created-at = UtcInstant.new(0), updated-at = UtcInstant.new(0)), refresh-cookie = true))
        response.status
        => 422
        effects {
