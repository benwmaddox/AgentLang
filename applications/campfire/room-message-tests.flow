test-file campfire-room-pages {
    override fn campfire.rooms.page-for-user(user-id: UserId, after-room-id: Option<RoomId>, page-size: Int) -> Result<List<RoomRow>, DbError> {
        if user-id == UserId.new(11) {
            match after-room-id {
                none => {
                    if page-size == 10 {
                        result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
                            id = RoomId.new(1),
                            name = option.none<String>(),
                            kind = RoomKind.open(),
                            creator-id = UserId.new(11),
                            created-at = "2026-10-11 12:00:00",
                            updated-at = "2026-10-11 12:00:00"
                        )))
                    } else {
                        if page-size == 20 {
                            result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
                                id = RoomId.new(2),
                                name = option.some<String>("closed room"),
                                kind = RoomKind.closed(),
                                creator-id = UserId.new(11),
                                created-at = "2026-10-11 12:00:00",
                                updated-at = "2026-10-11 12:00:00"
                            )))
                        } else {
                            if page-size == 40 {
                                result.error<List<RoomRow>, DbError>(DbError.unavailable())
                            } else {
                                if page-size == 41 {
                                    result.error<List<RoomRow>, DbError>(DbError.not-found())
                                } else {
                                    if page-size == 42 {
                                        result.error<List<RoomRow>, DbError>(DbError.constraint-conflict())
                                    } else {
                                        if page-size == 43 {
                                            result.error<List<RoomRow>, DbError>(DbError.invalid-input())
                                        } else {
                                            result.error<List<RoomRow>, DbError>(DbError.invalid-input())
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                some cursor => {
                    if cursor == RoomId.new(4) {
                        if page-size == 30 {
                            result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
                                id = RoomId.new(5),
                                name = option.some<String>("direct room"),
                                kind = RoomKind.direct(),
                                creator-id = UserId.new(11),
                                created-at = "2026-10-11 12:00:00",
                                updated-at = "2026-10-11 12:00:00"
                            )))
                        } else {
                            result.error<List<RoomRow>, DbError>(DbError.invalid-input())
                        }
                    } else {
                        result.error<List<RoomRow>, DbError>(DbError.invalid-input())
                    }
                }
            }
        } else {
            result.error<List<RoomRow>, DbError>(DbError.not-found())
        }
    }

    test campfire.rooms.list-for-user/open-first-page {
        campfire.rooms.list-for-user(UserId.new(11), option.none<RoomId>(), 10)
        => value result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
            id = RoomId.new(1),
            name = option.none<String>(),
            kind = RoomKind.open(),
            creator-id = UserId.new(11),
            created-at = "2026-10-11 12:00:00",
            updated-at = "2026-10-11 12:00:00"
        ))) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/closed-page {
        campfire.rooms.list-for-user(UserId.new(11), option.none<RoomId>(), 20)
        => value result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
            id = RoomId.new(2),
            name = option.some<String>("closed room"),
            kind = RoomKind.closed(),
            creator-id = UserId.new(11),
            created-at = "2026-10-11 12:00:00",
            updated-at = "2026-10-11 12:00:00"
        ))) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/cursor-page {
        campfire.rooms.list-for-user(UserId.new(11), option.some<RoomId>(RoomId.new(4)), 30)
        => value result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
            id = RoomId.new(5),
            name = option.some<String>("direct room"),
            kind = RoomKind.direct(),
            creator-id = UserId.new(11),
            created-at = "2026-10-11 12:00:00",
            updated-at = "2026-10-11 12:00:00"
        ))) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/provider-errors {
        campfire.rooms.list-for-user(UserId.new(11), option.none<RoomId>(), 40)
        => value result.error<List<RoomRow>, DbError>(DbError.unavailable()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/missing-user {
        campfire.rooms.list-for-user(UserId.new(99), option.none<RoomId>(), 10)
        => value result.error<List<RoomRow>, DbError>(DbError.not-found()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/constraint-error {
        campfire.rooms.list-for-user(UserId.new(11), option.none<RoomId>(), 42)
        => value result.error<List<RoomRow>, DbError>(DbError.constraint-conflict()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.rooms.list-for-user/invalid-page {
        campfire.rooms.list-for-user(UserId.new(11), option.none<RoomId>(), 43)
        => value result.error<List<RoomRow>, DbError>(DbError.invalid-input()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }
}

test-file campfire-message-pages {
    override fn campfire.membership.exists?(key: MembershipKey) -> Result<Bool, DbError> {
        if key.user-id == UserId.new(71) {
            result.error<Bool, DbError>(DbError.unavailable())
        } else {
            if key.user-id == UserId.new(72) {
                result.error<Bool, DbError>(DbError.not-found())
            } else {
                if key.user-id == UserId.new(73) {
                    result.error<Bool, DbError>(DbError.constraint-conflict())
                } else {
                    if key.user-id == UserId.new(74) {
                        result.error<Bool, DbError>(DbError.invalid-input())
                    } else {
                        if key.room-id == RoomId.new(20) {
                            result.ok<Bool, DbError>(false)
                        } else {
                            result.ok<Bool, DbError>(true)
                        }
                    }
                }
            }
        }
    }

    override fn campfire.messages.last-page(room-id: RoomId) -> Result<List<MessageRow>, DbError> {
        if room-id == RoomId.new(4) {
            result.error<List<MessageRow>, DbError>(DbError.unavailable())
        } else {
            if room-id == RoomId.new(5) {
                result.error<List<MessageRow>, DbError>(DbError.not-found())
            } else {
                if room-id == RoomId.new(6) {
                    result.error<List<MessageRow>, DbError>(DbError.constraint-conflict())
                } else {
                    if room-id == RoomId.new(7) {
                        result.error<List<MessageRow>, DbError>(DbError.invalid-input())
                    } else {
                        result.ok<List<MessageRow>, DbError>(list.singleton<MessageRow>(messageRow.new(
                            id = MessageId.new(100),
                            room-id = room-id,
                            creator-id = UserId.new(11),
                            client-message-id = "fixture-message",
                            body = option.some<String>("<p>stored body</p>"),
                            created-at = "2026-10-11 12:01:00",
                            updated-at = "2026-10-11 12:01:00"
                        )))
                    }
                }
            }
        }
    }

    test campfire.messages.list-for-member/member-can-read {
        campfire.messages.list-for-member(UserId.new(11), RoomId.new(1))
        => value result.ok<List<MessageRow>, RoomMessageError>(list.singleton<MessageRow>(messageRow.new(
            id = MessageId.new(100),
            room-id = RoomId.new(1),
            creator-id = UserId.new(11),
            client-message-id = "fixture-message",
            body = option.some<String>("<p>stored body</p>"),
            created-at = "2026-10-11 12:01:00",
            updated-at = "2026-10-11 12:01:00"
        ))) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.messages.list-for-member/non-member-denied {
        campfire.messages.list-for-member(UserId.new(22), RoomId.new(20))
        => value result.error<List<MessageRow>, RoomMessageError>(RoomMessageError.access-denied()) effects {
            db.read: 0
