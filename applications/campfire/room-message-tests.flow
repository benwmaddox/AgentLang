test-file campfire-message-create {
    override fn campfire.membership.exists?(key: MembershipKey) -> Result<Bool, DbError> {
        if key.user-id == UserId.new(71) {
            result.error<Bool, DbError>(DbError.unavailable())
        } else {
            if key.user-id == UserId.new(72) {
                result.error<Bool, DbError>(DbError.not-found())
            } else {
                if key.user-id == UserId.new(73) {
                    result.error<Bool, DbError>(DbError.constraint-conflict())
                } else {
                    if key.user-id == UserId.new(74) {
                        result.error<Bool, DbError>(DbError.invalid-input())
                    } else {
                        if key.room-id == RoomId.new(20) {
                            result.ok<Bool, DbError>(false)
                        } else {
                            result.ok<Bool, DbError>(true)
                        }
                    }
                }
            }
        }
    }

    override fn campfire.messages.create(message: NewMessage) -> Result<MessageRow, DbError> {
        if message.creator-id == UserId.new(42) {
            if message.room-id == RoomId.new(1) {
                if message.client-message-id == "db-unavailable" {
                    result.error<MessageRow, DbError>(DbError.unavailable())
                } else {
                    if message.client-message-id == "db-not-found" {
                        result.error<MessageRow, DbError>(DbError.not-found())
                    } else {
                        if message.client-message-id == "db-constraint" {
                            result.error<MessageRow, DbError>(DbError.constraint-conflict())
                        } else {
                            if message.client-message-id == "db-invalid" {
                                result.error<MessageRow, DbError>(DbError.invalid-input())
                            } else {
                                result.ok<MessageRow, DbError>(messageRow.new(
                                    id = MessageId.new(800),
                                    room-id = message.room-id,
                                    creator-id = message.creator-id,
                                    client-message-id = message.client-message-id,
                                    body = message.body,
                                    created-at = "2026-10-11 12:02:00",
                                    updated-at = "2026-10-11 12:02:00"
                                ))
                            }
                        }
                    }
                }
            } else {
                result.error<MessageRow, DbError>(DbError.invalid-input())
            }
        } else {
            result.error<MessageRow, DbError>(DbError.invalid-input())
        }
    }

    test campfire.messages.create-for-member/member-body-absent {
        campfire.messages.create-for-member(UserId.new(42), RoomId.new(1), "created-none", option.none<String>())
        => value result.ok<MessageRow, RoomMessageError>(messageRow.new(
            id = MessageId.new(800),
            room-id = RoomId.new(1),
            creator-id = UserId.new(42),
            client-message-id = "created-none",
            body = option.none<String>(),
            created-at = "2026-10-11 12:02:00",
            updated-at = "2026-10-11 12:02:00"
        )) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.messages.create-for-member/member-empty-body-is-not-rejected {
        campfire.messages.create-for-member(UserId.new(42), RoomId.new(1), "created-empty", option.some<String>(""))
        => value result.ok<MessageRow, RoomMessageError>(messageRow.new(
            id = MessageId.new(800),
            room-id = RoomId.new(1),
            creator-id = UserId.new(42),
            client-message-id = "created-empty",
            body = option.some<String>(""),
            created-at = "2026-10-11 12:02:00",
            updated-at = "2026-10-11 12:02:00"
        )) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.messages.create-for-member/non-member-does-not-create {
        campfire.messages.create-for-member(UserId.new(42), RoomId.new(20), "unexpected-create", option.none<String>())
        => value result.error<MessageRow, RoomMessageError>(RoomMessageError.access-denied()) effects {
            db.read: 0
