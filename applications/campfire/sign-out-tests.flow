    test campfire.authentication.sign-out/session-invalid-input {
        campfire.authentication.sign-out(UserId.new(7), SessionId.new(13), option.none<String>())
        => value result.error<Unit, DbError>(DbError.invalid-input()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.authentication.sign-out/session-failure-after-push-revocation {
        campfire.authentication.sign-out(UserId.new(7), SessionId.new(14), option.some<String>("push-ok"))
        => value result.error<Unit, DbError>(DbError.unavailable()) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}
