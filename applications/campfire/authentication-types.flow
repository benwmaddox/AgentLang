type SessionId : Int { }

type SessionToken : String { }

type BotKey : String { }

type RemoteIp : String { }

enum AuthUserStatus {
    active
    deactivated
    banned
}

record AuthUser {
    id: UserId
    name: String
    role: Role
    status: AuthUserStatus
}

record SessionRow {
    id: SessionId
    user-id: UserId
    token: SessionToken
    ip-address: Option<RemoteIp>
    user-agent: Option<String>
    last-active-at: UtcInstant
    created-at: UtcInstant
    updated-at: UtcInstant
}

record SessionStart {
    user-id: UserId
    now: UtcInstant
    ip-address: Option<RemoteIp>
    user-agent: Option<String>
}

record SessionRefresh {
    session-id: SessionId
    cutoff: UtcInstant
    now: UtcInstant
    ip-address: Option<RemoteIp>
    user-agent: Option<String>
}

record RestoredSession {
    user: Option<AuthUser>
    session: SessionRow
    refresh-cookie: Bool
}
