test-file campfire-http-login-page {
    test campfire.http.login-page/reflected-email-only {
        let response = campfire.http.login-page(campfireHttpRequest.new(
            route = HttpRoute.session-new(),
            method = RequestMethod.get(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("limited"),
            user-agent = option.none<String>(),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("same-origin"),
            session-token = option.none<String>(),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.some<HttpLoginInput>(httpLoginInput.new(email-address = option.some<String>("member@example.test"), password = option.some<String>("never-render-this-password")))),
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = false,
            accepts-html = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ), 401)
        response
        => value campfireHttpResponse.new(
            status = 401,
            view = HttpView.login-page(),
            text = "member@example.test",
            room = option.none<RoomRow>(),
            message = option.none<MessageRow>(),
            refresh-session-token = option.none<SessionToken>(),
            remember-return-to = false,
            last-room = option.none<RoomId>(), new-csrf-token = option.none<String>(), body = "<!doctype html><html><body><p role=\"alert\">Too many requests or unauthorized.</p><form method=\"post\" action=\"/session\"><label for=\"email_address\">Email address</label><input id=\"email_address\" name=\"email_address\" type=\"email\" autocomplete=\"username\" value=\"member@example.test\"><label for=\"password\">Password</label><input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" maxlength=\"72\"><button type=\"submit\">Sign in</button></form></body></html>"
        )
    }
}

