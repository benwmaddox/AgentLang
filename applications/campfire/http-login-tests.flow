test-file campfire-http-dispatch-after-ban {
    override fn campfire.sessions.login-attempt-count(ip: RemoteIp, now: UtcInstant) -> Result<Int, DbError> {
        if RemoteIp.value(ip) == "counter-failure" {
            result.error<Int, DbError>(DbError.unavailable())
        } else {
            if RemoteIp.value(ip) == "limited" {
                result.ok<Int, DbError>(11)
            } else {
                result.ok<Int, DbError>(1)
            }
        }
    }
    override fn campfire.users.any?() -> Result<Bool, DbError> {
        result.ok<Bool, DbError>(true)
    }
    override fn campfire.authentication.sign-in(email-address: String, password: String, now: UtcInstant, ip-address: Option<RemoteIp>, user-agent: Option<String>) -> Result<Option<SessionRow>, DbError> {
        if email-address == "sign-in-error@example.test" {
            result.error<Option<SessionRow>, DbError>(DbError.unavailable())
        } else {
            if email-address == "member@example.test" {
                if password == "correct-password" {
                    result.ok<Option<SessionRow>, DbError>(option.some<SessionRow>(sessionRow.new(
                        id = SessionId.new(991),
                        user-id = UserId.new(91),
                        token = SessionToken.new("new-login-token"),
                        ip-address = ip-address,
                        user-agent = user-agent,
                        last-active-at = now,
                        created-at = UtcInstant.new(1),
                        updated-at = now
                    )))
                } else {
                    result.ok<Option<SessionRow>, DbError>(option.none<SessionRow>())
                }
            } else {
                result.ok<Option<SessionRow>, DbError>(option.none<SessionRow>())
            }
        }
    }
    override fn campfire.browser.supported?(info: BrowserInfo) -> Bool {
        if info.family == BrowserFamily.internet-explorer() { false } else { true }
    }
    override fn campfire.cookies.verify-session-token(signed: String, now: UtcInstant) -> Option<SessionToken> {
        option.none<SessionToken>()
    }
    override fn campfire.users.authenticate-bot-key(key: BotKey) -> Result<Option<AuthUser>, DbError> {
        result.ok<Option<AuthUser>, DbError>(option.some<AuthUser>(authUser.new(
            id = UserId.new(92),
            name = "Bot",
            role = Role.bot(),
            status = AuthUserStatus.active()
        )))
    }
    test campfire.http.dispatch-after-ban/session-create-bypasses-cookie-and-bot-auth {
        let response = campfire.http.dispatch-after-ban(campfireHttpRequest.new(
            route = HttpRoute.session-create(), method = RequestMethod.unsafe(), room-id = RoomId.new(1), now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("allowed"), user-agent = option.some<String>("login-agent"), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
            origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.some<String>("invalid-cookie"),
            bot-key = option.some<BotKey>(BotKey.new("active-bot")), message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.some<HttpLoginInput>(httpLoginInput.new(email-address = option.some<String>("member@example.test"), password = option.some<String>("correct-password")))),
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = false, accepts-html = false, last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response
        => value campfireHttpResponse.new(
            status = 302,
            view = HttpView.redirect-authenticated(),
            text = "",
            room = option.none<RoomRow>(),
            message = option.none<MessageRow>(),
            refresh-session-token = option.some<SessionToken>(SessionToken.new("new-login-token")),
            remember-return-to = false,
            last-room = option.none<RoomId>(), new-csrf-token = option.none<String>(), body = ""
        )
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
    test campfire.http.dispatch-after-ban/public-route-bypasses-cookie-and-bot-auth {
        let response = campfire.http.dispatch-after-ban(campfireHttpRequest.new(
            route = HttpRoute.session-new(), method = RequestMethod.get(), room-id = RoomId.new(1), now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("allowed"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
            origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.some<String>("invalid-cookie"),
            bot-key = option.some<BotKey>(BotKey.new("active-bot")), message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()), logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = false, accepts-html = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 200
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}

test-file campfire-http-login-dispatch {
    override fn campfire.bans.ip-banned?(ip: RemoteIp) -> Result<Bool, DbError> {
        result.ok<Bool, DbError>(RemoteIp.value(ip) == "banned")
    }
    test campfire.http.dispatch/login-ban-before-rate-counter {
        let response = campfire.http.dispatch(campfireHttpRequest.new(
            route = HttpRoute.session-create(), method = RequestMethod.unsafe(), room-id = RoomId.new(1), now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("banned"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
            origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.none<String>(), bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.error<Option<HttpLoginInput>, HttpFormError>(HttpFormError.invalid-form()), logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = false, accepts-html = true,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 429
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}
