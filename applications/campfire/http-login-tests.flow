test-file campfire-http-login-route-registered {
    override fn campfire.users.any?() -> Result<Bool, DbError> {
        result.ok<Bool, DbError>(true)
    }
    override fn campfire.browser.supported?(info: BrowserInfo) -> Bool {
        if info.family == BrowserFamily.internet-explorer() { false } else { true }
    }
    test campfire.http.session-login-route/get-without-html {
        let response = campfire.http.session-login-route(campfireHttpRequest.new(
            route = HttpRoute.session-new(),
            method = RequestMethod.get(),
            room-id = RoomId.new(1),
            now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("allowed"),
            user-agent = option.none<String>(),
            base-url = "https://chat.test",
            request-is-ssl = true,
            force-ssl = false,
            origin = option.none<String>(),
            fetch-site = option.some<String>("same-origin"),
            session-token = option.none<String>(),
            bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()), accepts-turbo = false,
            accepts-html = false,
            last-room = option.none<String>(),
            csrf-token = option.none<String>()
        ))
        response.status
        => 406
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
