// users#show (/users/<id>) as Rails renders it, and Rails' static public/404.html.
// Generated by .agentlang/pages-285/make_users_views.py from Rails' own pages: each
// block is a single-line html template, so values go in through escaped holes.

record UserPage {
    id: Int
    name: String
    email: String
    bio: String
    avatar-url: String
    // "active", "deactivated" or "banned".
    status: String
    bot: Bool
    // The viewer is an administrator (Current.user.can_administer?) / is this user.
    viewer-admin: Bool
    viewer-self: Bool
    // session_transfer_url(user.transfer_id) and its QR code id; empty unless the viewer administers.
    transfer-url: String
    transfer-qr: String
}

fn campfire.views.user-nav(back: String, viewer-self: Bool) -> Html {
    effects none
    doc "users/show's nav: link_back (the referrer, else the root) and, on one's own page, the profile link."
    let actions = if viewer-self { campfire.views.unterminated(html.raw(string.concat(campfire.views.text(html"      <a class=\"btn\" href=\"/users/me/profile\">\n        <img aria-hidden=\"true\" src=\"/assets/pencil-cf9d28aa.svg\" />\n        <span class=\"for-screen-reader\">Edit my profile</span>\n</a>"), "\n"))) } else { html.raw("") }
    // back is the request's Referer: an href takes it only as a safe Url (report 302).
    let back-url = if string.url-safe?(back) { Url.new(back) } else { Url.new("/") }
    html"  <div class=\"flex-item-justify-start\">\n    <a class=\"btn\" href=\"{back-url}\"><img aria-hidden=\"true\" src=\"/assets/arrow-left-abe40556.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Go Back</span></a>\n  </div>\n\n  <div class=\"flex align-center gap flex-item-justify-end\">\n{actions}  </div>\n"
}

test campfire.views.user-nav/own-page {
    expect string.contains(campfire.views.text(campfire.views.user-nav("/", true)), "Edit my profile</span>\n</a>  </div>")
}

fn campfire.views.user-details(user: UserPage) -> Html {
    effects none
    doc "The user block of users/show: a bot's ping button or notice, a deactivated user's notice, or the name, email (for administrators), bio, ping button, transfer link (administrators, active users) and ban button (administrators, other users)."
    let id = int.to-string(user.id)
    let name = user.name
    if user.bot {
        if user.status == "active" { html"      <div class=\"pad-double--inline push--inline push--block-start\">\n          <form class=\"button_to\" method=\"post\" action=\"/rooms/directs?user_ids%5B%5D={id}\"><button class=\"btn btn--primary full-width txt--large\" type=\"submit\"><img src=\"/assets/messages-9395d503.svg\" /></button></form>\n      </div>\n" } else { html"      <div class=\"pad-double--inline push--inline push--block-start\">\n          <div>{name} is no longer on this account</div>\n      </div>\n" }
    } else if user.status == "deactivated" {
        html"        <div>\n          <h1 class=\"txt-x-large margin-none\">{name}</h1>\n          <div>{name} is no longer on this account</div>\n        </div>\n"
    } else {
        let email = if user.viewer-admin { campfire.views.user-email(user.email) } else { html.raw("") }
        let bio = user.bio
        let person = html"        <div class=\"flex flex-column gap\" style=\"--row-gap: calc(var(--block-space) / 3)\">\n          <h1 class=\"txt-x-large txt-tight-lines margin-none\">{name}</h1>\n{email}          <div>{bio}</div>\n        </div>\n"
        let active = user.status == "active"
        let ping = if active { string.concat("\n", campfire.views.text(html"          <div class=\"pad-inline-double margin-inline margin-block-start\">\n            <form class=\"button_to\" method=\"post\" action=\"/rooms/directs?user_ids%5B%5D={id}\"><button class=\"btn btn--reversed full-width txt-large\" type=\"submit\">\n              <img aria-hidden=\"true\" aria-label=\"Ping {name}\" src=\"/assets/messages-9395d503.svg\" />\n</button></form>          </div>\n")) } else { "" }
        let label = if user.viewer-self { html"      <label for=\"session_transfer_url\" class=\"for-screen-reader\">Use this link to login automatically on another device</label>\n" } else { html"      <div class=\"flex align-center gap justify-center\">\n        <img aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" src=\"/assets/crown-00d190cb.svg\" width=\"16\" height=\"16\" />\n        <label for=\"session_transfer_url\">Share to get them back into their account</label>\n      </div>\n" }
        let url = user.transfer-url
        let qr = user.transfer-qr
        let transfer = if active && user.viewer-admin { string.concat("\n", campfire.views.text(html"            <hr class=\"margin-block-start borderless\">\n\n            \n<fieldset>\n  <legend class=\"gap\">\n    <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/laptop-cf35e6d4.svg\" width=\"36\" height=\"36\" />\n    <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/transfer-3ec4f61b.svg\" width=\"36\" height=\"36\" />\n    <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/mobile-phone-d0d2301d.svg\" width=\"36\" height=\"36\" />\n  </legend>\n\n\n  <div class=\"flex flex-column gap\">\n{label}\n    <input type=\"text\" class=\"input\" value=\"{url}\" id=\"session_transfer_url\" readonly>\n\n    <div class=\"flex align-center center gap\">\n      <a class=\"btn\" data-lightbox-target=\"image\" data-action=\"lightbox#open\" data-lightbox-url-value=\"/qr_code/{qr}\" href=\"/qr_code/{qr}\">\n        <span class=\"for-screen-reader\">Show auto-login QR code</span>\n        <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/qr-code-dac3b273.svg\" width=\"20\" height=\"20\" />\n</a>\n      <button class=\"btn\" data-controller=\"copy-to-clipboard\" data-action=\"copy-to-clipboard#copy\" data-copy-to-clipboard-success-class=\"btn--success\" data-copy-to-clipboard-content-value=\"{url}\">\n        <span class=\"for-screen-reader\">Copy auto-login link</span>\n        <img aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" src=\"/assets/copy-paste-4c379063.svg\" width=\"20\" height=\"20\" />\n</button>\n      <button class=\"btn\" hidden=\"hidden\" data-controller=\"web-share\" data-action=\"web-share#share\" data-web-share-url-value=\"{url}\" data-web-share-text-value=\"This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out.\" data-web-share-title-value=\"Your sign-in link\">\n        <span class=\"for-screen-reader\">Share auto-login link</span>\n        <img aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" src=\"/assets/share-bf28da4f.svg\" width=\"20\" height=\"20\" />\n</button>    </div>\n  </div>\n</fieldset>\n")) } else { "" }
        let ban = if user.viewer-admin && bool.not(user.viewer-self) { string.concat("\n", campfire.views.text(if active { html"          <div class=\"margin-block-start\">\n              <form class=\"button_to\" method=\"post\" action=\"/users/{id}/ban\"><button class=\"btn full-width\" data-turbo-confirm=\"Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses.\" type=\"submit\">\n    <img aria-hidden=\"true\" aria-label=\"Ban {name}\" src=\"/assets/cancel-c6dfeb78.svg\" />\n    <span>Ban {name}</span>\n</button></form>\n          </div>\n" } else { html"          <div class=\"margin-block-start\">\n              <form class=\"button_to\" method=\"post\" action=\"/users/{id}/ban\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn btn--negative full-width\" data-turbo-confirm=\"Are you sure you want to remove the ban on this user?\" type=\"submit\">\n    <img aria-hidden=\"true\" aria-label=\"Remove Ban {name}\" src=\"/assets/cancel-c6dfeb78.svg\" />\n    <span>Remove ban</span>\n</button></form>\n          </div>\n" })) } else { "\n" }
        html.raw(string.join([campfire.views.text(person), ping, transfer, "\n", ban]))
    }
}

test campfire.views.user-details/bot {
    expect string.contains(campfire.views.text(campfire.views.user-details(userPage.new(id = 3, name = "B", email = "", bio = "", avatar-url = "", status = "deactivated", bot = true, viewer-admin = false, viewer-self = false, transfer-url = "", transfer-qr = ""))), "B is no longer on this account")
}

fn campfire.views.user-email(email: String) -> Html {
    effects none
    doc "mail_to the user's email address."
    html"            <div><a href=\"mailto:{email}\">{email}</a></div>\n"
}

test campfire.views.user-email/link {
    expect string.contains(campfire.views.text(campfire.views.user-email("a@b")), "mailto:a@b")
}

fn campfire.views.user-page(head: Html, body-class: String, nav: Html, user: UserPage) -> Html {
    effects none
    doc "users#show inside layouts/application."
    let title = user.name
    let banned = if user.status == "banned" && bool.not(user.bot) { "banned" } else { "" }
    let avatar = user.avatar-url
    let details = campfire.views.user-details(user)
    let section = html"<section class=\"panel txt-align-center\">\n  <div class=\"flex flex-column gap {banned}\">\n    <div class=\"avatar txt-xx-large center\" style=\"background: white\">\n      <img alt=\"Profile avatar\" class=\"avatar\" src=\"{Url.new(avatar)}\" />\n    </div>\n\n{details}  </div>\n</section>\n"
    let lightbox = campfire.views.lightbox()
    html"<!DOCTYPE html>\n<html>\n  <head>\n    <title>{title}</title>\n\n{head}\n    \n  </head>\n\n  <body class=\"{body-class}\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n      {nav}\n    </nav>\n\n\n    <main id=\"main-content\">\n      \n\n{section}\n\n      <footer id=\"footer\">\n        \n      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n      \n    </aside>\n\n{lightbox}  </body>\n</html>\n"
}

test campfire.views.user-page/title {
    expect string.contains(campfire.views.text(campfire.views.user-page(html"<x></x>", "admin", html"<y></y>", userPage.new(id = 3, name = "Ann", email = "", bio = "", avatar-url = "/a", status = "active", bot = false, viewer-admin = false, viewer-self = false, transfer-url = "", transfer-qr = ""))), "<title>Ann</title>")
}

fn campfire.views.not-found-page() -> String {
    effects none
    doc "Rails' public/404.html, byte for byte (the reference app's static file)."
    "<!DOCTYPE html>\n<html>\n\n<head>\n  <title>We can’t find that (404)</title>\n  <meta charset=\"UTF-8\">\n  <style>\n    *,\n    *::before,\n    *::after {\n      box-sizing: border-box;\n    }\n\n    body {\n      --lch-black: 0% 0 0;\n      --lch-gray: 75% 0.005 96;\n      --lch-white: 100% 0 0;\n\n      --color-border: oklch(var(--lch-gray));\n      --color-bg: oklch(var(--lch-white));\n      --color-text: oklch(var(--lch-black));\n\n      --btn-size: 2.65em;\n\n      background-color: var(--color-bg);\n      block-size: 100dvh;\n      color: var(--color-text);\n      display: grid;\n      margin: 0;\n      padding: 0;\n      place-items: center;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\";\n\n      @media (prefers-color-scheme: dark) {\n        --lch-black: 100% 0 0;\n        --lch-gray: 44.95% 0 0;\n        --lch-white: 0% 0 0;\n      }\n    }\n\n    svg {\n      fill: var(--color-text);\n\n      @media (prefers-color-scheme: dark) {\n        fill: var(--color-text);\n      }\n    }\n\n    .error {\n      align-items: center;\n      display: flex;\n      flex-direction: column;\n      gap: 2em;\n      justify-content: start;\n      margin-block-end: 15dvh;\n    }\n\n    .error__img {\n      aspect-ratio: 1;\n      background-color: var(--color-text);\n      block-size: auto;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      inline-size: 30dvh;\n\n      svg {\n        fill: var(--color-bg);\n        grid-area: 1/1;\n        max-inline-size: 66%;\n\n        @media (prefers-color-scheme: dark) {\n          fill: var(--color-bg);\n        }\n      }\n    }\n\n    .buttons {\n      display: flex;\n      flex-direction: row;\n      gap: 1em;\n      justify-content: center;\n    }\n\n    .btn {\n      align-items: center;\n      aspect-ratio: 1;\n      background-color: var(--color-bg);\n      block-size: var(--btn-size);\n      border-radius: 50%;\n      border: 1px solid var(--color-border);\n      color: var(--color-text);\n      cursor: pointer;\n      display: grid;\n      font-weight: 600;\n      font-size: 1.4rem;\n      gap: 0.5em;\n      inline-size: var(--btn-size);\n      justify-content: center;\n      padding: 0;\n      place-items: center;\n      text-align: center;\n\n      svg {\n        -webkit-touch-callout: none;\n        grid-area: 1/1;\n        inline-size: 1.3em;\n        max-inline-size: unset;\n        user-select: none;\n      }\n    }\n\n    .for-screen-reader {\n      clip-path: inset(50%);\n      height: 1px;\n      width: 1px;\n      overflow: hidden;\n      position: absolute;\n      white-space: nowrap;\n    }\n\n  </style>\n</head>\n\n<body>\n  <div class=\"error\">\n    <div class=\"error__img\">\n      <svg enable-background=\"new 0 0 24 24\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Not found\">\n        <path\n          d=\"m24 4.8c0-1.7-1.3-3-3-3h-18c-1.7 0-3 1.3-3 3v14.5c0 1.7 1.3 3 3 3h18c1.7 0 3-1.3 3-3zm-14.3-1c.3-.5.8-.6 1.3-.4.2.1.3.2.4.4.1.1.1.3.2.5 0 .2-.1.4-.2.5-.3.5-.8.6-1.3.4-.2-.2-.4-.3-.4-.4-.1-.2-.2-.4-.2-.6 0-.1.1-.3.2-.4zm-3.5 0c.2-.5.8-.7 1.3-.4.2.1.3.2.4.4 0 .1.1.3.1.4 0 .2-.1.4-.2.5-.2.5-.8.7-1.3.4-.1-.1-.3-.2-.3-.3-.1-.2-.2-.4-.2-.6 0-.1.1-.3.2-.4zm-3.6 0c.2-.4.5-.6.9-.6s.7.2.8.5c.1.1.1.3.2.5 0 .2-.1.4-.2.5-.2.5-.8.7-1.3.4-.1-.1-.3-.2-.3-.3-.1-.2-.2-.4-.2-.6 0-.1 0-.2.1-.4zm19.4 15.4c0 .6-.4 1-1 1h-18c-.6 0-1-.4-1-1v-12.2c0-.1.1-.2.2-.2h19.5c.2 0 .3.1.3.2z\" />\n        <path\n          d=\"m16.4 10.9c.2-.2.2-.6 0-.9l-.9-.9c-.2-.2-.6-.2-.9 0l-2.6 2.6h-.1l-2.5-2.6c-.2-.2-.6-.2-.9 0l-.9.9c-.2.2-.2.6 0 .9l2.6 2.6v.1l-2.6 2.6c-.2.2-.2.6 0 .9l.9.9c.2.2.6.2.9 0l2.6-2.6h.1l2.6 2.6c.2.2.6.2.9 0l.9-.9c.2-.2.2-.6 0-.9l-2.6-2.6v-.1z\" />\n      </svg>\n    </div>\n    <a href=\"/\" class=\"btn\" autofocus=\"true\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path\n          d=\"m21.864 9.5h-11.607a.25.25 0 0 1 -.174-.43l3.864-3.721a2.609 2.609 0 0 0 -.075-3.682 2.612 2.612 0 0 0 -3.68-.077l-9.792 9.699a1 1 0 0 0 -.008 1.411l9.625 9.724a2.66 2.66 0 0 0 3.755-3.757l-3.729-3.733a.25.25 0 0 1 .177-.427h11.673c1.556 0 2-1.675 2-2.51a2.28 2.28 0 0 0 -2.029-2.497z\" />\n      </svg>\n      <span class=\"for-screen-reader\">Go back</span>\n    </a>\n  </div>\n</body>\n\n</html>\n"
}

test campfire.views.not-found-page/static {
    expect string.starts-with(campfire.views.not-found-page(), "<!DOCTYPE html>") && string.byte-length(campfire.views.not-found-page()) == 4237
}
