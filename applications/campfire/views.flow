fn campfire.views.text(value: Html) -> String {
    effects none
    doc "The markup as a String (a free retag)."

    Html.value(value)
}

fn campfire.views.message(message: MessageRow) -> Html {
    effects none
    doc "One message, shaped like Rails messages_helper#message_tag: DOM ids use client_message_id (Message#to_key), data-message-id the row id. Bodies are escaped text until the rich-text partial lands."

    let body = match message.body {
        none => ""
        some text => text
    }
    html"""<div id="message_{message.client-message-id}" class="message" data-message-id="{int.to-string(MessageId.value(message.id))}"><div id="presentation_message_{message.client-message-id}" dir="auto">{body}</div></div>"""
}

fn campfire.views.room(room: RoomRow, messages: List<MessageRow>) -> Html {
    effects none
    doc "The room page the native host currently renders in C (campfire_http_renderer.c), as a Flow template with Rails escaping."

    let name = match room.name {
        none => ""
        some text => text
    }
    html"""<!doctype html><html><body><h1>{name}</h1><section id="messages">{messages.map(campfire.views.message)}</section><form method="post" action="/rooms/{int.to-string(RoomId.value(room.id))}/messages"><textarea name="message[body]"></textarea><button type="submit">Send</button></form></body></html>"""
}

fn campfire.views.room-text(room: RoomRow, messages: List<MessageRow>) -> String {
    effects none
    doc "Entry point for hosts and tests: the room page markup as a String."

    campfire.views.text(campfire.views.room(room, messages))
}

fn campfire.views.not-found(text: String) -> Html {
    effects none
    html"<!doctype html><html><body><p>{text}</p></body></html>"
}

fn campfire.views.incompatible() -> Html {
    effects none
    html"<!doctype html><html><body><p>Please upgrade your browser.</p></body></html>"
}

fn campfire.views.login(status: Int, email: String) -> Html {
    effects none
    doc "The sign-in form; 401 and 429 show the throttling alert."

    let alert = if bool.or(status == 401, status == 429) {
        html"""<p role="alert">Too many requests or unauthorized.</p>"""
    } else {
        html""
    }
    html"""<!doctype html><html><body>{alert}<form method="post" action="/session"><label for="email_address">Email address</label><input id="email_address" name="email_address" type="email" autocomplete="username" value="{email}"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="72"><button type="submit">Sign in</button></form></body></html>"""
}

fn campfire.views.append(message: MessageRow) -> Html {
    effects none
    doc "Turbo stream appending one message to the room's message list."

    html"""<turbo-stream action="append" target="messages"><template>{campfire.views.message(message)}</template></turbo-stream>"""
}

fn campfire.views.body(status: Int, view: HttpView, text: String) -> String {
    effects none
    doc "The body of every response without route data: markup for the HTML views, empty for redirects and plain responses."

    match view {
        empty => ""
        room => ""
        append-message => ""
        redirect-root => ""
        redirect-session => ""
        incompatible-browser => campfire.views.text(campfire.views.incompatible())
        room-not-found => campfire.views.text(campfire.views.not-found(text))
        login-page => campfire.views.text(campfire.views.login(status, text))
        redirect-authenticated => ""
        redirect-first-run => ""
        redirect-signed-out => ""
    }
}
