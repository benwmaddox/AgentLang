// users/avatars#show's SVG bodies: the initials avatar as Rails renders
// users/avatars/show.svg.erb, and the reference app's default bot avatar. Generated by
// .agentlang/pages-285/make_avatar_views.py from Rails' own output.

fn campfire.views.avatar-colors() -> List<String> {
    effects none
    doc "Users::AvatarsHelper::AVATAR_COLORS."
    ["#AF2E1B", "#CC6324", "#3B4B59", "#BFA07A", "#ED8008", "#ED3F1C", "#BF1B1B", "#736B1E", "#D07B53", "#736356", "#AD1D1D", "#BF7C2A", "#C09C6F", "#698F9C", "#7C956B", "#5D618F", "#3B3633", "#67695E"]
}

test campfire.views.avatar-colors/count {
    expect list.count(campfire.views.avatar-colors()) == 18
}

fn campfire.views.crc32(text: String) -> Int {
    effects none
    doc "Zlib.crc32 of the text's bytes (the IEEE polynomial, reflected), as an unsigned Int. A checksum, not cryptography."
    var crc = 4294967295
    for index in 0..string.byte-length(text) {
        crc = crc ^ string.byte-at-or(text, index, 0)
        for round in 0..8 {
            if (crc & 1) == 1 {
                crc = (crc >> 1) ^ 3988292384
            } else {
                crc = crc >> 1
            }
        }
    }
    crc ^ 4294967295
}

test campfire.views.crc32/zlib {
    expect campfire.views.crc32("127326141") == 914180625 && campfire.views.crc32("") == 0 && campfire.views.crc32("a") == 3904355907
}

fn campfire.views.user-initials(name: String) -> String {
    effects none
    doc "User#initials: name.scan(/\\b\\w/).join, the first character of every run of ASCII letters, digits and underscores (Ruby's \\w is ASCII)."
    var out = ""
    var in-word = false
    for index in 0..string.byte-length(name) {
        let byte = string.byte-at-or(name, index, 0)
        let word = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
        if word && bool.not(in-word) {
            out = string.concat(out, rich-html.ascii-char(byte))
        }
        in-word = word
    }
    out
}

test campfire.views.user-initials/scan {
    expect campfire.views.user-initials("Rita Lopez") == "RL" && campfire.views.user-initials("O'Brien-x_y") == "OBx" && campfire.views.user-initials("José") == "J"
}

fn campfire.views.initials-avatar(user-id: Int, name: String) -> String {
    effects none
    doc "users/avatars/show.svg.erb: the initials on the color AVATAR_COLORS[crc32(id) % 18], squeezed (textLength) when there are three or more."
    let colors = campfire.views.avatar-colors()
    let color = match list.get(colors, campfire.views.crc32(int.to-string(user-id)) % list.count(colors)) { none => ""; some c => c }
    let initials = campfire.views.user-initials(name)
    let squeeze = if string.byte-length(initials) >= 3 { "      textLength=\"85%\" lengthAdjust=\"spacingAndGlyphs\"\n" } else { "      \n" }
    // The initials are ASCII word characters and the color a constant: nothing needs escaping.
    string.join(["<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n  viewBox=\"0 0 512 512\" class=\"avatar\" aria-hidden=\"true\">\n  <defs>\n    <clipPath id=\"porthole\">\n      <circle cx=\"50%\" cy=\"50%\" r=\"50%\" />\n    </clipPath>\n  </defs>\n\n  <g>\n    <rect width=\"100%\" height=\"100%\" rx=\"50\" fill=\"", color, "\" />\n\n    <text x=\"50%\" y=\"50%\" fill=\"#FFFFFF\"\n      text-anchor=\"middle\" dy=\"0.35em\"\n", squeeze, "      font-family=\"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif\"\n      font-size=\"230\"\n      font-weight=\"800\"\n      letter-spacing=\"-5\">\n", "      ", initials, "\n", "    </text>\n  </g>\n</svg>\n"])
}

test campfire.views.initials-avatar/david {
    expect campfire.views.initials-avatar(127326141, "David") == "<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n  viewBox=\"0 0 512 512\" class=\"avatar\" aria-hidden=\"true\">\n  <defs>\n    <clipPath id=\"porthole\">\n      <circle cx=\"50%\" cy=\"50%\" r=\"50%\" />\n    </clipPath>\n  </defs>\n\n  <g>\n    <rect width=\"100%\" height=\"100%\" rx=\"50\" fill=\"#736356\" />\n\n    <text x=\"50%\" y=\"50%\" fill=\"#FFFFFF\"\n      text-anchor=\"middle\" dy=\"0.35em\"\n      \n      font-family=\"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif\"\n      font-size=\"230\"\n      font-weight=\"800\"\n      letter-spacing=\"-5\">\n      D\n    </text>\n  </g>\n</svg>\n"
}

fn campfire.views.default-bot-avatar() -> String {
    effects none
    doc "app/assets/images/default-bot-avatar.svg, byte for byte."
    "<svg enable-background=\"new 0 0 18 18\" viewBox=\"0 0 18 18\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"m0 0h18v18h-18z\" fill=\"#fff\"/><path d=\"m0 0h18v18h-18z\" fill-opacity=\".33\"/><g fill-opacity=\".5\"><path d=\"m14.9 15.2-3.3-.6s0-.9 0-1.1-.8-.1-.8-.1v-.3c.1 0 .2-.1.2-.1s.1-.1.2-.2h.6v.3l.4-.2v-1.1l-.4-.4.5-.1.2-1.1h.3l.2-1.8-.3-.2.1-.2s.1-.9-.5-2.3c-.7-1.7-3.1-2.5-3.1-2.5h-.4c-.4.1-2.4 1-3.1 2.5-.6 1.3-.4 2.2-.4 2.2l.1.2-.4.3.3 1.9h.3l.2 1.1.5.1-.4.4v1.1l.4.2v-.3h.6c0 .1 0 .1.1.2 0 0 .1.1.2.1v.3s-.8-.1-.8.1v1.1l-3.3.6s-.9 1-.8 2.8h13.5c0-1.9-.9-2.9-.9-2.9zm-7.1-5.5c-.5 0-.8-.4-.8-.8-.1-.5.3-.9.8-.9s.8.4.8.8c0 .5-.4.9-.8.9zm1.8 2.2h-1.2v-.4h1.1zm.6-2.2c-.5 0-.8-.4-.8-.8 0-.5.4-.9.8-.9.5 0 .8.4.8.8.1.5-.3.9-.8.9z\"/><path d=\"m7.8 8.6c-.1 0-.2.1-.2.2s.1.2.2.2c.1.1.2 0 .2-.2 0-.1-.1-.2-.2-.2z\"/><path d=\"m10.2 8.6c-.1 0-.2.1-.2.2s.1.2.2.2.2-.1.2-.2c.1-.1 0-.2-.2-.2z\"/></g></svg>"
}

test campfire.views.default-bot-avatar/svg {
    expect string.byte-length(campfire.views.default-bot-avatar()) == 884
}
