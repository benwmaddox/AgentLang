    test campfire.authentication.restore-session/exactly-one-hour-does-not-refresh {
        campfire.authentication.restore-session(SessionToken.new("exact-hour"), UtcInstant.new(3600000000), option.none<RemoteIp>(), option.none<String>())
        => value result.ok<Option<RestoredSession>, DbError>(option.some<RestoredSession>(restoredSession.new(
            user = authUser.new(id = UserId.new(11), name = "campfire-user", role = Role.member(), status = AuthUserStatus.active()),
            session = sessionRow.new(id = SessionId.new(20), user-id = UserId.new(11), token = SessionToken.new("exact-hour"), ip-address = option.some<RemoteIp>(RemoteIp.new("192.0.2.1")), user-agent = option.some<String>("stored-agent"), last-active-at = UtcInstant.new(0), created-at = UtcInstant.new(100), updated-at = UtcInstant.new(200)),
            refresh-cookie = false
        ))) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
        }
    }

    test campfire.authentication.restore-session/one-microsecond-due-refresh-preserves-metadata {
        campfire.authentication.restore-session(SessionToken.new("due-one-microsecond"), UtcInstant.new(3600000001), option.some<RemoteIp>(RemoteIp.new("203.0.113.8")), option.some<String>("new-agent"))
