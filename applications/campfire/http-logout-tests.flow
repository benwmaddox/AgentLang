test-file campfire-http-logout-form-errors {
    override fn campfire.push-subscriptions.destroy-for-user(user-id: UserId, endpoint: String) -> Result<Unit, DbError> {
        result.ok<Unit, DbError>(unit)
    }
    override fn campfire.sessions.destroy(session-id: SessionId) -> Result<Unit, DbError> {
        result.ok<Unit, DbError>(unit)
    }

    test campfire.http.logout/invalid-form-precedes-revocation-and-keeps-refresh {
        let response = campfire.http.logout(
            campfireHttpRequest.new(
                route = HttpRoute.session-destroy(), method = RequestMethod.unsafe(), room-id = RoomId.new(1), now = UtcInstant.new(100),
                remote-ip = RemoteIp.new("allowed"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
                origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.none<String>(), bot-key = option.none<BotKey>(),
                message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
                login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
                logout-form = result.error<Option<HttpLogoutInput>, HttpFormError>(HttpFormError.invalid-form()),
                accepts-turbo = false, accepts-html = false, last-room = option.none<String>(),
                browser = browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = false)
            ),
            authUser.new(id = UserId.new(7), name = "member", role = Role.member(), status = AuthUserStatus.active()),
            SessionId.new(31),
            option.some<SessionToken>(SessionToken.new("pending-refresh"))
        )
        response
        => value campfireHttpResponse.new(
            status = 400, view = HttpView.empty(), text = "", room = option.none<RoomRow>(), messages = list.empty<MessageRow>(),
            message = option.none<MessageRow>(), refresh-session-token = option.some<SessionToken>(SessionToken.new("pending-refresh")),
            remember-return-to = false, last-room = option.none<RoomId>()
        ) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.http.logout/unsupported-media-precedes-revocation {
        campfire.http.logout(
            campfireHttpRequest.new(
                route = HttpRoute.session-destroy(), method = RequestMethod.unsafe(), room-id = RoomId.new(1), now = UtcInstant.new(100),
                remote-ip = RemoteIp.new("allowed"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
                origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.none<String>(), bot-key = option.none<BotKey>(),
                message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
                login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
                logout-form = result.error<Option<HttpLogoutInput>, HttpFormError>(HttpFormError.unsupported-media()),
                accepts-turbo = false, accepts-html = false, last-room = option.none<String>(),
                browser = browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = false)
            ),
            authUser.new(id = UserId.new(7), name = "member", role = Role.member(), status = AuthUserStatus.active()), SessionId.new(31), option.none<SessionToken>()
        ).status
        => 415
        effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

