test-file campfire-http-dispatch-after-ban-sign-out {
    override fn campfire.http.authenticate(request: CampfireHttpRequest) -> CampfireHttpResponse {
        match request.route {
            session-destroy => campfire.http.response(201, HttpView.empty(), "authenticated", option.none<SessionToken>())
            room-show => campfire.http.response(500, HttpView.empty(), "", option.none<SessionToken>())
            message-create => campfire.http.response(500, HttpView.empty(), "", option.none<SessionToken>())
            session-new => campfire.http.response(500, HttpView.empty(), "", option.none<SessionToken>())
            session-create => campfire.http.response(500, HttpView.empty(), "", option.none<SessionToken>())
        }
    }

    test campfire.http.dispatch-after-ban/session-destroy-uses-authenticated-routing {
        let response = campfire.http.dispatch-after-ban(campfireHttpRequest.new(
            route = HttpRoute.session-destroy(), method = RequestMethod.unsafe(), room-id = RoomId.new(1), now = UtcInstant.new(100),
            remote-ip = RemoteIp.new("allowed"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
            origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.none<String>(), bot-key = option.none<BotKey>(),
            message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
            login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
            logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.none<HttpLogoutInput>()),
            accepts-turbo = false, accepts-html = false, last-room = option.none<String>(),
            browser = browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = false)
        ))
        response
        => value campfireHttpResponse.new(
            status = 201, view = HttpView.empty(), text = "authenticated", room = option.none<RoomRow>(),
            messages = list.empty<MessageRow>(), message = option.none<MessageRow>(), refresh-session-token = option.none<SessionToken>(),
            remember-return-to = false, last-room = option.none<RoomId>()
        ) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}
