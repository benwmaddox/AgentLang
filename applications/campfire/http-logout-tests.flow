test-file campfire-http-authenticated-sign-out {
    override fn campfire.rooms.find-for-user(user-id: UserId, room-id: RoomId) -> Result<Option<RoomRow>, DbError> {
        result.error<Option<RoomRow>, DbError>(DbError.unavailable())
    }
    override fn campfire.browser.supported?(info: BrowserInfo) -> Bool {
        if info.family == BrowserFamily.internet-explorer() { false } else { true }
    }
    override fn campfire.push-subscriptions.destroy-for-user(user-id: UserId, endpoint: String) -> Result<Unit, DbError> {
        if user-id == UserId.new(7) {
            if endpoint == "push-ok" {
                result.ok<Unit, DbError>(unit)
            } else {
                if endpoint == "push-failure" {
                    result.error<Unit, DbError>(DbError.unavailable())
                } else {
                    result.error<Unit, DbError>(DbError.invalid-input())
                }
            }
        } else {
            result.error<Unit, DbError>(DbError.invalid-input())
        }
    }
    override fn campfire.sessions.destroy(session-id: SessionId) -> Result<Unit, DbError> {
        if SessionId.value(session-id) == 31 {
            result.ok<Unit, DbError>(unit)
        } else {
            if SessionId.value(session-id) == 32 {
                result.ok<Unit, DbError>(unit)
            } else {
                if SessionId.value(session-id) == 88 {
                    result.error<Unit, DbError>(DbError.unavailable())
                } else {
                    result.error<Unit, DbError>(DbError.invalid-input())
                }
            }
        }
    }

    test campfire.http.authenticated/session-destroy-revokes-push-and-redirects-without-refresh {
        let response = campfire.http.authenticated(
            campfireHttpRequest.new(
                route = HttpRoute.session-destroy(), method = RequestMethod.unsafe(), room-id = RoomId.new(999), now = UtcInstant.new(100),
                remote-ip = RemoteIp.new("allowed"), user-agent = option.none<String>(), base-url = "https://chat.test", request-is-ssl = true, force-ssl = false,
                origin = option.none<String>(), fetch-site = option.some<String>("same-origin"), session-token = option.none<String>(), bot-key = option.none<BotKey>(),
                message-form = result.ok<Option<HttpMessageInput>, HttpFormError>(option.none<HttpMessageInput>()),
                login-form = result.ok<Option<HttpLoginInput>, HttpFormError>(option.none<HttpLoginInput>()),
                logout-form = result.ok<Option<HttpLogoutInput>, HttpFormError>(option.some<HttpLogoutInput>(httpLogoutInput.new(push-subscription-endpoint = option.some<String>("push-ok")))),
                accepts-turbo = false, accepts-html = false, last-room = option.none<String>(),
                browser = browserInfo.new(family = BrowserFamily.other(), version = option.none<String>(), is-bot = false)
            ),
            restoredSession.new(
                user = option.some<AuthUser>(authUser.new(id = UserId.new(7), name = "member", role = Role.member(), status = AuthUserStatus.active())),
                session = sessionRow.new(id = SessionId.new(31), user-id = UserId.new(7), token = SessionToken.new("restored-token"),
                    ip-address = option.none<RemoteIp>(), user-agent = option.none<String>(), last-active-at = UtcInstant.new(100),
                    created-at = UtcInstant.new(1), updated-at = UtcInstant.new(100)),
                refresh-cookie = true
            )
        )
        response
        => value campfireHttpResponse.new(
            status = 302,
            view = HttpView.redirect-signed-out(),
            text = "",
            room = option.none<RoomRow>(),
            messages = list.empty<MessageRow>(),
            message = option.none<MessageRow>(),
            refresh-session-token = option.none<SessionToken>(),
            remember-return-to = false,
            last-room = option.none<RoomId>()
        ) effects {
            db.read: 0
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

