<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="owning-mailbox.flow" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="owning-mailbox-refinements.flow" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentLang.Core\AgentLang.Core.fsproj" />
    <ProjectReference Include="..\..\src\AgentLang.Llvm\AgentLang.Llvm.fsproj" />
  </ItemGroup>
</Project>
