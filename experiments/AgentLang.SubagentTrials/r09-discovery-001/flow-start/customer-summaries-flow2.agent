test store.customer-metrics-customer-step/customer-overflow-propagates {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let customer = customer::new(
        id = customer-id, email = Email::new("c1@example.test"), kind = "standard",
        balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let first-invoice = invoice::new(
        id = InvoiceId::new("20000000-0000-0000-0000-000000000011"), customer-id = customer-id,
        lines = list::empty<InvoiceLine>(), total = Money::new(9223372036854775807),
        created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let second-invoice = invoice::new(
        id = InvoiceId::new("20000000-0000-0000-0000-000000000012"), customer-id = customer-id,
        lines = list::empty<InvoiceLine>(), total = Money::new(1),
        created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let first-payment = payment::new(
        id = PaymentId::new("30000000-0000-0000-0000-000000000011"), invoice-id = first-invoice.id,
        amount = first-invoice.total, provider-reference = "metrics-customer-overflow-001", paid-at = first-invoice.created-at);
    let second-payment = payment::new(
        id = PaymentId::new("30000000-0000-0000-0000-000000000012"), invoice-id = second-invoice.id,
        amount = second-invoice.total, provider-reference = "metrics-customer-overflow-002", paid-at = second-invoice.created-at);
    let store = store::new(
        customers = list::singleton<Customer>(customer), products = list::empty<Product>(),
        subscriptions = list::empty<Subscription>(), invoices = list::append(list::singleton<Invoice>(first-invoice), second-invoice),
        payments = list::append(list::singleton<Payment>(first-payment), second-payment),
        email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    let metrics = storeCustomerMetrics::new(
        customers = 1, products = 0, subscriptions = 0, invoices = 2, payments = 2,
        pending-emails = 0, sent-emails = 0, paid-total = Money::new(0));
    let initial = metricsCustomerAccumulator::new(
        store = store, outcome = result::ok<StoreCustomerMetrics, BusinessError>(metrics));
    match store::customer-metrics-customer-step(initial, customer).outcome {
        ok updated => { false }
        error problem => { problem.code == "MONEY_OVERFLOW" }
    }
    => true
}

