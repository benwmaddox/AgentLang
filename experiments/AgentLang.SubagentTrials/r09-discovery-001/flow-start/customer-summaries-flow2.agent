test store.customer-metrics-customer-step/preserves-prior-error {
    let customer = customer::new(
        id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        email = Email::new("c1@example.test"),
        kind = "standard",
        balance = Money::new(0),
        created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let metrics = storeCustomerMetrics::new(
        customers = 1, products = 0, subscriptions = 0, invoices = 0,
        payments = 0, pending-emails = 0, sent-emails = 0, paid-total = Money::new(0));
    let initial = metricsCustomerAccumulator::new(
        store = store::new(
            customers = list::singleton<Customer>(customer),
            products = list::empty<Product>(), subscriptions = list::empty<Subscription>(),
            invoices = list::empty<Invoice>(), payments = list::empty<Payment>(),
            email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>()),
        outcome = result::error<StoreCustomerMetrics, BusinessError>(businessError::new(
            code = "MONEY_OVERFLOW", message = "previous overflow")));
    match store::customer-metrics-customer-step(initial, customer).outcome {
        ok value => { false }
        error problem => { problem.code == "MONEY_OVERFLOW" }
    }
    => true
}

test customer.account-summary/preserves-customer-and-sums-only-owned-payments {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let foreign-id = CustomerId::new("10000000-0000-0000-0000-000000000002");
    let customer = customer::new(
        id = customer-id, email = Email::new("custom@example.test"), kind = "premium",
        balance = Money::new(17), created-at = Instant::new("2001-02-03T00:00:00.0000000+00:00"));
    let foreign = customer::new(
        id = foreign-id, email = Email::new("c2@example.test"), kind = "standard",
        balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let owned-first = invoice::new(
        id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = customer-id,
        lines = list::empty<InvoiceLine>(), total = Money::new(250), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let foreign-invoice = invoice::new(
        id = InvoiceId::new("20000000-0000-0000-0000-000000000002"), customer-id = foreign-id,
        lines = list::empty<InvoiceLine>(), total = Money::new(900), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let owned-second = invoice::new(
        id = InvoiceId::new("20000000-0000-0000-0000-000000000003"), customer-id = customer-id,
        lines = list::empty<InvoiceLine>(), total = Money::new(125), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let pay-first = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = owned-first.id, amount = Money::new(250), provider-reference = "account-001", paid-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"));
    let pay-foreign = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000002"), invoice-id = foreign-invoice.id, amount = Money::new(900), provider-reference = "account-002", paid-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"));
    let pay-second = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000003"), invoice-id = owned-second.id, amount = Money::new(125), provider-reference = "account-003", paid-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"));
    let store = store::new(
        customers = list::append(list::singleton<Customer>(customer), foreign),
        products = list::empty<Product>(), subscriptions = list::empty<Subscription>(),
        invoices = list::append(list::append(list::singleton<Invoice>(owned-first), foreign-invoice), owned-second),
        payments = list::append(list::append(list::singleton<Payment>(pay-first), pay-foreign), pay-second),
        email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    match customer::account-summary(store, customer-id) {
        ok summary => { bool::and(summary.customer == customer, summary.paid-total == Money::new(375)) }
        error problem => { false }
    }
    => true
}

test customer.account-summary/unknown-customer-precedes-overflow {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let known = customer::new(
        id = customer-id, email = Email::new("c1@example.test"), kind = "standard",
        balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let max-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = customer-id, lines = list::empty<InvoiceLine>(), total = Money::new(9223372036854775807), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let plus-one-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000002"), customer-id = customer-id, lines = list::empty<InvoiceLine>(), total = Money::new(1), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let first = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = max-invoice.id, amount = max-invoice.total, provider-reference = "account-overflow-001", paid-at = max-invoice.created-at);
    let second = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000002"), invoice-id = plus-one-invoice.id, amount = plus-one-invoice.total, provider-reference = "account-overflow-002", paid-at = plus-one-invoice.created-at);
    let store = store::new(
        customers = list::singleton<Customer>(known), products = list::empty<Product>(), subscriptions = list::empty<Subscription>(),
        invoices = list::append(list::singleton<Invoice>(max-invoice), plus-one-invoice), payments = list::append(list::singleton<Payment>(first), second),
        email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    match customer::account-summary(store, CustomerId::new("10000000-0000-0000-0000-000000000009")) {
        ok summary => { false }
        error problem => { problem.code == "CUSTOMER_NOT_FOUND" }
    }
    => true
}

test customer.account-summary/owned-total-overflow-is-an-error {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let customer = customer::new(id = customer-id, email = Email::new("c1@example.test"), kind = "standard", balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let first-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = customer-id, lines = list::empty<InvoiceLine>(), total = Money::new(9223372036854775807), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let second-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000002"), customer-id = customer-id, lines = list::empty<InvoiceLine>(), total = Money::new(1), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let first = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = first-invoice.id, amount = first-invoice.total, provider-reference = "account-overflow-003", paid-at = first-invoice.created-at);
    let second = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000002"), invoice-id = second-invoice.id, amount = second-invoice.total, provider-reference = "account-overflow-004", paid-at = second-invoice.created-at);
    let store = store::new(customers = list::singleton<Customer>(customer), products = list::empty<Product>(), subscriptions = list::empty<Subscription>(), invoices = list::append(list::singleton<Invoice>(first-invoice), second-invoice), payments = list::append(list::singleton<Payment>(first), second), email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    match customer::account-summary(store, customer-id) {
        ok summary => { false }
        error problem => { problem.code == "MONEY_OVERFLOW" }
    }
    => true
}

test store.customer-metrics-customer-step/adds-customer-subtotal {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let customer = customer::new(id = customer-id, email = Email::new("c1@example.test"), kind = "standard", balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = customer-id, lines = list::empty<InvoiceLine>(), total = Money::new(25), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let payment = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = invoice.id, amount = Money::new(25), provider-reference = "metrics-customer-001", paid-at = invoice.created-at);
    let store = store::new(customers = list::singleton<Customer>(customer), products = list::empty<Product>(), subscriptions = list::empty<Subscription>(), invoices = list::singleton<Invoice>(invoice), payments = list::singleton<Payment>(payment), email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    let metrics = storeCustomerMetrics::new(customers = 1, products = 0, subscriptions = 0, invoices = 1, payments = 1, pending-emails = 0, sent-emails = 0, paid-total = Money::new(10));
    let initial = metricsCustomerAccumulator::new(store = store, outcome = result::ok<StoreCustomerMetrics, BusinessError>(metrics));
    match store::customer-metrics-customer-step(initial, customer).outcome {
        ok updated => { bool::and(updated.customers == 1, bool::and(updated.invoices == 1, updated.paid-total == Money::new(35))) }
        error problem => { false }
    }
    => true
}

test store.customer-metrics/all-counts-and-owned-total {
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let product-id = ProductId::new("40000000-0000-0000-0000-000000000001");
    let customer = customer::new(id = customer-id, email = Email::new("c1@example.test"), kind = "standard", balance = Money::new(17), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let product = product::new(id = product-id, name = "Reference product", unit-price = Money::new(250));
    let line = invoiceLine::new(product-id = product-id, description = "Reference product", quantity = 1, unit-price = Money::new(250), line-total = Money::new(250));
    let invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = customer-id, lines = list::singleton<InvoiceLine>(line), total = Money::new(250), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let payment = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = invoice.id, amount = Money::new(250), provider-reference = "metrics-001", paid-at = invoice.created-at);
    let subscription = subscription::new(id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"), customer-id = customer-id, product-id = product-id, term = "annual", started-at = Instant::new("2001-02-03T00:00:00.0000000+00:00"), expires-at = Instant::new("2002-02-03T00:00:00.0000000+00:00"), status = SubscriptionStatus::new("active"), cancelled-at = option::none<Instant>());
    let pending = emailMessage::new(to = customer.email, subject = "Pending", body = "Message pending.");
    let sent = emailMessage::new(to = customer.email, subject = "Sent", body = "Message sent.");
    let store = store::new(customers = list::singleton<Customer>(customer), products = list::singleton<Product>(product), subscriptions = list::singleton<Subscription>(subscription), invoices = list::singleton<Invoice>(invoice), payments = list::singleton<Payment>(payment), email-outbox = list::singleton<EmailMessage>(pending), sent-emails = list::singleton<EmailMessage>(sent));
    match store::customer-metrics(store) {
        ok metrics => {
            bool::and(metrics.customers == 1, bool::and(metrics.products == 1, bool::and(metrics.subscriptions == 1, bool::and(metrics.invoices == 1, bool::and(metrics.payments == 1, bool::and(metrics.pending-emails == 1, bool::and(metrics.sent-emails == 1, metrics.paid-total == Money::new(250))))))))
        }
        error problem => { false }
    }
    => true
}

