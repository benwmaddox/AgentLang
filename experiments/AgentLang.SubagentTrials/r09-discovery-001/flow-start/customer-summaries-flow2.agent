# Initially correct duplicated Flow/2 baseline for the two summary refactor task.
# The account and dashboard each own a separate customer-payment aggregation.

record CustomerAccountSummary {
    field customer: Customer;
    field paid-total: Money;
}

record StoreCustomerMetrics {
    field customers: Int;
    field products: Int;
    field subscriptions: Int;
    field invoices: Int;
    field payments: Int;
    field pending-emails: Int;
    field sent-emails: Int;
    field paid-total: Money;
}

record AccountSummaryPaymentAccumulator {
    field target: CustomerId;
    field store: Store;
    field outcome: Result<Money, BusinessError>;
}

record MetricsPaymentAccumulator {
    field target: CustomerId;
    field store: Store;
    field outcome: Result<Money, BusinessError>;
}

record MetricsCustomerAccumulator {
    field store: Store;
    field outcome: Result<StoreCustomerMetrics, BusinessError>;
}

fn customer.account-summary-payment-step(accumulator: AccountSummaryPaymentAccumulator, payment: Payment) -> AccountSummaryPaymentAccumulator {
    doc "Add an account payment only when its invoice belongs to the requested customer, preserving checked errors."

    match accumulator.outcome {
        error prior => { accumulator }
        ok subtotal => {
            match store::invoice(payment.invoice-id, accumulator.store) {
                none => { accumulator }
                some invoice => {
                    if invoice.customer-id == accumulator.target {
                        accountSummaryPaymentAccumulator::new(
                            target = accumulator.target,
                            store = accumulator.store,
                            outcome = money::add(subtotal, payment.amount))
                    } else {
                        accumulator
                    }
                }
            }
        }
    }
}

fn store.customer-metrics-payment-step(accumulator: MetricsPaymentAccumulator, payment: Payment) -> MetricsPaymentAccumulator {
    doc "Add a dashboard customer's payment only when its invoice belongs to that customer, preserving checked errors."

    match accumulator.outcome {
        error prior => { accumulator }
        ok subtotal => {
            match store::invoice(payment.invoice-id, accumulator.store) {
                none => { accumulator }
                some invoice => {
                    if invoice.customer-id == accumulator.target {
                        metricsPaymentAccumulator::new(
                            target = accumulator.target,
                            store = accumulator.store,
                            outcome = money::add(subtotal, payment.amount))
                    } else {
                        accumulator
                    }
                }
            }
        }
    }
}

fn store.customer-metrics-customer-step(accumulator: MetricsCustomerAccumulator, customer: Customer) -> MetricsCustomerAccumulator {
    doc "Add one customer's checked payment subtotal to the dashboard, preserving an earlier error."

    match accumulator.outcome {
        error prior => { accumulator }
        ok metrics => {
            let initial = metricsPaymentAccumulator::new(
                target = customer.id,
                store = accumulator.store,
                outcome = result::ok<Money, BusinessError>(Money::new(0)));
            match accumulator.store.payments.fold(initial, store::customer-metrics-payment-step).outcome {
                error problem => {
                    metricsCustomerAccumulator::new(
                        store = accumulator.store,
                        outcome = result::error<StoreCustomerMetrics, BusinessError>(problem))
                }
                ok subtotal => {
                    match money::add(metrics.paid-total, subtotal) {
                        error problem => {
                            metricsCustomerAccumulator::new(
                                store = accumulator.store,
                                outcome = result::error<StoreCustomerMetrics, BusinessError>(problem))
                        }
                        ok total => {
                            let updated = storeCustomerMetrics::new(
                                customers = metrics.customers,
                                products = metrics.products,
                                subscriptions = metrics.subscriptions,
                                invoices = metrics.invoices,
                                payments = metrics.payments,
                                pending-emails = metrics.pending-emails,
                                sent-emails = metrics.sent-emails,
                                paid-total = total);
                            metricsCustomerAccumulator::new(
                                store = accumulator.store,
                                outcome = result::ok<StoreCustomerMetrics, BusinessError>(updated))
                        }
                    }
                }
            }
        }
    }
}

fn customer.account-summary(store: Store, customer-id: CustomerId) -> Result<CustomerAccountSummary, BusinessError> {
    doc "Return the complete original customer and that customer's checked paid total."

    match store::customer(customer-id, store) {
        none => {
            result::error<CustomerAccountSummary, BusinessError>(businessError::new(
                code = "CUSTOMER_NOT_FOUND",
                message = "The customer does not exist."))
        }
        some customer => {
            let initial = accountSummaryPaymentAccumulator::new(
                target = customer.id,
                store = store,
                outcome = result::ok<Money, BusinessError>(Money::new(0)));
            match store.payments.fold(initial, customer::account-summary-payment-step).outcome {
                error problem => {
                    result::error<CustomerAccountSummary, BusinessError>(problem)
                }
                ok total => {
                    result::ok<CustomerAccountSummary, BusinessError>(customerAccountSummary::new(
                        customer = customer,
                        paid-total = total))
                }
            }
        }
    }
}

fn store.customer-metrics(store: Store) -> Result<StoreCustomerMetrics, BusinessError> {
    doc "Return all seven Store counts and the checked sum of customer payment totals."

    let initial-metrics = storeCustomerMetrics::new(
        customers = store.customers.count(),
        products = store.products.count(),
        subscriptions = store.subscriptions.count(),
        invoices = store.invoices.count(),
        payments = store.payments.count(),
        pending-emails = store.email-outbox.count(),
        sent-emails = store.sent-emails.count(),
        paid-total = Money::new(0));
    let initial = metricsCustomerAccumulator::new(
        store = store,
        outcome = result::ok<StoreCustomerMetrics, BusinessError>(initial-metrics));
    store.customers.fold(initial, store::customer-metrics-customer-step).outcome
}

test customer.account-summary-payment-step/adds-owned-payment {
    let target = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let invoice-id = InvoiceId::new("20000000-0000-0000-0000-000000000001");
    let invoice = invoice::new(
        id = invoice-id,
        customer-id = target,
        lines = list::empty<InvoiceLine>(),
        total = Money::new(250),
        created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"),
        status = InvoiceStatus::new("paid"));
    let payment = payment::new(
        id = PaymentId::new("30000000-0000-0000-0000-000000000001"),
        invoice-id = invoice-id,
        amount = Money::new(250),
        provider-reference = "summary-control-payment-001",
        paid-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"));
    let initial = accountSummaryPaymentAccumulator::new(
        target = target,
        store = store::with-invoices(store::empty(unit), list::singleton<Invoice>(invoice)),
        outcome = result::ok<Money, BusinessError>(Money::new(0)));
    match customer::account-summary-payment-step(initial, payment).outcome {
        ok total => { total == Money::new(250) }
        error problem => { false }
    }
    => true
}

