        error problem => { false }
    }
    => true
}

test store.customer-metrics/dashboard-overflow-is-checked {
    let first-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let second-id = CustomerId::new("10000000-0000-0000-0000-000000000002");
    let first = customer::new(id = first-id, email = Email::new("c1@example.test"), kind = "standard", balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let second = customer::new(id = second-id, email = Email::new("c2@example.test"), kind = "standard", balance = Money::new(0), created-at = Instant::new("2000-01-01T00:00:00.0000000+00:00"));
    let first-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000001"), customer-id = first-id, lines = list::empty<InvoiceLine>(), total = Money::new(9223372036854775807), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let second-invoice = invoice::new(id = InvoiceId::new("20000000-0000-0000-0000-000000000002"), customer-id = second-id, lines = list::empty<InvoiceLine>(), total = Money::new(1), created-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"), status = InvoiceStatus::new("paid"));
    let first-payment = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000001"), invoice-id = first-invoice.id, amount = first-invoice.total, provider-reference = "metrics-overflow-001", paid-at = first-invoice.created-at);
    let second-payment = payment::new(id = PaymentId::new("30000000-0000-0000-0000-000000000002"), invoice-id = second-invoice.id, amount = second-invoice.total, provider-reference = "metrics-overflow-002", paid-at = second-invoice.created-at);
    let store = store::new(customers = list::append(list::singleton<Customer>(first), second), products = list::empty<Product>(), subscriptions = list::empty<Subscription>(), invoices = list::append(list::singleton<Invoice>(first-invoice), second-invoice), payments = list::append(list::singleton<Payment>(first-payment), second-payment), email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>());
    match store::customer-metrics(store) {
        ok metrics => { false }
        error problem => { problem.code == "MONEY_OVERFLOW" }
    }
    => true
}

