test customer.account-summary-payment-step/earlier-error-remains-sticky-defensively {
    let target = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let payment = payment::new(
        id = PaymentId::new("30000000-0000-0000-0000-000000000004"),
        invoice-id = InvoiceId::new("20000000-0000-0000-0000-000000000004"),
        amount = Money::new(1), provider-reference = "account-defensive-001",
        paid-at = Instant::new("2001-02-03T04:05:06.0000000+00:00"));
    let initial = accountSummaryPaymentAccumulator::new(
        target = target, store = store::empty(unit),
        outcome = result::error<Money, BusinessError>(businessError::new(code = "MONEY_OVERFLOW", message = "earlier error")));
    match customer::account-summary-payment-step(initial, payment).outcome {
        ok total => { false }
        error problem => { problem.code == "MONEY_OVERFLOW" }
    }
    => true
}

