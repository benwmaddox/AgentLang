# Pure payment and email transitions for the small-business fixture.
# Provider outcomes are explicit values; this vocabulary never calls a provider.

record InvoiceReplacement {
    field target: InvoiceId;
    field replacement: Invoice;
    field replaced: Bool;
    field values: List<Invoice>;
}

record EmailDeliveryPlan {
    field first: Option<EmailMessage>;
    field remaining: List<EmailMessage>;
}

word store.replace-invoice-step(accumulator: InvoiceReplacement, candidate: Invoice) -> InvoiceReplacement {
    effects none
    doc "Replace only the first invoice with the target ID while preserving list order."
    if accumulator.replaced() {
        invoiceReplacement::new(
            target = accumulator.target(),
            replacement = accumulator.replacement(),
            replaced = true,
            values = list::append(accumulator.values(), candidate))
    } else {
        if equals(candidate.id(), accumulator.target()) {
            invoiceReplacement::new(
                target = accumulator.target(),
                replacement = accumulator.replacement(),
                replaced = true,
                values = list::append(accumulator.values(), accumulator.replacement()))
        } else {
            invoiceReplacement::new(
                target = accumulator.target(),
                replacement = accumulator.replacement(),
                replaced = false,
                values = list::append(accumulator.values(), candidate))
        }
    }
}

word store.replace-invoice(store: Store, invoice: Invoice) -> Store {
    effects none
    doc "Replace the first invoice with the same ID, keeping all other Store fields and invoice order."
    let replacement = invoiceReplacement::new(
        target = invoice.id(),
        replacement = invoice,
        replaced = false,
        values = list::empty<Invoice>());
    let completed = store.invoices().fold(replacement, store::replace-invoice-step);
    store::with-invoices(store, completed.values())
}

word email.delivery-fold-step(accumulator: EmailDeliveryPlan, candidate: EmailMessage) -> EmailDeliveryPlan {
    effects none
    doc "Separate the first outbox message from the FIFO remainder."
    match accumulator.first() {
        some first => {
            emailDeliveryPlan::new(
                first = accumulator.first(),
                remaining = list::append(accumulator.remaining(), candidate))
        }
        none => {
            emailDeliveryPlan::new(
                first = option::some<EmailMessage>(candidate),
                remaining = accumulator.remaining())
        }
    }
}

word payment.apply-result(store: Store, id: PaymentId, invoice-id: InvoiceId, amount: Money, requested-at: Instant, outcome: Result<PaymentReceipt, BusinessError>) -> Result<Store, BusinessError> {
    effects none
    doc "Apply an explicit payment-provider outcome after validating the request and open invoice."
    match store::payment(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_PAYMENT",
                message = "A payment with this identifier already exists."))
        }
        none => {
            if int::greater-than(Money::value(amount), 0) {
                match store::invoice(invoice-id, store) {
                    none => {
                        result::error<Store, BusinessError>(businessError::new(
                            code = "INVOICE_NOT_FOUND",
                            message = "The invoice does not exist."))
                    }
                    some invoice => {
                        if equals(invoice.status(), InvoiceStatus::new("paid")) {
                            result::error<Store, BusinessError>(businessError::new(
                                code = "INVOICE_ALREADY_PAID",
                                message = "The invoice is already paid."))
                        } else {
                            if equals(invoice.total(), amount) {
                                match outcome {
                                    error provider-error => {
                                        result::error<Store, BusinessError>(businessError::new(
                                            code = "PAYMENT_PROVIDER_FAILURE",
                                            message = provider-error.message()))
                                    }
                                    ok receipt => {
                                        match payment-receipt::create(receipt.reference(), receipt.amount()) {
                                            error invalid-receipt => {
                                                result::error<Store, BusinessError>(invalid-receipt)
                                            }
                                            ok valid-receipt => {
                                                if equals(valid-receipt.amount(), amount) {
                                                    let paid-invoice = invoice::new(
                                                        id = invoice.id(),
                                                        customer-id = invoice.customer-id(),
                                                        lines = invoice.lines(),
                                                        total = invoice.total(),
                                                        created-at = invoice.created-at(),
                                                        status = InvoiceStatus::new("paid"));
                                                    let payment = payment::new(
                                                        id = id,
                                                        invoice-id = invoice-id,
                                                        amount = amount,
                                                        provider-reference = valid-receipt.reference(),
                                                        paid-at = requested-at);
                                                    let replaced = store::replace-invoice(store, paid-invoice);
                                                    let updated = store::with-payments(
                                                        replaced,
                                                        list::append(replaced.payments(), payment));
                                                    result::ok<Store, BusinessError>(updated)
                                                } else {
                                                    result::error<Store, BusinessError>(businessError::new(
                                                        code = "INVALID_PROVIDER_RECEIPT",
                                                        message = "Payment provider returned an invalid receipt: receipt amount does not match the requested amount"))
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                result::error<Store, BusinessError>(businessError::new(
                                    code = "PAYMENT_AMOUNT_MISMATCH",
                                    message = "A payment must equal the full open invoice balance."))
                            }
                        }
                    }
                }
            } else {
                result::error<Store, BusinessError>(businessError::new(
                    code = "PAYMENT_AMOUNT_MUST_BE_POSITIVE",
                    message = "A payment amount must be positive."))
            }
        }
    }
}

word email.queue(store: Store, customer-id: CustomerId, subject: String, body: String) -> Result<Store, BusinessError> {
    effects none
    doc "Queue a trimmed, validated email for an existing customer, preserving FIFO order."
    match store::customer(customer-id, store) {
        none => {
            result::error<Store, BusinessError>(businessError::new(
                code = "CUSTOMER_NOT_FOUND",
                message = "The customer does not exist."))
        }
        some customer => {
            match email-message::create(customer.email(), subject, body) {
                error invalid-message => { result::error<Store, BusinessError>(invalid-message) }
                ok message => {
                    let updated = store::with-email-state(
                        store,
                        list::append(store.email-outbox(), message),
                        store.sent-emails());
                    result::ok<Store, BusinessError>(updated)
                }
            }
        }
    }
}

word email.apply-delivery-result(store: Store, outcome: Result<Unit, BusinessError>) -> Result<Store, BusinessError> {
    effects none
    doc "Apply one explicit delivery outcome to the first queued email; failures leave Store unchanged."
    let plan = store.email-outbox().fold(
        emailDeliveryPlan::new(first = option::none<EmailMessage>(), remaining = list::empty<EmailMessage>()),
        email::delivery-fold-step);
    match plan.first() {
        none => {
            result::error<Store, BusinessError>(businessError::new(
                code = "NO_PENDING_EMAIL",
                message = "There is no queued email to deliver."))
        }
        some message => {
            match outcome {
                error provider-error => {
                    result::error<Store, BusinessError>(businessError::new(
                        code = "EMAIL_PROVIDER_FAILURE",
                        message = provider-error.message()))
                }
                ok delivered => {
                    let sent = list::append(store.sent-emails(), message);
                    let updated = store::with-email-state(store, plan.remaining(), sent);
                    result::ok<Store, BusinessError>(updated)
                }
            }
        }
    }
}

test store.replace-invoice-step/nonmatching-invoice {
    let target = InvoiceId::new("00000000-0000-0000-0000-000000000001");
    let candidate = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let state = invoiceReplacement::new(
        target = target,
        replacement = candidate,
        replaced = false,
        values = list::empty<Invoice>());
    let next = store::replace-invoice-step(state, candidate);
    bool::and(equals(next.replaced(), false), equals(next.values(), list::singleton<Invoice>(candidate)))
    => true
}

test store.replace-invoice-step/first-match-replaced {
    let candidate = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let replacement = invoice::new(
        id = candidate.id(),
        customer-id = candidate.customer-id(),
        lines = candidate.lines(),
        total = Money::new(30),
        created-at = candidate.created-at(),
        status = InvoiceStatus::new("paid"));
    let state = invoiceReplacement::new(
        target = candidate.id(),
        replacement = replacement,
        replaced = false,
        values = list::empty<Invoice>());
    let next = store::replace-invoice-step(state, candidate);
    bool::and(equals(next.replaced(), true), equals(next.values(), list::singleton<Invoice>(replacement)))
    => true
}

test store.replace-invoice-step/preserves-items-after-first-match {
    let first = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let later = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(40),
        created-at = Instant::new("2024-01-02T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let state = invoiceReplacement::new(
        target = first.id(),
        replacement = first,
        replaced = true,
        values = list::singleton<Invoice>(first));
    let next = store::replace-invoice-step(state, later);
    equals(next.values(), list::append(list::singleton<Invoice>(first), later))
    => true
}

test store.replace-invoice/empty-fold-identity {
    let replacement = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("paid"));
    store::replace-invoice(store::empty(unit), replacement).invoices().count()
    => 0
}

test store.replace-invoice/nonempty-fold-preserves-order-and-records {
    let first = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let second = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(40),
        created-at = Instant::new("2024-01-02T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let replacement = invoice::new(
        id = second.id(),
        customer-id = second.customer-id(),
        lines = second.lines(),
        total = Money::new(40),
        created-at = second.created-at(),
        status = InvoiceStatus::new("paid"));
    let base = store::empty(unit);
    let initial = store::with-invoices(base, list::append(list::singleton<Invoice>(first), second));
    let updated = store::replace-invoice(initial, replacement);
    bool::and(
        equals(updated.invoices().get(0), option::some<Invoice>(first)),
        bool::and(
            equals(updated.invoices().get(1), option::some<Invoice>(replacement)),
            bool::and(
                equals(updated.customers(), initial.customers()),
                bool::and(
                    equals(updated.products(), initial.products()),
                    bool::and(
                        equals(updated.subscriptions(), initial.subscriptions()),
                        bool::and(
                            equals(updated.payments(), initial.payments()),
                            bool::and(
                                equals(updated.email-outbox(), initial.email-outbox()),
                                equals(updated.sent-emails(), initial.sent-emails()))))))))
    => true
}

test email.delivery-fold-step/first-message {
    let message = emailMessage::new(
        to = Email::new("first@example.test"),
        subject = "First",
        body = "Body");
    let state = emailDeliveryPlan::new(
        first = option::none<EmailMessage>(),
        remaining = list::empty<EmailMessage>());
    let next = email::delivery-fold-step(state, message);
    match next.first() {
        some found => { bool::and(equals(found, message), equals(next.remaining().count(), 0)) }
        none => { false }
    }
    => true
}

test email.delivery-fold-step/later-message-appended {
    let first = emailMessage::new(
        to = Email::new("first@example.test"),
        subject = "First",
        body = "Body");
    let later = emailMessage::new(
        to = Email::new("later@example.test"),
        subject = "Later",
        body = "Body");
    let state = emailDeliveryPlan::new(
        first = option::some<EmailMessage>(first),
        remaining = list::empty<EmailMessage>());
    let next = email::delivery-fold-step(state, later);
    bool::and(
        equals(next.first(), option::some<EmailMessage>(first)),
        equals(next.remaining(), list::singleton<EmailMessage>(later)))
    => true
}

test payment.apply-result/duplicate-precedes-invalid-amount {
    let id = PaymentId::new("00000000-0000-0000-0000-000000000001");
    let payment = payment::new(
        id = id,
        invoice-id = InvoiceId::new("00000000-0000-0000-0000-000000000002"),
        amount = Money::new(10),
        provider-reference = "existing-ref",
        paid-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let base = store::empty(unit);
    let initial = store::with-payments(base, list::singleton<Payment>(payment));
    match payment::apply-result(
        initial,
        id,
        InvoiceId::new("00000000-0000-0000-0000-000000000003"),
        Money::new(0),
        Instant::new("2024-01-02T00:00:00.0000000+00:00"),
        result::error<PaymentReceipt, BusinessError>(businessError::new(code = "IGNORED", message = "ignored"))) {
        error problem => { equals(problem.code(), "DUPLICATE_PAYMENT") }
        ok updated => { false }
    }
    => true
}

