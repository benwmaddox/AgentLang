}

test email.queue/rejects-blank-message-without-mutating-store {
    let customer = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000001"),
        email = Email::new("customer@example.test"),
        kind = "test",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let base = store::empty(unit);
    let initial = store::new(
        customers = list::singleton<Customer>(customer),
        products = base.products(),
        subscriptions = base.subscriptions(),
        invoices = base.invoices(),
        payments = base.payments(),
        email-outbox = base.email-outbox(),
        sent-emails = base.sent-emails());
    match email::queue(initial, customer.id(), "   ", "Body") {
        error problem => { bool::and(equals(problem.code(), "INVALID_EMAIL_MESSAGE"), equals(initial.email-outbox().count(), 0)) }
        ok updated => { false }
    }
    => true
}

test email.queue/appends-trimmed-message-and-preserves-other-state {
    let customer = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000001"),
        email = Email::new("customer@example.test"),
        kind = "test",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let older = emailMessage::new(to = customer.email(), subject = "Older", body = "Older body");
    let prior-sent = emailMessage::new(to = customer.email(), subject = "Sent", body = "Sent body");
    let base = store::empty(unit);
    let with-customer = store::new(
        customers = list::singleton<Customer>(customer),
        products = base.products(),
        subscriptions = base.subscriptions(),
        invoices = base.invoices(),
        payments = base.payments(),
        email-outbox = list::singleton<EmailMessage>(older),
        sent-emails = list::singleton<EmailMessage>(prior-sent));
    match email::queue(with-customer, customer.id(), "  New subject  ", "  New body  ") {
        error problem => { false }
        ok updated => {
            let appended = emailMessage::new(to = customer.email(), subject = "New subject", body = "New body");
            bool::and(
                equals(updated.email-outbox(), list::append(list::singleton<EmailMessage>(older), appended)),
                bool::and(
                    equals(updated.sent-emails(), with-customer.sent-emails()),
                    bool::and(
                        equals(updated.customers(), with-customer.customers()),
                        bool::and(
                            equals(updated.products(), with-customer.products()),
                            bool::and(
                                equals(updated.subscriptions(), with-customer.subscriptions()),
                                bool::and(equals(updated.invoices(), with-customer.invoices()), equals(updated.payments(), with-customer.payments())))))))
        }
    }
    => true
}

test email.apply-delivery-result/empty-outbox-precedes-provider-error {
    let failure = businessError::new(code = "DECLINED", message = "mail rejected");
    match email::apply-delivery-result(store::empty(unit), result::error<Unit, BusinessError>(failure)) {
        error problem => { equals(problem.code(), "NO_PENDING_EMAIL") }
        ok updated => { false }
    }
    => true
}

test email.apply-delivery-result/provider-failure-retains-fifo-state {
    let first = emailMessage::new(to = Email::new("first@example.test"), subject = "First", body = "First body");
    let later = emailMessage::new(to = Email::new("later@example.test"), subject = "Later", body = "Later body");
    let initial = store::with-email-state(
        store::empty(unit),
        list::append(list::singleton<EmailMessage>(first), later),
        list::empty<EmailMessage>());
    match email::apply-delivery-result(
        initial,
        result::error<Unit, BusinessError>(businessError::new(code = "TEMPORARY", message = "mail gateway unavailable"))) {
        error problem => {
            bool::and(
                equals(problem.code(), "EMAIL_PROVIDER_FAILURE"),
                bool::and(
                    equals(problem.message(), "mail gateway unavailable"),
                    bool::and(equals(initial.email-outbox(), list::append(list::singleton<EmailMessage>(first), later)), equals(initial.sent-emails().count(), 0))))
        }
        ok updated => { false }
    }
    => true
}

test email.apply-delivery-result/success-moves-only-first-message {
    let first = emailMessage::new(to = Email::new("first@example.test"), subject = "First", body = "First body");
    let later = emailMessage::new(to = Email::new("later@example.test"), subject = "Later", body = "Later body");
    let prior-sent = emailMessage::new(to = Email::new("sent@example.test"), subject = "Sent", body = "Sent body");
    let initial = store::with-email-state(
        store::empty(unit),
        list::append(list::singleton<EmailMessage>(first), later),
        list::singleton<EmailMessage>(prior-sent));
    match email::apply-delivery-result(initial, result::ok<Unit, BusinessError>(unit)) {
        error problem => { false }
        ok updated => {
            bool::and(
                equals(updated.email-outbox(), list::singleton<EmailMessage>(later)),
                bool::and(
                    equals(updated.sent-emails(), list::append(list::singleton<EmailMessage>(prior-sent), first)),
                    bool::and(
                        equals(updated.customers(), initial.customers()),
                        bool::and(
                            equals(updated.products(), initial.products()),
                            bool::and(
                                equals(updated.subscriptions(), initial.subscriptions()),
                                bool::and(equals(updated.invoices(), initial.invoices()), equals(updated.payments(), initial.payments())))))))
        }
    }
    => true
}

example store.replace-invoice/empty-store {
    let invoice = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("paid"));
    store::replace-invoice(store::empty(unit), invoice).invoices().count()
    => 0
}

example payment.apply-result/provider-decline {
    let invoice = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(100),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let initial = store::with-invoices(store::empty(unit), list::singleton<Invoice>(invoice));
    match payment::apply-result(
        initial,
        PaymentId::new("00000000-0000-0000-0000-000000000001"),
        invoice.id(),
        Money::new(100),
        Instant::new("2024-01-02T00:00:00.0000000+00:00"),
        result::error<PaymentReceipt, BusinessError>(businessError::new(code = "DECLINED", message = "declined"))) {
        error problem => { equals(problem.code(), "PAYMENT_PROVIDER_FAILURE") }
        ok updated => { false }
    }
    => true
}

example email.queue/missing-customer {
    match email::queue(store::empty(unit), CustomerId::new("00000000-0000-0000-0000-000000000001"), "Notice", "Body") {
        error problem => { problem.code() }
        ok updated => { "unexpected" }
    }
    => "CUSTOMER_NOT_FOUND"
}

example email.apply-delivery-result/empty-outbox {
    match email::apply-delivery-result(store::empty(unit), result::ok<Unit, BusinessError>(unit)) {
        error problem => { problem.code() }
        ok updated => { "unexpected" }
    }
    => "NO_PENDING_EMAIL"
}
