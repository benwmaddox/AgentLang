test store.with-payments/replaces-existing-list {
    let initial = business::seed(unit);
    let old-payment = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000000"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(10),
        provider-reference = "old-payment",
        paid-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"));
    let initial-with-old-payment = store::with-payments(initial, list::singleton<Payment>(old-payment));
    let first = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000001"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(20),
        provider-reference = "first-payment",
        paid-at = Instant::new("2026-01-03T12:00:00.0000000+00:00"));
    let second = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000002"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(30),
        provider-reference = "second-payment",
        paid-at = Instant::new("2026-01-04T12:00:00.0000000+00:00"));
    let values = list::append(list::singleton<Payment>(first), second);
    let updated = store::with-payments(initial-with-old-payment, values);
    bool::and(
        equals(updated.payments(), values),
        bool::and(
            equals(updated.customers(), initial-with-old-payment.customers()),
            bool::and(
                equals(updated.products(), initial-with-old-payment.products()),
                bool::and(
                    equals(updated.subscriptions(), initial-with-old-payment.subscriptions()),
                    bool::and(
                        equals(updated.invoices(), initial-with-old-payment.invoices()),
                        bool::and(
                            equals(updated.email-outbox(), initial-with-old-payment.email-outbox()),
                            equals(updated.sent-emails(), initial-with-old-payment.sent-emails())))))))
    => true
}