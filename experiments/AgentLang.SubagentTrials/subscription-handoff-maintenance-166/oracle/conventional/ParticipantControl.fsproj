<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Operations.fs" />
    <Compile Include="Handoff.fs" />
    <Compile Include="Scorer.fs" />
    <Compile Include="ParticipantProgram.fs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AgentLang.Business">
      <HintPath>lib\AgentLang.Business.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
