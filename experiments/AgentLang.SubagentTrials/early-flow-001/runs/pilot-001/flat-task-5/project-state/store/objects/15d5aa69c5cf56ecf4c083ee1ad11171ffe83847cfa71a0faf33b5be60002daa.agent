word customer.renewal-savings(customer: Customer, subscription: Subscription) -> Float {
    effects none
    let balance = customer.balance()
    let premium_balance = if ::equals(customer.kind(), "premium") {
        float::multiply(balance, 0.9)
    } else { balance }
    let renewal_balance = if bool::and(::equals(subscription.term(), "annual"), subscription.renewable()) {
        float::multiply(premium_balance, 0.95)
    } else { premium_balance }
    float::subtract(balance, renewal_balance)
}