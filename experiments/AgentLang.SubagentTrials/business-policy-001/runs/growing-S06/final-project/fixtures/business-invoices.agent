    let line = invoiceLine::new(
        product-id = ProductId::new("90000000-0000-0000-0000-000000000001"),
        description = "line",
        quantity = 1,
        unit-price = Money::new(10),
        line-total = Money::new(10));
    let updated = invoice::sum-lines-step(initial, line);
    match updated.outcome() {
        error actual => { equals(actual.code(), "EARLIER") }
        ok total => { false }
    }
    => true
}

