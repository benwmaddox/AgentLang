test invoice.build-lines-step/preserves-prior-error {
    let problem = businessError::new(code = "EARLIER", message = "first error");
    let initial = invoiceLinesAccumulator::new(
        store = store::empty(unit),
        outcome = result::error<List<InvoiceLine>, BusinessError>(problem));
    let cart = cartLine::new(
        product-id = ProductId::new("90000000-0000-0000-0000-000000000001"),
        quantity = 1);
    let updated = invoice::build-lines-step(initial, cart);
    match updated.outcome() {
        error actual => { equals(actual.code(), "EARLIER") }
        ok lines => { false }
    }
    => true
}

test invoice.build-lines-step/captures-line-error {
    let initial = invoiceLinesAccumulator::new(
        store = store::empty(unit),
        outcome = result::ok<List<InvoiceLine>, BusinessError>(list::empty<InvoiceLine>()));
    let cart = cartLine::new(
        product-id = ProductId::new("90000000-0000-0000-0000-000000000001"),
        quantity = 1);
    let updated = invoice::build-lines-step(initial, cart);
    match updated.outcome() {
        error problem => { equals(problem.code(), "PRODUCT_NOT_FOUND") }
        ok lines => { false }
    }
    => true
}

test invoice.build-lines-step/appends-successful-line {
    let initial = business::seed(unit);
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let accumulator = invoiceLinesAccumulator::new(
        store = initial,
        outcome = result::ok<List<InvoiceLine>, BusinessError>(list::empty<InvoiceLine>()));
    let cart = cartLine::new(product-id = product-id, quantity = 2);
    let updated = invoice::build-lines-step(accumulator, cart);
    match updated.outcome() {
        error problem => { false }
        ok lines => {
            let expected = invoiceLine::new(
                product-id = product-id,
                description = "Monthly plan",
                quantity = 2,
                unit-price = Money::new(199),
                line-total = Money::new(398));
            equals(lines, list::singleton<InvoiceLine>(expected))
        }
    }
    => true
}

test invoice.build-lines/empty-fold {
    match invoice::build-lines(business::seed(unit), list::empty<CartLine>()) {
        ok lines => { equals(lines.count(), 0) }
        error problem => { false }
    }
    => true
}

test invoice.build-lines/nonempty-fold-preserves-order {
    let store = business::seed(unit);
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let first = cartLine::new(product-id = product-id, quantity = 2);
    let second = cartLine::new(product-id = product-id, quantity = 1);
    let cart = list::append(list::singleton<CartLine>(first), second);
    match invoice::build-lines(store, cart) {
        error problem => { false }
        ok lines => {
            let expected-first = invoiceLine::new(
                product-id = product-id,
                description = "Monthly plan",
                quantity = 2,
                unit-price = Money::new(199),
                line-total = Money::new(398));
            let expected-second = invoiceLine::new(
                product-id = product-id,
                description = "Monthly plan",
                quantity = 1,
                unit-price = Money::new(199),
                line-total = Money::new(199));
            equals(lines, list::append(list::singleton<InvoiceLine>(expected-first), expected-second))
        }
    }
    => true
}

test invoice.build-lines/propagates-first-line-error {
    let store = business::seed(unit);
    let valid-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let missing-id = ProductId::new("90000000-0000-0000-0000-000000000001");
    let first = cartLine::new(product-id = valid-id, quantity = 1);
    let bad = cartLine::new(product-id = missing-id, quantity = 1);
    let later = cartLine::new(product-id = missing-id, quantity = 0);
    let cart = list::append(list::append(list::singleton<CartLine>(first), bad), later);
    match invoice::build-lines(store, cart) {
        ok lines => { false }
        error problem => { equals(problem.code(), "PRODUCT_NOT_FOUND") }
    }
    => true
}

test invoice.sum-lines-step/preserves-prior-error {
    let problem = businessError::new(code = "EARLIER", message = "first error");
    let initial = invoiceTotalAccumulator::new(
