# A line-building fold carries the Store and an ordered Result list because
# static callbacks cannot capture either value from the calling word.
record InvoiceLinesAccumulator {
    field store: Store;
    field outcome: Result<List<InvoiceLine>, BusinessError>;
}

record InvoiceTotalAccumulator {
    field outcome: Result<Money, BusinessError>;
}

word invoice.line(store: Store, cart: CartLine) -> Result<InvoiceLine, BusinessError> {
    effects none
    doc "Validate a cart line, copy its product details, and compute its checked line total."
    let quantity = cart.quantity();
    if int::less-than(quantity, 1) {
        result::error<InvoiceLine, BusinessError>(businessError::new(
            code = "INVALID_QUANTITY",
            message = string::concat("Quantity must be positive; received ", string::concat(int::to-string(quantity), "."))))
    } else {
        if int::greater-than(quantity, 2147483647) {
            result::error<InvoiceLine, BusinessError>(businessError::new(
                code = "INVALID_QUANTITY",
                message = "Quantity must be at most 2147483647."))
        } else {
            match store::product(cart.product-id(), store) {
                none => {
                    result::error<InvoiceLine, BusinessError>(businessError::new(
                        code = "PRODUCT_NOT_FOUND",
                        message = "The product does not exist."))
                }
                some product => {
                    if money::nonnegative?(product.unit-price()) {
                        match money::multiply-by-quantity(product.unit-price(), quantity) {
                            ok line-total => {
                                result::ok<InvoiceLine, BusinessError>(invoiceLine::new(
                                    product-id = product.id(),
                                    description = product.name(),
                                    quantity = quantity,
                                    unit-price = product.unit-price(),
                                    line-total = line-total))
                            }
                            error problem => { result::error<InvoiceLine, BusinessError>(problem) }
                        }
                    } else {
                        result::error<InvoiceLine, BusinessError>(businessError::new(
                            code = "NEGATIVE_PRODUCT_PRICE",
                            message = "Product prices must be nonnegative."))
                    }
                }
            }
        }
    }
}

word invoice.build-lines-step(accumulator: InvoiceLinesAccumulator, cart: CartLine) -> InvoiceLinesAccumulator {
    effects none
    doc "Build cart lines in order while preserving the first line error."
    match accumulator.outcome() {
        error problem => { accumulator }
        ok lines => {
            match invoice::line(accumulator.store(), cart) {
                error problem => {
                    invoiceLinesAccumulator::new(
                        store = accumulator.store(),
                        outcome = result::error<List<InvoiceLine>, BusinessError>(problem))
                }
                ok line => {
                    invoiceLinesAccumulator::new(
                        store = accumulator.store(),
                        outcome = result::ok<List<InvoiceLine>, BusinessError>(list::append(lines, line)))
                }
            }
        }
    }
}

word invoice.build-lines(store: Store, cart: List<CartLine>) -> Result<List<InvoiceLine>, BusinessError> {
    effects none
    doc "Build cart lines in input order, returning the first line error or an empty list for an empty cart."
    let initial = invoiceLinesAccumulator::new(
        store = store,
        outcome = result::ok<List<InvoiceLine>, BusinessError>(list::empty<InvoiceLine>()));
    cart.fold(initial, invoice::build-lines-step).outcome()
}

word invoice.sum-lines-step(accumulator: InvoiceTotalAccumulator, line: InvoiceLine) -> InvoiceTotalAccumulator {
    effects none
    doc "Add one line total with checked arithmetic, preserving any earlier error."
    match accumulator.outcome() {
        error problem => { accumulator }
        ok subtotal => {
            match money::add(subtotal, line.line-total()) {
                ok total => {
                    invoiceTotalAccumulator::new(
                        outcome = result::ok<Money, BusinessError>(total))
                }
                error problem => {
                    invoiceTotalAccumulator::new(
                        outcome = result::error<Money, BusinessError>(problem))
                }
            }
        }
    }
}

word invoice.sum-lines(lines: List<InvoiceLine>) -> Result<Money, BusinessError> {
    effects none
    doc "Sum invoice line totals from zero using checked left-to-right Money addition."
    let initial = invoiceTotalAccumulator::new(
        outcome = result::ok<Money, BusinessError>(Money::new(0)));
    lines.fold(initial, invoice::sum-lines-step).outcome()
}

word invoice.create(store: Store, id: InvoiceId, customer-id: CustomerId, cart: List<CartLine>, created-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Create an open invoice after duplicate, customer, cart-line, and checked-total validation."
    match store::invoice(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_INVOICE",
                message = "An invoice with this identifier already exists."))
        }
        none => {
            match store::customer(customer-id, store) {
                none => {
                    result::error<Store, BusinessError>(businessError::new(
                        code = "CUSTOMER_NOT_FOUND",
                        message = "The customer does not exist."))
                }
                some customer => {
                    if equals(cart.count(), 0) {
                        result::error<Store, BusinessError>(businessError::new(
                            code = "EMPTY_INVOICE",
                            message = "An invoice must contain at least one line."))
                    } else {
                        match invoice::build-lines(store, cart) {
                            error problem => { result::error<Store, BusinessError>(problem) }
                            ok lines => {
                                match invoice::sum-lines(lines) {
                                    error problem => { result::error<Store, BusinessError>(problem) }
                                    ok total => {
                                        let created = invoice::new(
                                            id = id,
                                            customer-id = customer-id,
                                            lines = lines,
                                            total = total,
                                            created-at = created-at,
                                            status = InvoiceStatus::new("open"));
                                        let updated = store::with-invoices(
                                            store,
                                            list::append(store.invoices(), created));
                                        result::ok<Store, BusinessError>(updated)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

test invoice.line/nonpositive-quantity {
    let cart = cartLine::new(
        product-id = ProductId::new("90000000-0000-0000-0000-000000000001"),
        quantity = 0);
    match invoice::line(store::empty(unit), cart) {
        ok line => { false }
        error problem => { equals(problem.code(), "INVALID_QUANTITY") }
    }
    => true
}

