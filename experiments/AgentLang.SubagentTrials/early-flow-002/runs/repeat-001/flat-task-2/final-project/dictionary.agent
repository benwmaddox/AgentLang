// frontend: flow/1

record Customer {
    field kind: String;
    field balance: Float;
}

// frontend: flow/1

record Subscription {
    field term: String;
    field renewable: Bool;
}

// frontend: flow/1

word customer.discounted-balance(inputCustomer: Customer) -> Float {
    effects none
    if ::equals(customer::kind(inputCustomer), "premium") {
        float::multiply(customer::balance(inputCustomer), 0.9)
    } else {
        customer::balance(inputCustomer)
    }
}

// frontend: flow/1

test customer.discounted-balance/exact-kind-match {
    customer::discounted-balance(customer::new("Premium", 100))
    => 100
}

// frontend: flow/1

test customer.discounted-balance/negative-non-premium {
    customer::discounted-balance(customer::new("standard", -12.5))
    => -12.5
}

// frontend: flow/1

test customer.discounted-balance/non-premium {
    customer::discounted-balance(customer::new("standard", 100))
    => 100
}

// frontend: flow/1

test customer.discounted-balance/premium {
    customer::discounted-balance(customer::new("premium", 100))
    => 90
}

// frontend: flow/1

test customer.discounted-balance/zero-balance {
    customer::discounted-balance(customer::new("premium", 0))
    => 0
}
