    {
      "ok": true,
      "kind": "source",
      "text": "word customer.renewal-balance(customer: Customer, subscription: Subscription) -> Float {\n    effects none\n    let initialBalance = if ::equals(customer::kind(customer), \"premium\") {\n        float::multiply(customer::balance(customer), 0.9)\n    } else {\n        customer::balance(customer)\n    }\n    if ::equals(subscription::term(subscription), \"annual\") {\n        if subscription::renewable(subscription) {\n            float::multiply(initialBalance, 0.95)\n        } else {\n            initialBalance\n        }\n    } else {\n        initialBalance\n    }\n}",
