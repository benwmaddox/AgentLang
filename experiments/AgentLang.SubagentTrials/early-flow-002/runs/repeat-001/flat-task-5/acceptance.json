    {
      "ok": true,
      "kind": "source",
      "text": "word customer.renewal-savings(customer: Customer, subscription: Subscription) -> Float {\n    effects none\n    let originalBalance = customer::balance(customer)\n    let premiumFactor = if ::equals(customer::kind(customer), \"premium\") { 0.9 } else { 1.0 }\n    let afterPremium = float::multiply(originalBalance, premiumFactor)\n    let annualAndRenewable = bool::and(::equals(subscription::term(subscription), \"annual\"), subscription::renewable(subscription))\n    let annualFactor = if annualAndRenewable { 0.95 } else { 1.0 }\n    let renewalBalance = float::multiply(afterPremium, annualFactor)\n    float::subtract(originalBalance, renewalBalance)\n}",
      "data": "word customer.renewal-savings(customer: Customer, subscription: Subscription) -> Float {\n    effects none\n    let originalBalance = customer::balance(customer)\n    let premiumFactor = if ::equals(customer::kind(customer), \"premium\") { 0.9 } else { 1.0 }\n    let afterPremium = float::multiply(originalBalance, premiumFactor)\n    let annualAndRenewable = bool::and(::equals(subscription::term(subscription), \"annual\"), subscription::renewable(subscription))\n    let annualFactor = if annualAndRenewable { 0.95 } else { 1.0 }\n    let renewalBalance = float::multiply(afterPremium, annualFactor)\n    float::subtract(originalBalance, renewalBalance)\n}"
    },
