// frontend: flow/1

record Customer {
    field kind: String;
    field balance: Float;
}

// frontend: flow/1

record Subscription {
    field term: String;
    field renewable: Bool;
}

// frontend: flow/1

word subscription.annual-renewable?(value: Subscription) -> Bool {
    effects none
    bool::and(::equals(subscription::term(value), "annual"), subscription::renewable(value))
}

// frontend: flow/1

test subscription.annual-renewable?/annual-and-renewable {
    subscription::annual-renewable?(subscription::new("annual", true))
    => true
}

// frontend: flow/1

test subscription.annual-renewable?/annual-but-not-renewable {
    subscription::annual-renewable?(subscription::new("annual", false))
    => false
}

// frontend: flow/1

test subscription.annual-renewable?/case-sensitive-term {
    subscription::annual-renewable?(subscription::new("Annual", true))
    => false
}

// frontend: flow/1

test subscription.annual-renewable?/nonannual-but-renewable {
    subscription::annual-renewable?(subscription::new("monthly", true))
    => false
}
