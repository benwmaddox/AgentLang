{"request":{"op":"define","source":"word customer.premium? : Customer -> Bool\n    effects none\n    doc \"Returns true only when the customer kind is exactly premium.\"\n    customer.kind \"premium\" equals\nend\n\ntest customer.premium?/premium\n    \"premium\" 100.0 customer.new customer.premium?\n    => true\nend\n\ntest customer.premium?/standard\n    \"standard\" 100.0 customer.new customer.premium?\n    => false\nend\n\ntest customer.premium?/case-sensitive\n    \"Premium\" 100.0 customer.new customer.premium?\n    => false\nend\n\nword customer.discounted-balance : Customer -> Float\n    effects none\n    doc \"Returns 90 percent of the balance for premium customers and the original balance for every other kind.\"\n    let customer\n    $customer customer.premium?\n    if\n        $customer customer.balance 0.9 float.multiply\n    else\n        $customer customer.balance\n    end\nend\n\ntest customer.discounted-balance/premium\n    \"premium\" 100.0 customer.new customer.discounted-balance\n    => 90.0\nend\n\ntest customer.discounted-balance/premium-larger-balance\n    \"premium\" 250.0 customer.new customer.discounted-balance\n    => 225.0\nend\n\ntest customer.discounted-balance/standard\n    \"standard\" 100.0 customer.new customer.discounted-balance\n    => 100.0\nend\n\ntest customer.discounted-balance/case-sensitive\n    \"Premium\" 80.0 customer.new customer.discounted-balance\n    => 80.0\nend"},"response":{"ok":true,"kind":"defined","text":"Definitions parsed, type checked, and staged.","data":["customer.premium?","customer.discounted-balance"]}}
