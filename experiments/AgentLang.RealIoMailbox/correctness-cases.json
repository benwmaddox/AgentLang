{
  "schemaVersion": 1,
  "status": "expected-values-frozen-before-first-native-execution",
  "description": "Hand-authored exact expected values for the bounded real-I/O mailbox fixture. Expected values are independent of interpreter output.",
  "contract": {
    "stateFieldOrder": ["attempted", "completed", "latest"],
    "continuationFieldOrder": ["request"],
    "counterType": "Int",
    "maximumRequestUtf8Bytes": 4096,
    "maximumCompletionUtf8Bytes": 4096,
    "boundedness": "Counters have fixed width. The host must enforce request and completion-message byte limits; the fixture does not enforce string-size limits.",
    "resumeFailure": "The exact completion message FAIL triggers checked divide-by-zero before a new State is returned. The pending Begin-produced State and Continuation remain available for retry.",
    "cancellation": "After provider acknowledgement of completion or cancellation, the host preserves the Begin-produced State, retires the Continuation, and invalidates the pending token. No cancellation function is implemented in Flow.",
    "notImplementedAtInitialAuthoring": ["socket I/O", "provider acknowledgement", "host cancellation API", "native execution"]
  },
  "cases": [
    {
      "id": "unicode-and-nul",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "m1",
          "seed": "A🙂",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "A🙂" } }
        },
        {
          "op": "begin",
          "mailbox": "m1",
          "request": "δ",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "A🙂" },
            "continuation": { "request": "δ" }
          }
        },
        {
          "op": "resume",
          "mailbox": "m1",
          "message": "\u0000🚀",
          "expected": { "state": { "attempted": 1, "completed": 1, "latest": "δ\u0000🚀" } }
        }
      ]
    },
    {
      "id": "empty-request-and-message",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "empty",
          "seed": "discarded-by-completion",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "discarded-by-completion" } }
        },
        {
          "op": "begin",
          "mailbox": "empty",
          "request": "",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "discarded-by-completion" },
            "continuation": { "request": "" }
          }
        },
        {
          "op": "resume",
          "mailbox": "empty",
          "message": "",
          "expected": { "state": { "attempted": 1, "completed": 1, "latest": "" } }
        }
      ]
    },
    {
      "id": "sequential-completions-replace-latest",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "steady",
          "seed": "seed",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "seed" } }
        },
        {
          "op": "begin",
          "mailbox": "steady",
          "request": "r1:",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "seed" },
            "continuation": { "request": "r1:" }
          }
        },
        {
          "op": "resume",
          "mailbox": "steady",
          "message": "one",
          "expected": { "state": { "attempted": 1, "completed": 1, "latest": "r1:one" } }
        },
        {
          "op": "begin",
          "mailbox": "steady",
          "request": "r2:",
          "expected": {
            "state": { "attempted": 2, "completed": 1, "latest": "r1:one" },
            "continuation": { "request": "r2:" }
          }
        },
        {
          "op": "resume",
          "mailbox": "steady",
          "message": "two",
          "expected": { "state": { "attempted": 2, "completed": 2, "latest": "r2:two" } }
        },
        {
          "op": "begin",
          "mailbox": "steady",
          "request": "r3:",
          "expected": {
            "state": { "attempted": 3, "completed": 2, "latest": "r2:two" },
            "continuation": { "request": "r3:" }
          }
        },
        {
          "op": "resume",
          "mailbox": "steady",
          "message": "three",
          "expected": { "state": { "attempted": 3, "completed": 3, "latest": "r3:three" } }
        }
      ]
    },
    {
      "id": "cancel-after-begin-preserves-updated-state",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "cancelled",
          "seed": "preserved",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "preserved" } }
        },
        {
          "op": "begin",
          "mailbox": "cancelled",
          "request": "cancel-me",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "preserved" },
            "continuation": { "request": "cancel-me" }
          }
        },
        {
          "op": "host.cancelAfterProviderAcknowledgement",
          "mailbox": "cancelled",
          "input": {
            "state": { "attempted": 1, "completed": 0, "latest": "preserved" },
            "continuation": { "request": "cancel-me" }
          },
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "preserved" },
            "continuation": null,
            "pendingToken": null
          }
        }
      ]
    },
    {
      "id": "failed-resume-retries-same-token",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "retry",
          "seed": "prefix",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "prefix" } }
        },
        {
          "op": "begin",
          "mailbox": "retry",
          "request": "operation-",
          "token": "retry-token-1",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "prefix" },
            "continuation": { "request": "operation-" }
          }
        },
        {
          "op": "resume",
          "mailbox": "retry",
          "token": "retry-token-1",
          "message": "FAIL",
          "expected": {
            "error": "checked-divide-by-zero",
            "state": { "attempted": 1, "completed": 0, "latest": "prefix" },
            "continuation": { "request": "operation-" },
            "tokenRemainsPending": true
          }
        },
        {
          "op": "resume",
          "mailbox": "retry",
          "token": "retry-token-1",
          "message": "done",
          "expected": {
            "state": { "attempted": 1, "completed": 1, "latest": "operation-done" },
            "continuation": null,
            "tokenRemainsPending": false
          }
        }
      ]
    },
    {
      "id": "two-mailboxes-remain-independent",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "A",
          "seed": "alpha",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "alpha" } }
        },
        {
          "op": "initialize",
          "mailbox": "B",
          "seed": "beta",
          "expected": { "state": { "attempted": 0, "completed": 0, "latest": "beta" } }
        },
        {
          "op": "begin",
          "mailbox": "A",
          "request": "a-request",
          "token": "token-A",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "alpha" },
            "continuation": { "request": "a-request" }
          }
        },
        {
          "op": "begin",
          "mailbox": "B",
          "request": "b-request",
          "token": "token-B",
          "expected": {
            "state": { "attempted": 1, "completed": 0, "latest": "beta" },
            "continuation": { "request": "b-request" }
          }
        },
        {
          "op": "resume",
          "mailbox": "A",
          "token": "token-A",
          "message": "FAIL",
          "expected": {
            "error": "checked-divide-by-zero",
            "state": { "attempted": 1, "completed": 0, "latest": "alpha" },
            "continuation": { "request": "a-request" },
            "tokenRemainsPending": true,
            "otherMailboxes": {
              "B": {
                "state": { "attempted": 1, "completed": 0, "latest": "beta" },
                "continuation": { "request": "b-request" },
                "token": "token-B"
              }
            }
          }
        },
        {
          "op": "resume",
          "mailbox": "B",
          "token": "token-B",
          "message": ":ok",
          "expected": {
            "state": { "attempted": 1, "completed": 1, "latest": "b-request:ok" },
            "continuation": null,
            "tokenRemainsPending": false,
            "otherMailboxes": {
              "A": {
                "state": { "attempted": 1, "completed": 0, "latest": "alpha" },
                "continuation": { "request": "a-request" },
                "token": "token-A"
              }
            }
          }
        },
        {
          "op": "resume",
          "mailbox": "A",
          "token": "token-A",
          "message": ":ok",
          "expected": {
            "state": { "attempted": 1, "completed": 1, "latest": "a-request:ok" },
            "continuation": null,
            "tokenRemainsPending": false,
            "otherMailboxes": {
              "B": {
                "state": { "attempted": 1, "completed": 1, "latest": "b-request:ok" },
                "continuation": null,
                "token": null
              }
            }
          }
        }
      ]
    },
    {
      "id": "maximum-sized-request-and-message",
      "steps": [
        {
          "op": "initialize",
          "mailbox": "large",
          "seed": "small",
          "expected": {
            "state": {
              "attempted": 0,
              "completed": 0,
              "latest": "small"
            }
          }
        },
        {
          "op": "begin",
          "mailbox": "large",
          "request": "",
          "expected": {
            "state": {
              "attempted": 1,
              "completed": 0,
              "latest": "small"
            },
            "continuation": {
              "request": ""
            }
          }
        },
        {
          "op": "resume",
          "mailbox": "large",
          "message": "",
          "expected": {
            "state": {
              "attempted": 1,
              "completed": 1,
              "latest": ""
            },
            "continuation": null,
            "tokenRemainsPending": false
          }
        }
      ]
    }
  ]
}
