<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Db.fs" />
    <Compile Include="SqlCheck.fs" />
    <Compile Include="Cache.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="FlowApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentLang.Llvm\AgentLang.Llvm.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\stdlib\*.flow" Link="stdlib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
