// Standard library: database values and row accessors (docs/LINUX-SERVER-PLAN.md
// piece C). The host operations are
//   db.query(sql: String, parameters: List<DbValue>) -> Result<List<DbRow>, DbError>   effects db.read
//   db.execute(sql: String, parameters: List<DbValue>) -> Result<Int, DbError>       effects db.write
// `sql` must be a string literal; each worker prepares it once and reuses it.
// Parameters bind in order (?1, ?2, ...). Columns are read by zero-based index.
// SQLite REAL columns arrive as text (sqlite3_column_text).

enum DbValueKind {
    null-value
    int-value
    text-value
    blob-value
}

record DbValue {
    kind: DbValueKind
    int-value: Int
    text-value: String
    blob-value: Bytes
}

record DbRow {
    values: List<DbValue>
}

record DbError {
    code: Int
    message: String
}

fn db.int-param(value: Int) -> DbValue {
    dbValue.new(kind = DbValueKind.int-value(), int-value = value, text-value = "", blob-value = bytes.from-utf8(""))
}

fn db.text-param(value: String) -> DbValue {
    dbValue.new(kind = DbValueKind.text-value(), int-value = 0, text-value = value, blob-value = bytes.from-utf8(""))
}

fn db.blob-param(value: Bytes) -> DbValue {
    dbValue.new(kind = DbValueKind.blob-value(), int-value = 0, text-value = "", blob-value = value)
}

fn db.null-param() -> DbValue {
    dbValue.new(kind = DbValueKind.null-value(), int-value = 0, text-value = "", blob-value = bytes.from-utf8(""))
}

fn db.column(row: DbRow, column: Int) -> Option<DbValue> {
    list.get(row.values, column)
}

fn db.optional-int(row: DbRow, column: Int) -> Option<Int> {
    match db.column(row, column) {
        none => option.none<Int>()
        some value => match value.kind {
            int-value => option.some<Int>(value.int-value)
            null-value => option.none<Int>()
            text-value => option.none<Int>()
            blob-value => option.none<Int>()
        }
    }
}

fn db.int(row: DbRow, column: Int) -> Int {
    doc "The column's integer, or 0 when it is null, missing or not an integer."
    match db.optional-int(row, column) {
        none => 0
        some value => value
    }
}

fn db.optional-text(row: DbRow, column: Int) -> Option<String> {
    match db.column(row, column) {
        none => option.none<String>()
        some value => match value.kind {
            text-value => option.some<String>(value.text-value)
            int-value => option.some<String>(int.to-string(value.int-value))
            null-value => option.none<String>()
            blob-value => option.none<String>()
        }
    }
}

fn db.text(row: DbRow, column: Int) -> String {
    doc "The column as text (integers are formatted), or empty when null or missing."
    match db.optional-text(row, column) {
        none => ""
        some value => value
    }
}

fn db.blob(row: DbRow, column: Int) -> Bytes {
    match db.column(row, column) {
        none => bytes.from-utf8("")
        some value => match value.kind {
            blob-value => value.blob-value
            text-value => bytes.from-utf8(value.text-value)
            int-value => bytes.from-utf8("")
            null-value => bytes.from-utf8("")
        }
    }
}

test db.int/values {
    let row = dbRow.new(values = [db.int-param(7), db.text-param("x"), db.null-param()])
    expect db.int(row, 0) == 7
    expect db.int(row, 1) == 0
    expect db.int(row, 2) == 0
    expect db.int(row, 9) == 0
    expect db.optional-int(row, 2) == option.none<Int>()
}

test db.text/values {
    let row = dbRow.new(values = [db.int-param(7), db.text-param("x"), db.null-param(), db.blob-param(bytes.from-utf8("b"))])
    expect db.text(row, 0) == "7"
    expect db.text(row, 1) == "x"
    expect db.optional-text(row, 2) == option.none<String>()
    expect db.text(row, 3) == ""
    expect hex.encode(db.blob(row, 3)) == "62"
}
