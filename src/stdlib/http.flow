// Standard library: the portable HTTP host contract (docs/LINUX-SERVER-PLAN.md
// piece A). An app supplies
//   fn <app>.worker-init(config: List<HttpHeader>) -> <Context>
//   fn <app>.handle(request: HttpRequest, context: <Context>) -> HttpResponse
// The host lower-cases header names and passes the raw target (path and query).

record HttpHeader {
    name: String
    value: String
}

record HttpRequest {
    method: String
    target: String
    headers: List<HttpHeader>
    body: Bytes
    remote-ip: String
    now-microseconds: Int
}

// streamed: the body is this request's response stream (response.write,
// response.write-store; src/stdlib/store.flow) followed by `body`. When false
// the stream is discarded, so an error or redirect built after partial writes
// never carries them.
record HttpResponse {
    status: Int
    headers: List<HttpHeader>
    body: String
    streamed: Bool
}

fn http.header(headers: List<HttpHeader>, name: String) -> Option<String> {
    doc "The first header with this exact (lower-case) name."
    var found = option.none<String>()
    for header in headers {
        if header.name == name {
            found = option.some<String>(header.value)
            break
        }
    }
    found
}

test http.header/found {
    let headers = [httpHeader.new(name = "host", value = "a"), httpHeader.new(name = "accept", value = "b")]
    expect http.header(headers, "accept") == option.some<String>("b")
    expect http.header(headers, "cookie") == option.none<String>()
}

fn http.path(target: String) -> String {
    doc "The target's path: everything before the first '?'."
    match string.index-of(target, "?", 0) {
        none => target
        some index => match string.slice(target, 0, index) {
            none => target
            some path => path
        }
    }
}

test http.path/query {
    expect http.path("/items?id=3") == "/items"
    expect http.path("/items") == "/items"
}

fn http.query(target: String) -> String {
    doc "The target's query: everything after the first '?', or empty."
    match string.index-of(target, "?", 0) {
        none => ""
        some index => match string.slice(target, index + 1, string.byte-length(target) - index - 1) {
            none => ""
            some query => query
        }
    }
}

test http.query/present {
    expect http.query("/items?id=3&x=4") == "id=3&x=4"
    expect http.query("/items") == ""
}

fn http.config(config: List<HttpHeader>, name: String) -> String {
    doc "A worker configuration value, or empty when absent."
    match http.header(config, name) {
        none => ""
        some value => value
    }
}

test http.config/absent {
    expect http.config([httpHeader.new(name = "db", value = "x")], "db") == "x"
    expect http.config([httpHeader.new(name = "db", value = "x")], "other") == ""
}

fn http.response(status: Int, content-type: String, body: String) -> HttpResponse {
    doc "A response with one Content-Type header; the host adds Content-Length."
    httpResponse.new(status = status, headers = [httpHeader.new(name = "content-type", value = content-type)], body = body, streamed = false)
}

fn http.streamed(status: Int, headers: List<HttpHeader>, tail: String) -> HttpResponse {
    doc "A response whose body is the response stream written so far, then tail."
    httpResponse.new(status = status, headers = headers, body = tail, streamed = true)
}

test http.response/text {
    let response = http.response(404, "text/plain", "missing")
    expect response.status == 404
    expect response.body == "missing"
}

test http.streamed/flag {
    let response = http.streamed(200, list.empty<HttpHeader>(), "tail")
    expect response.streamed && response.body == "tail"
    expect bool.not(http.response(200, "text/plain", "x").streamed)
}

fn http.hex-value(byte: Int) -> Int {
    doc "The value of one hexadecimal digit, or -1."
    if byte >= 48 && byte <= 57 { byte - 48 } else if byte >= 97 && byte <= 102 { byte - 87 } else if byte >= 65 && byte <= 70 { byte - 55 } else { -1 }
}

test http.hex-value/digits {
    expect http.hex-value(57) == 9 && http.hex-value(102) == 15 && http.hex-value(71) == -1
}

fn http.byte(value: Int) -> Bytes {
    doc "One byte (0-255) as Bytes: decoded from its two-character Base64 chunk."
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let first = match string.slice(table, value / 4, 1) { none => "A"; some s => s }
    let second = match string.slice(table, (value % 4) * 16, 1) { none => "A"; some s => s }
    match base64.decode(string.join([first, second, "=="])) { none => bytes.from-utf8(""); some data => data }
}

test http.byte/values {
    expect bytes.to-utf8(http.byte(65)) == option.some<String>("A") && bytes.length(http.byte(233)) == 1
}

fn http.form-decode(text: String) -> Option<String> {
    doc "application/x-www-form-urlencoded decoding of one name or value (Rack's unescape): '+' is a space, %XX a byte. None for a malformed escape or bytes that are not UTF-8 (Rails answers 400)."
    var out = bytes.from-utf8("")
    var at = 0
    var valid = true
    let length = string.byte-length(text)
    for step in 0..length {
        if at >= length || bool.not(valid) {
            break
        }
        let byte = string.byte-at-or(text, at, 0)
        if byte == 43 {
            out = bytes.concat(out, bytes.from-utf8(" "))
            at = at + 1
        } else if byte == 37 {
            let high = http.hex-value(string.byte-at-or(text, at + 1, 0))
            let low = http.hex-value(string.byte-at-or(text, at + 2, 0))
            if high < 0 || low < 0 {
                valid = false
            } else {
                out = bytes.concat(out, http.byte(high * 16 + low))
                at = at + 3
            }
        } else {
            let next = match string.index-of(text, "%", at) { none => length; some index => index }
            let plus = match string.index-of(text, "+", at) { none => length; some index => index }
            let stop = if plus < next { plus } else { next }
            out = bytes.concat(out, bytes.from-utf8(match string.slice(text, at, stop - at) { none => ""; some s => s }))
            at = stop
        }
    }
    if valid { bytes.to-utf8(out) } else { option.none<String>() }
}

test http.form-decode/escapes {
    expect http.form-decode("a+b%20c") == option.some<String>("a b c")
    expect http.form-decode("caf%C3%A9") == option.some<String>("café")
    expect http.form-decode("%zz") == option.none<String>() && http.form-decode("%FF") == option.none<String>()
}

fn http.form-encode(text: String) -> String {
    doc "CGI.escape (Rails' to_query): letters, digits and '*-._' stay, a space is '+', every other byte is %XX."
    let digits = "0123456789ABCDEF"
    var out = ""
    for index in 0..string.byte-length(text) {
        let byte = string.byte-at-or(text, index, 0)
        let kept = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 42 || byte == 45 || byte == 46 || byte == 95
        let piece = if kept { match string.slice(text, index, 1) { none => ""; some s => s } } else if byte == 32 { "+" } else { string.join(["%", match string.slice(digits, byte / 16, 1) { none => ""; some s => s }, match string.slice(digits, byte % 16, 1) { none => ""; some s => s }]) }
        out = string.concat(out, piece)
    }
    out
}

test http.form-encode/cgi {
    expect http.form-encode("a b&c/é") == "a+b%26c%2F%C3%A9" && http.form-encode("x-y_z.*") == "x-y_z.*"
}
