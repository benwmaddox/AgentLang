// Standard library: user rich text that is already safe and canonical
// (docs/EQUAL-PAGES-PLAN.md, phase A of the Flow HTML work).
//
// rich-html.canonical?(text) is true only when text is markup that Rails'
// message pipeline (Action Text load, Campfire's content filters, the
// Action Text sanitizer, auto_link) returns unchanged. Such text is safe to
// insert as Html, and inserting it gives the same bytes Rails renders. The
// check is strict and refuses anything it is not sure about:
//   * Nokogiri's HTML5 serialization: lower-case names, attributes as
//     ` name="value"`, explicit end tags, void elements without them, text
//     escaping only & < > and U+00A0 (as &amp; &lt; &gt; &nbsp;), attribute
//     values escaping only & " and U+00A0;
//   * the allowlisted tags and attributes (no on* handlers, no `name`, no
//     `style`), and URLs only with an allowed protocol (no javascript:);
//   * no structure an HTML5 parser would rearrange: no block element inside
//     <p>, no nested <a>, no heading inside a heading, no <li> directly in
//     <li>, table parts only where tables allow them, no newline right after
//     <pre>, no comments or doctypes;
//   * nothing auto_link would turn into a link (://, www., @).
// Anything else is false; the caller escapes the text instead (never unsafe,
// only possibly different from Rails until the full pipeline exists).

fn rich-html.allowed-tag?(name: String) -> Bool {
    doc "Rails' SafeList tags (without the ones only Campfire's attachments emit) plus the editor's formatting tags."
    let tags = ["a", "abbr", "acronym", "address", "b", "big", "blockquote", "br", "cite", "code", "dd", "del", "dfn", "div", "dl", "dt", "em", "h1", "h2", "h3", "h4", "h5", "h6", "hr", "i", "img", "ins", "kbd", "li", "mark", "ol", "p", "pre", "samp", "small", "span", "strong", "sub", "sup", "time", "tt", "ul", "var", "s", "u", "table", "thead", "tbody", "tfoot", "tr", "th", "td"]
    var found = false
    for tag in tags {
        if tag == name {
            found = true
            break
        }
    }
    found
}

test rich-html.allowed-tag?/list {
    expect rich-html.allowed-tag?("p") && rich-html.allowed-tag?("td") && rich-html.allowed-tag?("mark")
    expect bool.not(rich-html.allowed-tag?("script")) && bool.not(rich-html.allowed-tag?("figure")) && bool.not(rich-html.allowed-tag?("style"))
}

fn rich-html.allowed-attribute?(name: String) -> Bool {
    doc "Rails' SafeList attributes without `name`, plus the editor's data-language. No on*, no style."
    let names = ["abbr", "alt", "cite", "class", "datetime", "height", "href", "lang", "src", "title", "width", "xml:lang", "data-language"]
    var found = false
    for allowed in names {
        if allowed == name {
            found = true
            break
        }
    }
    found
}

test rich-html.allowed-attribute?/list {
    expect rich-html.allowed-attribute?("href") && rich-html.allowed-attribute?("data-language")
    expect bool.not(rich-html.allowed-attribute?("onclick")) && bool.not(rich-html.allowed-attribute?("style")) && bool.not(rich-html.allowed-attribute?("name"))
}

fn rich-html.void?(name: String) -> Bool {
    doc "Allowed void elements: serialized without an end tag."
    name == "br" || name == "hr" || name == "img"
}

test rich-html.void?/br {
    expect rich-html.void?("br") && bool.not(rich-html.void?("p"))
}

fn rich-html.closes-p?(name: String) -> Bool {
    doc "Allowed elements whose start tag closes an open <p> in HTML5 parsing (so they may not appear inside one)."
    let blocks = ["address", "blockquote", "div", "dl", "h1", "h2", "h3", "h4", "h5", "h6", "hr", "ol", "p", "pre", "table", "ul", "dd", "dt", "li"]
    var found = false
    for block in blocks {
        if block == name {
            found = true
            break
        }
    }
    found
}

test rich-html.closes-p?/div {
    expect rich-html.closes-p?("div") && bool.not(rich-html.closes-p?("strong"))
}

fn rich-html.heading?(name: String) -> Bool {
    name == "h1" || name == "h2" || name == "h3" || name == "h4" || name == "h5" || name == "h6"
}

test rich-html.heading?/h2 {
    expect rich-html.heading?("h2") && bool.not(rich-html.heading?("hr"))
}

fn rich-html.safe-url?(value: String) -> Bool {
    doc "A URL Loofah keeps: no scheme (relative), or an allowed scheme before ':'. Leading spaces, control characters and entity tricks are refused rather than normalized."
    let length = string.byte-length(value)
    var ok = true
    var scheme-end = -1
    for index in 0..length {
        let byte = string.byte-at-or(value, index, 0)
        if byte <= 32 || byte == 127 {
            ok = false
            break
        }
        if byte == 58 {
            scheme-end = index
            break
        }
        if byte == 47 || byte == 63 || byte == 35 {
            break
        }
    }
    if bool.not(ok) {
        false
    } else if scheme-end < 0 {
        true
    } else {
        let scheme = string.to-lower-ascii(match string.slice(value, 0, scheme-end) { none => ""; some text => text })
        let schemes = ["http", "https", "mailto", "tel", "ftp", "sms", "xmpp", "irc", "webcal", "callto", "afs", "aim", "ed2k", "fax", "gopher", "line", "modem", "news", "nntp", "rsync", "rtsp", "sftp", "ssh", "tag", "telnet", "urn"]
        var allowed = false
        for name in schemes {
            if name == scheme {
                allowed = true
                break
            }
        }
        allowed
    }
}

test rich-html.safe-url?/schemes {
    expect rich-html.safe-url?("https://example.com/launch") && rich-html.safe-url?("/users/1") && rich-html.safe-url?("mailto:a@b.c")
    expect bool.not(rich-html.safe-url?("javascript:alert(1)")) && bool.not(rich-html.safe-url?("JaVaScRiPt:x")) && bool.not(rich-html.safe-url?(" javascript:x"))
    expect bool.not(rich-html.safe-url?("data:text/html,x"))
}

fn rich-html.name-char?(byte: Int) -> Bool {
    (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 58
}

test rich-html.name-char?/ascii {
    expect rich-html.name-char?(97) && rich-html.name-char?(45) && bool.not(rich-html.name-char?(65))
}

fn rich-html.entity-at(text: String, at: Int, in-attribute: Bool) -> Int {
    doc "The length of the escape Nokogiri writes at this '&' (&amp; &lt; &gt; &nbsp; in text; &amp; &quot; &nbsp; in attributes), or 0 when it is anything else."
    let rest = match string.slice(text, at, if string.byte-length(text) - at < 6 { string.byte-length(text) - at } else { 6 }) { none => ""; some s => s }
    if string.starts-with(rest, "&amp;") {
        5
    } else if string.starts-with(rest, "&nbsp;") {
        6
    } else if in-attribute && string.starts-with(rest, "&quot;") {
        6
    } else if bool.not(in-attribute) && (string.starts-with(rest, "&lt;") || string.starts-with(rest, "&gt;")) {
        4
    } else {
        0
    }
}

test rich-html.entity-at/escapes {
    expect rich-html.entity-at("a&amp;b", 1, false) == 5
    expect rich-html.entity-at("&lt;", 0, false) == 4 && rich-html.entity-at("&lt;", 0, true) == 0
    expect rich-html.entity-at("&quot;", 0, true) == 6 && rich-html.entity-at("&quot;", 0, false) == 0
    expect rich-html.entity-at("&copy;", 0, false) == 0
}

// The open-element stack is a path of names, outermost first: "/div/p".

fn rich-html.last-slash(stack: String) -> Int {
    doc "The index of the last '/' in the stack path, or -1."
    var found = -1
    for index in 0..string.byte-length(stack) {
        if string.byte-at-or(stack, index, 0) == 47 {
            found = index
        }
    }
    found
}

test rich-html.last-slash/path {
    expect rich-html.last-slash("/div/p") == 4 && rich-html.last-slash("") == -1
}

fn rich-html.top(stack: String) -> String {
    doc "The innermost open element, or empty."
    let at = rich-html.last-slash(stack)
    if at < 0 { "" } else { match string.slice(stack, at + 1, string.byte-length(stack) - at - 1) { none => ""; some name => name } }
}

test rich-html.top/empty {
    expect rich-html.top("") == "" && rich-html.top("/a/b") == "b"
}

fn rich-html.pop(stack: String) -> String {
    doc "The stack without its innermost element."
    let at = rich-html.last-slash(stack)
    if at < 0 { "" } else { match string.slice(stack, 0, at) { none => ""; some rest => rest } }
}

test rich-html.pop/one {
    expect rich-html.pop("/a/b") == "/a" && rich-html.pop("/a") == ""
}

fn rich-html.open?(stack: String, name: String) -> Bool {
    doc "True when an element of this name is open."
    string.contains(string.concat(stack, "/"), string.join(["/", name, "/"]))
}

test rich-html.open?/inside {
    expect rich-html.open?("/a/b", "a") && bool.not(rich-html.open?("/b", "a")) && bool.not(rich-html.open?("/ab", "a"))
}

fn rich-html.child-ok?(parent: String, child: String, stack: String) -> Bool {
    doc "Whether an HTML5 parser keeps this start tag where it is (no implied end tags, foster parenting or adoption)."
    let table-part = child == "thead" || child == "tbody" || child == "tfoot" || child == "tr" || child == "th" || child == "td"
    let in-table-context = parent == "table" || parent == "thead" || parent == "tbody" || parent == "tfoot" || parent == "tr"
    if rich-html.open?(stack, "p") && rich-html.closes-p?(child) {
        false
    } else if child == "a" && rich-html.open?(stack, "a") {
        false
    } else if rich-html.heading?(child) && rich-html.heading?(parent) {
        false
    } else if child == "li" && parent == "li" {
        false
    } else if (child == "dd" || child == "dt") && (parent == "dd" || parent == "dt") {
        false
    } else if in-table-context {
        (parent == "table" && (child == "thead" || child == "tbody" || child == "tfoot")) || ((parent == "thead" || parent == "tbody" || parent == "tfoot") && child == "tr") || (parent == "tr" && (child == "th" || child == "td"))
    } else if table-part {
        false
    } else {
        true
    }
}

test rich-html.child-ok?/rules {
    expect bool.not(rich-html.child-ok?("p", "div", "/p"))
    expect bool.not(rich-html.child-ok?("strong", "p", "/p/strong"))
    expect bool.not(rich-html.child-ok?("span", "a", "/a/span"))
    expect rich-html.child-ok?("table", "tbody", "/table") && rich-html.child-ok?("tr", "td", "/table/tbody/tr")
    expect bool.not(rich-html.child-ok?("table", "tr", "/table")) && bool.not(rich-html.child-ok?("div", "td", "/div"))
    expect rich-html.child-ok?("div", "p", "/div")
}

fn rich-html.word-byte?(byte: Int) -> Bool {
    doc "A byte auto_link's e-mail pattern may treat as a word character: ASCII letters, digits, '_' and '-', and (conservatively) any non-ASCII byte."
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95 || byte == 45 || byte >= 128
}

test rich-html.word-byte?/classes {
    expect rich-html.word-byte?(97) && rich-html.word-byte?(45) && rich-html.word-byte?(200) && bool.not(rich-html.word-byte?(46))
}

fn rich-html.email-like?(text: String) -> Bool {
    doc "True when some '@' is followed by word characters, a '.', and another word character: the shape auto_link links as an e-mail address (user@host.tld). '@' without a dotted host after it is left alone, as auto_link leaves it."
    let length = if string.contains(text, "@") { string.byte-length(text) } else { 0 }
    var found = false
    for index in 0..length {
        if string.byte-at-or(text, index, 0) == 64 {
            var at = index + 1
            let start = at
            for k in start..length {
                if bool.not(rich-html.word-byte?(string.byte-at-or(text, k, 0))) {
                    break
                }
                at = k + 1
            }
            if at > start && string.byte-at-or(text, at, 0) == 46 && rich-html.word-byte?(string.byte-at-or(text, at + 1, 0)) {
                found = true
            }
        }
    }
    found
}

test rich-html.email-like?/shapes {
    expect rich-html.email-like?("mail a@b.c") && rich-html.email-like?("x@host.example")
    expect bool.not(rich-html.email-like?("Deployed campfire@4f2c1e9 to production")) && bool.not(rich-html.email-like?("@ home")) && bool.not(rich-html.email-like?("a@b."))
    expect bool.not(rich-html.email-like?("no at sign.here"))
}

fn rich-html.blank?(text: String) -> Bool {
    doc "True when text is only spaces, newlines and tabs (or empty)."
    string.replace(string.replace(string.replace(text, " ", ""), "\n", ""), "\t", "") == ""
}

test rich-html.blank?/kinds {
    expect rich-html.blank?("") && rich-html.blank?(" \n\t ")
    expect bool.not(rich-html.blank?(" x ")) && bool.not(rich-html.blank?("\r"))
}

fn rich-html.text-ok?(stack: String, text: String) -> Bool {
    doc "rich-html.text-ok-for? with no links allowed."
    rich-html.text-ok-for?(stack, text, false)
}

fn rich-html.text-ok-for?(stack: String, text: String, links-allowed: Bool) -> Bool {
    doc "Text a parser keeps in place and auto_link leaves alone: only whitespace directly in table structure; nothing that looks like a URL or e-mail address."
    let parent = rich-html.top(stack)
    let in-table = parent == "table" || parent == "thead" || parent == "tbody" || parent == "tfoot" || parent == "tr"
    // Only text in table structure must be blank, and "www." needs a '.', so most
    // text skips the replaces and the lower-cased copy (report 310).
    if in-table && bool.not(rich-html.blank?(text)) {
        false
    } else {
        (links-allowed || (bool.not(string.contains(text, "://")) && bool.not(string.contains(text, ".") && string.contains(string.to-lower-ascii(text), "www.")))) && bool.not(rich-html.email-like?(text))
    }
}

test rich-html.text-ok?/links-and-tables {
    expect rich-html.text-ok?("/p", "plain text")
    expect bool.not(rich-html.text-ok?("/p", "see https://x.y")) && bool.not(rich-html.text-ok?("/p", "mail a@b.c")) && bool.not(rich-html.text-ok?("/p", "WWW.example.com"))
    expect rich-html.text-ok?("/table/tbody", " ") && bool.not(rich-html.text-ok?("/table/tbody", "x"))
    expect rich-html.text-ok?("/p", "a.b") && bool.not(rich-html.text-ok?("/p", "go to www.x"))
}

fn rich-html.canonical?(text: String) -> Bool {
    doc "True when text is safe, canonical rich text that Rails' message pipeline returns unchanged (see the file comment). Anything uncertain is false."
    rich-html.scan(text, false)
}

fn rich-html.scan(text: String, links-allowed: Bool) -> Bool {
    doc "The canonical-text check. With links-allowed, text may contain URLs (rich-html.present links them); everything else is as strict."

    let length = string.byte-length(text)
    var ok = true
    var at = 0
    var stack = ""
    var text-start = 0
    let steps = length + 1
    for step in 0..steps {
        if bool.not(ok) || at >= length {
            break
        }
        let byte = string.byte-at-or(text, at, 0)
        if byte == 60 {
            // Flush the text run before this tag.
            let run = match string.slice(text, text-start, at - text-start) { none => ""; some s => s }
            ok = ok && rich-html.text-ok-for?(stack, run, links-allowed)
            let closing = string.byte-at-or(text, at + 1, 0) == 47
            var name-end = if closing { at + 2 } else { at + 1 }
            let name-scan = name-end
            for k in name-scan..length {
                if bool.not(rich-html.name-char?(string.byte-at-or(text, k, 0))) {
                    break
                }
                name-end = k + 1
            }
            let name-start = if closing { at + 2 } else { at + 1 }
            let name = match string.slice(text, name-start, name-end - name-start) { none => ""; some s => s }
            if name == "" || bool.not(rich-html.allowed-tag?(name)) {
                ok = false
            } else if closing {
                // An end tag must close the element on top of the stack, exactly as `</name>`.
                ok = ok && string.byte-at-or(text, name-end, 0) == 62 && rich-html.top(stack) == name && bool.not(rich-html.void?(name))
                stack = rich-html.pop(stack)
                at = name-end + 1
            } else {
                ok = ok && rich-html.child-ok?(rich-html.top(stack), name, stack)
                // Attributes: ` name="value"` until '>'.
                var cursor = name-end
                var seen = ""
                for attribute in 0..64 {
                    if bool.not(ok) || string.byte-at-or(text, cursor, 0) == 62 {
                        break
                    }
                    if string.byte-at-or(text, cursor, 0) != 32 {
                        ok = false
                        break
                    }
                    var attr-end = cursor + 1
                    let attr-scan = cursor + 1
                    for k in attr-scan..length {
                        if bool.not(rich-html.name-char?(string.byte-at-or(text, k, 0))) {
                            break
                        }
                        attr-end = k + 1
                    }
                    let attr-name = match string.slice(text, cursor + 1, attr-end - cursor - 1) { none => ""; some s => s }
                    if attr-name == "" || bool.not(rich-html.allowed-attribute?(attr-name)) || rich-html.open?(seen, attr-name) || string.byte-at-or(text, attr-end, 0) != 61 || string.byte-at-or(text, attr-end + 1, 0) != 34 {
                        ok = false
                        break
                    }
                    seen = string.join([seen, "/", attr-name])
                    // The value runs to the next '"'; only Nokogiri's attribute escapes may appear.
                    var value-end = attr-end + 2
                    let value-scan = attr-end + 2
                    for k in value-scan..length {
                        let value-byte = string.byte-at-or(text, k, 0)
                        if value-byte == 34 {
                            break
                        }
                        if value-byte == 38 && rich-html.entity-at(text, k, true) == 0 {
                            ok = false
                        }
                        value-end = k + 1
                    }
                    let value = match string.slice(text, attr-end + 2, value-end - attr-end - 2) { none => ""; some s => s }
                    if string.byte-at-or(text, value-end, 0) != 34 || string.contains(value, " ") || string.contains(value, "\n") || string.contains(value, "<") || string.contains(value, ">") {
                        ok = false
                        break
                    }
                    if (attr-name == "href" || attr-name == "src" || attr-name == "cite") && bool.not(rich-html.safe-url?(string.replace(value, "&amp;", "&"))) {
                        ok = false
                        break
                    }
                    cursor = value-end + 1
                }
                ok = ok && string.byte-at-or(text, cursor, 0) == 62
                // A newline right after <pre> is dropped by HTML5 parsing.
                if name == "pre" && string.byte-at-or(text, cursor + 1, 0) == 10 {
                    ok = false
                }
                if bool.not(rich-html.void?(name)) {
                    stack = string.join([stack, "/", name])
                }
                at = cursor + 1
            }
            text-start = at
        } else if byte == 62 {
            ok = false
        } else if byte == 38 {
            let size = rich-html.entity-at(text, at, false)
            if size == 0 {
                ok = false
            }
            at = at + size
        } else if byte == 194 && string.byte-at-or(text, at + 1, 0) == 160 {
            // A raw U+00A0 would be serialized as &nbsp;.
            ok = false
        } else {
            at = at + 1
        }
    }
    let tail = match string.slice(text, text-start, length - text-start) { none => ""; some s => s }
    ok && stack == "" && rich-html.text-ok-for?(stack, tail, links-allowed)
}

test rich-html.canonical?/editor-markup {
    expect rich-html.canonical?("<p>092. I'm heading out for lunch.</p>")
    expect rich-html.canonical?("I don't care &amp; you &lt;3")
    expect rich-html.canonical?("<p>Here's the plan for the <strong>spring launch</strong>:</p> <ol><li>Finish</li><li>Ship <code>2026-03-16</code></li></ol> <blockquote>Simple.</blockquote>")
    expect rich-html.canonical?("<p>The helper:</p><pre data-language=\"ruby\">def greet(name)<br>  \"Hello\"<br>end</pre>")
    expect rich-html.canonical?("<table><tbody> <tr><th><p>Name</p></th></tr> </tbody></table>")
    expect rich-html.canonical?("<p>See <a href=\"/rooms/1\">the room</a>.</p>")
}

test rich-html.canonical?/refuses-unsafe-or-noncanonical {
    expect bool.not(rich-html.canonical?("<script>alert(1)</script>"))
    expect bool.not(rich-html.canonical?("<p onclick=\"x()\">hi</p>"))
    expect bool.not(rich-html.canonical?("<a href=\"javascript:alert(1)\">x</a>"))
    expect bool.not(rich-html.canonical?("<p style=\"color: red\">x</p>"))
    expect bool.not(rich-html.canonical?("<P>x</P>"))
    expect bool.not(rich-html.canonical?("<p class='x'>x</p>"))
    expect bool.not(rich-html.canonical?("<p>x"))
    expect bool.not(rich-html.canonical?("<p><div>x</div></p>"))
    expect bool.not(rich-html.canonical?("<a href=\"/a\"><a href=\"/b\">x</a></a>"))
    expect bool.not(rich-html.canonical?("<table><tr><td>x</td></tr></table>"))
    expect bool.not(rich-html.canonical?("<p>visit https://example.com</p>"))
    expect bool.not(rich-html.canonical?("<p>x &copy; y</p>"))
    expect bool.not(rich-html.canonical?("<!-- c --><p>x</p>"))
    expect bool.not(rich-html.canonical?("<pre>\nx</pre>"))
    expect bool.not(rich-html.canonical?("a > b"))
    expect bool.not(rich-html.canonical?("<figure><p>x</p></figure>"))
}

fn rich-html.without-figure(text: String) -> Option<String> {
    doc "Rails' SanitizeTags strips the disallowed <figure> Lexxy wraps a table in and keeps its children. This handles exactly that shape: the whole text is one top-level <figure ...>...</figure> with no other figure inside. Returns the children, or none for any other text."
    let length = string.byte-length(text)
    let open-end = match string.index-of(text, ">", 0) { none => -1; some at => at }
    let shaped = string.starts-with(text, "<figure") && string.ends-with(text, "</figure>") && open-end > 0
    let after-name = string.byte-at-or(text, 7, 0)
    if bool.not(shaped) || (after-name != 62 && after-name != 32) {
        option.none<String>()
    } else {
        let inner = match string.slice(text, open-end + 1, length - open-end - 1 - 9) { none => ""; some s => s }
        if string.contains(inner, "<figure") || string.contains(inner, "</figure>") {
            option.none<String>()
        } else {
            option.some<String>(inner)
        }
    }
}

test rich-html.without-figure/lexxy-table {
    expect rich-html.without-figure("<figure class=\"lexxy-content__table-wrapper\"><table><tbody> <tr><td><p>x</p></td></tr> </tbody></table></figure>") == option.some<String>("<table><tbody> <tr><td><p>x</p></td></tr> </tbody></table>")
    expect rich-html.without-figure("<p>x</p>") == option.none<String>()
    expect rich-html.without-figure("<figure><figure>x</figure></figure>") == option.none<String>()
    expect rich-html.without-figure("<figures>x</figures>") == option.none<String>()
}

// ------------------------------------------------------------------ auto_link
//
// rails_autolink 1.1.8's auto_link(html, html: { target: "_blank" }), as
// MessagesHelper#message_presentation applies it to the rendered rich text.
// It runs regular expressions over the serialized HTML; on canonical text
// (rich-html.structure-ok?) a match is never inside a tag, so "already
// linked" reduces to "inside an open <a>". URLs are linked first, then e-mail
// addresses. Cases whose exact Ruby behaviour this does not reproduce are
// refused (none), never guessed: a non-ASCII character where a URL ends (Ruby
// strips by Unicode word class), and '&' or "'" in an e-mail address.

fn rich-html.ascii-word?(byte: Int) -> Bool {
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

test rich-html.ascii-word?/classes {
    expect rich-html.ascii-word?(95) && rich-html.ascii-word?(90) && bool.not(rich-html.ascii-word?(45))
}

fn rich-html.url-char?(byte: Int) -> Bool {
    doc "AUTO_LINK_RE's [^ \\t\\r\\n\\v\\f<\\u00A0\"] on a byte (raw U+00A0 never occurs in canonical text)."
    byte != 32 && byte != 9 && byte != 13 && byte != 10 && byte != 11 && byte != 12 && byte != 60 && byte != 34
}

test rich-html.url-char?/stops {
    expect rich-html.url-char?(97) && bool.not(rich-html.url-char?(32)) && bool.not(rich-html.url-char?(60))
}

fn rich-html.url-start(text: String, at: Int) -> Int {
    doc "When an AUTO_LINK_RE match can begin at this byte: the index just after its prefix ('<scheme>://' or 'www.' plus one word character), else -1. Schemes compare case-insensitively."
    let schemes = ["ed2k", "ftp", "http", "https", "irc", "mailto", "news", "gopher", "nntp", "telnet", "webcal", "xmpp", "callto", "feed", "svn", "urn", "aim", "rsync", "tag", "ssh", "sftp", "rtsp", "afs", "file"]
    let rest = string.to-lower-ascii(match string.slice(text, at, if string.byte-length(text) - at < 10 { string.byte-length(text) - at } else { 10 }) { none => ""; some s => s })
    var found = -1
    for scheme in schemes {
        if found < 0 && string.starts-with(rest, string.concat(scheme, "://")) {
            found = at + string.byte-length(scheme) + 3
        }
    }
    if found < 0 && string.starts-with(rest, "www.") && rich-html.ascii-word?(string.byte-at-or(text, at + 4, 0)) {
        found = at + 5
    }
    found
}

test rich-html.url-start/prefixes {
    expect rich-html.url-start("see https://x", 4) == 12
    expect rich-html.url-start("HTTP://x", 0) == 7
    expect rich-html.url-start("www.example", 0) == 5
    expect rich-html.url-start("www.-x", 0) == -1 && rich-html.url-start("plain", 0) == -1
}

fn rich-html.count-byte(text: String, byte: Int) -> Int {
    var count = 0
    for index in 0..string.byte-length(text) {
        if string.byte-at-or(text, index, 0) == byte {
            count = count + 1
        }
    }
    count
}

test rich-html.count-byte/parens {
    expect rich-html.count-byte("a(b)(c", 40) == 2
}

fn rich-html.html-escape(text: String) -> String {
    doc "ERB::Util.html_escape: & < > \" ' as &amp; &lt; &gt; &quot; &#39;."
    string.html-escape(text)
}

test rich-html.html-escape/quote {
    expect rich-html.html-escape("a'b") == "a&#39;b"
}

fn rich-html.link-url(href: String, scheme-given: Bool) -> Option<String> {
    doc "The link for one AUTO_LINK_RE match: rails_autolink strips trailing punctuation (keeping a closing bracket that balances an opening one), keeps a trailing &gt; outside the link, and adds http:// to www. matches. None when the URL ends in a non-ASCII character."
    var url = href
    var trailing = ""
    var refused = false
    let steps = string.byte-length(href)
    for step in 0..steps {
        let length = string.byte-length(url)
        let last = string.byte-at-or(url, length - 1, 0)
        if length == 0 || rich-html.ascii-word?(last) || last == 47 || last == 45 || last == 61 || last == 59 {
            break
        }
        if last >= 128 {
            refused = true
            break
        }
        let without = match string.slice(url, 0, length - 1) { none => ""; some s => s }
        let opening = if last == 41 { 40 } else if last == 93 { 91 } else if last == 125 { 123 } else { 0 }
        if opening != 0 && rich-html.count-byte(without, opening) > rich-html.count-byte(without, last) {
            break
        }
        trailing = string.concat(match string.slice(url, length - 1, 1) { none => ""; some s => s }, trailing)
        url = without
    }
    if refused {
        option.none<String>()
    } else {
        let gt = string.ends-with(url, "&gt;")
        let shown = if gt { match string.slice(url, 0, string.byte-length(url) - 4) { none => url; some s => s } } else { url }
        let target = if scheme-given { shown } else { string.concat("http://", shown) }
        option.some<String>(string.join(["<a target=\"_blank\" href=\"", target, "\">", shown, "</a>", rich-html.html-escape(trailing), if gt { "&gt;" } else { "" }]))
    }
}

test rich-html.link-url/punctuation {
    expect rich-html.link-url("https://example.com/docs", true) == option.some<String>("<a target=\"_blank\" href=\"https://example.com/docs\">https://example.com/docs</a>")
    expect rich-html.link-url("https://x.y/a.", true) == option.some<String>("<a target=\"_blank\" href=\"https://x.y/a\">https://x.y/a</a>.")
    expect rich-html.link-url("https://x.y/(a)", true) == option.some<String>("<a target=\"_blank\" href=\"https://x.y/(a)\">https://x.y/(a)</a>")
    expect rich-html.link-url("www.x.y,", false) == option.some<String>("<a target=\"_blank\" href=\"http://www.x.y\">www.x.y</a>,")
    expect rich-html.link-url("https://x.y/✅", true) == option.none<String>()
}

fn rich-html.link-text-run(run: String) -> Option<String> {
    doc "A text run (no tags) with every AUTO_LINK_RE match linked, or none when one is refused."
    let length = string.byte-length(run)
    var out = ""
    var copied = 0
    var at = 0
    var refused = false
    let steps = length + 1
    for step in 0..steps {
        if at >= length || refused {
            break
        }
        let body = rich-html.url-start(run, at)
        if body < 0 {
            at = at + 1
        } else {
            var end = body
            for k in body..length {
                if bool.not(rich-html.url-char?(string.byte-at-or(run, k, 0))) {
                    break
                }
                end = k + 1
            }
            let www = bool.not(string.contains(string.to-lower-ascii(match string.slice(run, at, body - at) { none => ""; some s => s }), "://"))
            if end == body {
                // AUTO_LINK_RE needs at least one URL character after the prefix.
                at = at + 1
            } else {
                let linked = rich-html.link-url(match string.slice(run, at, end - at) { none => ""; some s => s }, bool.not(www))
                if linked == option.none<String>() {
                    refused = true
                } else {
                    out = string.join([out, match string.slice(run, copied, at - copied) { none => ""; some s => s }, match linked { none => ""; some text => text }])
                    copied = end
                    at = end
                }
            }
        }
    }
    if refused {
        option.none<String>()
    } else {
        option.some<String>(string.concat(out, match string.slice(run, copied, length - copied) { none => ""; some s => s }))
    }
}

test rich-html.link-text-run/two-links {
    expect rich-html.link-text-run("Docs are at https://example.com/docs and the old ones at http://example.org/docs") == option.some<String>("Docs are at <a target=\"_blank\" href=\"https://example.com/docs\">https://example.com/docs</a> and the old ones at <a target=\"_blank\" href=\"http://example.org/docs\">http://example.org/docs</a>")
    expect rich-html.link-text-run("no links") == option.some<String>("no links")
    expect rich-html.link-text-run("bare https:// x") == option.some<String>("bare https:// x")
}

fn rich-html.link(text: String) -> Option<String> {
    doc "auto_link over canonical text: every text run outside an <a> element gets its URLs linked. Tags are copied as they are (canonical attribute values hold no '>')."
    let length = string.byte-length(text)
    var out = ""
    var at = 0
    var anchors = 0
    var refused = false
    let steps = length + 1
    for step in 0..steps {
        if at >= length || refused {
            break
        }
        if string.byte-at-or(text, at, 0) == 60 {
            let close = match string.index-of(text, ">", at) { none => length - 1; some end => end }
            let tag = match string.slice(text, at, close + 1 - at) { none => ""; some s => s }
            if string.starts-with(tag, "<a ") || tag == "<a>" {
                anchors = anchors + 1
            } else if tag == "</a>" {
                anchors = anchors - 1
            }
            out = string.concat(out, tag)
            at = close + 1
        } else {
            let next = match string.index-of(text, "<", at) { none => length; some lt => lt }
            let run = match string.slice(text, at, next - at) { none => ""; some s => s }
            if anchors > 0 {
                out = string.concat(out, run)
            } else {
                let linked = rich-html.link-text-run(run)
                if linked == option.none<String>() {
                    refused = true
                } else {
                    out = string.concat(out, match linked { none => ""; some piece => piece })
                }
            }
            at = next
        }
    }
    if refused { option.none<String>() } else { option.some<String>(out) }
}

test rich-html.link/outside-anchors {
    expect rich-html.link("<p>see https://a.b/c and <a href=\"https://a.b/d\">https://a.b/d</a></p>") == option.some<String>("<p>see <a target=\"_blank\" href=\"https://a.b/c\">https://a.b/c</a> and <a href=\"https://a.b/d\">https://a.b/d</a></p>")
}

fn rich-html.present(text: String) -> Option<String> {
    doc "Rich text as Rails' sanitize-then-auto_link leaves it, when the text is canonical apart from URL text: the text itself when nothing needs linking, else the linked text. None for anything else (the caller escapes)."
    if rich-html.canonical?(text) {
        option.some<String>(text)
    } else if rich-html.scan(text, true) {
        rich-html.link(text)
    } else {
        option.none<String>()
    }
}

test rich-html.present/links {
    expect rich-html.present("<p>hi</p>") == option.some<String>("<p>hi</p>")
    expect rich-html.present("<p>Docs at https://example.com/docs</p>") == option.some<String>("<p>Docs at <a target=\"_blank\" href=\"https://example.com/docs\">https://example.com/docs</a></p>")
    expect rich-html.present("<script>x</script>") == option.none<String>()
}

test rich-html.scan/links-allowed {
    expect rich-html.scan("<p>see https://x.y</p>", true) && bool.not(rich-html.scan("<p>see https://x.y</p>", false))
    expect bool.not(rich-html.scan("<p title=\"a>b\">x</p>", true))
}

test rich-html.text-ok-for?/links {
    expect rich-html.text-ok-for?("/p", "https://x.y", true) && bool.not(rich-html.text-ok-for?("/p", "https://x.y", false))
}

// ----------------------------------------------------- start-tag tokenizer
//
// The HTML5 tokenizer's tag states (tag name, attribute name/value, after
// value, self-closing), for reading one start tag exactly as an HTML5 parser
// does: '>' inside a quoted value does not stop the tag, an attribute name may
// contain '"' or "'" (a parse error the spec tolerates), names are
// lower-cased, the first of duplicate attributes wins. Character references
// in values: &amp; &lt; &gt; &quot; &apos; &nbsp; and numeric ones are
// decoded; any other named reference makes the tag unreadable (ok = false),
// since this library carries no full entity table.

record HtmlAttribute {
    name: String
    value: String
}

record HtmlTag {
    name: String
    attributes: List<HtmlAttribute>
    stop: Int
    valid: Bool
}

fn rich-html.space?(byte: Int) -> Bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13
}

test rich-html.space?/kinds {
    expect rich-html.space?(9) && bool.not(rich-html.space?(65))
}

fn rich-html.ascii-char(code: Int) -> String {
    doc "The printable ASCII character with this code (32-126), else empty."
    let table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if code < 32 || code > 126 { "" } else { match string.slice(table, code - 32, 1) { none => ""; some c => c } }
}

test rich-html.ascii-char/table {
    expect rich-html.ascii-char(39) == "'" && rich-html.ascii-char(65) == "A" && rich-html.ascii-char(126) == "~" && rich-html.ascii-char(200) == ""
}

fn rich-html.char-ref(text: String, at: Int) -> List<String> {
    doc "The character reference starting at this '&' in an attribute value: [decoded text, length consumed]; ['&', '1'] when it is not a reference; ['', '0'] when it is a named reference this library cannot decode."
    let rest = match string.slice(text, at, if string.byte-length(text) - at < 12 { string.byte-length(text) - at } else { 12 }) { none => ""; some s => s }
    let names = ["&amp;", "&lt;", "&gt;", "&quot;", "&apos;", "&nbsp;"]
    let values = ["&", "<", ">", "\"", "'", " "]
    var found = ["&", "1"]
    for name, index in names {
        if string.starts-with(rest, name) {
            found = [match list.get(values, index) { none => ""; some value => value }, int.to-string(string.byte-length(name))]
        }
    }
    if string.starts-with(rest, "&#") {
        let hex = string.byte-at-or(rest, 2, 0) == 120 || string.byte-at-or(rest, 2, 0) == 88
        let start = if hex { 3 } else { 2 }
        var value = 0
        var digits = 0
        let limit = string.byte-length(rest)
        for k in start..limit {
            let byte = string.byte-at-or(rest, k, 0)
            let digit = if byte >= 48 && byte <= 57 { byte - 48 } else if hex && byte >= 97 && byte <= 102 { byte - 87 } else if hex && byte >= 65 && byte <= 70 { byte - 55 } else { -1 }
            if digit < 0 {
                break
            }
            value = value * (if hex { 16 } else { 10 }) + digit
            digits = digits + 1
        }
        let terminated = string.byte-at-or(rest, start + digits, 0) == 59
        if digits > 0 && terminated && rich-html.ascii-char(value) != "" {
            // Printable ASCII only; other code points are refused (no encoder in this library).
            found = [rich-html.ascii-char(value), int.to-string(start + digits + 1)]
        } else {
            found = ["", "0"]
        }
    } else if found == ["&", "1"] && rich-html.ascii-word?(string.byte-at-or(rest, 1, 0)) {
        // &name...: a named reference we cannot decode (or a bare ampersand followed by a word, which HTML keeps; refuse both).
        found = ["", "0"]
    }
    found
}

test rich-html.char-ref/kinds {
    expect rich-html.char-ref("&quot;x", 0) == ["\"", "6"]
    expect rich-html.char-ref("&#39;", 0) == ["'", "5"]
    expect rich-html.char-ref("& x", 0) == ["&", "1"]
    expect rich-html.char-ref("&copy;", 0) == ["", "0"]
}

fn rich-html.tag(text: String, at: Int) -> HtmlTag {
    doc "The start tag beginning at this '<', read with the HTML5 tokenizer's tag states. ok is false when it has no stop or holds a reference this library cannot decode. Names and values are taken as byte ranges of the text (one slice each), not built a character at a time (report 304)."
    let length = string.byte-length(text)
    var name-end = at + 1
    var attributes = list.empty<HtmlAttribute>()
    var state = 0
    // The attribute name is text[name-from, name-to); its value is value-prefix (the part
    // before the last character reference, decoded) then text[value-from, i).
    var name-from = 0
    var name-to = 0
    var value-prefix = ""
    var value-from = 0
    var attr-value = ""
    var quote = 0
    var stop = -1
    var ok = true
    var i = at + 1
    // A state change can re-read a byte (advance = 0), at most twice more: 1 -> 2,
    // 2 -> 3, 3 -> 2. length + 1 steps (report 285) could stop before the last
    // attribute of a tag with several (report 304).
    let steps = 3 * length + 3
    // States: 0 tag name, 1 before attribute name, 2 attribute name, 3 after attribute name,
    // 4 before attribute value, 5 quoted value, 6 unquoted value, 7 after quoted value, 8 self-closing.
    for step in 0..steps {
        if i >= length || stop >= 0 || bool.not(ok) {
            break
        }
        let byte = string.byte-at-or(text, i, 0)
        var advance = 1
        var emit-attr = false
        if state == 0 {
            if rich-html.space?(byte) { state = 1 } else if byte == 47 { state = 8 } else if byte == 62 { stop = i } else { name-end = i + 1 }
        } else if state == 1 {
            if rich-html.space?(byte) {
                state = 1
            } else if byte == 47 || byte == 62 {
                state = 3
                advance = 0
            } else if byte == 61 {
                name-from = i
                name-to = i + 1
                attr-value = ""
                state = 2
            } else {
                name-from = i
                name-to = i
                attr-value = ""
                state = 2
                advance = 0
            }
        } else if state == 2 {
            if rich-html.space?(byte) || byte == 47 || byte == 62 { state = 3; advance = 0 } else if byte == 61 { state = 4 } else { name-to = i + 1 }
        } else if state == 3 {
            if rich-html.space?(byte) {
                state = 3
            } else if byte == 47 {
                emit-attr = name-to > name-from
                state = 8
            } else if byte == 61 {
                state = 4
            } else if byte == 62 {
                emit-attr = name-to > name-from
                stop = i
            } else {
                emit-attr = name-to > name-from
                state = 2
                advance = 0
            }
        } else if state == 4 {
            if rich-html.space?(byte) {
                state = 4
            } else if byte == 34 || byte == 39 {
                quote = byte
                value-prefix = ""
                value-from = i + 1
                state = 5
            } else if byte == 62 {
                emit-attr = true
                stop = i
            } else {
                value-prefix = ""
                value-from = i
                state = 6
                advance = 0
            }
        } else if state == 5 || state == 6 {
            let ends = if state == 5 { byte == quote } else { rich-html.space?(byte) || byte == 62 }
            if ends {
                let run = match string.slice(text, value-from, i - value-from) { none => ""; some s => s }
                attr-value = if value-prefix == "" { run } else { string.concat(value-prefix, run) }
                emit-attr = true
                if state == 5 { state = 7 } else if byte == 62 { stop = i } else { state = 1 }
            } else if byte == 38 {
                let ref = rich-html.char-ref(text, i)
                let size = match int.parse(match list.get(ref, 1) { none => "0"; some n => n }) { none => 0; some n => n }
                if size == 0 {
                    ok = false
                } else {
                    let run = match string.slice(text, value-from, i - value-from) { none => ""; some s => s }
                    value-prefix = string.join([value-prefix, run, match list.get(ref, 0) { none => ""; some s => s }])
                    value-from = i + size
                    advance = size
                }
            }
        } else if state == 7 {
            if rich-html.space?(byte) { state = 1 } else if byte == 47 { state = 8 } else if byte == 62 { stop = i } else { state = 1; advance = 0 }
        } else {
            if byte == 62 { stop = i } else { state = 1; advance = 0 }
        }
        if emit-attr {
            // The tokenizer lower-cases ASCII letters in attribute names.
            let attr-name = string.to-lower-ascii(match string.slice(text, name-from, name-to - name-from) { none => ""; some s => s })
            var seen = false
            for attribute in attributes {
                if attribute.name == attr-name {
                    seen = true
                }
            }
            if bool.not(seen) {
                attributes = list.append(attributes, htmlAttribute.new(name = attr-name, value = attr-value))
            }
            // A next attribute read straight from state 3 starts at this byte.
            name-from = i
            name-to = i
            attr-value = ""
        }
        i = i + advance
    }
    let name = match string.slice(text, at + 1, name-end - at - 1) { none => ""; some s => s }
    htmlTag.new(name = string.to-lower-ascii(name), attributes = attributes, stop = stop, valid = ok && stop >= 0)
}

test rich-html.tag/spec-states {
    let tag = rich-html.tag("<action-text-attachment sgid=\"abc\" content-type=\"application/vnd.campfire.mention\" content=\"<span class=\" mention\"=\"\"></action-text-attachment>", 0)
    expect tag.valid && tag.name == "action-text-attachment"
    expect tag.attributes == [htmlAttribute.new(name = "sgid", value = "abc"), htmlAttribute.new(name = "content-type", value = "application/vnd.campfire.mention"), htmlAttribute.new(name = "content", value = "<span class="), htmlAttribute.new(name = "mention\"", value = "")]
    let quoted = rich-html.tag("<a title='x>y' HREF=/a>z", 0)
    expect quoted.valid && quoted.stop == 22 && quoted.attributes == [htmlAttribute.new(name = "title", value = "x>y"), htmlAttribute.new(name = "href", value = "/a")]
    expect rich-html.tag("<p class=\"a&quot;b\">", 0).attributes == [htmlAttribute.new(name = "class", value = "a\"b")]
    expect bool.not(rich-html.tag("<p title=\"&copy;\">", 0).valid)
    expect bool.not(rich-html.tag("<p title=\"x", 0).valid)
    // Multi-byte text is kept whole (report 304; it used to be dropped).
    expect rich-html.tag("<p title=\"é🚀\" data-x=y&amp;z>", 0).attributes == [htmlAttribute.new(name = "title", value = "é🚀"), htmlAttribute.new(name = "data-x", value = "y&z")]
    expect rich-html.tag("<p a b=1 c>", 0).attributes == [htmlAttribute.new(name = "a", value = ""), htmlAttribute.new(name = "b", value = "1"), htmlAttribute.new(name = "c", value = "")]
}

fn rich-html.attribute(tag: HtmlTag, name: String) -> Option<String> {
    var found = option.none<String>()
    for attribute in tag.attributes {
        if attribute.name == name {
            found = option.some<String>(attribute.value)
            break
        }
    }
    found
}

test rich-html.attribute/lookup {
    let tag = rich-html.tag("<a href=\"/x\">", 0)
    expect rich-html.attribute(tag, "href") == option.some<String>("/x") && rich-html.attribute(tag, "title") == option.none<String>()
}

fn rich-html.escape-text(text: String) -> String {
    doc "Nokogiri's HTML5 serialization of text: & U+00A0 < > as &amp; &nbsp; &lt; &gt;."
    string.replace(string.replace(string.replace(string.replace(text, "&", "&amp;"), " ", "&nbsp;"), "<", "&lt;"), ">", "&gt;")
}

test rich-html.escape-text/set {
    expect rich-html.escape-text("a & <b> \"q\"") == "a &amp; &lt;b&gt; \"q\""
}

fn rich-html.escape-attribute(text: String) -> String {
    doc "Nokogiri's HTML5 serialization of an attribute value: & U+00A0 \" as &amp; &nbsp; &quot;."
    string.replace(string.replace(string.replace(text, "&", "&amp;"), " ", "&nbsp;"), "\"", "&quot;")
}

test rich-html.escape-attribute/set {
    expect rich-html.escape-attribute("a\"b&c<") == "a&quot;b&amp;c<"
}

// ------------------------------------------------------------ fragment queries
//
// Small read-only queries over a fragment, enough to read an element's text
// the way Nokogiri's `.text` does (every descendant text node, references
// decoded) and to find the first element of a name or class. Comments are
// skipped; a reference this library cannot decode makes the text unreadable.

fn rich-html.letter?(byte: Int) -> Bool {
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

test rich-html.letter?/ascii {
    expect rich-html.letter?(97) && rich-html.letter?(90) && bool.not(rich-html.letter?(48))
}

fn rich-html.has-class?(tag: HtmlTag, class: String) -> Bool {
    doc "Whether the tag's class attribute holds this class among its whitespace-separated tokens."
    match rich-html.attribute(tag, "class") {
        none => false
        some value => string.contains(string.join([" ", string.replace(string.replace(string.replace(string.replace(value, "\t", " "), "\n", " "), "\r", " "), "\f", " "), " "]), string.join([" ", class, " "]))
    }
}

test rich-html.has-class?/tokens {
    let tag = rich-html.tag("<div class=\"og-embed gap\tx\">", 0)
    expect rich-html.has-class?(tag, "gap") && rich-html.has-class?(tag, "x") && bool.not(rich-html.has-class?(tag, "og"))
}

fn rich-html.find-start-tag(text: String, from: Int, to: Int, name: String, class: String) -> Int {
    doc "Where the first start tag in [from, to) with this name (any when empty) and class (any when empty) begins; -1 when there is none."
    var at = from
    var found = -1
    let steps = to - from + 1
    for step in 0..steps {
        let next = match string.index-of(text, "<", at) { none => -1; some index => index }
        if next < 0 || next >= to || found >= 0 {
            break
        }
        if rich-html.letter?(string.byte-at-or(text, next + 1, 0)) {
            let tag = rich-html.tag(text, next)
            if tag.valid && (name == "" || tag.name == name) && (class == "" || rich-html.has-class?(tag, class)) {
                found = next
            }
            at = if tag.valid { tag.stop + 1 } else { next + 1 }
        } else {
            at = next + 1
        }
    }
    found
}

test rich-html.find-start-tag/name-and-class {
    let text = "<div class=\"a\"><a href=\"/x\">x</a><div class=\"b c\">y</div></div>"
    expect rich-html.find-start-tag(text, 0, string.byte-length(text), "", "c") == 33
    expect rich-html.find-start-tag(text, 1, string.byte-length(text), "a", "") == 15
    expect rich-html.find-start-tag(text, 0, 10, "", "c") == -1
}

fn rich-html.element-end(text: String, at: Int) -> Int {
    doc "Just past the end tag matching the start tag at this '<' (elements of the same name nest); just past the start tag for a void element; the text's end when it is never closed; -1 when the start tag is unreadable."
    let tag = rich-html.tag(text, at)
    let length = string.byte-length(text)
    let close = string.join(["</", tag.name])
    var depth = 1
    var stop = length
    var i = tag.stop + 1
    if bool.not(tag.valid) {
        stop = -1
    } else if rich-html.void?(tag.name) {
        stop = tag.stop + 1
    } else {
        for step in 0..length {
            let next = match string.index-of(text, "<", i) { none => -1; some index => index }
            if next < 0 || depth == 0 {
                break
            }
            let after = string.byte-at-or(text, next + string.byte-length(close), 0)
            let bounded = after == 62 || rich-html.space?(after) || after == 47
            if string.to-lower-ascii(match string.slice(text, next, string.byte-length(close)) { none => ""; some s => s }) == close && bounded {
                depth = depth - 1
                let gt = match string.index-of(text, ">", next) { none => length - 1; some index => index }
                if depth == 0 {
                    stop = gt + 1
                }
                i = gt + 1
            } else if rich-html.letter?(string.byte-at-or(text, next + 1, 0)) {
                let inner = rich-html.tag(text, next)
                if inner.valid && inner.name == tag.name {
                    depth = depth + 1
                }
                i = if inner.valid { inner.stop + 1 } else { next + 1 }
            } else {
                i = next + 1
            }
        }
    }
    stop
}

test rich-html.element-end/nesting {
    let text = "<div><div>a</div>b</DIV>c"
    expect rich-html.element-end(text, 0) == 24
    expect rich-html.element-end(text, 5) == 17
    expect rich-html.element-end("<img src=\"/a\">b", 0) == 14
    expect rich-html.element-end("<p>open", 0) == 7
}

fn rich-html.decode-text(text: String) -> Option<String> {
    doc "A text node's character references decoded; none when one cannot be decoded."
    var out = ""
    var at = 0
    var readable = true
    let length = string.byte-length(text)
    let steps = length + 1
    for step in 0..steps {
        let next = match string.index-of(text, "&", at) { none => -1; some index => index }
        if next < 0 || bool.not(readable) {
            break
        }
        let ref = rich-html.char-ref(text, next)
        let size = match int.parse(match list.get(ref, 1) { none => "0"; some n => n }) { none => 0; some n => n }
        if size == 0 {
            readable = false
        } else {
            out = string.join([out, match string.slice(text, at, next - at) { none => ""; some s => s }, match list.get(ref, 0) { none => ""; some s => s }])
            at = next + size
        }
    }
    if readable { option.some<String>(string.concat(out, match string.slice(text, at, length - at) { none => ""; some s => s })) } else { option.none<String>() }
}

test rich-html.decode-text/references {
    expect rich-html.decode-text("a &amp; b &#39;c&#39;") == option.some<String>("a & b 'c'")
    expect rich-html.decode-text("&copy;") == option.none<String>()
}

fn rich-html.text-between(text: String, from: Int, to: Int) -> Option<String> {
    doc "Every text node in [from, to) joined, references decoded, tags and comments left out (Nokogiri's .text of the element there); none when a reference cannot be decoded."
    var out = ""
    var at = from
    var readable = true
    let steps = to - from + 1
    for step in 0..steps {
        if at >= to || bool.not(readable) {
            break
        }
        let next = match string.index-of(text, "<", at) { none => to; some index => if index < to { index } else { to } }
        let chunk = match string.slice(text, at, next - at) { none => ""; some s => s }
        let decoded = rich-html.decode-text(chunk)
        if decoded == option.none<String>() {
            readable = false
        } else {
            out = string.concat(out, match decoded { none => ""; some value => value })
        }
        let second = string.byte-at-or(text, next + 1, 0)
        if next >= to {
            at = to
        } else if string.starts-with(match string.slice(text, next, 4) { none => ""; some s => s }, "<!--") {
            at = match string.index-of(text, "-->", next) { none => to; some index => index + 3 }
        } else if rich-html.letter?(second) || second == 47 || second == 33 || second == 63 {
            at = match string.index-of(text, ">", next) { none => to; some index => index + 1 }
        } else {
            out = string.concat(out, "<")
            at = next + 1
        }
    }
    if readable { option.some<String>(out) } else { option.none<String>() }
}

test rich-html.text-between/text-nodes {
    let text = "<a href=\"/x\">Free <b>cookies</b> &amp; <!-- no -->milk</a>"
    expect rich-html.text-between(text, 0, string.byte-length(text)) == option.some<String>("Free cookies & milk")
    expect rich-html.text-between("a < b", 0, 5) == option.some<String>("a < b")
}
