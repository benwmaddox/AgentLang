<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NativeAbi.fs" />
    <Compile Include="NativeValues.fs" />
    <Compile Include="NativeValueMetrics.fs" />
    <Compile Include="LlvmToolchain.fs" />
    <Compile Include="LlvmAot.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="native\arena_runtime.h" LogicalName="AgentLang.Llvm.native.arena_runtime.h" />
    <EmbeddedResource Include="native\arena_runtime.c" LogicalName="AgentLang.Llvm.native.arena_runtime.c" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentLang.Core\AgentLang.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentLang.Llvm.Tests" />
  </ItemGroup>
</Project>
