test store.add-customer/adds-and-preserves-all-collections {
    let new-customer = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000001"),
        email = Email::new("new@example.com"),
        kind = "new",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let product = product::new(
        id = ProductId::new("00000000-0000-0000-0000-000000000002"),
        name = "saved product",
        unit-price = Money::new(25));
    let subscription = subscription::new(
        id = SubscriptionId::new("00000000-0000-0000-0000-000000000003"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000004"),
        product-id = ProductId::new("00000000-0000-0000-0000-000000000002"),
        term = "monthly",
        started-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        expires-at = Instant::new("2024-02-01T00:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let invoice = invoice::new(
        id = InvoiceId::new("00000000-0000-0000-0000-000000000005"),
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000004"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(25),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let payment = payment::new(
        id = PaymentId::new("00000000-0000-0000-0000-000000000006"),
        invoice-id = InvoiceId::new("00000000-0000-0000-0000-000000000005"),
        amount = Money::new(25),
        provider-reference = "saved-payment",
        paid-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let email = emailMessage::new(
        to = Email::new("saved@example.com"), subject = "saved", body = "saved body");
    let initial = store::new(
        customers = list::empty<Customer>(),
        products = list::singleton<Product>(product),
        subscriptions = list::singleton<Subscription>(subscription),
        invoices = list::singleton<Invoice>(invoice),
        payments = list::singleton<Payment>(payment),
        email-outbox = list::singleton<EmailMessage>(email),
        sent-emails = list::singleton<EmailMessage>(email));
    match store::add-customer(new-customer, initial) {
        ok updated => {
            bool::and(
                equals(updated.customers(), list::append(initial.customers(), new-customer)),
                bool::and(
                    equals(updated.products(), initial.products()),
                    bool::and(
                        equals(updated.subscriptions(), initial.subscriptions()),
                        bool::and(
                            equals(updated.invoices(), initial.invoices()),
                            bool::and(
                                equals(updated.payments(), initial.payments()),
                                bool::and(
                                    equals(updated.email-outbox(), initial.email-outbox()),
                                    equals(updated.sent-emails(), initial.sent-emails())))))))
        }
        error problem => { false }
    }
    => true
}

test store.add-customer/duplicate-code-and-input-unchanged {
    let existing = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000001"),
        email = Email::new("same@example.com"),
        kind = "existing",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let blank = store::empty(unit);
    let initial = store::new(
        customers = list::singleton<Customer>(existing),
        products = blank.products(),
        subscriptions = blank.subscriptions(),
        invoices = blank.invoices(),
        payments = blank.payments(),
        email-outbox = blank.email-outbox(),
        sent-emails = blank.sent-emails());
    match store::add-customer(existing, initial) {
        ok updated => { false }
        error problem => {
            bool::and(
                equals(problem.code(), "DUPLICATE_CUSTOMER"),
                equals(initial.customers().count(), 1))
        }
    }
    => true
}

