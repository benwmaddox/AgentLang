# The lookup helper records keep the search key and first match inside each
# static list.fold callback.
record CustomerLookup {
    field target: CustomerId;
    field found: Option<Customer>;
}

record ProductLookup {
    field target: ProductId;
    field found: Option<Product>;
}

record SubscriptionLookup {
    field target: SubscriptionId;
    field found: Option<Subscription>;
}

record InvoiceLookup {
    field target: InvoiceId;
    field found: Option<Invoice>;
}

record PaymentLookup {
    field target: PaymentId;
    field found: Option<Payment>;
}

word store.customer-fold-step(accumulator: CustomerLookup, candidate: Customer) -> CustomerLookup {
    effects none
    doc "Keep the first customer whose ID matches the lookup key."
    match accumulator.found() {
        some existing => { accumulator }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                customerLookup::new(
                    target = accumulator.target(),
                    found = option::some<Customer>(candidate))
            } else {
                accumulator
            }
        }
    }
}

word store.product-fold-step(accumulator: ProductLookup, candidate: Product) -> ProductLookup {
    effects none
    doc "Keep the first product whose ID matches the lookup key."
    match accumulator.found() {
        some existing => { accumulator }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                productLookup::new(
                    target = accumulator.target(),
                    found = option::some<Product>(candidate))
            } else {
                accumulator
            }
        }
    }
}

word store.subscription-fold-step(accumulator: SubscriptionLookup, candidate: Subscription) -> SubscriptionLookup {
    effects none
    doc "Keep the first subscription whose ID matches the lookup key."
    match accumulator.found() {
        some existing => { accumulator }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                subscriptionLookup::new(
                    target = accumulator.target(),
                    found = option::some<Subscription>(candidate))
            } else {
                accumulator
            }
        }
    }
}

word store.invoice-fold-step(accumulator: InvoiceLookup, candidate: Invoice) -> InvoiceLookup {
    effects none
    doc "Keep the first invoice whose ID matches the lookup key."
    match accumulator.found() {
        some existing => { accumulator }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                invoiceLookup::new(
                    target = accumulator.target(),
                    found = option::some<Invoice>(candidate))
            } else {
                accumulator
            }
        }
    }
}

word store.payment-fold-step(accumulator: PaymentLookup, candidate: Payment) -> PaymentLookup {
    effects none
    doc "Keep the first payment whose ID matches the lookup key."
    match accumulator.found() {
        some existing => { accumulator }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                paymentLookup::new(
                    target = accumulator.target(),
                    found = option::some<Payment>(candidate))
            } else {
                accumulator
            }
        }
    }
}

word store.empty(value: Unit) -> Store {
    effects none
    doc "Create a Store with all seven collections empty."
    store::new(
        customers = list::empty<Customer>(),
        products = list::empty<Product>(),
        subscriptions = list::empty<Subscription>(),
        invoices = list::empty<Invoice>(),
        payments = list::empty<Payment>(),
        email-outbox = list::empty<EmailMessage>(),
        sent-emails = list::empty<EmailMessage>())
}

word store.customer(id: CustomerId, store: Store) -> Option<Customer> {
    effects none
    doc "Find the first customer with this ID, preserving list order."
    store.customers().fold(
        customerLookup::new(target = id, found = option::none<Customer>()),
        store::customer-fold-step).found()
}

word store.product(id: ProductId, store: Store) -> Option<Product> {
    effects none
    doc "Find the first product with this ID, preserving list order."
    store.products().fold(
        productLookup::new(target = id, found = option::none<Product>()),
        store::product-fold-step).found()
}

word store.subscription(id: SubscriptionId, store: Store) -> Option<Subscription> {
    effects none
    doc "Find the first subscription with this ID, preserving list order."
    store.subscriptions().fold(
        subscriptionLookup::new(target = id, found = option::none<Subscription>()),
        store::subscription-fold-step).found()
}

word store.invoice(id: InvoiceId, store: Store) -> Option<Invoice> {
    effects none
    doc "Find the first invoice with this ID, preserving list order."
    store.invoices().fold(
        invoiceLookup::new(target = id, found = option::none<Invoice>()),
        store::invoice-fold-step).found()
}

word store.payment(id: PaymentId, store: Store) -> Option<Payment> {
    effects none
    doc "Find the first payment with this ID, preserving list order."
    store.payments().fold(
        paymentLookup::new(target = id, found = option::none<Payment>()),
        store::payment-fold-step).found()
}

word store.add-customer(customer: Customer, store: Store) -> Result<Store, BusinessError> {
    effects none
    doc "Append a customer when its ID is unused, or return DUPLICATE_CUSTOMER."
    match store::customer(customer.id(), store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_CUSTOMER",
                message = "A customer with this identifier already exists."))
        }
        none => {
            let updated = store::new(
                customers = list::append(store.customers(), customer),
                products = store.products(),
                subscriptions = store.subscriptions(),
                invoices = store.invoices(),
                payments = store.payments(),
                email-outbox = store.email-outbox(),
                sent-emails = store.sent-emails());
            result::ok<Store, BusinessError>(updated)
        }
    }
}

word store.add-product(product: Product, store: Store) -> Result<Store, BusinessError> {
    effects none
    doc "Append a product when its ID is unused, or return DUPLICATE_PRODUCT."
    match store::product(product.id(), store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_PRODUCT",
                message = "A product with this identifier already exists."))
        }
        none => {
            let updated = store::new(
                customers = store.customers(),
                products = list::append(store.products(), product),
                subscriptions = store.subscriptions(),
                invoices = store.invoices(),
                payments = store.payments(),
                email-outbox = store.email-outbox(),
                sent-emails = store.sent-emails());
            result::ok<Store, BusinessError>(updated)
        }
    }
}

test store.customer-fold-step/no-match {
    let key = CustomerId::new("00000000-0000-0000-0000-000000000001");
    let other = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000002"),
        email = Email::new("other@example.com"),
        kind = "other",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let initial = customerLookup::new(target = key, found = option::none<Customer>());
    match store::customer-fold-step(initial, other).found() {
        some selected => { false }
        none => { true }
    }
    => true
}

