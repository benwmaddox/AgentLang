# Subscription transitions are pure Store transformations. No renewal policy
# or external provider behavior is included in this fixture.

record SubscriptionReplacementState {
    field target-id: SubscriptionId;
    field replacement: Subscription;
    field output: List<Subscription>;
    field replaced: Bool;
}

word subscription.replace-step(state: SubscriptionReplacementState, candidate: Subscription) -> SubscriptionReplacementState {
    effects none
    doc "Copy subscriptions in order, replacing only the first item with the target ID."
    let matches-target = equals(candidate.id(), state.target-id());
    let replace-now = bool::and(bool::not(state.replaced()), matches-target);
    if replace-now {
        subscriptionReplacementState::new(
            target-id = state.target-id(),
            replacement = state.replacement(),
            output = list::append(state.output(), state.replacement()),
            replaced = true)
    } else {
        subscriptionReplacementState::new(
            target-id = state.target-id(),
            replacement = state.replacement(),
            output = list::append(state.output(), candidate),
            replaced = state.replaced())
    }
}

word subscription.replace-list(values: List<Subscription>, target-id: SubscriptionId, replacement: Subscription) -> List<Subscription> {
    effects none
    doc "Replace the first subscription with the target ID while preserving list order."
    let initial = subscriptionReplacementState::new(
        target-id = target-id,
        replacement = replacement,
        output = list::empty<Subscription>(),
        replaced = false);
    values.fold(initial, subscription::replace-step).output()
}

word subscription.start(store: Store, id: SubscriptionId, customer-id: CustomerId, product-id: ProductId, term: String, started-at: Instant, expires-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Append a new active subscription after checking ID, term, dates, customer, and product in reference order."
    match store::subscription(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_SUBSCRIPTION",
                message = "A subscription with this identifier already exists."))
        }
        none => {
            let normalized-term = string::trim(term);
            if equals(string::length(normalized-term), 0) {
                result::error<Store, BusinessError>(businessError::new(
                    code = "INVALID_SUBSCRIPTION_TERM",
                    message = "Subscription term must contain non-whitespace text."))
            } else {
                let expires-before-start = instant::before?(Instant::value(expires-at), Instant::value(started-at));
                let expires-equal-start = equals(Instant::value(expires-at), Instant::value(started-at));
                if bool::or(expires-before-start, expires-equal-start) {
                    result::error<Store, BusinessError>(businessError::new(
                        code = "SUBSCRIPTION_EXPIRY_MUST_FOLLOW_START",
                        message = "Subscription expiry must be later than its start."))
                } else {
                    match store::customer(customer-id, store) {
                        none => {
                            result::error<Store, BusinessError>(businessError::new(
                                code = "CUSTOMER_NOT_FOUND",
                                message = "The customer does not exist."))
                        }
                        some customer => {
                            match store::product(product-id, store) {
                                none => {
                                    result::error<Store, BusinessError>(businessError::new(
                                        code = "PRODUCT_NOT_FOUND",
                                        message = "The product does not exist."))
                                }
                                some product => {
                                    let subscription = subscription::new(
                                        id = id,
                                        customer-id = customer-id,
                                        product-id = product-id,
                                        term = normalized-term,
                                        started-at = started-at,
                                        expires-at = expires-at,
                                        status = SubscriptionStatus::new("active"),
                                        cancelled-at = option::none<Instant>());
                                    let updated = store::with-subscriptions(
                                        store,
                                        list::append(store.subscriptions(), subscription));
                                    result::ok<Store, BusinessError>(updated)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

word subscription.cancel(store: Store, id: SubscriptionId, cancelled-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Cancel an active subscription at or after its start while preserving Store and list order."
    match store::subscription(id, store) {
        none => {
            result::error<Store, BusinessError>(businessError::new(
                code = "SUBSCRIPTION_NOT_FOUND",
                message = "The subscription does not exist."))
        }
        some existing => {
            if equals(SubscriptionStatus::value(existing.status()), "cancelled") {
                result::error<Store, BusinessError>(businessError::new(
                    code = "SUBSCRIPTION_ALREADY_CANCELLED",
                    message = "The subscription is already cancelled."))
            } else {
                if instant::before?(Instant::value(cancelled-at), Instant::value(existing.started-at())) {
                    result::error<Store, BusinessError>(businessError::new(
                        code = "CANCEL_BEFORE_START",
                        message = "A subscription cannot be cancelled before it starts."))
                } else {
                    let cancelled = subscription::new(
                        id = existing.id(),
                        customer-id = existing.customer-id(),
                        product-id = existing.product-id(),
                        term = existing.term(),
                        started-at = existing.started-at(),
                        expires-at = existing.expires-at(),
                        status = SubscriptionStatus::new("cancelled"),
                        cancelled-at = option::some<Instant>(cancelled-at));
                    let updated-subscriptions = subscription::replace-list(
                        store.subscriptions(), id, cancelled);
                    let updated-store = store::with-subscriptions(store, updated-subscriptions);
                    result::ok<Store, BusinessError>(updated-store)
                }
            }
        }
    }
}

test subscription.replace-step/replaces-first-match {
    let candidate = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "original",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let replacement = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "replacement",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let initial = subscriptionReplacementState::new(
        target-id = candidate.id(),
        replacement = replacement,
        output = list::empty<Subscription>(),
        replaced = false);
    let updated = subscription::replace-step(initial, candidate);
    bool::and(
        updated.replaced(),
        equals(updated.output(), list::singleton<Subscription>(replacement)))
    => true
}

