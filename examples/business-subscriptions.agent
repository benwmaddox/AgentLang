# Subscription transitions are pure Store transformations. No renewal policy
# or external provider behavior is included in this fixture.

record OccupiedPeriod {
    field start: Instant;
    field finish: Instant;
    validate occupied-period::valid?;
}

record SubscriptionOverlapState {
    field customer-id: CustomerId;
    field product-id: ProductId;
    field period: OccupiedPeriod;
    field overlaps: Bool;
}

fn occupied-period.valid?(value: OccupiedPeriod) -> Bool {
    doc "Accept exactly nonempty half-open periods whose start precedes their finish."

    instant::before?(Instant::value(value.start), Instant::value(value.finish))
}

fn occupied-period.try-create(start: Instant, finish: Instant) -> Option<OccupiedPeriod> {
    doc "Return a validated occupied period when start precedes finish; otherwise return none."

    if instant::before?(Instant::value(start), Instant::value(finish)) {
        option::some<OccupiedPeriod>(occupiedPeriod::new(start = start, finish = finish))
    } else {
        option::none<OccupiedPeriod>()
    }
}

fn occupied-period.overlaps?(left: OccupiedPeriod, right: OccupiedPeriod) -> Bool {
    doc "Whether two nonempty half-open occupied periods share any instants."

    bool::and(
        instant::before?(Instant::value(left.start), Instant::value(right.finish)),
        instant::before?(Instant::value(right.start), Instant::value(left.finish)))
}

fn subscription.occupied-period(value: Subscription) -> Option<OccupiedPeriod> {
    doc "Derive the subscription's active or cancelled half-open occupied period."

    if value.status == SubscriptionStatus::new("active") {
        occupied-period::try-create(value.started-at, value.expires-at)
    } else {
        match value.cancelled-at {
            none => { option::none<OccupiedPeriod>() }
            some cancelled-at => {
                let finish = if instant::before?(Instant::value(cancelled-at), Instant::value(value.expires-at)) {
                    cancelled-at
                } else {
                    value.expires-at
                };
                occupied-period::try-create(value.started-at, finish)
            }
        }
    }
}

fn subscription.overlap-step(state: SubscriptionOverlapState, candidate: Subscription) -> SubscriptionOverlapState {
    doc "Accumulate whether a matching customer's product period overlaps the candidate period."

    if state.overlaps {
        state
    } else {
        let same-customer = candidate.customer-id == state.customer-id;
        let same-product = candidate.product-id == state.product-id;
        if bool::and(same-customer, same-product) {
            match subscription::occupied-period(candidate) {
                some existing-period => {
                    subscriptionOverlapState::new(
                        customer-id = state.customer-id,
                        product-id = state.product-id,
                        period = state.period,
                        overlaps = occupied-period::overlaps?(state.period, existing-period))
                }
                none => { state }
            }
        } else {
            state
        }
    }
}

fn subscription.has-overlap?(subscriptions: List<Subscription>, customer-id: CustomerId, product-id: ProductId, period: OccupiedPeriod) -> Bool {
    doc "Whether an existing subscription for this customer and product overlaps the proposed period."

    let initial = subscriptionOverlapState::new(
        customer-id = customer-id,
        product-id = product-id,
        period = period,
        overlaps = false);
    subscriptions.fold(initial, subscription::overlap-step).overlaps
}

record SubscriptionReplacementState {
    field target-id: SubscriptionId;
    field replacement: Subscription;
    field output: List<Subscription>;
    field replaced: Bool;
}

fn subscription.replace-step(state: SubscriptionReplacementState, candidate: Subscription) -> SubscriptionReplacementState {
    doc "Copy subscriptions in order, replacing only the first item with the target ID."

    let matches-target = candidate.id == state.target-id;
    let replace-now = bool::and(bool::not(state.replaced), matches-target);
    if replace-now {
        subscriptionReplacementState::new(
            target-id = state.target-id,
            replacement = state.replacement,
            output = list::append(state.output, state.replacement),
            replaced = true)
    } else {
        subscriptionReplacementState::new(
            target-id = state.target-id,
            replacement = state.replacement,
            output = list::append(state.output, candidate),
            replaced = state.replaced)
    }
}

fn subscription.replace-list(values: List<Subscription>, target-id: SubscriptionId, replacement: Subscription) -> List<Subscription> {
    doc "Replace the first subscription with the target ID while preserving list order."

    let initial = subscriptionReplacementState::new(
        target-id = target-id,
        replacement = replacement,
        output = list::empty<Subscription>(),
        replaced = false);
    values.fold(initial, subscription::replace-step).output
}

fn subscription.start(store: Store, id: SubscriptionId, customer-id: CustomerId, product-id: ProductId, term: String, started-at: Instant, expires-at: Instant) -> Result<Store, BusinessError> {
    doc "Append a new active subscription after checking ID, term, dates, customer, product, and occupied-period overlap in reference order."

    match store::subscription(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(
                code = "DUPLICATE_SUBSCRIPTION",
                message = "A subscription with this identifier already exists."))
        }
        none => {
            let normalized-term = string::trim(term);
            if string::length(normalized-term) == 0 {
                result::error<Store, BusinessError>(businessError::new(
                    code = "INVALID_SUBSCRIPTION_TERM",
                    message = "Subscription term must contain non-whitespace text."))
            } else {
                match occupied-period::try-create(started-at, expires-at) {
                    none => {
                        result::error<Store, BusinessError>(businessError::new(
                            code = "SUBSCRIPTION_EXPIRY_MUST_FOLLOW_START",
                            message = "Subscription expiry must be later than its start."))
                    }
                    some period => {
                        match store::customer(customer-id, store) {
                            none => {
                                result::error<Store, BusinessError>(businessError::new(
                                    code = "CUSTOMER_NOT_FOUND",
                                    message = "The customer does not exist."))
                            }
                            some customer => {
                                match store::product(product-id, store) {
                                    none => {
                                        result::error<Store, BusinessError>(businessError::new(
                                            code = "PRODUCT_NOT_FOUND",
                                            message = "The product does not exist."))
                                    }
                                    some product => {
                                        if subscription::has-overlap?(
                                            store.subscriptions, customer-id, product-id, period) {
                                            result::error<Store, BusinessError>(businessError::new(
                                                code = "SUBSCRIPTION_OVERLAP",
                                                message = "This customer already has an overlapping subscription for the product."))
                                        } else {
                                            let subscription = subscription::new(
                                                id = id,
                                                customer-id = customer-id,
                                                product-id = product-id,
                                                term = normalized-term,
                                                started-at = started-at,
                                                expires-at = expires-at,
                                                status = SubscriptionStatus::new("active"),
                                                cancelled-at = option::none<Instant>());
                                            let updated = store::with-subscriptions(
                                                store,
                                                list::append(store.subscriptions, subscription));
                                            result::ok<Store, BusinessError>(updated)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn subscription.cancel(store: Store, id: SubscriptionId, cancelled-at: Instant) -> Result<Store, BusinessError> {
    doc "Cancel an active subscription at or after its start while preserving Store and list order."

    match store::subscription(id, store) {
        none => {
            result::error<Store, BusinessError>(businessError::new(
                code = "SUBSCRIPTION_NOT_FOUND",
                message = "The subscription does not exist."))
        }
        some existing => {
            if existing.status == SubscriptionStatus::new("cancelled") {
                result::error<Store, BusinessError>(businessError::new(
                    code = "SUBSCRIPTION_ALREADY_CANCELLED",
                    message = "The subscription is already cancelled."))
            } else {
                if instant::before?(Instant::value(cancelled-at), Instant::value(existing.started-at)) {
                    result::error<Store, BusinessError>(businessError::new(
                        code = "CANCEL_BEFORE_START",
                        message = "A subscription cannot be cancelled before it starts."))
                } else {
                    let cancelled = subscription::new(
                        id = existing.id,
                        customer-id = existing.customer-id,
                        product-id = existing.product-id,
                        term = existing.term,
                        started-at = existing.started-at,
                        expires-at = existing.expires-at,
                        status = SubscriptionStatus::new("cancelled"),
                        cancelled-at = option::some<Instant>(cancelled-at));
                    let updated-subscriptions = subscription::replace-list(
                        store.subscriptions, id, cancelled);
                    let updated-store = store::with-subscriptions(store, updated-subscriptions);
                    result::ok<Store, BusinessError>(updated-store)
                }
            }
        }
    }
}

test subscription.replace-step/replaces-first-match {
    let candidate = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "original",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let replacement = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "replacement",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let initial = subscriptionReplacementState::new(
        target-id = candidate.id,
        replacement = replacement,
        output = list::empty<Subscription>(),
        replaced = false);
    let updated = subscription::replace-step(initial, candidate);
    bool::and(
        updated.replaced,
        equals(updated.output, list::singleton<Subscription>(replacement)))
    => true
}

