        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-03T12:00:00.0000000+00:00")));
    let initial = store::with-subscriptions(baseline, list::singleton<Subscription>(cancelled));
