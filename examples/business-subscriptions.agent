test occupied-period.try-create/nonempty-is-some {
    let start = Instant::new("2026-01-02T12:00:00.0000000+00:00");
    let finish = Instant::new("2026-01-03T12:00:00.0000000+00:00");
    match occupied-period::try-create(start, finish) {
        some value => { bool::and(value.start == start, value.finish == finish) }
        none => { false }
    }
    => true
}

test occupied-period.try-create/empty-is-none {
    let instant = Instant::new("2026-01-02T12:00:00.0000000+00:00");
    match occupied-period::try-create(instant, instant) {
        some value => { false }
        none => { true }
    }
    => true
}

