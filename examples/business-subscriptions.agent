        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-02T12:00:00.0000000+00:00")));
    equals(
        subscription::replace-list(list::empty<Subscription>(), replacement.id(), replacement),
        list::empty<Subscription>())
    => true
}

test subscription.replace-list/nonempty-fold-replaces-first-in-order {
    let first = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "first",
        started-at = Instant::new("2026-01-01T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let target = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000003"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "target",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let replacement = subscription::new(
        id = target.id(),
        customer-id = target.customer-id(),
        product-id = target.product-id(),
        term = "replacement",
        started-at = target.started-at(),
        expires-at = target.expires-at(),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-02T12:00:00.0000000+00:00")));
    equals(
        subscription::replace-list(
            list::append(list::singleton<Subscription>(first), target),
            target.id(),
            replacement),
        list::append(list::singleton<Subscription>(first), replacement))
    => true
}

test subscription.start/appends-active-subscription {
    let initial = business::seed(unit);
    let id = SubscriptionId::new("50000000-0000-0000-0000-000000000001");
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    match subscription::start(
        initial,
        id,
        customer-id,
        product-id,
        "  monthly  ",
        Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        Instant::new("2026-03-02T12:00:00.0000000+00:00")) {
        ok updated => {
            match store::subscription(id, updated) {
                some created => {
                    bool::and(
                        equals(created.term(), "monthly"),
                        bool::and(
                            equals(created.status(), SubscriptionStatus::new("active")),
                            bool::and(
                                equals(created.cancelled-at(), option::none<Instant>()),
                                bool::and(
                                    equals(updated.subscriptions().count(), 2),
                                    bool::and(
                                        equals(updated.customers(), initial.customers()),
                                        bool::and(
                                            equals(updated.products(), initial.products()),
                                            bool::and(
                                                equals(updated.invoices(), initial.invoices()),
                                                bool::and(
                                                    equals(updated.payments(), initial.payments()),
                                                    bool::and(
                                                        equals(updated.email-outbox(), initial.email-outbox()),
                                                        equals(updated.sent-emails(), initial.sent-emails()))))))))))
                }
                none => { false }
            }
        }
        error problem => { false }
    }
    => true
}

test subscription.start/duplicate-precedes-other-errors {
    let initial = business::seed(unit);
    match subscription::start(
        initial,
        SubscriptionId::new("30000000-0000-0000-0000-000000000001"),
        CustomerId::new("90000000-0000-0000-0000-000000000001"),
        ProductId::new("90000000-0000-0000-0000-000000000002"),
        " \t ",
        Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        Instant::new("2026-01-02T12:00:00.0000000+00:00")) {
        ok updated => { "UNEXPECTED_SUCCESS" }
        error problem => { problem.code() }
    }
    => "DUPLICATE_SUBSCRIPTION"
}

