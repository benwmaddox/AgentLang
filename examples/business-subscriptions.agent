        business::seed(unit).subscriptions,
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        ProductId::new("20000000-0000-0000-0000-000000000001"),
        occupiedPeriod::new(
            start = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-03-01T12:00:00.0000000+00:00")))
    => false
}

test subscription.has-overlap?/other-customer-is-allowed {
    subscription::has-overlap?(
        business::seed(unit).subscriptions,
        CustomerId::new("10000000-0000-0000-0000-000000000002"),
        ProductId::new("20000000-0000-0000-0000-000000000001"),
        occupiedPeriod::new(
            start = Instant::new("2026-01-15T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-02-15T12:00:00.0000000+00:00")))
    => false
}

test subscription.has-overlap?/other-product-is-allowed {
    subscription::has-overlap?(
        business::seed(unit).subscriptions,
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        ProductId::new("20000000-0000-0000-0000-000000000002"),
        occupiedPeriod::new(
            start = Instant::new("2026-01-15T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-02-15T12:00:00.0000000+00:00")))
    => false
}

test subscription.has-overlap?/cancelled-period-ends-at-cancellation {
    let cancelled = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000033"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "monthly",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-15T12:00:00.0000000+00:00")));
    subscription::has-overlap?(
        list::singleton<Subscription>(cancelled),
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        ProductId::new("20000000-0000-0000-0000-000000000001"),
        occupiedPeriod::new(
            start = Instant::new("2026-01-15T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-02-15T12:00:00.0000000+00:00")))
    => false
}

test subscription.start/rejects-overlapping-customer-product-period {
    match subscription::start(
        business::seed(unit),
        SubscriptionId::new("50000000-0000-0000-0000-000000000034"),
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        ProductId::new("20000000-0000-0000-0000-000000000001"),
        "monthly",
        Instant::new("2026-01-15T12:00:00.0000000+00:00"),
        Instant::new("2026-02-15T12:00:00.0000000+00:00")) {
        ok updated => { "UNEXPECTED_SUCCESS" }
        error problem => { problem.code }
    }
    => "SUBSCRIPTION_OVERLAP"
}

test subscription.start/accepts-period-after-cancellation {
    let baseline = business::seed(unit);
    let cancelled = subscription::new(
        id = SubscriptionId::new("30000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "monthly",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-15T12:00:00.0000000+00:00")));
    let initial = store::with-subscriptions(baseline, list::singleton<Subscription>(cancelled));
    match subscription::start(
        initial,
        SubscriptionId::new("50000000-0000-0000-0000-000000000035"),
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        ProductId::new("20000000-0000-0000-0000-000000000001"),
        "monthly",
        Instant::new("2026-01-15T12:00:00.0000000+00:00"),
        Instant::new("2026-02-01T12:00:00.0000000+00:00")) {
        ok updated => { updated.subscriptions.count() }
        error problem => { -1 }
    }
    => 2
}

example occupied-period.try-create/nonempty-period {
    match occupied-period::try-create(
        Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        Instant::new("2026-01-03T12:00:00.0000000+00:00")) {
        some value => { bool::and(value.start == Instant::new("2026-01-02T12:00:00.0000000+00:00"), value.finish == Instant::new("2026-01-03T12:00:00.0000000+00:00")) }
        none => { false }
    }
    => true
}

example occupied-period.overlaps?/touching-periods {
    occupied-period::overlaps?(
        occupiedPeriod::new(
            start = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-01-03T12:00:00.0000000+00:00")),
        occupiedPeriod::new(
            start = Instant::new("2026-01-03T12:00:00.0000000+00:00"),
            finish = Instant::new("2026-01-04T12:00:00.0000000+00:00")))
    => false
}

example subscription.occupied-period/cancelled-period {
    let value = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000036"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "monthly",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(Instant::new("2026-01-15T12:00:00.0000000+00:00")));
    match subscription::occupied-period(value) {
        some period => { period.finish == Instant::new("2026-01-15T12:00:00.0000000+00:00") }
        none => { false }
    }
    => true
}
