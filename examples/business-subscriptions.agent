    bool::and(
        bool::not(updated.replaced()),
        equals(updated.output(), list::singleton<Subscription>(candidate)))
    => true
}

test subscription.replace-step/keeps-later-duplicate {
    let earlier = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "earlier",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let candidate = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "later duplicate",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let replacement = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "replacement",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let initial = subscriptionReplacementState::new(
        target-id = candidate.id(),
        replacement = replacement,
        output = list::singleton<Subscription>(earlier),
        replaced = true);
    let updated = subscription::replace-step(initial, candidate);
    bool::and(
        updated.replaced(),
        equals(updated.output(), list::append(list::singleton<Subscription>(earlier), candidate)))
    => true
}

test subscription.replace-step/preserves-cancelled-replacement-time {
    let cancelled-at = Instant::new("2026-01-02T12:00:00.0000000+00:00");
    let candidate = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "candidate",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let replacement = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "cancelled replacement",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("cancelled"),
        cancelled-at = option::some<Instant>(cancelled-at));
    let initial = subscriptionReplacementState::new(
        target-id = replacement.id(),
        replacement = replacement,
        output = list::empty<Subscription>(),
        replaced = false);
    let updated = subscription::replace-step(initial, candidate);
    equals(updated.replacement().cancelled-at(), option::some<Instant>(cancelled-at))
    => true
}

test subscription.replace-list/empty-fold {
    let replacement = subscription::new(
        id = SubscriptionId::new("50000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
