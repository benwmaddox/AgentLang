# A tiny customer vocabulary for demonstrating the AgentLang workflow.
record Customer
    field kind String
    field balance Float
end

word customer.premium? : Customer -> Bool
    effects none
    doc "Whether this customer has premium status."
    let customer
    $customer customer.kind
    "premium"
    equals
end

word customer.discounted-balance : Customer -> Float
    effects none
    doc "Apply a 10% discount to premium customers."
    let customer
    $customer customer.balance
    $customer customer.premium?
    if
        0.9 float.multiply
    else
    end
end

test customer.premium?/premium
    "premium" 100.0 customer.new customer.premium?
    => true
end

test customer.premium?/regular
    "regular" 100.0 customer.new customer.premium?
    => false
end

test customer.discounted-balance/premium
    "premium" 100.0 customer.new customer.discounted-balance
    => 90.0
end

test customer.discounted-balance/regular
    "regular" 100.0 customer.new customer.discounted-balance
    => 100.0
end

example customer.discounted-balance/premium
    "premium" 100.0 customer.new customer.discounted-balance
    => 90.0
end
