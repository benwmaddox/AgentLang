enum RenewalState {
    case pending
    case renewed
    case cancelled
}

fn renewal.echo(value: RenewalState) -> RenewalState {
    value
}

fn renewal.describe(state: RenewalState) -> String {
    match renewal.echo(state) {
        pending => {
            renewal.echo(RenewalState.pending())
            "Pending"
        }
        renewed => {
            renewal.echo(RenewalState.renewed())
            "Renewed"
        }
        cancelled => {
            renewal.echo(RenewalState.cancelled())
            "Cancelled"
        }
    }
}

test renewal.echo/pending {
    renewal.echo(RenewalState.pending())
    => value RenewalState.pending()
}

test renewal.describe/pending {
    renewal.describe(RenewalState.pending())
    => "Pending"
}

test renewal.describe/renewed {
    renewal.describe(RenewalState.renewed())
    => "Renewed"
}

test renewal.describe/cancelled {
    renewal.describe(RenewalState.cancelled())
    => "Cancelled"
}
