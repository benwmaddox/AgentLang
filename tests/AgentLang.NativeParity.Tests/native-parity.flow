type Label : String {
}

fn native.parity.member?(name: String) -> Bool {
    let tags = ["a", "abbr", "b", "blockquote", "br", "code", "div", "em", "h1", "p", "pre", "span", "strong", "é", "🚀"]
    var found = false
    for tag in tags {
        if tag == name {
            found = true
            break
        }
    }
    found
}

fn native.parity.literal-sum(extra: Int) -> Int {
    var total = 0
    for value in [1, -2, 300, 9223372036854775000, -9223372036854775000, 4] {
        total = total + value
    }
    total + extra
}

fn native.parity.literal-grow(extra: String) -> String {
    doc "Appends to a fresh literal list, so an in-place append must never reach the shared image."
    var items = ["x", "yy"]
    items = list.append(items, extra)
    items = list.append(items, extra)
    string.join(items)
}

fn native.parity.literal-join(extra: String) -> String {
    string.concat(string.join(["<", "b", ">"]), extra)
}

test native.parity.member?/yes {
    native.parity.member?("em")
}

test native.parity.literal-sum/zero {
    expect native.parity.literal-sum(0) == 303
}

test native.parity.literal-grow/twice {
    expect native.parity.literal-grow("z") == "xyyzz"
}

test native.parity.literal-join/text {
    expect native.parity.literal-join("!") == "<b>!"
}

fn native.parity.same?(a: String, b: String) -> Bool {
    a == b
}

fn native.parity.same-bytes?(a: String, b: String) -> Bool {
    bytes.from-utf8(a) == bytes.from-utf8(b)
}

fn native.parity.same-label?(a: String, b: String) -> Bool {
    Label.new(a) == Label.new(b)
}

test native.parity.same?/yes {
    native.parity.same?("abc", "abc")
}

test native.parity.same-bytes?/no {
    expect bool.not(native.parity.same-bytes?("abc", "abd"))
}

test native.parity.same-label?/yes {
    native.parity.same-label?("x", "x")
}

fn native.parity.abs(n: Int) -> Int {
    int.abs(n)
}

fn native.parity.min(a: Int, b: Int) -> Int {
    int.min(a, b)
}

fn native.parity.max(a: Int, b: Int) -> Int {
    int.max(a, b)
}

fn native.parity.empty?(items: List<String>) -> Bool {
    list.is-empty?(items)
}

fn native.parity.trim(text: String) -> String {
    string.trim(text)
}

test native.parity.abs/negative {
    expect native.parity.abs(-4) == 4
}

test native.parity.min/order {
    expect native.parity.min(3, -2) == -2
}

test native.parity.max/order {
    expect native.parity.max(3, -2) == 3
}

test native.parity.empty?/one {
    expect bool.not(native.parity.empty?(["a"]))
}

test native.parity.trim/spaces {
    expect native.parity.trim("  a b  ") == "a b"
}

fn native.parity.next-in(text: String, set: String, from: Int) -> Int {
    string.next-byte-in(text, set, from)
}

test native.parity.next-in/first {
    expect native.parity.next-in("ab<c&", "<&", 0) == 2
    expect native.parity.next-in("abc", "<", 1) == 3
}

fn native.parity.next-not-in(text: String, set: String, from: Int) -> Int {
    string.next-byte-not-in(text, set, from)
}

test native.parity.next-not-in/run {
    expect native.parity.next-not-in("  x", " ", 0) == 2
    expect native.parity.next-not-in("aaa", "a", -4) == 3
}
