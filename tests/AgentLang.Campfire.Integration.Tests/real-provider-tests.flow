test-file campfire-real-room-pages {
    test campfire.rooms.list-for-user/real-member-page {
        campfire.rooms.list-for-user(UserId.new(1), option.none<RoomId>(), 10)
        => value result.ok<List<RoomRow>, DbError>(list.singleton<RoomRow>(roomRow.new(
            id = RoomId.new(1),
            name = option.some<String>("Room 1"),
            kind = RoomKind.open(),
            creator-id = UserId.new(1),
            created-at-ms = 1577836800000,
            updated-at-ms = 1577836800000,
            created-at = "2020-01-01 00:00:00",
            creator-name = "",
            creator-bio = "",
            creator-updated-at = "",
            creator-avatar-token = ""
        ))) effects {
            db.read: 1
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.rooms.list-for-user/real-invalid-page-size {
        campfire.rooms.list-for-user(UserId.new(1), option.none<RoomId>(), 0)
        => value result.error<List<RoomRow>, DbError>(DbError.invalid-input()) effects {
            db.read: 1
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.rooms.list-for-user/real-missing-user {
        campfire.rooms.list-for-user(UserId.new(777), option.none<RoomId>(), 10)
        => value result.error<List<RoomRow>, DbError>(DbError.not-found()) effects {
            db.read: 1
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}

test-file campfire-real-message-pages {
    test campfire.messages.page-for-member/real-member-page {
        campfire.messages.page-for-member(UserId.new(1), RoomId.new(1))
        => value result.ok<List<MessageWithCreator>, RoomMessageError>(list.singleton<MessageWithCreator>(messageWithCreator.new(
            id = MessageId.new(100),
            room-id = RoomId.new(1),
            creator-id = UserId.new(1),
            client-message-id = "fixture-message",
            body = option.some<String>("fixture body"),
            created-at-ms = 1577836800000,
            updated-at-ms = 1577836800000,
            created-at = "2020-01-01 00:00:00",
            creator-name = "",
            creator-bio = "",
            creator-updated-at = "",
            creator-avatar-token = ""
        ))) effects {
            db.read: 2
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.messages.page-for-member/real-non-member-denied {
        campfire.messages.page-for-member(UserId.new(2), RoomId.new(1))
        => value result.error<List<MessageWithCreator>, RoomMessageError>(RoomMessageError.access-denied()) effects {
            db.read: 1
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.messages.page-for-member/real-orphan-membership-room-missing {
        campfire.messages.page-for-member(UserId.new(9), RoomId.new(99))
        => value result.error<List<MessageWithCreator>, RoomMessageError>(RoomMessageError.database-not-found()) effects {
            db.read: 2
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }
}

test-file campfire-real-message-create {
    test campfire.messages.create-for-member/real-member-create {
        campfire.messages.create-for-member(UserId.new(1), RoomId.new(1), option.none<String>(), option.none<String>())
        => value result.ok<MessageRow, RoomMessageError>(messageRow.new(
            id = MessageId.new(101),
            room-id = RoomId.new(1),
            creator-id = UserId.new(1),
            client-message-id = "12345678-90ab-cdef-1234-567890abcdef",
            body = option.none<String>(),
            created-at = "2025-01-01 00:00:00",
            updated-at = "2025-01-01 00:00:00"
        )) effects {
            db.read: 1
            db.write: 1
            clock.read: 1
            random.read: 1
        }
    }

    test campfire.messages.create-for-member/real-supplied-empty-client-id {
        campfire.messages.create-for-member(UserId.new(1), RoomId.new(1), option.some<String>(""), option.none<String>())
        => value result.ok<MessageRow, RoomMessageError>(messageRow.new(
            id = MessageId.new(101),
            room-id = RoomId.new(1),
            creator-id = UserId.new(1),
            client-message-id = "",
            body = option.none<String>(),
            created-at = "2025-01-01 00:00:00",
            updated-at = "2025-01-01 00:00:00"
        )) effects {
            db.read: 1
            db.write: 1
            clock.read: 1
            random.read: 1
        }
    }

    test campfire.messages.create-for-member/real-non-member-does-not-create {
        campfire.messages.create-for-member(UserId.new(2), RoomId.new(1), option.none<String>(), option.none<String>())
        => value result.error<MessageRow, RoomMessageError>(RoomMessageError.access-denied()) effects {
            db.read: 1
            db.write: 0
            clock.read: 0
            random.read: 0
        }
    }

    test campfire.messages.create-for-member/real-body-failure-rolls-back {
        campfire.messages.create-for-member(UserId.new(1), RoomId.new(1), option.some<String>("real-abort-create"), option.some<String>("abort-after-insert"))
        => value result.error<MessageRow, RoomMessageError>(RoomMessageError.database-unavailable()) effects {
            db.read: 1
            db.write: 1
            clock.read: 1
            random.read: 1
        }
    }

    test campfire.messages.create-for-member/real-unique-conflict-rolls-back {
        campfire.messages.create-for-member(UserId.new(1), RoomId.new(1), option.some<String>("real-unique-create"), option.some<String>("unique-conflict-body"))
        => value result.error<MessageRow, RoomMessageError>(RoomMessageError.database-constraint-conflict()) effects {
            db.read: 1
            db.write: 1
            clock.read: 1
            random.read: 1
        }
    }
}
