<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\campfire_user_agents.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\MIT-LICENSE.37signals" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentLang.Core\AgentLang.Core.fsproj" />
    <ProjectReference Include="..\..\src\AgentLang.Llvm\AgentLang.Llvm.fsproj" />
  </ItemGroup>
</Project>
