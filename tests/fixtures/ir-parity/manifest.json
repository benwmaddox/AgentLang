    {
      "name": "nominal-record-and-refinement-contracts",
      "sessions": [
        {
          "name": "typed-values-and-mismatch",
          "requests": [
            {
              "request": { "op": "define", "sourceFile": "nominal.agent" },
              "expect": { "subset": { "ok": true, "kind": "defined" } }
            },
            {
              "request": { "op": "test", "word": "parity.email-valid?" },
              "expect": {
                "subset": {
                  "ok": true,
                  "data": {
                    "results": [
                      { "name": "missing-at", "word": "parity.email-valid?", "passed": true, "actual": ["false"] },
                      { "name": "valid", "word": "parity.email-valid?", "passed": true, "actual": ["true"] }
                    ]
                  }
                }
              }
            },
            {
              "request": { "op": "eval", "code": "\"ada@example.test\" Email.new" },
              "expect": {
                "subset": { "ok": true, "data": { "stack": ["Email(\"ada@example.test\")"], "stackTypes": ["Email"] } },
                "exact": [ { "path": "data.effects", "value": {} } ]
              }
            },
            {
              "request": { "op": "eval", "code": "\"invalid\" Email.new" },
              "expect": {
                "subset": {
                  "ok": false,
                  "error": {
                    "code": "REFINEMENT_FAILED",
                    "word": "Email.new",
                    "expected": ["validator returns true"],
                    "actual": ["false"],
                    "span": { "file": "<generated>", "line": 1, "column": 1, "length": 9 }
                  }
                }
              }
            },
            {
              "request": { "op": "eval", "code": "3.5 MetersPerSecond.new \"north\" motion.new motion.speed" },
              "expect": {
                "subset": { "ok": true, "data": { "stack": ["MetersPerSecond(3.5)"], "stackTypes": ["MetersPerSecond"] } }
              }
            },
            {
              "request": { "op": "eval", "code": "4.0 KilometersPerHour.new parity.accept-speed" },
              "expect": {
                "subset": {
                  "ok": false,
                  "error": {
                    "code": "TYPE_STACK_MISMATCH",
                    "word": "parity.accept-speed",
                    "expected": ["MetersPerSecond"],
                    "actual": ["KilometersPerHour"],
                    "span": { "file": "<eval>", "line": 1, "column": 27, "length": 19 }
                  }
                }
              }
            }
          ]
        }
      ]
