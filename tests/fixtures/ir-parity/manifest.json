{
  "schemaVersion": 1,
  "fixtures": [
    {
      "name": "numeric-and-error-contracts",
      "sessions": [
        {
          "name": "numeric-cases",
          "requests": [
            {
              "request": { "op": "eval", "code": "2 3 add" },
              "expect": {
                "subset": {
                  "ok": true,
                  "kind": "eval",
                  "data": { "stack": ["5"], "stackTypes": ["Int"] }
                },
                "exact": [ { "path": "data.effects", "value": {} } ]
              }
            },
            {
              "request": { "op": "eval", "code": "9223372036854775807 1 add" },
              "expect": {
                "subset": {
                  "ok": false,
                  "kind": "error",
                  "error": {
                    "code": "RUNTIME_OVERFLOW",
                    "word": "add",
                    "actual": ["9223372036854775807", "1"]
                  }
                }
              }
            },
            {
              "request": { "op": "eval", "code": "1 0 divide" },
              "expect": {
                "subset": {
                  "ok": false,
                  "kind": "error",
                  "error": {
                    "code": "RUNTIME_DIVIDE_BY_ZERO",
                    "word": "divide",
                    "expected": [],
                    "actual": []
                  }
                }
              }
            },
            {
              "request": { "op": "eval", "code": "1e308 1e308 float.multiply" },
              "expect": {
                "subset": {
                  "ok": false,
                  "kind": "error",
                  "error": {
                    "code": "RUNTIME_NONFINITE_FLOAT",
                    "word": "float.multiply",
                    "expected": ["finite Float"],
                    "actual": ["Infinity"]
                  }
                }
              }
            },
            {
              "request": { "op": "define", "sourceFile": "numeric.agent" },
              "expect": { "subset": { "ok": true, "kind": "defined" } }
            },
            {
              "request": { "op": "test", "word": "parity.divide" },
              "expect": {
                "subset": {
                  "ok": true,
                  "kind": "test",
                  "data": {
                    "results": [
                      {
                        "name": "exact-error",
                        "word": "parity.divide",
                        "passed": true,
                        "expectedErrorCode": "RUNTIME_DIVIDE_BY_ZERO",
                        "actual": []
                      },
                      {
                        "name": "wrong-error-code",
                        "word": "parity.divide",
                        "passed": false,
                        "expectedErrorCode": "RUNTIME_OVERFLOW",
                        "errorCode": "RUNTIME_DIVIDE_BY_ZERO",
                        "actual": []
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
