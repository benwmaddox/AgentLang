word parity.coverage-positive? : Int -> Bool
    effects none
    0 int.greater-than
end

test parity.coverage-positive?/basic
    1 parity.coverage-positive?
    => true
end

word parity.library-filter-count : List<Int> -> Int
    effects none
    list.filter parity.coverage-positive?
    list.count
end

test parity.library-filter-count/a-empty
    list.empty<Int> parity.library-filter-count
    => 0
end
