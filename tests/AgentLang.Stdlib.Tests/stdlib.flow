// Standard library slice 1: Bytes, base64, hex, crypto and byte-offset string
// primitives. Bytes have no literal; tests compare through hex or base64.

fn stdlib.hex-of-text(text: String) -> String {
    hex.encode(bytes.from-utf8(text))
}

test stdlib.hex-of-text/mixed {
    stdlib.hex-of-text("aé🚀")
    => value "61c3a9f09f9a80"
}

fn stdlib.text-of-base64(text: String) -> String {
    match base64.decode(text) {
        none => "<invalid base64>"
        some data => match bytes.to-utf8(data) {
            none => "<invalid utf8>"
            some decoded => decoded
        }
    }
}

test stdlib.text-of-base64/round-trip {
    stdlib.text-of-base64(base64.encode(bytes.from-utf8("hello, wörld")))
    => value "hello, wörld"
}

test stdlib.text-of-base64/invalid {
    stdlib.text-of-base64("@@@")
    => value "<invalid base64>"
}

test stdlib.text-of-base64/invalid-utf8 {
    stdlib.text-of-base64("/w==")
    => value "<invalid utf8>"
}

fn stdlib.url-base64-of-text(text: String) -> String {
    base64.url-encode(bytes.from-utf8(text))
}

test stdlib.url-base64-of-text/unpadded {
    stdlib.url-base64-of-text("??>")
    => value "Pz8-"
}

fn stdlib.hex-of-url-base64(text: String) -> String {
    match base64.url-decode(text) {
        none => "<invalid>"
        some data => hex.encode(data)
    }
}

test stdlib.hex-of-url-base64/csrf-session {
    stdlib.hex-of-url-base64("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k")
    => value "a8adf3bfb710da86253f8fac5fa26d5b49c17fd791d6e1da31d2e0139895cbc9"
}

test stdlib.hex-of-url-base64/rejects-standard-alphabet {
    stdlib.hex-of-url-base64("Pz8+")
    => value "<invalid>"
}

fn stdlib.sha256-hex(text: String) -> String {
    hex.encode(crypto.sha256(bytes.from-utf8(text)))
}

test stdlib.sha256-hex/abc {
    stdlib.sha256-hex("abc")
    => value "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
}

fn stdlib.hmac-hex(key: String, message: String) -> String {
    hex.encode(crypto.hmac-sha256(bytes.from-utf8(key), bytes.from-utf8(message)))
}

test stdlib.hmac-hex/fox {
    stdlib.hmac-hex("key", "The quick brown fox jumps over the lazy dog")
    => value "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
}

// Rails: global_csrf_token = HMAC-SHA256(real session token, "!real_csrf_token").
fn stdlib.rails-csrf-hmac-hex(session-token: String, identifier: String) -> String {
    match base64.url-decode(session-token) {
        none => "<invalid>"
        some secret => hex.encode(crypto.hmac-sha256(secret, bytes.from-utf8(identifier)))
    }
}

test stdlib.rails-csrf-hmac-hex/global {
    stdlib.rails-csrf-hmac-hex("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "!real_csrf_token")
    => value "6ec0767be83c2cd5b35a59da9e04dc63995d1884b214289561b6d7528cd85d37"
}

test stdlib.rails-csrf-hmac-hex/form {
    stdlib.rails-csrf-hmac-hex("qK3zv7cQ2oYlP4-sX6JtW0nBf9eR1uHaMdLgE5iVy8k", "/rooms/1/messages#post")
    => value "c619633b83b27a77ba076ca7df0d6fbbcf92c7ac28d070244f7aed5f26fefa9a"
}

fn stdlib.pbkdf2-hex(password: String, salt: String, iterations: Int, length: Int) -> String {
    match crypto.pbkdf2-sha256(bytes.from-utf8(password), bytes.from-utf8(salt), iterations, length) {
        none => "<invalid>"
        some key => hex.encode(key)
    }
}

test stdlib.pbkdf2-hex/rfc-style {
    stdlib.pbkdf2-hex("password", "salt", 1, 32)
    => value "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b"
}

test stdlib.pbkdf2-hex/signed-id-key {
    stdlib.pbkdf2-hex("secret", "active_record/signed_id", 1000, 64)
    => value "d03d10936c20e70291800f31fbf41ff925926c3568f5449e6e17ec74fad0497696fcebb6aa1f88fd866f0b6cee49cd23cbcc5afdaecb60f643f05b1bcbe1f13f"
}

test stdlib.pbkdf2-hex/zero-iterations {
    stdlib.pbkdf2-hex("password", "salt", 0, 32)
    => value "<invalid>"
}

fn stdlib.xor-hex(left: String, right: String) -> String {
    match bytes.xor(bytes.from-utf8(left), bytes.from-utf8(right)) {
        none => "<length mismatch>"
        some data => hex.encode(data)
    }
}

test stdlib.xor-hex/same-length {
    stdlib.xor-hex("ab", "AB")
    => value "2020"
}

test stdlib.xor-hex/mismatch {
    stdlib.xor-hex("ab", "A")
    => value "<length mismatch>"
}

fn stdlib.equal-text?(left: String, right: String) -> Bool {
    bytes.equal-constant-time?(bytes.from-utf8(left), bytes.from-utf8(right))
}

test stdlib.equal-text?/same {
    stdlib.equal-text?("token", "token")
    => value true
}

test stdlib.equal-text?/different-length {
    stdlib.equal-text?("token", "toke")
    => value false
}

fn stdlib.middle-hex(text: String, start: Int, count: Int) -> String {
    match bytes.slice(bytes.concat(bytes.from-utf8(text), bytes.from-utf8("!")), start, count) {
        none => "<out of range>"
        some data => hex.encode(data)
    }
}

test stdlib.middle-hex/in-range {
    stdlib.middle-hex("abc", 1, 3)
    => value "626321"
}

test stdlib.middle-hex/out-of-range {
    stdlib.middle-hex("abc", 2, 3)
    => value "<out of range>"
}

fn stdlib.byte-count(text: String) -> Int {
    bytes.length(bytes.from-utf8(text))
}

test stdlib.byte-count/rocket {
    stdlib.byte-count("🚀")
    => value 4
}

fn stdlib.split(text: String, separator: String) -> List<String> {
    string.split(text, separator)
}

test stdlib.split/semicolons {
    stdlib.split("a; b;; c", ";")
    => value ["a", " b", "", " c"]
}

test stdlib.split/empty-separator {
    stdlib.split("abc", "")
    => value ["abc"]
}

test stdlib.split/multibyte {
    stdlib.split("é🚀é", "🚀")
    => value ["é", "é"]
}

fn stdlib.index-of(text: String, needle: String, start: Int) -> Int {
    match string.index-of(text, needle, start) {
        none => -1
        some index => index
    }
}

test stdlib.index-of/byte-offset {
    stdlib.index-of("é=é=", "=", 3)
    => value 5
}

test stdlib.index-of/missing {
    stdlib.index-of("abc", "z", 0)
    => value -1
}

fn stdlib.slice(text: String, start: Int, count: Int) -> String {
    match string.slice(text, start, count) {
        none => "<invalid>"
        some piece => piece
    }
}

test stdlib.slice/ascii {
    stdlib.slice("Mozilla/5.0", 8, 3)
    => value "5.0"
}

test stdlib.slice/splits-character {
    stdlib.slice("é", 1, 1)
    => value "<invalid>"
}

fn stdlib.byte-at(text: String, index: Int) -> Int {
    match string.byte-at(text, index) {
        none => -1
        some value => value
    }
}

test stdlib.byte-at/second {
    stdlib.byte-at("é", 1)
    => value 169
}

fn stdlib.parse(text: String) -> Int {
    match int.parse(text) {
        none => -999
        some value => value
    }
}

test stdlib.parse/digits {
    stdlib.parse("120")
    => value 120
}

test stdlib.parse/negative {
    stdlib.parse("-7")
    => value -7
}

test stdlib.parse/rejects-plus {
    stdlib.parse("+7")
    => value -999
}

test stdlib.parse/rejects-space {
    stdlib.parse(" 7")
    => value -999
}

test stdlib.sha256-hex/fifty-five {
    stdlib.sha256-hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    => value "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"
}

test stdlib.sha256-hex/fifty-six {
    stdlib.sha256-hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    => value "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"
}

test stdlib.sha256-hex/sixty-four {
    stdlib.sha256-hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    => value "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"
}

test stdlib.sha256-hex/multi-block {
    stdlib.sha256-hex("The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ")
    => value "dc985401a68faff03051c78bbf32bb2fd27ba216b0dba19b050b936d534b8ba9"
}

test stdlib.sha256-hex/empty {
    stdlib.sha256-hex("")
    => value "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

fn stdlib.hmac-base64-key-hex(key: String, message: String) -> String {
    match base64.decode(key) {
        none => "<invalid key>"
        some secret => hex.encode(crypto.hmac-sha256(secret, bytes.from-utf8(message)))
    }
}

// RFC 4231 test case 6: a 131-byte key is hashed first.
test stdlib.hmac-base64-key-hex/rfc4231-case-6 {
    stdlib.hmac-base64-key-hex("qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=", "Test Using Larger Than Block-Size Key - Hash Key First")
    => value "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
}

test stdlib.hmac-hex/multi-block-message {
    stdlib.hmac-hex("key", "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. ")
    => value "2f8ca7df83835c055c91ce10df2df6bd70e0296862fce2ed9d233e3b5b9a3645"
}

test stdlib.pbkdf2-hex/two-blocks {
    stdlib.pbkdf2-hex("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40)
    => value "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9"
}

fn stdlib.base64-hex(text: String) -> String {
    match base64.decode(text) {
        none => "<invalid>"
        some data => hex.encode(data)
    }
}

test stdlib.base64-hex/padded {
    stdlib.base64-hex("Pz8+")
    => value "3f3f3e"
}

test stdlib.base64-hex/one-pad {
    stdlib.base64-hex("Pz8=")
    => value "3f3f"
}

test stdlib.base64-hex/two-pads {
    stdlib.base64-hex("Pw==")
    => value "3f"
}

test stdlib.base64-hex/empty {
    stdlib.base64-hex("")
    => value ""
}

test stdlib.base64-hex/missing-padding {
    stdlib.base64-hex("Pz8")
    => value "<invalid>"
}

test stdlib.base64-hex/non-canonical-tail {
    stdlib.base64-hex("Pz9=")
    => value "<invalid>"
}

test stdlib.base64-hex/whitespace {
    stdlib.base64-hex("Pz8+ Pz8+")
    => value "<invalid>"
}

test stdlib.base64-hex/newline {
    stdlib.base64-hex("Pz8+\nPz8+")
    => value "<invalid>"
}

test stdlib.base64-hex/url-alphabet {
    stdlib.base64-hex("Pz8-")
    => value "<invalid>"
}

test stdlib.base64-hex/extra-padding {
    stdlib.base64-hex("Pz8+====")
    => value "<invalid>"
}

test stdlib.base64-hex/inner-padding {
    stdlib.base64-hex("Pz=+")
    => value "<invalid>"
}

test stdlib.hex-of-url-base64/padded-accepted {
    stdlib.hex-of-url-base64("Pz8=")
    => value "3f3f"
}

test stdlib.hex-of-url-base64/wrong-padding {
    stdlib.hex-of-url-base64("Pz8==")
    => value "<invalid>"
}

test stdlib.hex-of-url-base64/one-char-remainder {
    stdlib.hex-of-url-base64("Pz8-P")
    => value "<invalid>"
}

test stdlib.hex-of-url-base64/non-canonical-tail {
    stdlib.hex-of-url-base64("Pz9")
    => value "<invalid>"
}

test stdlib.index-of/empty-needle {
    stdlib.index-of("abc", "", 2)
    => value 2
}

test stdlib.index-of/start-past-end {
    stdlib.index-of("abc", "", 4)
    => value -1
}

test stdlib.split/empty-text {
    stdlib.split("", ",")
    => value [""]
}

test stdlib.split/trailing-separator {
    stdlib.split("a,", ",")
    => value ["a", ""]
}

test stdlib.slice/end-boundary {
    stdlib.slice("aé", 1, 2)
    => value "é"
}

test stdlib.slice/count-past-end {
    stdlib.slice("abc", 1, 3)
    => value "<invalid>"
}

test stdlib.byte-at/past-end {
    stdlib.byte-at("a", 1)
    => value -1
}

test stdlib.parse/empty {
    stdlib.parse("")
    => value -999
}

test stdlib.parse/minus-only {
    stdlib.parse("-")
    => value -999
}

test stdlib.parse/overflow {
    stdlib.parse("9223372036854775808")
    => value -999
}

test stdlib.parse/min-int {
    stdlib.parse("-9223372036854775808")
    => value -9223372036854775808
}

test stdlib.parse/leading-zero {
    stdlib.parse("007")
    => value 7
}

fn stdlib.lower(text: String) -> String {
    string.to-lower-ascii(text)
}

test stdlib.lower/mixed {
    stdlib.lower("Mozilla/5.0 (Windows NT; Win64) ÉCOLE")
    => value "mozilla/5.0 (windows nt; win64) École"
}

test stdlib.lower/empty {
    stdlib.lower("")
    => value ""
}

fn stdlib.random-length(count: Int) -> Int {
    effects random.read
    bytes.length(crypto.random-bytes(count))
}

test stdlib.random-length/thirty-two {
    stdlib.random-length(32)
    => value 32
}

test stdlib.random-length/zero {
    stdlib.random-length(0)
    => value 0
}

fn stdlib.random-differs?(count: Int) -> Bool {
    effects random.read
    let first = crypto.random-bytes(count)
    let second = crypto.random-bytes(count)
    bool.not(bytes.equal-constant-time?(first, second))
}

test stdlib.random-differs?/thirty-two {
    stdlib.random-differs?(32)
    => value true
}

// Spaced C-like infix operators (lowered to the Int primitives; % is int.remainder).
fn stdlib.op-remainder(a: Int, b: Int) -> Int {
    a % b
}

test stdlib.op-remainder/positive {
    stdlib.op-remainder(7, 3)
    => value 1
}

test stdlib.op-remainder/negative-dividend {
    stdlib.op-remainder(-7, 3)
    => value -1
}

test stdlib.op-remainder/negative-divisor {
    stdlib.op-remainder(7, -3)
    => value 1
}

test stdlib.op-remainder/min-by-negative-one {
    stdlib.op-remainder(-9223372036854775808, -1)
    => value 0
}

fn stdlib.op-arithmetic(a: Int, b: Int) -> Int {
    (a + b) * 2 - a / b + a % b * 10
}

test stdlib.op-arithmetic/mixed {
    stdlib.op-arithmetic(17, 5)
    => value 61
}

test stdlib.op-arithmetic/negative {
    stdlib.op-arithmetic(-17, 5)
    => value -41
}

fn stdlib.op-logic(a: Int, b: Int) -> Bool {
    b != 0 && a / b > 2 || a <= -10
}

test stdlib.op-logic/divides {
    stdlib.op-logic(9, 2)
    => value true
}

test stdlib.op-logic/zero-divisor-short-circuits {
    stdlib.op-logic(9, 0)
    => value false
}

test stdlib.op-logic/negative {
    stdlib.op-logic(-12, 0)
    => value true
}

test stdlib.op-logic/small {
    stdlib.op-logic(5, 3)
    => value false
}

// Loops (report 272): counted ranges, list loops, var locals, break/continue.

fn stdlib.range-sum(start: Int, finish: Int) -> Int {
    var total = 0
    for i in start..finish {
        total = total + i
    }
    total
}

test stdlib.range-sum/ten {
    stdlib.range-sum(0, 10)
    => value 45
}

test stdlib.range-sum/empty {
    stdlib.range-sum(5, 2)
    => value 0
}

test stdlib.range-sum/negative {
    stdlib.range-sum(-3, 3)
    => value -3
}

test stdlib.range-sum/loop-in-test {
    var total = 0
    for i in 1..4 {
        total = total + stdlib.range-sum(0, i)
    }
    expect total == 4
}

fn stdlib.count-byte(text: String, target: Int) -> Int {
    var count = 0
    for i in 0..string.byte-length(text) {
        let byte = match string.byte-at(text, i) {
            none => -1
            some value => value
        }
        if byte == target {
            count = count + 1
        }
    }
    count
}

test stdlib.count-byte/spaces {
    stdlib.count-byte("a b  c ", 32)
    => value 4
}

test stdlib.count-byte/utf8-continuation {
    stdlib.count-byte("éé", 169)
    => value 2
}

test stdlib.count-byte/empty {
    stdlib.count-byte("", 32)
    => value 0
}

fn stdlib.first-byte-index(text: String, target: Int) -> Int {
    var found = -1
    for i in 0..string.byte-length(text) {
        if stdlib.byte-at(text, i) == target {
            found = i
            break
        }
    }
    found
}

test stdlib.first-byte-index/found {
    stdlib.first-byte-index("key=value=x", 61)
    => value 3
}

test stdlib.first-byte-index/missing {
    stdlib.first-byte-index("key", 61)
    => value -1
}

fn stdlib.repeat(text: String, count: Int) -> String {
    var result = ""
    for i in 0..count {
        result = string.concat(result, text)
    }
    result
}

test stdlib.repeat/three {
    stdlib.repeat("ab", 3)
    => value "ababab"
}

test stdlib.repeat/zero {
    stdlib.repeat("ab", 0)
    => value ""
}

fn stdlib.number-fields(text: String) -> String {
    var result = ""
    for field, index in string.split(text, ",") {
        if field == "" {
            continue
        }
        if index > 0 {
            result = string.concat(result, ";")
        }
        result = string.concat(result, string.concat(int.to-string(index), string.concat(":", field)))
    }
    result
}

test stdlib.number-fields/three {
    stdlib.number-fields("a,b,c")
    => value "0:a;1:b;2:c"
}

test stdlib.number-fields/skip-empty {
    stdlib.number-fields("a,,c")
    => value "0:a;2:c"
}

fn stdlib.digit-sum(text: String) -> Int {
    var total = 0
    var digits = 0
    for i in 0..string.byte-length(text) {
        let byte = stdlib.byte-at(text, i)
        if byte < 48 || byte > 57 {
            continue
        }
        total = total + byte - 48
        digits = digits + 1
        if digits == 4 {
            break
        }
    }
    total
}

test stdlib.digit-sum/stops-after-four {
    stdlib.digit-sum("a1b2c3d4e5")
    => value 10
}

test stdlib.digit-sum/none {
    stdlib.digit-sum("abc")
    => value 0
}

fn stdlib.byte-or(text: String, index: Int) -> Int {
    string.byte-at-or(text, index, -1)
}

test stdlib.byte-or/inside {
    stdlib.byte-or("é", 1)
    => value 169
}

test stdlib.byte-or/past-end {
    stdlib.byte-or("a", 1)
    => value -1
}

test stdlib.byte-or/negative {
    stdlib.byte-or("a", -1)
    => value -1
}

test stdlib.byte-or/empty {
    stdlib.byte-or("", 0)
    => value -1
}
