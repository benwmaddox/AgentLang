// Standard library slice 2 (report 274): HMAC-SHA1, AES-256-GCM, JSON,
// cookies and time. Every key and secret here is synthetic.

fn stdlib.hmac-sha1-hex(key: String, message: String) -> String {
    hex.encode(crypto.hmac-sha1(bytes.from-utf8(key), bytes.from-utf8(message)))
}

test stdlib.hmac-sha1-hex/fox {
    stdlib.hmac-sha1-hex("key", "The quick brown fox jumps over the lazy dog")
    => value "de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9"
}

test stdlib.hmac-sha1-hex/empty {
    stdlib.hmac-sha1-hex("", "")
    => value "fbdb1d1b18aa6c08324b7d64b71fb76370690e1d"
}

test stdlib.hmac-sha1-hex/long-key {
    stdlib.hmac-sha1-hex("0123456789012345678901234567890123456789012345678901234567890123456789", "message")
    => value "3a1ed3050e3c10cda0464646eedca9d2c59c2332"
}
