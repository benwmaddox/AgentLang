// ------------------------------------------------------------------- JSON

fn stdlib.json-valid?(text: String) -> Bool {
    match json.parse(text) {
        none => false
        some _ => true
    }
}

test stdlib.json-valid?/object {
    stdlib.json-valid?(" {\"a\": [1, -2.5e+3, true, false, null, \"x\"], \"b\": {}} ")
    => value true
}

test stdlib.json-valid?/scalar {
    stdlib.json-valid?("-0")
    => value true
}

test stdlib.json-valid?/trailing-comma {
    stdlib.json-valid?("[1,]")
    => value false
}

test stdlib.json-valid?/leading-zero {
    stdlib.json-valid?("01")
    => value false
}

test stdlib.json-valid?/two-values {
    stdlib.json-valid?("1 2")
    => value false
}

test stdlib.json-valid?/empty {
    stdlib.json-valid?("")
    => value false
}

test stdlib.json-valid?/single-quotes {
    stdlib.json-valid?("{'a':1}")
    => value false
}

test stdlib.json-valid?/bad-escape {
    stdlib.json-valid?("\"\\x\"")
    => value false
}

test stdlib.json-valid?/lone-surrogate {
    stdlib.json-valid?("\"\\ud800\"")
    => value false
}

test stdlib.json-valid?/raw-control {
    stdlib.json-valid?("\"a\nb\"")
    => value false
}

test stdlib.json-valid?/bare-fraction {
    stdlib.json-valid?("1.")
    => value false
}

test stdlib.json-valid?/depth-32 {
    stdlib.json-valid?("[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]")
    => value true
}

test stdlib.json-valid?/depth-33 {
    stdlib.json-valid?("[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]")
    => value false
}

fn stdlib.json-text-at(text: String, name: String) -> String {
    match json.parse(text) {
        none => "<invalid>"
        some root => stdlib.json-string-field(root, name)
    }
}

test stdlib.json-text-at/escapes {
    stdlib.json-text-at("{\"a\": \"x\\\"y\\\\z\\/\\n\\u00e9\\ud83d\\ude80\"}", "a")
    => value "x\"y\\z/\né🚀"
}

test stdlib.json-text-at/last-duplicate-wins {
    stdlib.json-text-at("{\"a\": \"first\", \"a\": \"last\"}", "a")
    => value "last"
}

test stdlib.json-text-at/escaped-key {
    stdlib.json-text-at("{\"a\\u0062\": \"found\"}", "ab")
    => value "found"
}

test stdlib.json-text-at/missing {
    stdlib.json-text-at("{\"a\": 1}", "b")
    => value "<missing>"
}

test stdlib.json-text-at/not-text {
    stdlib.json-text-at("{\"a\": 1}", "a")
    => value "<not text>"
}

test stdlib.json-text-at/not-object {
    stdlib.json-text-at("[\"a\"]", "a")
    => value "<missing>"
}

fn stdlib.json-int-at(text: String, name: String) -> String {
    match json.parse(text) {
        none => "<invalid>"
        some root => match json.field(root, name) {
            none => "<missing>"
            some value => match json.int(value) {
                none => "<not int>"
                some number => int.to-string(number)
            }
        }
    }
}

test stdlib.json-int-at/min {
    stdlib.json-int-at("{\"n\": -9223372036854775808}", "n")
    => value "-9223372036854775808"
}

test stdlib.json-int-at/overflow {
    stdlib.json-int-at("{\"n\": 9223372036854775808}", "n")
    => value "<not int>"
}

test stdlib.json-int-at/fraction {
    stdlib.json-int-at("{\"n\": 1.0}", "n")
    => value "<not int>"
}

test stdlib.json-int-at/exponent {
    stdlib.json-int-at("{\"n\": 1e2}", "n")
    => value "<not int>"
}

test stdlib.json-int-at/negative-zero {
    stdlib.json-int-at("{\"n\": -0}", "n")
    => value "0"
}

// Walks a container: count, then each key (objects) and the encoded value.
fn stdlib.json-walk(text: String) -> String {
    match json.parse(text) {
        none => "<invalid>"
        some root => match json.count(root) {
            none => {
                let flag = match json.bool(root) {
                    none => "-"
                    some value => if value { "T" } else { "F" }
                }
                string.concat(json.encode(root), string.concat(" bool=", string.concat(flag, if json.null?(root) { " null" } else { "" })))
            }
            some count => {
                var result = int.to-string(count)
                for index in 0..count {
                    let key = match json.key-at(root, index) {
                        none => "#"
                        some name => name
                    }
                    let value = match json.index(root, index) {
                        none => "?"
                        some item => json.encode(item)
                    }
                    result = string.concat(result, string.concat("|", string.concat(key, string.concat("=", value))))
                }
                result
            }
        }
    }
}

test stdlib.json-walk/object {
    stdlib.json-walk(" { \"a\" : [1, 2] , \"b\\u00e9\":{\"c\":null},\"d\":\"\\u003c\" } ")
    => value "3|a=[1, 2]|bé={\"c\":null}|d=\"\\u003c\""
}

test stdlib.json-walk/array {
    stdlib.json-walk("[true, \"x\", {}]")
    => value "3|#=true|#=\"x\"|#={}"
}

test stdlib.json-walk/empty-object {
    stdlib.json-walk("{}")
    => value "0"
}

test stdlib.json-walk/true {
    stdlib.json-walk(" true ")
    => value "true bool=T"
}

test stdlib.json-walk/null {
    stdlib.json-walk("null")
    => value "null bool=- null"
}

fn stdlib.json-quote(text: String) -> String {
    json.quote(text)
}

test stdlib.json-quote/rails-escapes {
    stdlib.json-quote("a\"b\\c</d>&é/\n\tz")
    => value "\"a\\\"b\\\\c\\u003c/d\\u003e\\u0026é/\\n\\tz\""
}

test stdlib.json-quote/empty {
    stdlib.json-quote("")
    => value "\"\""
}

// ---------------------------------------------------------------- cookies

fn stdlib.cookie-or(header: String, name: String) -> String {
    match cookie.find(header, name) {
        none => "<none>"
        some value => value
    }
}

test stdlib.cookie-or/first-wins {
    stdlib.cookie-or("a=1; b=2; a=3", "a")
    => value "1"
}

test stdlib.cookie-or/trimmed {
    stdlib.cookie-or("x=0;   b=two words  ;c", "b")
    => value "two words"
}

test stdlib.cookie-or/value-with-equals {
    stdlib.cookie-or("t=a=b==", "t")
    => value "a=b=="
}

test stdlib.cookie-or/space-before-equals {
    stdlib.cookie-or("b =2", "b")
    => value "<none>"
}

test stdlib.cookie-or/no-equals {
    stdlib.cookie-or("b", "b")
    => value "<none>"
}

test stdlib.cookie-or/empty-value {
    stdlib.cookie-or("a=; b=1", "a")
    => value ""
}

test stdlib.cookie-or/unicode-space {
    stdlib.cookie-or("　a=1 ;", "a")
    => value "1"
}

fn stdlib.cookie-count(header: String, name: String) -> Int {
    cookie.count(header, name)
}

test stdlib.cookie-count/duplicates {
    stdlib.cookie-count("a=1; b=2; a=3", "a")
    => value 2
}

test stdlib.cookie-count/none {
    stdlib.cookie-count("", "a")
    => value 0
}

fn stdlib.cookie-escape(text: String) -> String {
    cookie.escape(text)
}

test stdlib.cookie-escape/rack {
    stdlib.cookie-escape("a b+c/é~*_-.")
    => value "a+b%2Bc%2F%C3%A9%7E*_-."
}

fn stdlib.cookie-unescape-hex(text: String) -> String {
    hex.encode(bytes.from-utf8(cookie.unescape(text)))
}

test stdlib.cookie-unescape-hex/plus-and-percent {
    stdlib.cookie-unescape-hex("a+b%2Bc%2f%C3%A9")
    => value "6120622b632fc3a9"
}

test stdlib.cookie-unescape-hex/malformed-keeps-value {
    stdlib.cookie-unescape-hex("a+b%zz")
    => value "612b62257a7a"
}

test stdlib.cookie-unescape-hex/truncated-percent {
    stdlib.cookie-unescape-hex("ab%4")
    => value "61622534"
}

test stdlib.cookie-unescape-hex/truncated-utf8 {
    stdlib.cookie-unescape-hex("%E2%82%41")
    => value "efbfbd41"
}

test stdlib.cookie-unescape-hex/overlong {
    stdlib.cookie-unescape-hex("%C0%80")
    => value "efbfbdefbfbd"
}

test stdlib.cookie-unescape-hex/surrogate {
    stdlib.cookie-unescape-hex("%ED%A0%80")
    => value "efbfbdefbfbdefbfbd"
}

test stdlib.cookie-unescape-hex/truncated-four {
    stdlib.cookie-unescape-hex("%F0%9F%9A")
    => value "efbfbd"
}

test stdlib.cookie-unescape-hex/emoji {
    stdlib.cookie-unescape-hex("%F0%9F%9A%80")
    => value "f09f9a80"
}

fn stdlib.set-cookie(name: String, value: String, path: String, expires: String, same-site: String, secure: Bool, http-only: Bool) -> String {
    match cookie.set-cookie(name, value, path, expires, same-site, secure, http-only) {
        none => "<invalid>"
        some header => header
    }
}

test stdlib.set-cookie/session {
    stdlib.set-cookie("_campfire_session", "a+b/c=", "/", "Wed, 14 Oct 2046 12:00:00 GMT", "Lax", false, true)
    => value "_campfire_session=a%2Bb%2Fc%3D; Path=/; SameSite=Lax; Expires=Wed, 14 Oct 2046 12:00:00 GMT; HttpOnly"
}

test stdlib.set-cookie/minimal {
    stdlib.set-cookie("last_room", "4", "", "", "", true, false)
    => value "last_room=4; Secure"
}

test stdlib.set-cookie/bad-name {
    stdlib.set-cookie("a b", "4", "/", "", "", false, false)
    => value "<invalid>"
}

test stdlib.set-cookie/attribute-injection {
    stdlib.set-cookie("a", "4", "/; Domain=evil", "", "", false, false)
    => value "<invalid>"
}

// ------------------------------------------------------------------- time

fn stdlib.time-text(micros: Int) -> String {
    let http = match time.rfc1123(micros) {
        none => "<none>"
        some text => text
    }
    let iso = match time.iso8601-ms(micros) {
        none => "<none>"
        some text => text
    }
    string.concat(http, string.concat(" | ", iso))
}

test stdlib.time-text/now {
    stdlib.time-text(1791979200000000)
    => value "Wed, 14 Oct 2026 12:00:00 GMT | 2026-10-14T12:00:00.000Z"
}

test stdlib.time-text/leap-day-fraction {
    stdlib.time-text(1709188215123456)
    => value "Thu, 29 Feb 2024 06:30:15 GMT | 2024-02-29T06:30:15.123Z"
}

test stdlib.time-text/before-epoch {
    stdlib.time-text(-1)
    => value "Wed, 31 Dec 1969 23:59:59 GMT | 1969-12-31T23:59:59.999Z"
}

test stdlib.time-text/minimum {
    stdlib.time-text(-62135596800000000)
    => value "Mon, 01 Jan 0001 00:00:00 GMT | 0001-01-01T00:00:00.000Z"
}

test stdlib.time-text/maximum {
    stdlib.time-text(253402300799999999)
    => value "Fri, 31 Dec 9999 23:59:59 GMT | 9999-12-31T23:59:59.999Z"
}

test stdlib.time-text/out-of-range {
    stdlib.time-text(253402300800000000)
    => value "<none> | <none>"
}

fn stdlib.add-years-iso(micros: Int, years: Int) -> String {
    match time.add-years(micros, years) {
        none => "<none>"
        some later => match time.iso8601-ms(later) {
            none => "<none>"
            some text => text
        }
    }
}

test stdlib.add-years-iso/twenty {
    stdlib.add-years-iso(1791979200000000, 20)
    => value "2046-10-14T12:00:00.000Z"
}

test stdlib.add-years-iso/leap-day-clamps {
    stdlib.add-years-iso(1709188215123456, 1)
    => value "2025-02-28T06:30:15.123Z"
}

test stdlib.add-years-iso/leap-day-keeps {
    stdlib.add-years-iso(1709188215123456, 4)
    => value "2028-02-29T06:30:15.123Z"
}

test stdlib.add-years-iso/negative {
    stdlib.add-years-iso(1709188215123456, -2024)
    => value "<none>"
}

test stdlib.add-years-iso/too-late {
    stdlib.add-years-iso(1791979200000000, 7974)
    => value "<none>"
}

fn stdlib.parse-iso(text: String) -> String {
    match time.parse-iso8601(text) {
        none => "<none>"
        some micros => int.to-string(micros)
    }
}

test stdlib.parse-iso/rails-exp {
    stdlib.parse-iso("2026-10-14T12:00:00.000Z")
    => value "1791979200000000"
}

test stdlib.parse-iso/offset {
    stdlib.parse-iso("2026-10-14T14:00:00+02:00")
    => value "1791979200000000"
}

test stdlib.parse-iso/negative-offset-lower-z {
    stdlib.parse-iso("2026-10-14t11:30:00.5-00:30")
    => value "1791979200500000"
}

test stdlib.parse-iso/seven-digits-round-up {
    stdlib.parse-iso("2026-10-14T12:00:00.0000001Z")
    => value "1791979200000001"
}

test stdlib.parse-iso/before-epoch-round-up {
    stdlib.parse-iso("1969-12-31T23:59:59.9999999Z")
    => value "0"
}

test stdlib.parse-iso/bad-day {
    stdlib.parse-iso("2026-02-29T00:00:00Z")
    => value "<none>"
}

test stdlib.parse-iso/space-separator {
    stdlib.parse-iso("2026-10-14 12:00:00Z")
    => value "<none>"
}

test stdlib.parse-iso/no-zone {
    stdlib.parse-iso("2026-10-14T12:00:00.000")
    => value "<none>"
}

test stdlib.parse-iso/offset-range {
    stdlib.parse-iso("2026-10-14T12:00:00+14:30")
    => value "<none>"
}

test stdlib.parse-iso/eight-digits {
    stdlib.parse-iso("2026-10-14T12:00:00.00000001Z")
    => value "<none>"
}

test stdlib.parse-iso/year-zero {
    stdlib.parse-iso("0000-01-01T00:00:00Z")
    => value "<none>"
}

// ------------------------------------------------------- helper tests

test stdlib.b64/decodes {
    hex.encode(stdlib.b64("AAE="))
    => value "0001"
}

test stdlib.rails-key/length {
    bytes.length(stdlib.rails-key("synthetic", "signed cookie", 64))
    => value 64
}

test stdlib.part/second {
    stdlib.part(string.split("a--b", "--"), 1)
    => value "b"
}

test stdlib.json-string-field/text {
    match json.parse("{\"a\":\"b\"}") {
        none => "<invalid>"
        some document => stdlib.json-string-field(document, "a")
    }
    => value "b"
}

test stdlib.rails-envelope-message/null-exp {
    stdlib.rails-envelope-message("{\"_rails\":{\"message\":\"ImEi\",\"exp\":null,\"pur\":\"p\"}}", "p", 0)
    => value "\"a\""
}

test stdlib.rails-envelope-message/wrong-purpose {
    stdlib.rails-envelope-message("{\"_rails\":{\"message\":\"ImEi\",\"pur\":\"q\"}}", "p", 0)
    => value "<wrong purpose>"
}

test stdlib.rails-envelope-message/exp-boundary {
    stdlib.rails-envelope-message("{\"_rails\":{\"message\":\"ImEi\",\"exp\":\"2026-10-14T12:00:00.000Z\",\"pur\":\"p\"}}", "p", 1791979200000000)
    => value "<expired>"
}

test stdlib.rails-envelope-message/bad-exp {
    stdlib.rails-envelope-message("{\"_rails\":{\"message\":\"ImEi\",\"exp\":\"tomorrow\",\"pur\":\"p\"}}", "p", 0)
    => value "<expired>"
}
