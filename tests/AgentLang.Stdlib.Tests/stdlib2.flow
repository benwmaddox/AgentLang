    stdlib.rails-cookie-open("synthetic-secret-key-base-for-agentlang-tests-0123456789abcdef", "session_token=abc", 1791979200000000)
    => value "<no cookie>"
}

// Writes the cookie value Rails would: the envelope expires 20 calendar years
// after now; the nonce is passed in so the result is deterministic.
fn stdlib.rails-cookie-seal(secret: String, inner: String, nonce: String, now: Int) -> String {
    let expiry = match time.add-years(now, 20) {
        none => ""
        some later => match time.iso8601-ms(later) {
            none => ""
            some text => text
        }
    }
    let envelope = string.concat("{\"_rails\":{\"message\":", string.concat(json.quote(base64.encode(bytes.from-utf8(inner))), string.concat(",\"exp\":", string.concat(json.quote(expiry), ",\"pur\":\"cookie._campfire_session\"}}"))))
    let key = stdlib.rails-key(secret, "authenticated encrypted cookie", 32)
    match crypto.aes-256-gcm-seal(key, stdlib.b64(nonce), bytes.from-utf8(envelope), bytes.from-utf8("")) {
        none => "<none>"
        some sealed => {
            let count = bytes.length(sealed) - 16
            let ciphertext = match bytes.slice(sealed, 0, count) {
                none => bytes.from-utf8("")
                some data => data
            }
            let tag = match bytes.slice(sealed, count, 16) {
                none => bytes.from-utf8("")
                some data => data
            }
            cookie.escape(string.concat(base64.encode(ciphertext), string.concat("--", string.concat(nonce, string.concat("--", base64.encode(tag))))))
        }
    }
}

test stdlib.rails-cookie-seal/matches-node {
    stdlib.rails-cookie-seal("synthetic-secret-key-base-for-agentlang-tests-0123456789abcdef", "{\"session_id\":\"abc123\",\"_csrf_token\":\"tok\\u003cen\"}", "AAECAwQFBgcICQoL", 1791979200000000)
    => value "ran44C2kDDci5MMQUGOERkoDjUdzEzq0t4%2BoYsDjvko5jUw5BhN9DklqxELd2Qbf9dK86iZq3H0%2Barqms7lEeJddHix2umJ7XEzcZ2LIJCfRMH%2B61CmejqLrnxh8%2F%2BMPC4TyTYgncwuaKkTBgMETtB2%2FaRU3LqtAk3TlsP3n6Xd%2Bl6lsHV%2F3%2BmOFKWJJ2mVQ0%2FIbo8%2Fmorx%2B7cVBchjA--AAECAwQFBgcICQoL--Z%2ByE4Koevv3JHTK2xcGT3Q%3D%3D"
}

// The signed session_token cookie: base64(envelope)--hex(HMAC-SHA1(signing key)).
fn stdlib.rails-signed-open(secret: String, value: String, now: Int) -> String {
    let parts = string.split(value, "--")
    if stdlib.count(parts) != 2 {
        "<format>"
    } else {
        let data = stdlib.part(parts, 0)
        let digest = hex.encode(crypto.hmac-sha1(stdlib.rails-key(secret, "signed cookie", 64), bytes.from-utf8(data)))
        if bool.not(bytes.equal-constant-time?(bytes.from-utf8(digest), bytes.from-utf8(stdlib.part(parts, 1)))) {
            "<bad digest>"
        } else {
            match base64.decode(data) {
                none => "<bad data>"
                some envelope => match bytes.to-utf8(envelope) {
                    none => "<bad data>"
                    some text => match json.parse(stdlib.rails-envelope-message(text, "cookie.session_token", now)) {
                        none => "<bad token json>"
                        some token => match json.text(token) {
                            none => "<not text>"
                            some result => result
                        }
                    }
                }
            }
        }
    }
}

test stdlib.rails-signed-open/node-token {
    stdlib.rails-signed-open("synthetic-secret-key-base-for-agentlang-tests-0123456789abcdef", "eyJfcmFpbHMiOnsibWVzc2FnZSI6IkluUnZhMlZ1TFhaaGJIVmxJZz09IiwiZXhwIjoiMjA0Ni0xMC0xNFQxMjowMDowMC4wMDBaIiwicHVyIjoiY29va2llLnNlc3Npb25fdG9rZW4ifX0=--8704e18d5a8588cbd123ab767e534e69fa0dfac4", 1791979200000000)
    => value "token-value"
}

