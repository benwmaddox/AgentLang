// Standard library slice 2 (report 274): HMAC-SHA1, AES-256-GCM, JSON,
// cookies and time. Every key and secret here is synthetic. Expected cookie
// values were produced independently with Node's OpenSSL bindings.

fn stdlib.hmac-sha1-hex(key: String, message: String) -> String {
    hex.encode(crypto.hmac-sha1(bytes.from-utf8(key), bytes.from-utf8(message)))
}

test stdlib.hmac-sha1-hex/fox {
    stdlib.hmac-sha1-hex("key", "The quick brown fox jumps over the lazy dog")
    => value "de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9"
}

test stdlib.hmac-sha1-hex/empty {
    stdlib.hmac-sha1-hex("", "")
    => value "fbdb1d1b18aa6c08324b7d64b71fb76370690e1d"
}

test stdlib.hmac-sha1-hex/long-key {
    stdlib.hmac-sha1-hex("0123456789012345678901234567890123456789012345678901234567890123456789", "message")
    => value "3a1ed3050e3c10cda0464646eedca9d2c59c2332"
}

// ---------------------------------------------------------------- AES-GCM

fn stdlib.b64(text: String) -> Bytes {
    match base64.decode(text) {
        none => bytes.from-utf8("")
        some data => data
    }
}

fn stdlib.gcm-seal-hex(key: String, nonce: String, plaintext: String, aad: String) -> String {
    match crypto.aes-256-gcm-seal(stdlib.b64(key), stdlib.b64(nonce), stdlib.b64(plaintext), stdlib.b64(aad)) {
        none => "<none>"
        some sealed => hex.encode(sealed)
    }
}

// GCM spec test case 13: empty plaintext, tag only.
test stdlib.gcm-seal-hex/spec-13 {
    stdlib.gcm-seal-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "AAAAAAAAAAAAAAAA", "", "")
    => value "530f8afbc74536b9a963b4f1c4cb738b"
}

// Test case 14: one zero block.
test stdlib.gcm-seal-hex/spec-14 {
    stdlib.gcm-seal-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "AAAAAAAAAAAAAAAA", "AAAAAAAAAAAAAAAAAAAAAA==", "")
    => value "cea7403d4d606b6e074ec5d3baf39d18d0d1c8a799996bf0265b98b5d48ab919"
}

// Test case 16: 60-byte plaintext with additional data.
test stdlib.gcm-seal-hex/spec-16 {
    stdlib.gcm-seal-hex("/v/pkoZlcxxtao+UZzCDCP7/6ZKGZXMcbWqPlGcwgwg=", "yv66vvrO263eyviI", "2TEyJfiEBuWlWQnFr/UmmoanqVMVNPfaLkwwPYoxinIcPAyVlWgJUy/PDiRJprUlsWrt9aoN5le6Y3s5", "/u36zt6tvu/+7frO3q2+76ut2tI=")
    => value "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b"
}

test stdlib.gcm-seal-hex/short-key {
    stdlib.gcm-seal-hex("AAAA", "AAAAAAAAAAAAAAAA", "", "")
    => value "<none>"
}

test stdlib.gcm-seal-hex/short-nonce {
    stdlib.gcm-seal-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "AAAA", "", "")
    => value "<none>"
}

fn stdlib.gcm-open-hex(key: String, nonce: String, ciphertext: String, tag: String, aad: String) -> String {
    match crypto.aes-256-gcm-open(stdlib.b64(key), stdlib.b64(nonce), stdlib.b64(ciphertext), stdlib.b64(tag), stdlib.b64(aad)) {
        none => "<rejected>"
        some plaintext => hex.encode(plaintext)
    }
}

test stdlib.gcm-open-hex/spec-16 {
    stdlib.gcm-open-hex("/v/pkoZlcxxtao+UZzCDCP7/6ZKGZXMcbWqPlGcwgwg=", "yv66vvrO263eyviI", "Ui3B8JlWfQf0fzejKoRCfWQ6jNy/5cDJdZiivSVV0aqMsI5IWQ27PaewixBWgog4xfYeY5O6egq8yfZi", "dvxuzg9OF2jN34hTuy1VGw==", "/u36zt6tvu/+7frO3q2+76ut2tI=")
    => value "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
}

test stdlib.gcm-open-hex/bad-tag {
    stdlib.gcm-open-hex("/v/pkoZlcxxtao+UZzCDCP7/6ZKGZXMcbWqPlGcwgwg=", "yv66vvrO263eyviI", "Ui3B8JlWfQf0fzejKoRCfWQ6jNy/5cDJdZiivSVV0aqMsI5IWQ27PaewixBWgog4xfYeY5O6egq8yfZi", "dvxuzg9OF2jN34hTuy1VGQ==", "/u36zt6tvu/+7frO3q2+76ut2tI=")
    => value "<rejected>"
}

test stdlib.gcm-open-hex/wrong-aad {
    stdlib.gcm-open-hex("/v/pkoZlcxxtao+UZzCDCP7/6ZKGZXMcbWqPlGcwgwg=", "yv66vvrO263eyviI", "Ui3B8JlWfQf0fzejKoRCfWQ6jNy/5cDJdZiivSVV0aqMsI5IWQ27PaewixBWgog4xfYeY5O6egq8yfZi", "dvxuzg9OF2jN34hTuy1VGw==", "")
    => value "<rejected>"
}

test stdlib.gcm-open-hex/wrong-key {
    stdlib.gcm-open-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "yv66vvrO263eyviI", "Ui3B8JlWfQf0fzejKoRCfWQ6jNy/5cDJdZiivSVV0aqMsI5IWQ27PaewixBWgog4xfYeY5O6egq8yfZi", "dvxuzg9OF2jN34hTuy1VGw==", "/u36zt6tvu/+7frO3q2+76ut2tI=")
    => value "<rejected>"
}

test stdlib.gcm-open-hex/short-tag {
    stdlib.gcm-open-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "AAAAAAAAAAAAAAAA", "", "AAAA", "")
    => value "<rejected>"
}

test stdlib.gcm-open-hex/empty-plaintext {
    stdlib.gcm-open-hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", "AAAAAAAAAAAAAAAA", "", "Uw+K+8dFNrmpY7TxxMtziw==", "")
    => value ""
}

// ------------------------------------------- Rails 7 encrypted cookies

// Rails 7 key: PBKDF2-HMAC-SHA256(secret_key_base, salt, 1000 iterations).
fn stdlib.rails-key(secret: String, salt: String, length: Int) -> Bytes {
    match crypto.pbkdf2-sha256(bytes.from-utf8(secret), bytes.from-utf8(salt), 1000, length) {
        none => bytes.from-utf8("")
        some key => key
    }
}

// Loops rather than list.get / list.count, which the owning backend lacks.
fn stdlib.part(parts: List<String>, index: Int) -> String {
    var found = ""
    for part, position in parts {
        if position == index {
            found = part
        }
    }
    found
}

fn stdlib.count(parts: List<String>) -> Int {
    var total = 0
    for part in parts {
        total = total + 1
    }
    total
}

test stdlib.count/three {
    stdlib.count(string.split("a--b--c", "--"))
    => value 3
}

fn stdlib.json-string-field(document: Json, name: String) -> String {
    match json.field(document, name) {
        none => "<missing>"
        some value => match json.text(value) {
            none => "<not text>"
            some text => text
        }
    }
}

// The Rails metadata envelope {"_rails":{"message":base64,"exp":iso|null,"pur":...}}:
// the decoded message when the purpose matches and exp is absent, null or later than now.
fn stdlib.rails-envelope-message(envelope: String, purpose: String, now: Int) -> String {
    match json.parse(envelope) {
        none => "<bad json>"
        some root => match json.field(root, "_rails") {
            none => "<no metadata>"
            some rails => {
                let expired = match json.field(rails, "exp") {
                    none => false
                    some exp => if json.null?(exp) {
                        false
                    } else {
                        match json.text(exp) {
                            none => true
                            some text => match time.parse-iso8601(text) {
                                none => true
                                some expiry => now >= expiry
                            }
                        }
                    }
                }
                if stdlib.json-string-field(rails, "pur") != purpose {
                    "<wrong purpose>"
                } else if expired {
                    "<expired>"
                } else {
                    match base64.decode(stdlib.json-string-field(rails, "message")) {
                        none => "<bad message>"
                        some message => match bytes.to-utf8(message) {
                            none => "<bad message>"
                            some text => text
                        }
                    }
                }
            }
        }
    }
}

// The _campfire_session value from a Cookie header: unescape,
// base64(ciphertext)--base64(iv)--base64(tag), AES-256-GCM with no AAD.
fn stdlib.rails-cookie-open(secret: String, header: String, now: Int) -> String {
    match cookie.find(header, "_campfire_session") {
        none => "<no cookie>"
        some wire => {
            let parts = string.split(cookie.unescape(wire), "--")
            if stdlib.count(parts) != 3 {
                "<format>"
            } else {
                let key = stdlib.rails-key(secret, "authenticated encrypted cookie", 32)
                match crypto.aes-256-gcm-open(key, stdlib.b64(stdlib.part(parts, 1)), stdlib.b64(stdlib.part(parts, 0)), stdlib.b64(stdlib.part(parts, 2)), bytes.from-utf8("")) {
                    none => "<rejected>"
                    some plaintext => match bytes.to-utf8(plaintext) {
                        none => "<bad utf8>"
                        some envelope => stdlib.rails-envelope-message(envelope, "cookie._campfire_session", now)
                    }
                }
            }
        }
    }
}

test stdlib.rails-cookie-open/node-cookie {
    stdlib.rails-cookie-open("synthetic-secret-key-base-for-agentlang-tests-0123456789abcdef", "last_room=4; _campfire_session=ran44C2kDDci5MMQUGOERkoDjUdzEzq0t4%2BoYsDjvko5jUw5BhN9DklqxELd2Qbf9dK86iZq3H0%2Barqms7lEeJddHix2umJ7XEzcZ2LIJCfRMH%2B61CmejqLrnxh8%2F%2BMPC4TyTYgncwuaKkTBgMETtB2%2FaRU3LqtAk3TlsP3n6Xd%2Bl6lsHV%2F3%2BmOFKWJJ2mVQ0%2FIbo8%2Fmorx%2B7cVBchjA--AAECAwQFBgcICQoL--Z%2ByE4Koevv3JHTK2xcGT3Q%3D%3D", 1791979200000000)
    => value "{\"session_id\":\"abc123\",\"_csrf_token\":\"tok\\u003cen\"}"
}

