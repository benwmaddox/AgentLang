// Example Flow HTTP app for the portable host tests: echo, a db-backed item
// list, the process-wide cache, the per-worker store with its worker cache and
// response stream, and a per-worker context derived once in worker-init.

record CounterContext {
    greeting: String
    key: Bytes
    items-at-start: Int
}

fn counter.worker-init(config: List<HttpHeader>) -> CounterContext {
    effects db.read
    let secret = http.config(config, "secret")
    let start = match db.query("select count(*) from items", list.empty<DbValue>()) {
        error failure => -1
        ok rows => match db.first-row(rows) {
            none => -1
            some row => db.int(row, 0)
        }
    }
    counterContext.new(
        greeting = http.config(config, "greeting"),
        key = crypto.hmac-sha256(bytes.from-utf8(secret), bytes.from-utf8("counter-key")),
        items-at-start = start)
}

fn counter.text(status: Int, body: String) -> HttpResponse {
    http.response(status, "text/plain; charset=utf-8", body)
}

fn counter.count(headers: List<HttpHeader>) -> Int {
    var count = 0
    for header in headers {
        count = count + 1
    }
    count
}

test counter.count/two {
    expect counter.count([httpHeader.new(name = "a", value = "1"), httpHeader.new(name = "b", value = "2")]) == 2
}

fn counter.echo(request: HttpRequest) -> HttpResponse {
    let probe = match http.header(request.headers, "x-probe") {
        none => "-"
        some value => value
    }
    let body = match bytes.to-utf8(request.body) {
        none => "<binary>"
        some text => text
    }
    let lines = [
        string.concat("method=", string.concat(request.method, ";")),
        string.concat("target=", string.concat(request.target, ";")),
        string.concat("path=", string.concat(http.path(request.target), ";")),
        string.concat("query=", string.concat(http.query(request.target), ";")),
        string.concat("probe=", string.concat(probe, ";")),
        string.concat("headers=", string.concat(int.to-string(counter.count(request.headers)), ";")),
        string.concat("body-bytes=", string.concat(int.to-string(bytes.length(request.body)), ";")),
        string.concat("body=", string.concat(body, ";")),
        string.concat("remote=", string.concat(request.remote-ip, ";"))
    ]
    httpResponse.new(
        status = 200,
        headers = [httpHeader.new(name = "content-type", value = "text/plain"), httpHeader.new(name = "x-echo", value = probe)],
        body = string.replace(string.join(lines), ";", "\n"), streamed = false)
}

fn counter.line(row: DbRow) -> String {
    string.concat(string.concat(db.text(row, 0), ":"), db.text(row, 1))
}

fn counter.list-items() -> HttpResponse {
    effects db.read
    match db.query("select id, name, note from items order by id", list.empty<DbValue>()) {
        error failure => counter.text(500, string.concat("db error ", int.to-string(failure.code)))
        ok rows => {
            var text = ""
            for row in rows {
                text = string.concat(text, string.concat(counter.line(row), "\n"))
            }
            counter.text(200, text)
        }
    }
}

fn counter.find-item(target: String) -> HttpResponse {
    effects db.read
    let wanted = match string.index-of(target, "id=", 0) {
        none => -1
        some at => match string.slice(target, at + 3, string.byte-length(target) - at - 3) {
            none => -1
            some digits => match int.parse(digits) {
                none => -1
                some id => id
            }
        }
    }
    match db.query("select name, note from items where id = ?1", [db.int-param(wanted)]) {
        error failure => counter.text(500, failure.message)
        ok rows => match db.first-row(rows) {
            none => counter.text(404, "no such item")
            some row => {
                let note = match db.optional-text(row, 1) {
                    none => "(none)"
                    some value => value
                }
                counter.text(200, string.concat(string.concat(db.text(row, 0), " / "), note))
            }
        }
    }
}

fn counter.add-item(request: HttpRequest) -> HttpResponse {
    effects db.write
    match bytes.to-utf8(request.body) {
        none => counter.text(400, "body must be UTF-8")
        some name => {
            let note = match http.header(request.headers, "x-note") {
                none => db.null-param()
                some value => db.text-param(value)
            }
            match db.execute("insert into items(name, note) values (?1, ?2)", [db.text-param(name), note]) {
                error failure => counter.text(409, string.concat("db error ", int.to-string(failure.code)))
                ok changed => counter.text(201, string.concat("created ", int.to-string(changed)))
            }
        }
    }
}

fn counter.context-text(context: CounterContext) -> HttpResponse {
    let key = match bytes.slice(context.key, 0, 4) {
        none => ""
        some prefix => hex.encode(prefix)
    }
    counter.text(200, string.join([context.greeting, ",", key, ",", int.to-string(context.items-at-start)]))
}

fn counter.cache(request: HttpRequest) -> HttpResponse {
    effects cache.read, cache.write
    doc "GET /cache?<key>: hit:<value> or miss. POST /cache?<key> with the value as body: stored, or kept when the key was already cached (first writer wins)."
    let key = http.query(request.target)
    if request.method == "POST" {
        let value = match bytes.to-utf8(request.body) {
            none => ""
            some text => text
        }
        if cache.put(key, value) {
            counter.text(201, "stored")
        } else {
            counter.text(200, "kept")
        }
    } else {
        match cache.get(key) {
            none => counter.text(404, "miss")
            some value => counter.text(200, string.concat("hit:", value))
        }
    }
}

test counter.cache/first-writer-wins {
    expect counter.cache(counter.test-request("GET", "/cache?t1", "")).body == "miss"
    expect counter.cache(counter.test-request("POST", "/cache?t1", "one")).body == "stored"
    expect counter.cache(counter.test-request("POST", "/cache?t1", "two")).body == "kept"
    expect counter.cache(counter.test-request("GET", "/cache?t1", "")).body == "hit:one"
}

fn counter.store(request: HttpRequest) -> HttpResponse {
    effects store.read, store.write, response.write
    doc "The worker cache over the whole store. GET /store?<key>: streamed \"store:<value>;hit\" (the value copied from the store to the output) or \"store:none;miss\". POST /store?<key> with the value as body: stored or refused. GET /store-text?<key>: the value through the data stack, or absent."
    let key = http.query(request.target)
    let cache = worker-cache.open(0, store.size())
    let path = http.path(request.target)
    if request.method == "POST" {
        let value = match bytes.to-utf8(request.body) {
            none => ""
            some text => text
        }
        if worker-cache.put(cache, key, value) {
            counter.text(201, "stored")
        } else {
            counter.text(200, "refused")
        }
    } else if path == "/store-text" {
        match worker-cache.text(cache, key) {
            none => counter.text(404, "absent")
            some value => counter.text(200, string.concat("text:", value))
        }
    } else {
        let opened = response.write("store:")
        if worker-cache.write-to-response(cache, key) {
            http.streamed(200, [httpHeader.new(name = "content-type", value = "text/plain; charset=utf-8")], ";hit")
        } else {
            let wrote = response.write("none")
            http.streamed(404, [httpHeader.new(name = "content-type", value = "text/plain; charset=utf-8")], ";miss")
        }
    }
}

test counter.store/miss-put-hit {
    expect response.discard(0) == 0
    expect counter.store(counter.test-request("GET", "/store?k", "")).status == 404
    expect response.written(0) == "store:none"
    expect response.discard(0) == 10
    expect counter.store(counter.test-request("POST", "/store?k", "<b>é</b>")).body == "stored"
    let hit = counter.store(counter.test-request("GET", "/store?k", ""))
    expect hit.status == 200 && hit.streamed && hit.body == ";hit"
    expect response.written(0) == "store:<b>é</b>"
    expect counter.store(counter.test-request("GET", "/store-text?k", "")).body == "text:<b>é</b>"
}

fn counter.store-unstreamed(request: HttpRequest) -> HttpResponse {
    effects response.write
    doc "Writes to the response stream, then returns an ordinary response: the written bytes must not be sent. /store-discard empties the stream first; /store-error does not."
    let wrote = response.write("junk")
    if http.path(request.target) == "/store-discard" {
        let dropped = response.discard(0)
        counter.text(200, string.concat("clean:", int.to-string(dropped)))
    } else {
        counter.text(500, "error after partial writes")
    }
}

test counter.store-unstreamed/drops {
    expect counter.store-unstreamed(counter.test-request("GET", "/store-discard", "")).body == "clean:4"
    let failed = counter.store-unstreamed(counter.test-request("GET", "/store-error", ""))
    expect failed.status == 500 && bool.not(failed.streamed)
}

// db.rows<Row>(sql, params) (report 305): the host binds the params record's
// fields by name and decodes each row into a Row, checking column kinds.

record ItemRow {
    id: Int
    name: String
    note: Option<String>
    odd: Bool
    raw: Bytes
}

record ItemQuery {
    skip: Option<String>
    min-id: Int
}

record NameAsInt {
    name: Int
}

record NoteRequired {
    note: String
}

record OddOnly {
    odd: Bool
}

type ItemId : Int { }

record OneId {
    min-id: ItemId
}

fn counter.row-line(row: ItemRow) -> String {
    let note = match row.note {
        none => "(none)"
        some value => value
    }
    let odd = if row.odd { "odd" } else { "even" }
    string.join([int.to-string(row.id), ":", row.name, ":", note, ":", odd, ":", hex.encode(row.raw), "\n"])
}

test counter.row-line/format {
    let row = itemRow.new(id = 3, name = "x", note = option.none<String>(), odd = true, raw = bytes.from-utf8("x"))
    expect counter.row-line(row) == "3:x:(none):odd:78\n"
}

fn counter.typed-rows(target: String) -> HttpResponse {
    effects db.read
    doc "GET /rows?skip=<name>: items with id >= 2 whose name is not <name> (all of them without skip), through db.rows. The SQL names $min_id before $skip, the reverse of the record's field order."
    let query = http.query(target)
    let skip = if string.starts-with(query, "skip=") {
        string.slice(query, 5, string.byte-length(query) - 5)
    } else {
        option.none<String>()
    }
    let params = itemQuery.new(skip = skip, min-id = 2)
    match db.rows<ItemRow>("select id, name, note, id % 2 as odd, cast(name as blob) as raw from items where id >= $min_id and ($skip is null or name <> $skip) order by id", params) {
        error failure => counter.text(500, string.join(["db error ", int.to-string(failure.code), " ", failure.message]))
        ok rows => {
            var text = ""
            for row in rows {
                text = string.concat(text, counter.row-line(row))
            }
            counter.text(200, text)
        }
    }
}

test counter.typed-rows/no-table {
    expect counter.typed-rows("/rows").status == 500
}

fn counter.row-error(failure: SqlError) -> HttpResponse {
    counter.text(500, string.join(["db error ", int.to-string(failure.code), " ", failure.message]))
}

test counter.row-error/text {
    expect counter.row-error(sqlError.new(code = 20, message = "m")).body == "db error 20 m"
}

fn counter.typed-row-errors(path: String) -> HttpResponse {
    effects db.read
    doc "/rows-bools reads one Bool per row. Each other /rows-* path reads rows that do not fit the row type: text into Int, NULL into String, 2 into Bool, two columns into a one-field row."
    let params = oneId.new(min-id = ItemId.new(1))
    if path == "/rows-bools" {
        match db.rows<OddOnly>("select id % 2 as odd from items where id >= $min_id order by id", params) {
            error failure => counter.row-error(failure)
            ok rows => {
                var text = ""
                for row in rows {
                    text = string.concat(text, if row.odd { "1" } else { "0" })
                }
                counter.text(200, text)
            }
        }
    } else if path == "/rows-text-as-int" {
        match db.rows<NameAsInt>("select name from items where id >= $min_id order by id", params) {
            error failure => counter.row-error(failure)
            ok rows => counter.text(200, int.to-string(list.count(rows)))
        }
    } else if path == "/rows-null" {
        match db.rows<NoteRequired>("select note from items where id >= $min_id order by id", params) {
            error failure => counter.row-error(failure)
            ok rows => counter.text(200, int.to-string(list.count(rows)))
        }
    } else if path == "/rows-bool" {
        match db.rows<OddOnly>("select id as odd from items where id >= $min_id order by id", params) {
            error failure => counter.row-error(failure)
            ok rows => counter.text(200, int.to-string(list.count(rows)))
        }
    } else {
        match db.rows<OddOnly>("select 1, 0 from items where id >= $min_id", params) {
            error failure => counter.row-error(failure)
            ok rows => counter.text(200, int.to-string(list.count(rows)))
        }
    }
}

test counter.typed-row-errors/no-table {
    expect counter.typed-row-errors("/rows-null").status == 500
}

fn counter.handle(request: HttpRequest, context: CounterContext) -> HttpResponse {
    effects db.read, db.write, cache.read, cache.write, store.read, store.write, response.write
    let path = http.path(request.target)
    if path == "/hello" {
        counter.text(200, string.concat("hello ", context.greeting))
    } else if path == "/echo" {
        counter.echo(request)
    } else if path == "/context" {
        counter.context-text(context)
    } else if path == "/items" && request.method == "GET" {
        counter.list-items()
    } else if path == "/items" && request.method == "POST" {
        counter.add-item(request)
    } else if path == "/item" {
        counter.find-item(request.target)
    } else if path == "/cache" {
        counter.cache(request)
    } else if path == "/store" || path == "/store-text" {
        counter.store(request)
    } else if path == "/store-discard" || path == "/store-error" {
        counter.store-unstreamed(request)
    } else if path == "/rows" {
        counter.typed-rows(request.target)
    } else if string.starts-with(path, "/rows-") {
        counter.typed-row-errors(path)
    } else if path == "/bad-sql" {
        match db.execute("insert into missing_table values (?1)", [db.int-param(1)]) {
            error failure => counter.text(500, string.concat("db error ", int.to-string(failure.code)))
            ok changed => counter.text(200, "unexpected")
        }
    } else {
        counter.text(404, string.concat("not found: ", path))
    }
}

// Attached tests run against a fresh in-memory database without the items
// table, so db calls take their error paths here; the HTTP tests cover the rest.

fn counter.test-request(method: String, target: String, body: String) -> HttpRequest {
    httpRequest.new(
        method = method,
        target = target,
        headers = [httpHeader.new(name = "x-probe", value = "p")],
        body = bytes.from-utf8(body),
        remote-ip = "127.0.0.1",
        now-microseconds = 0)
}

fn counter.test-context() -> CounterContext {
    counterContext.new(greeting = "hi", key = crypto.sha256(bytes.from-utf8("k")), items-at-start = 2)
}

test counter.test-request/fields {
    expect counter.test-request("GET", "/a", "b").method == "GET"
}

test counter.test-context/fields {
    expect counter.test-context().greeting == "hi"
}

test counter.worker-init/no-table {
    let context = counter.worker-init([httpHeader.new(name = "greeting", value = "g"), httpHeader.new(name = "secret", value = "s")])
    expect context.greeting == "g"
    expect context.items-at-start == -1
    expect bytes.length(context.key) == 32
}

test counter.text/status {
    expect counter.text(201, "x").status == 201
}

test counter.echo/body {
    let response = counter.echo(counter.test-request("POST", "/echo?q=1", "hello"))
    expect response.status == 200
    expect string.contains(response.body, "query=q=1")
    expect string.contains(response.body, "body=hello")
}

test counter.line/format {
    expect counter.line(dbRow.new(values = [db.int-param(3), db.text-param("x")])) == "3:x"
}

test counter.list-items/no-table {
    expect counter.list-items().status == 500
}

test counter.find-item/no-table {
    expect counter.find-item("/item?id=1").status == 500
}

test counter.add-item/no-table {
    expect counter.add-item(counter.test-request("POST", "/items", "a")).status == 409
}

test counter.context-text/format {
    let body = counter.context-text(counter.test-context()).body
    expect string.starts-with(body, "hi,")
    expect string.ends-with(body, ",2")
    expect string.byte-length(body) == 13
}

test counter.handle/routes {
    let context = counter.test-context()
    expect counter.handle(counter.test-request("GET", "/hello", ""), context).body == "hello hi"
    expect counter.handle(counter.test-request("GET", "/nope", ""), context).status == 404
    expect counter.handle(counter.test-request("GET", "/bad-sql", ""), context).status == 500
}
