{
  "commands": [
    {
      "frontend": "flow",
      "syntaxVersion": 2,
      "expectedRevision": 1,
      "replace": true,
      "source": "fn invoice.queue-reminders-for-pair(pair: InvoicePair) -> ReminderPairResult {\n    effects fs.read, fs.write\n    doc \"Queue open invoice reminders in pair order and return their exact markers.\"\n\n    let first-result =\n        if InvoiceStatus::value(pair.first.status) == \"open\" {\n            let first-path = invoice::reminder-path(pair.first.id);\n            if file::exists?(first-path) {\n                file::read(first-path)\n            } else {\n                file::write(first-path, \"queued\");\n                \"queued\"\n            }\n        } else {\n            \"not-open\"\n        };\n    let second-result =\n        if InvoiceStatus::value(pair.second.status) == \"open\" {\n            let second-path = invoice::reminder-path(pair.second.id);\n            if file::exists?(second-path) {\n                file::read(second-path)\n            } else {\n                file::write(second-path, \"queued\");\n                \"queued\"\n            }\n        } else {\n            \"not-open\"\n        };\n    reminderPairResult::new(first = first-result, second = second-result)\n}",
      "tests": [
        "test invoice.queue-reminders-for-pair/first-not-open-skips-open-second {\n    invoice::queue-reminders-for-pair(\n        invoicePair::new(\n            first = invoice::new(\n                id = InvoiceId::new(\"pair-flow-closed-first\"),\n                status = InvoiceStatus::new(\"Open\")),\n            second = invoice::new(\n                id = InvoiceId::new(\"pair-flow-open-second\"),\n                status = InvoiceStatus::new(\"open\"))))\n    => value reminderPairResult::new(first = \"not-open\", second = \"queued\")\n}"
      ],
      "op": "define"
    },
    {
      "word": "invoice.queue-reminders-for-pair",
      "op": "test"
    },
    {
      "op": "test-all"
    },
