{
  "requests": [
    {
      "source": "fn invoice.queue-reminders-for-pair(pair: InvoicePair) -> ReminderPairResult {\n    effects fs.read, fs.write\n    doc \"Queue open invoice reminders in pair order and return their exact markers.\"\n\n    let first-result =\n        if InvoiceStatus::value(pair.first.status) == \"open\" {\n            let first-path = invoice::reminder-path(pair.first.id);\n            if file::exists?(first-path) {\n                file::read(first-path)\n            } else {\n                file::write(first-path, \"queued\");\n                \"queued\"\n            }\n        } else {\n            \"not-open\"\n        };\n    let second-result =\n        if InvoiceStatus::value(pair.second.status) == \"open\" {\n            let second-path = invoice::reminder-path(pair.first.id);\n            if file::exists?(second-path) {\n                file::read(second-path)\n            } else {\n                file::write(second-path, \"queued\");\n                \"queued\"\n            }\n        } else {\n            \"not-open\"\n        };\n    reminderPairResult::new(first = first-result, second = second-result)\n}",
      "frontend": "flow",
      "syntaxVersion": 2,
      "op": "define",
      "replace": true,
      "expectedRevision": 2
    },
    {
      "word": "invoice.queue-reminders-for-pair",
      "op": "test"
    },
    {
      "op": "test-all"
    },
    {
      "syntaxVersion": 2,
      "frontend": "flow",
      "code": "file::write(\"outbox/invoice-reminders/pair-flow-existing-first\", \"custom marker\")",
      "op": "eval"
    },
