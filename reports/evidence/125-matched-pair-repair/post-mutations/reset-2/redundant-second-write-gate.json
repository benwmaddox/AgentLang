{
  "actor": "reset-2",
  "mutation": "redundant-second-write",
  "requests": [
    {
      "op": "define",
      "syntaxVersion": 2,
      "frontend": "flow",
      "replace": true,
      "expectedRevision": 2,
      "source": "fn invoice.queue-reminders-for-pair(pair: InvoicePair) -> ReminderPairResult {\n    effects fs.read, fs.write\n    doc \"Queue open invoice reminders in pair order and return their exact markers.\"\n\n    let first-result = if InvoiceStatus::value(pair.first.status) == \"open\" {\n    let first-path = invoice::reminder-path(pair.first.id);\n    if file::exists?(first-path) {\n        file::read(first-path)\n    } else {\n        file::write(first-path, \"queued\");\n        \"queued\"\n    }\n} else {\n    \"not-open\"\n};\n    let second-result = if InvoiceStatus::value(pair.second.status) == \"open\" {\n    let second-path = invoice::reminder-path(pair.second.id);\n    if file::exists?(second-path) {\n        let existing-marker = file::read(second-path);\n        file::write(second-path, existing-marker);\n        existing-marker\n    } else {\n        file::write(second-path, \"queued\");\n        \"queued\"\n    }\n} else {\n    \"not-open\"\n};\n    reminderPairResult::new(first = first-result, second = second-result)\n}"
    },
    {
      "op": "test",
      "word": "invoice.queue-reminders-for-pair"
    },
    {
      "op": "test-all"
    },
    {
      "op": "replace-word",
      "word": "invoice.queue-reminders-for-pair"
    }
  ],
