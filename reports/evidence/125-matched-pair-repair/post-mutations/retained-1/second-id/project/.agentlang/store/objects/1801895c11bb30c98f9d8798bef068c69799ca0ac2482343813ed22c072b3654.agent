test invoice.queue-reminders-for-pair/first-not-open-skips-open-second {
    invoice::queue-reminders-for-pair(
        invoicePair::new(
            first = invoice::new(
                id = InvoiceId::new("pair-flow-closed-first"),
                status = InvoiceStatus::new("Open")),
            second = invoice::new(
                id = InvoiceId::new("pair-flow-open-second"),
                status = InvoiceStatus::new("open"))))
    => value reminderPairResult::new(first = "not-open", second = "queued")
    effects { fs.read: 1; fs.write: 1; }
}