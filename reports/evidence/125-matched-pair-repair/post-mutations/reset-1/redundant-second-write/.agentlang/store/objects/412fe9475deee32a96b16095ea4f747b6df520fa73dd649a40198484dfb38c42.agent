test invoice.queue-reminders-for-pair/duplicate-id-second-reads-first-write {
    invoice::queue-reminders-for-pair(
        invoicePair::new(
            first = invoice::new(id = InvoiceId::new("same"), status = InvoiceStatus::new("open")),
            second = invoice::new(id = InvoiceId::new("same"), status = InvoiceStatus::new("open"))
        )
    )
    => value reminderPairResult::new(first = "queued", second = "queued")
    effects { fs.read: 3; fs.write: 1; }
}