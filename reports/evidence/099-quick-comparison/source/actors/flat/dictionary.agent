// frontend: flow/1

record Customer {
    field id: CustomerId;
    field email: Email;
    field kind: String;
    field balance: Money;
    field created-at: Instant;
}

// frontend: flow/1

type CustomerId : String {
    validate string::guid-canonical?;
}

// frontend: flow/1

type Email : String {
    validate string::email-address-valid?;
}

// frontend: flow/1

type Instant : String {
    validate instant::is-canonical-utc?;
}

// frontend: flow/1

type Money : Int {
}

// frontend: flow/1

type ProductId : String {
    validate string::guid-canonical?;
}

// frontend: flow/1

word customer.discounted-balance(customer: Customer) -> Money {
    effects none
    doc "Applies a 10% discount to premium balances, truncating fractional minor units toward zero."
    let kind = customer::kind(customer);
    let balance = Money::value(customer::balance(customer));
    if ::equals(kind, "premium") {
        let quotient = ::divide(balance, 10);
        let remainder = ::subtract(balance, ::multiply(quotient, 10));
        let whole = ::multiply(quotient, 9);
        let partial = ::divide(::multiply(remainder, 9), 10);
        Money::new(::add(whole, partial))
    } else {
        customer::balance(customer)
    }
}

// frontend: flow/1

test customer.discounted-balance/kind-is-not-trimmed {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium ", Money::new(15), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => 15
}

// frontend: flow/1

test customer.discounted-balance/kind-is-ordinal {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "Premium", Money::new(15), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => 15
}

// frontend: flow/1

test customer.discounted-balance/nonpremium-unchanged {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "standard", Money::new(15), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => 15
}

// frontend: flow/1

test customer.discounted-balance/premium-maximum {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium", Money::new(9223372036854775807), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => 8301034833169298226
}

// frontend: flow/1

test customer.discounted-balance/premium-minimum {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium", Money::new(-9223372036854775808), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => -8301034833169298227
}

// frontend: flow/1

test customer.discounted-balance/premium-negative-fraction {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium", Money::new(-15), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => -13
}

// frontend: flow/1

test customer.discounted-balance/premium-positive-fraction {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium", Money::new(15), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => 13
}

// frontend: flow/1

test customer.discounted-balance/premium-small-negative {
    Money::value(customer::discounted-balance(customer::new(CustomerId::new("00000000-0000-0000-0000-000000000001"), Email::new("trial@example.com"), "premium", Money::new(-9), Instant::new("2000-01-01T00:00:00.0000000\u002B00:00"))))
    => -8
}
