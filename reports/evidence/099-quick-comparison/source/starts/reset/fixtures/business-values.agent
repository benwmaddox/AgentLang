example product-id.parse/guid {
    match product-id::parse("00112233-4455-6677-8899-aabbccddeeff") {
        ok id => { ProductId::value(id) }
        error problem => { problem.code() }
    }
    => "00112233-4455-6677-8899-aabbccddeeff"
}

example payment-id.parse/guid {
    match payment-id::parse("00112233-4455-6677-8899-aabbccddeeff") {
