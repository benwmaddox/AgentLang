    }
    => "00112233-4455-6677-8899-aabbccddeeff"
}

example email.parse/accepted-address {
    match email::parse("dev@example.com") {
        ok address => { Email::value(address) }
        error problem => { problem.code() }
    }
    => "dev@example.com"
}

example instant.normalize/to-utc {
    match instant::normalize("2024-02-29T14:00:00+02:00") {
        ok timestamp => { Instant::value(timestamp) }
        error problem => { problem.code() }
    }
    => "2024-02-29T12:00:00.0000000+00:00"
}

example money.add/signed-minor-units {
    match money::add(Money::new(250), Money::new(300)) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "550"
}

example money.multiply-by-quantity/signed-quantity {
    match money::multiply-by-quantity(Money::new(250), -2) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "-500"
}

example money.nonnegative?/zero {
    money::nonnegative?(Money::new(0))
    => true
}

