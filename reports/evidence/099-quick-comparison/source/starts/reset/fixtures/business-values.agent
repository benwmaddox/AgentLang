test instant.normalize/offset-to-utc {
    match instant::normalize("2024-02-29T14:30:00+02:30") {
        ok timestamp => { Instant::value(timestamp) }
        error problem => { problem.code() }
    }
    => "2024-02-29T12:00:00.0000000+00:00"
}

test instant.normalize/invalid {
    match instant::normalize("next Tuesday") {
        ok timestamp => { Instant::value(timestamp) }
        error problem => { problem.code() }
    }
    => "INVALID_INSTANT"
}

test money.add/signed-values {
    match money::add(Money::new(-250), Money::new(1000)) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "750"
}

test money.add/int64-overflow {
    match money::add(Money::new(9223372036854775807), Money::new(1)) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "MONEY_OVERFLOW"
}

test money.multiply-by-quantity/negative-quantity {
    match money::multiply-by-quantity(Money::new(125), -2) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "-250"
}

test money.multiply-by-quantity/zero-quantity {
    match money::multiply-by-quantity(Money::new(125), 0) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "0"
}

test money.multiply-by-quantity/int32-min {
    match money::multiply-by-quantity(Money::new(1), -2147483648) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "-2147483648"
}

test money.multiply-by-quantity/int32-max {
    match money::multiply-by-quantity(Money::new(1), 2147483647) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "2147483647"
}

test money.multiply-by-quantity/below-int32 {
    match money::multiply-by-quantity(Money::new(1), -2147483649) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "INVALID_QUANTITY"
}

test money.multiply-by-quantity/above-int32 {
    match money::multiply-by-quantity(Money::new(1), 2147483648) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "INVALID_QUANTITY"
}

test money.multiply-by-quantity/int64-overflow {
    match money::multiply-by-quantity(Money::new(9223372036854775807), 2) {
        ok total => { int::to-string(Money::value(total)) }
        error problem => { problem.code() }
    }
    => "MONEY_OVERFLOW"
}

test money.nonnegative?/zero {
    money::nonnegative?(Money::new(0))
    => true
}

test money.nonnegative?/negative {
    money::nonnegative?(Money::new(-1))
    => false
}

