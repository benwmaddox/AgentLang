}

// frontend: flow/1

word store.replace-invoice(store: Store, invoice: Invoice) -> Store {
    effects none
    doc "Replace the first invoice with the same ID, keeping all other Store fields and invoice order."
    let replacement = invoiceReplacement::new(target = invoice.id(), replacement = invoice, replaced = false, values = list::empty<Invoice>());
    let completed = store.invoices().fold(replacement, store::replace-invoice-step);
    store::with-invoices(store, completed.values())
}

// frontend: flow/1

word store.replace-invoice-step(accumulator: InvoiceReplacement, candidate: Invoice) -> InvoiceReplacement {
    effects none
    doc "Replace only the first invoice with the target ID while preserving list order."
    if accumulator.replaced() {
        invoiceReplacement::new(target = accumulator.target(), replacement = accumulator.replacement(), replaced = true, values = list::append(accumulator.values(), candidate))
    } else {
        if equals(candidate.id(), accumulator.target()) {
            invoiceReplacement::new(target = accumulator.target(), replacement = accumulator.replacement(), replaced = true, values = list::append(accumulator.values(), accumulator.replacement()))
        } else {
            invoiceReplacement::new(target = accumulator.target(), replacement = accumulator.replacement(), replaced = false, values = list::append(accumulator.values(), candidate))
        }
    }
}

// frontend: flow/1

word store.subscription(id: SubscriptionId, store: Store) -> Option<Subscription> {
