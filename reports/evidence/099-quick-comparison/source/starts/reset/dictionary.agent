test store.with-invoices/replaces-existing-list {
    let initial = business::seed(unit);
    let old-invoice = invoice::new(id = InvoiceId::new("41000000-0000-0000-0000-000000000000"), customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"), lines = list::empty<InvoiceLine>(), total = Money::new(10), created-at = Instant::new("2026-01-02T12:00:00.0000000\u002B00:00"), status = InvoiceStatus::new("open"));
    let initial-with-old-invoice = store::with-invoices(initial, list::singleton<Invoice>(old-invoice));
    let first = invoice::new(id = InvoiceId::new("41000000-0000-0000-0000-000000000001"), customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"), lines = list::empty<InvoiceLine>(), total = Money::new(20), created-at = Instant::new("2026-01-03T12:00:00.0000000\u002B00:00"), status = InvoiceStatus::new("open"));
