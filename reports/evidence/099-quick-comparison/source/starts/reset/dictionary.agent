    let initial = store::new(customers = base.customers(), products = products, subscriptions = base.subscriptions(), invoices = base.invoices(), payments = base.payments(), email-outbox = base.email-outbox(), sent-emails = base.sent-emails());
    let first = cartLine::new(product-id = max-id, quantity = 1);
    let second = cartLine::new(product-id = one-id, quantity = 1);
    let later-invalid = cartLine::new(product-id = ProductId::new("92000000-0000-0000-0000-000000000003"), quantity = 1);
    let cart = list::append(list::append(list::singleton<CartLine>(first), second), later-invalid);
    match invoice::create(initial, InvoiceId::new("91000000-0000-0000-0000-000000000001"), CustomerId::new("10000000-0000-0000-0000-000000000001"), cart, Instant::new("2026-01-04T00:00:00.0000000\u002B00:00")) {
        ok updated => {
            false
        }
        error problem => {
            equals(problem.code(), "PRODUCT_NOT_FOUND")
        }
    }
    => true
}

