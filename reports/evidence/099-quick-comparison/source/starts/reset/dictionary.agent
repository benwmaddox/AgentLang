// frontend: flow/1

record BusinessError {
    field code: String;
    field message: String;
}

// frontend: flow/1

record CartLine {
    field product-id: ProductId;
    field quantity: Int;
}

// frontend: flow/1

record Customer {
    field id: CustomerId;
    field email: Email;
    field kind: String;
    field balance: Money;
    field created-at: Instant;
}

// frontend: flow/1

record CustomerLookup {
    field target: CustomerId;
    field found: Option<Customer>;
}

// frontend: flow/1

record EmailDeliveryPlan {
    field first: Option<EmailMessage>;
    field remaining: List<EmailMessage>;
}

// frontend: flow/1

record EmailMessage {
    field to: Email;
    field subject: String;
    field body: String;
}

// frontend: flow/1

record Invoice {
    field id: InvoiceId;
    field customer-id: CustomerId;
    field lines: List<InvoiceLine>;
    field total: Money;
    field created-at: Instant;
    field status: InvoiceStatus;
}

// frontend: flow/1

record InvoiceLine {
    field product-id: ProductId;
    field description: String;
    field quantity: Int;
    field unit-price: Money;
    field line-total: Money;
}

// frontend: flow/1

record InvoiceLinesAccumulator {
    field store: Store;
    field outcome: Result<List<InvoiceLine>, BusinessError>;
}

// frontend: flow/1

record InvoiceLookup {
    field target: InvoiceId;
    field found: Option<Invoice>;
}

// frontend: flow/1

record InvoiceReplacement {
    field target: InvoiceId;
    field replacement: Invoice;
    field replaced: Bool;
    field values: List<Invoice>;
}

// frontend: flow/1

record InvoiceTotalAccumulator {
    field outcome: Result<Money, BusinessError>;
}

// frontend: flow/1

record Payment {
    field id: PaymentId;
    field invoice-id: InvoiceId;
    field amount: Money;
    field provider-reference: String;
    field paid-at: Instant;
}

// frontend: flow/1

record PaymentLookup {
    field target: PaymentId;
    field found: Option<Payment>;
}

// frontend: flow/1

record PaymentReceipt {
    field reference: String;
    field amount: Money;
}

// frontend: flow/1

record Product {
    field id: ProductId;
    field name: String;
    field unit-price: Money;
}

// frontend: flow/1

record ProductLookup {
    field target: ProductId;
    field found: Option<Product>;
}

// frontend: flow/1

record Store {
    field customers: List<Customer>;
    field products: List<Product>;
    field subscriptions: List<Subscription>;
    field invoices: List<Invoice>;
    field payments: List<Payment>;
    field email-outbox: List<EmailMessage>;
    field sent-emails: List<EmailMessage>;
}

// frontend: flow/1

record Subscription {
    field id: SubscriptionId;
    field customer-id: CustomerId;
    field product-id: ProductId;
    field term: String;
    field started-at: Instant;
    field expires-at: Instant;
    field status: SubscriptionStatus;
    field cancelled-at: Option<Instant>;
}

// frontend: flow/1

record SubscriptionLookup {
    field target: SubscriptionId;
    field found: Option<Subscription>;
}

// frontend: flow/1

record SubscriptionReplacementState {
    field target-id: SubscriptionId;
    field replacement: Subscription;
    field output: List<Subscription>;
    field replaced: Bool;
}

// frontend: flow/1

type CustomerId : String {
    validate business::id-valid?;
}

// frontend: flow/1

type Email : String {
    validate business::email-valid?;
}

// frontend: flow/1

type Instant : String {
    validate business::instant-valid?;
}

// frontend: flow/1

type InvoiceId : String {
    validate business::id-valid?;
}

// frontend: flow/1

type InvoiceStatus : String {
    validate invoice::status-valid?;
}

// frontend: flow/1

type Money : Int {
}

// frontend: flow/1

type PaymentId : String {
    validate business::id-valid?;
}

// frontend: flow/1

type ProductId : String {
    validate business::id-valid?;
}

// frontend: flow/1

type SubscriptionId : String {
    validate business::id-valid?;
}

// frontend: flow/1

type SubscriptionStatus : String {
    validate subscription::status-valid?;
}

// frontend: flow/1

word business.email-valid?(value: String) -> Bool {
    effects none
    doc "Whether an address satisfies the fixture\u0027s bounded ASCII email policy."
    string::email-address-valid?(value)
}

// frontend: flow/1

word business.id-valid?(value: String) -> Bool {
    effects none
    doc "Whether an identifier is in canonical lower-case GUID D form."
    string::guid-canonical?(value)
}

// frontend: flow/1

word business.instant-valid?(value: String) -> Bool {
    effects none
    doc "Whether an instant is canonical UTC round-trip text."
    instant::is-canonical-utc?(value)
}

// frontend: flow/1

word business.seed(value: Unit) -> Store {
    effects none
    doc "Create the deterministic baseline customer, product, and subscription."
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let customer = customer::new(id = customer-id, email = Email::new("ada@example.test"), kind = "regular", balance = Money::new(1250), created-at = Instant::new("2026-01-01T12:00:00.0000000\u002B00:00"));
    let product = product::new(id = product-id, name = "Monthly plan", unit-price = Money::new(199));
    let subscription = subscription::new(id = SubscriptionId::new("30000000-0000-0000-0000-000000000001"), customer-id = customer-id, product-id = product-id, term = "monthly", started-at = Instant::new("2026-01-02T12:00:00.0000000\u002B00:00"), expires-at = Instant::new("2026-02-01T12:00:00.0000000\u002B00:00"), status = SubscriptionStatus::new("active"), cancelled-at = option::none<Instant>());
    store::new(customers = list::singleton<Customer>(customer), products = list::singleton<Product>(product), subscriptions = list::singleton<Subscription>(subscription), invoices = list::empty<Invoice>(), payments = list::empty<Payment>(), email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>())
}

// frontend: flow/1

word customer-id.parse(value: String) -> Result<CustomerId, BusinessError> {
    effects none
    doc "Parse any Guid.TryParse-compatible form and store canonical CustomerId text."
    let parsed = string::guid-normalize(value);
    match parsed {
        ok canonical => {
            result::ok<CustomerId, BusinessError>(CustomerId::new(canonical))
        }
        error detail => {
            result::error<CustomerId, BusinessError>(businessError::new(code = "INVALID_IDENTIFIER", message = "CustomerId must be a GUID."))
        }
    }
}

// frontend: flow/1

word customer.create(id: CustomerId, email: Email, kind: String, balance: Money, created-at: Instant) -> Result<Customer, BusinessError> {
    effects none
    doc "Create a customer with a trimmed, nonblank kind."
    let normalized-kind = string::trim(kind);
    if equals(string::length(normalized-kind), 0) {
        result::error<Customer, BusinessError>(businessError::new(code = "INVALID_NAME", message = "Customer kind must contain non-whitespace text."))
    } else {
        result::ok<Customer, BusinessError>(customer::new(id = id, email = email, kind = normalized-kind, balance = balance, created-at = created-at))
    }
}

// frontend: flow/1

word email-message.create(to: Email, subject: String, body: String) -> Result<EmailMessage, BusinessError> {
    effects none
    doc "Create an email message after trimming its nonblank subject and body."
    let normalized-subject = string::trim(subject);
    let normalized-body = string::trim(body);
    let subject-is-blank = equals(string::length(normalized-subject), 0);
    let body-is-blank = equals(string::length(normalized-body), 0);
    if bool::or(subject-is-blank, body-is-blank) {
        result::error<EmailMessage, BusinessError>(businessError::new(code = "INVALID_EMAIL_MESSAGE", message = "Email subject and body must contain non-whitespace text."))
    } else {
        result::ok<EmailMessage, BusinessError>(emailMessage::new(to = to, subject = normalized-subject, body = normalized-body))
    }
}

// frontend: flow/1

word email.apply-delivery-result(store: Store, outcome: Result<Unit, BusinessError>) -> Result<Store, BusinessError> {
    effects none
    doc "Apply one explicit delivery outcome to the first queued email; failures leave Store unchanged."
    let plan = store.email-outbox().fold(emailDeliveryPlan::new(first = option::none<EmailMessage>(), remaining = list::empty<EmailMessage>()), email::delivery-fold-step);
    match plan.first() {
        some message => {
            match outcome {
                ok delivered => {
                    let sent = list::append(store.sent-emails(), message);
                    let updated = store::with-email-state(store, plan.remaining(), sent);
                    result::ok<Store, BusinessError>(updated)
                }
                error provider-error => {
                    result::error<Store, BusinessError>(businessError::new(code = "EMAIL_PROVIDER_FAILURE", message = provider-error.message()))
                }
            }
        }
        none => {
            result::error<Store, BusinessError>(businessError::new(code = "NO_PENDING_EMAIL", message = "There is no queued email to deliver."))
        }
    }
}

// frontend: flow/1

word email.delivery-fold-step(accumulator: EmailDeliveryPlan, candidate: EmailMessage) -> EmailDeliveryPlan {
    effects none
    doc "Separate the first outbox message from the FIFO remainder."
    match accumulator.first() {
        some first => {
            emailDeliveryPlan::new(first = accumulator.first(), remaining = list::append(accumulator.remaining(), candidate))
        }
        none => {
            emailDeliveryPlan::new(first = option::some<EmailMessage>(candidate), remaining = accumulator.remaining())
        }
    }
}

// frontend: flow/1

word email.parse(value: String) -> Result<Email, BusinessError> {
    effects none
    doc "Validate and wrap an address without changing its spelling."
    if business::email-valid?(value) {
        result::ok<Email, BusinessError>(Email::new(value))
    } else {
        result::error<Email, BusinessError>(businessError::new(code = "INVALID_EMAIL", message = "Email does not match the documented address policy."))
    }
}

// frontend: flow/1

word email.queue(store: Store, customer-id: CustomerId, subject: String, body: String) -> Result<Store, BusinessError> {
    effects none
    doc "Queue a trimmed, validated email for an existing customer, preserving FIFO order."
    match store::customer(customer-id, store) {
        some customer => {
            match email-message::create(customer.email(), subject, body) {
                ok message => {
                    let updated = store::with-email-state(store, list::append(store.email-outbox(), message), store.sent-emails());
                    result::ok<Store, BusinessError>(updated)
                }
                error invalid-message => {
                    result::error<Store, BusinessError>(invalid-message)
                }
            }
        }
        none => {
            result::error<Store, BusinessError>(businessError::new(code = "CUSTOMER_NOT_FOUND", message = "The customer does not exist."))
        }
    }
}

// frontend: flow/1

word instant.normalize(value: String) -> Result<Instant, BusinessError> {
    effects none
    doc "Parse an explicitly zoned ISO instant and store canonical UTC text."
    let parsed = instant::parse-utc(value);
    match parsed {
        ok canonical => {
            result::ok<Instant, BusinessError>(Instant::new(canonical))
        }
        error detail => {
            result::error<Instant, BusinessError>(businessError::new(code = "INVALID_INSTANT", message = "Instant must be an explicitly zoned ISO timestamp."))
        }
    }
}

// frontend: flow/1

word invoice-id.parse(value: String) -> Result<InvoiceId, BusinessError> {
    effects none
    doc "Parse any Guid.TryParse-compatible form and store canonical InvoiceId text."
    let parsed = string::guid-normalize(value);
    match parsed {
        ok canonical => {
            result::ok<InvoiceId, BusinessError>(InvoiceId::new(canonical))
        }
        error detail => {
            result::error<InvoiceId, BusinessError>(businessError::new(code = "INVALID_IDENTIFIER", message = "InvoiceId must be a GUID."))
        }
    }
}

// frontend: flow/1

word invoice.build-lines(store: Store, cart: List<CartLine>) -> Result<List<InvoiceLine>, BusinessError> {
    effects none
    doc "Build cart lines in input order, returning the first line error or an empty list for an empty cart."
    let initial = invoiceLinesAccumulator::new(store = store, outcome = result::ok<List<InvoiceLine>, BusinessError>(list::empty<InvoiceLine>()));
    cart.fold(initial, invoice::build-lines-step).outcome()
}

// frontend: flow/1

word invoice.build-lines-step(accumulator: InvoiceLinesAccumulator, cart: CartLine) -> InvoiceLinesAccumulator {
    effects none
    doc "Build cart lines in order while preserving the first line error."
    match accumulator.outcome() {
        ok lines => {
            match invoice::line(accumulator.store(), cart) {
                ok line => {
                    invoiceLinesAccumulator::new(store = accumulator.store(), outcome = result::ok<List<InvoiceLine>, BusinessError>(list::append(lines, line)))
                }
                error problem => {
                    invoiceLinesAccumulator::new(store = accumulator.store(), outcome = result::error<List<InvoiceLine>, BusinessError>(problem))
                }
            }
        }
        error problem => {
            accumulator
        }
    }
}

// frontend: flow/1

word invoice.create(store: Store, id: InvoiceId, customer-id: CustomerId, cart: List<CartLine>, created-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Create an open invoice after duplicate, customer, cart-line, and checked-total validation."
    match store::invoice(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(code = "DUPLICATE_INVOICE", message = "An invoice with this identifier already exists."))
        }
        none => {
            match store::customer(customer-id, store) {
                some customer => {
                    if equals(cart.count(), 0) {
                        result::error<Store, BusinessError>(businessError::new(code = "EMPTY_INVOICE", message = "An invoice must contain at least one line."))
                    } else {
                        match invoice::build-lines(store, cart) {
                            ok lines => {
                                match invoice::sum-lines(lines) {
                                    ok total => {
                                        let created = invoice::new(id = id, customer-id = customer-id, lines = lines, total = total, created-at = created-at, status = InvoiceStatus::new("open"));
                                        let updated = store::with-invoices(store, list::append(store.invoices(), created));
                                        result::ok<Store, BusinessError>(updated)
                                    }
                                    error problem => {
                                        result::error<Store, BusinessError>(problem)
                                    }
                                }
                            }
                            error problem => {
                                result::error<Store, BusinessError>(problem)
                            }
                        }
                    }
                }
                none => {
                    result::error<Store, BusinessError>(businessError::new(code = "CUSTOMER_NOT_FOUND", message = "The customer does not exist."))
                }
            }
        }
    }
}

// frontend: flow/1

word invoice.line(store: Store, cart: CartLine) -> Result<InvoiceLine, BusinessError> {
    effects none
    doc "Validate a cart line, copy its product details, and compute its checked line total."
    let quantity = cart.quantity();
    if int::less-than(quantity, 1) {
        result::error<InvoiceLine, BusinessError>(businessError::new(code = "INVALID_QUANTITY", message = string::concat("Quantity must be positive; received ", string::concat(int::to-string(quantity), "."))))
    } else {
        if int::greater-than(quantity, 2147483647) {
            result::error<InvoiceLine, BusinessError>(businessError::new(code = "INVALID_QUANTITY", message = "Quantity must be at most 2147483647."))
        } else {
            match store::product(cart.product-id(), store) {
                some product => {
                    if money::nonnegative?(product.unit-price()) {
                        match money::multiply-by-quantity(product.unit-price(), quantity) {
                            ok line-total => {
                                result::ok<InvoiceLine, BusinessError>(invoiceLine::new(product-id = product.id(), description = product.name(), quantity = quantity, unit-price = product.unit-price(), line-total = line-total))
                            }
                            error problem => {
                                result::error<InvoiceLine, BusinessError>(problem)
                            }
                        }
                    } else {
                        result::error<InvoiceLine, BusinessError>(businessError::new(code = "NEGATIVE_PRODUCT_PRICE", message = "Product prices must be nonnegative."))
                    }
                }
                none => {
                    result::error<InvoiceLine, BusinessError>(businessError::new(code = "PRODUCT_NOT_FOUND", message = "The product does not exist."))
                }
            }
        }
    }
}

// frontend: flow/1

word invoice.status-valid?(value: String) -> Bool {
    effects none
    doc "Accept only the open and paid invoice states."
    bool::or(equals(value, "open"), equals(value, "paid"))
}

// frontend: flow/1

word invoice.sum-lines(lines: List<InvoiceLine>) -> Result<Money, BusinessError> {
    effects none
    doc "Sum invoice line totals from zero using checked left-to-right Money addition."
    let initial = invoiceTotalAccumulator::new(outcome = result::ok<Money, BusinessError>(Money::new(0)));
    lines.fold(initial, invoice::sum-lines-step).outcome()
}

// frontend: flow/1

word invoice.sum-lines-step(accumulator: InvoiceTotalAccumulator, line: InvoiceLine) -> InvoiceTotalAccumulator {
    effects none
    doc "Add one line total with checked arithmetic, preserving any earlier error."
    match accumulator.outcome() {
        ok subtotal => {
            match money::add(subtotal, line.line-total()) {
                ok total => {
                    invoiceTotalAccumulator::new(outcome = result::ok<Money, BusinessError>(total))
                }
                error problem => {
                    invoiceTotalAccumulator::new(outcome = result::error<Money, BusinessError>(problem))
                }
            }
        }
        error problem => {
            accumulator
        }
    }
}

// frontend: flow/1

word money.add(left: Money, right: Money) -> Result<Money, BusinessError> {
    effects none
    doc "Add signed minor-unit amounts with checked Int64 arithmetic."
    let sum = int::add-checked(Money::value(left), Money::value(right));
    match sum {
        ok value => {
            result::ok<Money, BusinessError>(Money::new(value))
        }
        error detail => {
            result::error<Money, BusinessError>(businessError::new(code = "MONEY_OVERFLOW", message = "The money operation exceeded the Int64 minor-unit range."))
        }
    }
}

// frontend: flow/1

word money.multiply-by-quantity(amount: Money, quantity: Int) -> Result<Money, BusinessError> {
    effects none
    doc "Multiply signed minor units by a signed Int32 quantity with checked arithmetic."
    let below-int32 = int::less-than(quantity, -2147483648);
    let above-int32 = int::greater-than(quantity, 2147483647);
    if bool::or(below-int32, above-int32) {
        result::error<Money, BusinessError>(businessError::new(code = "INVALID_QUANTITY", message = "Quantity must fit the signed Int32 range."))
    } else {
        let product = int::multiply-checked(Money::value(amount), quantity);
        match product {
            ok value => {
                result::ok<Money, BusinessError>(Money::new(value))
            }
            error detail => {
                result::error<Money, BusinessError>(businessError::new(code = "MONEY_OVERFLOW", message = "The money operation exceeded the Int64 minor-unit range."))
            }
        }
    }
}

// frontend: flow/1

word money.nonnegative?(amount: Money) -> Bool {
    effects none
    doc "Whether a signed minor-unit amount is zero or greater."
    bool::not(int::less-than(Money::value(amount), 0))
}

// frontend: flow/1

word payment-id.parse(value: String) -> Result<PaymentId, BusinessError> {
    effects none
    doc "Parse any Guid.TryParse-compatible form and store canonical PaymentId text."
    let parsed = string::guid-normalize(value);
    match parsed {
        ok canonical => {
            result::ok<PaymentId, BusinessError>(PaymentId::new(canonical))
        }
        error detail => {
            result::error<PaymentId, BusinessError>(businessError::new(code = "INVALID_IDENTIFIER", message = "PaymentId must be a GUID."))
        }
    }
}

// frontend: flow/1

word payment-receipt.create(reference: String, amount: Money) -> Result<PaymentReceipt, BusinessError> {
    effects none
    doc "Create a receipt with a trimmed, nonblank provider reference."
    let normalized-reference = string::trim(reference);
    if equals(string::length(normalized-reference), 0) {
        result::error<PaymentReceipt, BusinessError>(businessError::new(code = "INVALID_PROVIDER_RECEIPT", message = "Payment receipt reference must not be empty."))
    } else {
        result::ok<PaymentReceipt, BusinessError>(paymentReceipt::new(reference = normalized-reference, amount = amount))
    }
}

// frontend: flow/1

word payment.apply-result(store: Store, id: PaymentId, invoice-id: InvoiceId, amount: Money, requested-at: Instant, outcome: Result<PaymentReceipt, BusinessError>) -> Result<Store, BusinessError> {
    effects none
    doc "Apply an explicit payment-provider outcome after validating the request and open invoice."
    match store::payment(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(code = "DUPLICATE_PAYMENT", message = "A payment with this identifier already exists."))
        }
        none => {
            if int::greater-than(Money::value(amount), 0) {
                match store::invoice(invoice-id, store) {
                    some invoice => {
                        if equals(invoice.status(), InvoiceStatus::new("paid")) {
                            result::error<Store, BusinessError>(businessError::new(code = "INVOICE_ALREADY_PAID", message = "The invoice is already paid."))
                        } else {
                            if equals(invoice.total(), amount) {
                                match outcome {
                                    ok receipt => {
                                        match payment-receipt::create(receipt.reference(), receipt.amount()) {
                                            ok valid-receipt => {
                                                if equals(valid-receipt.amount(), amount) {
                                                    let paid-invoice = invoice::new(id = invoice.id(), customer-id = invoice.customer-id(), lines = invoice.lines(), total = invoice.total(), created-at = invoice.created-at(), status = InvoiceStatus::new("paid"));
                                                    let payment = payment::new(id = id, invoice-id = invoice-id, amount = amount, provider-reference = valid-receipt.reference(), paid-at = requested-at);
                                                    let replaced = store::replace-invoice(store, paid-invoice);
                                                    let updated = store::with-payments(replaced, list::append(replaced.payments(), payment));
                                                    result::ok<Store, BusinessError>(updated)
                                                } else {
                                                    result::error<Store, BusinessError>(businessError::new(code = "INVALID_PROVIDER_RECEIPT", message = "Payment provider returned an invalid receipt: receipt amount does not match the requested amount"))
                                                }
                                            }
                                            error invalid-receipt => {
                                                result::error<Store, BusinessError>(invalid-receipt)
                                            }
                                        }
                                    }
                                    error provider-error => {
                                        result::error<Store, BusinessError>(businessError::new(code = "PAYMENT_PROVIDER_FAILURE", message = provider-error.message()))
                                    }
                                }
                            } else {
                                result::error<Store, BusinessError>(businessError::new(code = "PAYMENT_AMOUNT_MISMATCH", message = "A payment must equal the full open invoice balance."))
                            }
                        }
                    }
                    none => {
                        result::error<Store, BusinessError>(businessError::new(code = "INVOICE_NOT_FOUND", message = "The invoice does not exist."))
                    }
                }
            } else {
                result::error<Store, BusinessError>(businessError::new(code = "PAYMENT_AMOUNT_MUST_BE_POSITIVE", message = "A payment amount must be positive."))
            }
        }
    }
}

// frontend: flow/1

word product-id.parse(value: String) -> Result<ProductId, BusinessError> {
    effects none
    doc "Parse any Guid.TryParse-compatible form and store canonical ProductId text."
    let parsed = string::guid-normalize(value);
    match parsed {
        ok canonical => {
            result::ok<ProductId, BusinessError>(ProductId::new(canonical))
        }
        error detail => {
            result::error<ProductId, BusinessError>(businessError::new(code = "INVALID_IDENTIFIER", message = "ProductId must be a GUID."))
        }
    }
}

// frontend: flow/1

word product.create(id: ProductId, name: String, unit-price: Money) -> Result<Product, BusinessError> {
    effects none
    doc "Create a product with a trimmed name and a nonnegative unit price."
    let normalized-name = string::trim(name);
    if equals(string::length(normalized-name), 0) {
        result::error<Product, BusinessError>(businessError::new(code = "INVALID_NAME", message = "Product name must contain non-whitespace text."))
    } else {
        if money::nonnegative?(unit-price) {
            result::ok<Product, BusinessError>(product::new(id = id, name = normalized-name, unit-price = unit-price))
        } else {
            result::error<Product, BusinessError>(businessError::new(code = "NEGATIVE_PRODUCT_PRICE", message = "Product prices must be nonnegative."))
        }
    }
}

// frontend: flow/1

word store.add-customer(customer: Customer, store: Store) -> Result<Store, BusinessError> {
    effects none
    doc "Append a customer when its ID is unused, or return DUPLICATE_CUSTOMER."
    match store::customer(customer.id(), store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(code = "DUPLICATE_CUSTOMER", message = "A customer with this identifier already exists."))
        }
        none => {
            let updated = store::new(customers = list::append(store.customers(), customer), products = store.products(), subscriptions = store.subscriptions(), invoices = store.invoices(), payments = store.payments(), email-outbox = store.email-outbox(), sent-emails = store.sent-emails());
            result::ok<Store, BusinessError>(updated)
        }
    }
}

// frontend: flow/1

word store.add-product(product: Product, store: Store) -> Result<Store, BusinessError> {
    effects none
    doc "Append a product when its ID is unused, or return DUPLICATE_PRODUCT."
    match store::product(product.id(), store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(code = "DUPLICATE_PRODUCT", message = "A product with this identifier already exists."))
        }
        none => {
            let updated = store::new(customers = store.customers(), products = list::append(store.products(), product), subscriptions = store.subscriptions(), invoices = store.invoices(), payments = store.payments(), email-outbox = store.email-outbox(), sent-emails = store.sent-emails());
            result::ok<Store, BusinessError>(updated)
        }
    }
}

// frontend: flow/1

word store.customer(id: CustomerId, store: Store) -> Option<Customer> {
    effects none
    doc "Find the first customer with this ID, preserving list order."
    store.customers().fold(customerLookup::new(target = id, found = option::none<Customer>()), store::customer-fold-step).found()
}

// frontend: flow/1

word store.customer-fold-step(accumulator: CustomerLookup, candidate: Customer) -> CustomerLookup {
    effects none
    doc "Keep the first customer whose ID matches the lookup key."
    match accumulator.found() {
        some existing => {
            accumulator
        }
        none => {
            if equals(candidate.id(), accumulator.target()) {
                customerLookup::new(target = accumulator.target(), found = option::some<Customer>(candidate))
            } else {
                accumulator
            }
        }
    }
}

// frontend: flow/1

word store.empty(value: Unit) -> Store {
    effects none
    doc "Create a Store with all seven collections empty."
    store::new(customers = list::empty<Customer>(), products = list::empty<Product>(), subscriptions = list::empty<Subscription>(), invoices = list::empty<Invoice>(), payments = list::empty<Payment>(), email-outbox = list::empty<EmailMessage>(), sent-emails = list::empty<EmailMessage>())
}

