    let initial = store::with-invoices(store::empty(unit), list::singleton<Invoice>(invoice));
    match payment::apply-result(initial, PaymentId::new("00000000-0000-0000-0000-000000000001"), invoice.id(), Money::new(99), Instant::new("2024-01-02T00:00:00.0000000\u002B00:00"), result::error<PaymentReceipt, BusinessError>(businessError::new(code = "IGNORED", message = "ignored"))) {
        ok updated => {
            false
        }
        error problem => {
            equals(problem.code(), "INVOICE_ALREADY_PAID")
        }
    }
    => true
}

