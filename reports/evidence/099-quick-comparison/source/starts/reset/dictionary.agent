}

// frontend: flow/1

word store.with-subscriptions(store: Store, values: List<Subscription>) -> Store {
    effects none
    doc "Replace the subscription list while preserving every other Store field."
    store::new(customers = store.customers(), products = store.products(), subscriptions = values, invoices = store.invoices(), payments = store.payments(), email-outbox = store.email-outbox(), sent-emails = store.sent-emails())
}

// frontend: flow/1

word subscription-id.parse(value: String) -> Result<SubscriptionId, BusinessError> {
    effects none
    doc "Parse any Guid.TryParse-compatible form and store canonical SubscriptionId text."
    let parsed = string::guid-normalize(value);
    match parsed {
        ok canonical => {
            result::ok<SubscriptionId, BusinessError>(SubscriptionId::new(canonical))
        }
        error detail => {
            result::error<SubscriptionId, BusinessError>(businessError::new(code = "INVALID_IDENTIFIER", message = "SubscriptionId must be a GUID."))
        }
    }
}

// frontend: flow/1

word subscription.cancel(store: Store, id: SubscriptionId, cancelled-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Cancel an active subscription at or after its start while preserving Store and list order."
    match store::subscription(id, store) {
        some existing => {
            if equals(SubscriptionStatus::value(existing.status()), "cancelled") {
                result::error<Store, BusinessError>(businessError::new(code = "SUBSCRIPTION_ALREADY_CANCELLED", message = "The subscription is already cancelled."))
            } else {
                if instant::before?(Instant::value(cancelled-at), Instant::value(existing.started-at())) {
                    result::error<Store, BusinessError>(businessError::new(code = "CANCEL_BEFORE_START", message = "A subscription cannot be cancelled before it starts."))
                } else {
                    let cancelled = subscription::new(id = existing.id(), customer-id = existing.customer-id(), product-id = existing.product-id(), term = existing.term(), started-at = existing.started-at(), expires-at = existing.expires-at(), status = SubscriptionStatus::new("cancelled"), cancelled-at = option::some<Instant>(cancelled-at));
                    let updated-subscriptions = subscription::replace-list(store.subscriptions(), id, cancelled);
                    let updated-store = store::with-subscriptions(store, updated-subscriptions);
                    result::ok<Store, BusinessError>(updated-store)
                }
            }
        }
        none => {
            result::error<Store, BusinessError>(businessError::new(code = "SUBSCRIPTION_NOT_FOUND", message = "The subscription does not exist."))
        }
    }
}

// frontend: flow/1

word subscription.replace-list(values: List<Subscription>, target-id: SubscriptionId, replacement: Subscription) -> List<Subscription> {
    effects none
    doc "Replace the first subscription with the target ID while preserving list order."
    let initial = subscriptionReplacementState::new(target-id = target-id, replacement = replacement, output = list::empty<Subscription>(), replaced = false);
    values.fold(initial, subscription::replace-step).output()
}

// frontend: flow/1

word subscription.replace-step(state: SubscriptionReplacementState, candidate: Subscription) -> SubscriptionReplacementState {
    effects none
    doc "Copy subscriptions in order, replacing only the first item with the target ID."
    let matches-target = equals(candidate.id(), state.target-id());
    let replace-now = bool::and(bool::not(state.replaced()), matches-target);
    if replace-now {
        subscriptionReplacementState::new(target-id = state.target-id(), replacement = state.replacement(), output = list::append(state.output(), state.replacement()), replaced = true)
    } else {
        subscriptionReplacementState::new(target-id = state.target-id(), replacement = state.replacement(), output = list::append(state.output(), candidate), replaced = state.replaced())
    }
}

// frontend: flow/1

word subscription.start(store: Store, id: SubscriptionId, customer-id: CustomerId, product-id: ProductId, term: String, started-at: Instant, expires-at: Instant) -> Result<Store, BusinessError> {
    effects none
    doc "Append a new active subscription after checking ID, term, dates, customer, and product in reference order."
    match store::subscription(id, store) {
        some existing => {
            result::error<Store, BusinessError>(businessError::new(code = "DUPLICATE_SUBSCRIPTION", message = "A subscription with this identifier already exists."))
        }
        none => {
            let normalized-term = string::trim(term);
            if equals(string::length(normalized-term), 0) {
                result::error<Store, BusinessError>(businessError::new(code = "INVALID_SUBSCRIPTION_TERM", message = "Subscription term must contain non-whitespace text."))
            } else {
                let expires-before-start = instant::before?(Instant::value(expires-at), Instant::value(started-at));
                let expires-equal-start = equals(Instant::value(expires-at), Instant::value(started-at));
                if bool::or(expires-before-start, expires-equal-start) {
                    result::error<Store, BusinessError>(businessError::new(code = "SUBSCRIPTION_EXPIRY_MUST_FOLLOW_START", message = "Subscription expiry must be later than its start."))
                } else {
                    match store::customer(customer-id, store) {
                        some customer => {
                            match store::product(product-id, store) {
                                some product => {
                                    let subscription = subscription::new(id = id, customer-id = customer-id, product-id = product-id, term = normalized-term, started-at = started-at, expires-at = expires-at, status = SubscriptionStatus::new("active"), cancelled-at = option::none<Instant>());
                                    let updated = store::with-subscriptions(store, list::append(store.subscriptions(), subscription));
                                    result::ok<Store, BusinessError>(updated)
                                }
                                none => {
                                    result::error<Store, BusinessError>(businessError::new(code = "PRODUCT_NOT_FOUND", message = "The product does not exist."))
                                }
                            }
                        }
                        none => {
                            result::error<Store, BusinessError>(businessError::new(code = "CUSTOMER_NOT_FOUND", message = "The customer does not exist."))
                        }
                    }
                }
            }
        }
    }
}

// frontend: flow/1

word subscription.status-valid?(value: String) -> Bool {
    effects none
    doc "Accept only the active and cancelled subscription states."
    bool::or(equals(value, "active"), equals(value, "cancelled"))
}

