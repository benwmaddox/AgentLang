      "ok": true,
      "kind": "source",
      "text": "word customer.renewal-balance(customer: Customer, subscription: Subscription) -> Float {\n    effects none\n    doc \"Returns the existing customer discount, with a further 5 percent reduction for renewable annual subscriptions.\"\n    let baseline = customer.discounted-balance();\n    if equals(subscription.term(), \"annual\") {\n        if subscription.renewable() {\n            float::multiply(baseline, 0.95)\n        } else {\n            baseline\n        }\n    } else {\n        baseline\n    }\n}",
      "data": "word customer.renewal-balance(customer: Customer, subscription: Subscription) -> Float {\n    effects none\n    doc \"Returns the existing customer discount, with a further 5 percent reduction for renewable annual subscriptions.\"\n    let baseline = customer.discounted-balance();\n    if equals(subscription.term(), \"annual\") {\n        if subscription.renewable() {\n            float::multiply(baseline, 0.95)\n        } else {\n            baseline\n        }\n    } else {\n        baseline\n    }\n}"
