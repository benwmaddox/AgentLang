// frontend: flow/1

record Customer {
    field id: CustomerId;
    field email: Email;
    field kind: String;
    field balance: Money;
    field created-at: Instant;
}

// frontend: flow/1

type CustomerId : String {
    validate string::guid-canonical?;
}

// frontend: flow/1

type Email : String {
    validate string::email-address-valid?;
}

// frontend: flow/1

type Instant : String {
    validate instant::is-canonical-utc?;
}

// frontend: flow/1

type Money : Int {
}

// frontend: flow/1

type ProductId : String {
    validate string::guid-canonical?;
}

// frontend: flow/1

word customer.premium?(customer: Customer) -> Bool {
    effects none
    doc "Classifies the raw customer kind using exact ordinal equality."
    equals(customer::kind(customer), "premium")
}

// frontend: flow/1

test customer.premium?/case-sensitive {
    customer::premium?(customer::new(id = CustomerId::new("10000000-0000-0000-0000-000000000001"), email = Email::new("ada@example.test"), kind = "Premium", balance = Money::new(1050), created-at = Instant::new("2026-01-01T12:00:00.0000000\u002B00:00")))
    => false
}

// frontend: flow/1

test customer.premium?/premium {
    customer::premium?(customer::new(id = CustomerId::new("10000000-0000-0000-0000-000000000001"), email = Email::new("ada@example.test"), kind = "premium", balance = Money::new(1050), created-at = Instant::new("2026-01-01T12:00:00.0000000\u002B00:00")))
    => true
}

// frontend: flow/1

test customer.premium?/regular {
    customer::premium?(customer::new(id = CustomerId::new("10000000-0000-0000-0000-000000000001"), email = Email::new("ada@example.test"), kind = "regular", balance = Money::new(1050), created-at = Instant::new("2026-01-01T12:00:00.0000000\u002B00:00")))
    => false
}

// frontend: flow/1

example customer.premium?/premium {
    customer::premium?(customer::new(id = CustomerId::new("10000000-0000-0000-0000-000000000001"), email = Email::new("ada@example.test"), kind = "premium", balance = Money::new(1050), created-at = Instant::new("2026-01-01T12:00:00.0000000\u002B00:00")))
    => true
}
