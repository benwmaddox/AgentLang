// frontend: flow/1

record Customer {
    field id: CustomerId;
    field email: Email;
    field kind: String;
    field balance: Money;
    field created-at: Instant;
}

// frontend: flow/1

type CustomerId : String {
    validate string::guid-canonical?;
}

// frontend: flow/1

type Email : String {
    validate string::email-address-valid?;
}

// frontend: flow/1

type Instant : String {
    validate instant::is-canonical-utc?;
}

// frontend: flow/1

type Money : Int {
}

// frontend: flow/1

type ProductId : String {
    validate string::guid-canonical?;
}
