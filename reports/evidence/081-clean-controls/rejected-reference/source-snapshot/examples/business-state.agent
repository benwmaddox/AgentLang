# Pure constructors and explicit Store rebuilds for the small-business fixture.

word store.with-subscriptions(store: Store, values: List<Subscription>) -> Store {
    effects none
    doc "Replace the subscription list while preserving every other Store field."
    store::new(
        customers = store.customers(),
        products = store.products(),
        subscriptions = values,
        invoices = store.invoices(),
        payments = store.payments(),
        email-outbox = store.email-outbox(),
        sent-emails = store.sent-emails())
}

word store.with-invoices(store: Store, values: List<Invoice>) -> Store {
    effects none
    doc "Replace the invoice list while preserving every other Store field."
    store::new(
        customers = store.customers(),
        products = store.products(),
        subscriptions = store.subscriptions(),
        invoices = values,
        payments = store.payments(),
        email-outbox = store.email-outbox(),
        sent-emails = store.sent-emails())
}

word store.with-payments(store: Store, values: List<Payment>) -> Store {
    effects none
    doc "Replace the payment list while preserving every other Store field."
    store::new(
        customers = store.customers(),
        products = store.products(),
        subscriptions = store.subscriptions(),
        invoices = store.invoices(),
        payments = values,
        email-outbox = store.email-outbox(),
        sent-emails = store.sent-emails())
}

word store.with-email-state(store: Store, outbox: List<EmailMessage>, sent: List<EmailMessage>) -> Store {
    effects none
    doc "Replace both email lists while preserving the five business entity lists."
    store::new(
        customers = store.customers(),
        products = store.products(),
        subscriptions = store.subscriptions(),
        invoices = store.invoices(),
        payments = store.payments(),
        email-outbox = outbox,
        sent-emails = sent)
}

word business.seed(value: Unit) -> Store {
    effects none
    doc "Create the deterministic baseline customer, product, and subscription."
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let customer = customer::new(
        id = customer-id,
        email = Email::new("ada@example.test"),
        kind = "regular",
        balance = Money::new(1250),
        created-at = Instant::new("2026-01-01T12:00:00.0000000+00:00"));
    let product = product::new(
        id = product-id,
        name = "Monthly plan",
        unit-price = Money::new(199));
    let subscription = subscription::new(
        id = SubscriptionId::new("30000000-0000-0000-0000-000000000001"),
        customer-id = customer-id,
        product-id = product-id,
        term = "monthly",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    store::new(
        customers = list::singleton<Customer>(customer),
        products = list::singleton<Product>(product),
        subscriptions = list::singleton<Subscription>(subscription),
        invoices = list::empty<Invoice>(),
        payments = list::empty<Payment>(),
        email-outbox = list::empty<EmailMessage>(),
        sent-emails = list::empty<EmailMessage>())
}

test store.with-subscriptions/replaces-in-order {
    let initial = business::seed(unit);
    let first = subscription::new(
        id = SubscriptionId::new("40000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "first",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let second = subscription::new(
        id = SubscriptionId::new("40000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        term = "second",
        started-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        expires-at = Instant::new("2026-02-01T12:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let values = list::append(list::singleton<Subscription>(first), second);
    let updated = store::with-subscriptions(initial, values);
    bool::and(
        equals(updated.subscriptions(), values),
        bool::and(
            equals(updated.customers(), initial.customers()),
            bool::and(
                equals(updated.products(), initial.products()),
                bool::and(
                    equals(updated.invoices(), initial.invoices()),
                    bool::and(
                        equals(updated.payments(), initial.payments()),
                        bool::and(
                            equals(updated.email-outbox(), initial.email-outbox()),
                            equals(updated.sent-emails(), initial.sent-emails())))))))
    => true
}

test store.with-invoices/replaces-existing-list {
    let initial = business::seed(unit);
    let old-invoice = invoice::new(
        id = InvoiceId::new("41000000-0000-0000-0000-000000000000"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(10),
        created-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let initial-with-old-invoice = store::with-invoices(initial, list::singleton<Invoice>(old-invoice));
    let first = invoice::new(
        id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(20),
        created-at = Instant::new("2026-01-03T12:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let second = invoice::new(
        id = InvoiceId::new("41000000-0000-0000-0000-000000000002"),
        customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001"),
        lines = list::empty<InvoiceLine>(),
        total = Money::new(30),
        created-at = Instant::new("2026-01-04T12:00:00.0000000+00:00"),
        status = InvoiceStatus::new("open"));
    let values = list::append(list::singleton<Invoice>(first), second);
    let updated = store::with-invoices(initial-with-old-invoice, values);
    bool::and(
        equals(updated.invoices(), values),
        bool::and(
            equals(updated.customers(), initial-with-old-invoice.customers()),
            bool::and(
                equals(updated.products(), initial-with-old-invoice.products()),
                bool::and(
                    equals(updated.subscriptions(), initial-with-old-invoice.subscriptions()),
                    bool::and(
                        equals(updated.payments(), initial-with-old-invoice.payments()),
                        bool::and(
                            equals(updated.email-outbox(), initial-with-old-invoice.email-outbox()),
                            equals(updated.sent-emails(), initial-with-old-invoice.sent-emails())))))))
    => true
}

test store.with-payments/replaces-existing-list {
    let initial = business::seed(unit);
    let old-payment = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000000"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(10),
        provider-reference = "old-payment",
        paid-at = Instant::new("2026-01-02T12:00:00.0000000+00:00"));
    let initial-with-old-payment = store::with-payments(initial, list::singleton<Payment>(old-payment));
    let first = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000001"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(20),
        provider-reference = "first-payment",
        paid-at = Instant::new("2026-01-03T12:00:00.0000000+00:00"));
    let second = payment::new(
        id = PaymentId::new("42000000-0000-0000-0000-000000000002"),
        invoice-id = InvoiceId::new("41000000-0000-0000-0000-000000000001"),
        amount = Money::new(30),
        provider-reference = "second-payment",
        paid-at = Instant::new("2026-01-04T12:00:00.0000000+00:00"));
    let values = list::append(list::singleton<Payment>(first), second);
    let updated = store::with-payments(initial-with-old-payment, values);
    bool::and(
        equals(updated.payments(), values),
        bool::and(
            equals(updated.customers(), initial-with-old-payment.customers()),
            bool::and(
                equals(updated.products(), initial-with-old-payment.products()),
                bool::and(
                    equals(updated.subscriptions(), initial-with-old-payment.subscriptions()),
                    bool::and(
                        equals(updated.invoices(), initial-with-old-payment.invoices()),
                        bool::and(
                            equals(updated.email-outbox(), initial-with-old-payment.email-outbox()),
                            equals(updated.sent-emails(), initial-with-old-payment.sent-emails())))))))
    => true
}

test store.with-email-state/replaces-both-lists {
    let initial = business::seed(unit);
    let old-message = emailMessage::new(
        to = Email::new("old@example.test"), subject = "old", body = "old body");
    let initial-with-old-email = store::with-email-state(
        initial,
        list::singleton<EmailMessage>(old-message),
        list::singleton<EmailMessage>(old-message));
    let outbox-first = emailMessage::new(
        to = Email::new("first@example.test"), subject = "first", body = "first body");
    let outbox-second = emailMessage::new(
        to = Email::new("second@example.test"), subject = "second", body = "second body");
    let sent = emailMessage::new(
        to = Email::new("sent@example.test"), subject = "sent", body = "sent body");
    let outbox = list::append(list::singleton<EmailMessage>(outbox-first), outbox-second);
    let sent-list = list::singleton<EmailMessage>(sent);
    let updated = store::with-email-state(initial-with-old-email, outbox, sent-list);
    bool::and(
        equals(updated.email-outbox(), outbox),
        bool::and(
            equals(updated.sent-emails(), sent-list),
            bool::and(
                equals(updated.customers(), initial-with-old-email.customers()),
                bool::and(
                    equals(updated.products(), initial-with-old-email.products()),
                    bool::and(
                        equals(updated.subscriptions(), initial-with-old-email.subscriptions()),
                        bool::and(
                            equals(updated.invoices(), initial-with-old-email.invoices()),
                            equals(updated.payments(), initial-with-old-email.payments())))))))
    => true
}

test business.seed/exact-baseline {
    let baseline = business::seed(unit);
    let customer-id = CustomerId::new("10000000-0000-0000-0000-000000000001");
    let product-id = ProductId::new("20000000-0000-0000-0000-000000000001");
    let subscription-id = SubscriptionId::new("30000000-0000-0000-0000-000000000001");
    let customer-is-exact = match store::customer(customer-id, baseline) {
        some selected => {
            bool::and(
                equals(selected.email(), Email::new("ada@example.test")),
                bool::and(
                    equals(selected.kind(), "regular"),
                    bool::and(
                        equals(selected.balance(), Money::new(1250)),
                        equals(selected.created-at(), Instant::new("2026-01-01T12:00:00.0000000+00:00")))))
        }
        none => { false }
    };
    let product-is-exact = match store::product(product-id, baseline) {
        some selected => {
            bool::and(
                equals(selected.name(), "Monthly plan"),
                equals(selected.unit-price(), Money::new(199)))
        }
        none => { false }
    };
    let subscription-is-exact = match store::subscription(subscription-id, baseline) {
        some selected => {
            bool::and(
                equals(selected.customer-id(), customer-id),
                bool::and(
                    equals(selected.product-id(), product-id),
                    bool::and(
                        equals(selected.term(), "monthly"),
                        bool::and(
                            equals(selected.started-at(), Instant::new("2026-01-02T12:00:00.0000000+00:00")),
                            bool::and(
                                equals(selected.expires-at(), Instant::new("2026-02-01T12:00:00.0000000+00:00")),
                                bool::and(
                                    equals(selected.status(), SubscriptionStatus::new("active")),
                                    equals(selected.cancelled-at(), option::none<Instant>())))))))
        }
        none => { false }
    };
    bool::and(
        equals(baseline.customers().count(), 1),
        bool::and(
            equals(baseline.products().count(), 1),
            bool::and(
                equals(baseline.subscriptions().count(), 1),
                bool::and(
                    equals(baseline.invoices().count(), 0),
                    bool::and(
                        equals(baseline.payments().count(), 0),
                        bool::and(
                            equals(baseline.email-outbox().count(), 0),
                            bool::and(
                                equals(baseline.sent-emails().count(), 0),
                                bool::and(customer-is-exact, bool::and(product-is-exact, subscription-is-exact)))))))))
    => true
}

example store.with-subscriptions/replaces-list {
    store::with-subscriptions(business::seed(unit), list::empty<Subscription>()).subscriptions().count()
    => 0
}

example store.with-invoices/replaces-list {
    store::with-invoices(business::seed(unit), list::empty<Invoice>()).invoices().count()
    => 0
}

example store.with-payments/replaces-list {
    store::with-payments(business::seed(unit), list::empty<Payment>()).payments().count()
    => 0
}

example store.with-email-state/replaces-lists {
    store::with-email-state(
        business::seed(unit),
        list::empty<EmailMessage>(),
        list::empty<EmailMessage>()).email-outbox().count()
    => 0
}

example business.seed/deterministic-baseline {
    business::seed(unit).customers().count()
    => 1
}
