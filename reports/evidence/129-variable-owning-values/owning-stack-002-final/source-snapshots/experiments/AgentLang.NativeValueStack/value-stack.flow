record Leaf {
    field value: Int;
}

record Envelope {
    field leaf: Leaf;
    field tag: Int;
}

record State {
    field count: Int;
    field last: Envelope;
}

fn mailbox.make-envelope(value: Int, tag: Int) -> Envelope {
    effects none
    let nestedLeaf = leaf::new(value = value);
    envelope::new(leaf = nestedLeaf, tag = tag)
}

fn mailbox.exercise(value: Int) -> Int {
    effects none
    let (left, right) = dup(mailbox::make-envelope(value, add(value, 100)));
    let left_value = left.leaf.value;
    let right_value = right.leaf.value;
    add(left_value, right_value)
}

fn mailbox.initialize() -> State {
    effects none
    let last = mailbox::make-envelope(5, 70);
    state::new(count = 10, last = last)
}

fn mailbox.branch(value: Int, choose_left: Bool) -> Envelope {
    effects none
    let selected = if choose_left {
        mailbox::make-envelope(value, 700)
    } else {
        mailbox::make-envelope(add(value, 1), 800)
    };
    selected
}

fn mailbox.unit-value() -> Unit {
    effects none
    unit
}

fn mailbox.empty-value() -> Empty {
    effects none
    empty::new()
}

fn mailbox.scoped-width(value: Int) -> Envelope {
    effects none
    let held = mailbox::make-envelope(value, 700);
    let observed = if equals(value, 0) {
        let narrow = leaf::new(value = value);
        narrow.value
    } else {
        let wide = state::new(count = value, last = mailbox::make-envelope(value, 800));
        wide.count
    };
    envelope::new(leaf = held.leaf, tag = add(held.tag, observed))
}

fn mailbox.fail-after-allocation(state: State, value: Int) -> Int {
    effects none
    let scratch = mailbox::make-envelope(value, add(value, 1));
    divide(1, 0)
}

record TextLeaf {
    field text: String;
    field codeUnits: Int;
}

record TextEnvelope {
    field leaf: TextLeaf;
    field tag: Int;
}

record TextState {
    field count: Int;
    field last: TextEnvelope;
}

record TextMixed {
    field marker: Empty;
    field text: String;
    field sentinel: Int;
}

fn mailbox.transform-text-envelope(previous: TextEnvelope) -> TextEnvelope {
    effects none
    let (left, right) = dup(previous);
    let leftText = string::concat(left.leaf.text, "!");
    let rightText = string::concat(right.leaf.text, "?");
    let combined = string::concat(leftText, rightText);
    let codeUnits = string::length(left.leaf.text);
    let nextLeaf = textLeaf::new(text = combined, codeUnits = codeUnits);
    textEnvelope::new(leaf = nextLeaf, tag = add(previous.tag, 1))
}

fn mailbox.transform-text-envelope-with-length(previous: TextEnvelope) -> (TextEnvelope, Int) {
    effects none
    let next = mailbox::transform-text-envelope(previous);
    let outputLength = string::length(next.leaf.text);
    return (next, outputLength)
}

fn mailbox.turn-text(state: TextState) -> (TextState, Int) {
    effects none
    let (next, outputLength) = mailbox::transform-text-envelope-with-length(state.last);
    let nextState = textState::new(count = add(state.count, 1), last = next);
    return (nextState, outputLength)
}

fn mailbox.identity-string(value: String) -> String {
    effects none
    value
}

fn mailbox.join-strings(left: String, right: String) -> String {
    effects none
    string::concat(left, right)
}

fn mailbox.make-text-mixed(text: String, sentinel: Int) -> TextMixed {
    effects none
    let marker = empty::new();
    textMixed::new(marker = marker, text = text, sentinel = sentinel)
}

fn mailbox.project-text-mixed(value: TextMixed) -> (String, Int) {
    effects none
    let text = value.text;
    let sentinel = value.sentinel;
    return (text, sentinel)
}

fn mailbox.project-text-mixed-marker(value: TextMixed) -> Empty {
    effects none
    value.marker
}

fn mailbox.choose-text-envelope(left: TextEnvelope, right: TextEnvelope, chooseLeft: Bool) -> (TextEnvelope, Int) {
    effects none
    let selected = if chooseLeft { left } else { right };
    let outputLength = string::length(selected.leaf.text);
    return (selected, outputLength)
}

fn mailbox.fail-after-text-allocation(state: TextState) -> Int {
    effects none
    let scratch = string::concat(state.last.leaf.text, "!");
    divide(1, 0)
}
