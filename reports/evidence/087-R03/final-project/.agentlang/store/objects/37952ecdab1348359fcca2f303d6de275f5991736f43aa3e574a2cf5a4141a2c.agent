example invoice.create/open-invoice {
    let cart = cartLine::new(
        product-id = ProductId::new("20000000-0000-0000-0000-000000000001"),
        quantity = 1);
    match invoice::create(
        business::seed(unit),
        InvoiceId::new("94000000-0000-0000-0000-000000000001"),
        CustomerId::new("10000000-0000-0000-0000-000000000001"),
        list::singleton<CartLine>(cart),
        Instant::new("2026-01-04T00:00:00.0000000+00:00")) {
        ok updated => { updated.invoices().count() }
        error problem => { -1 }
    }
    => 1
}