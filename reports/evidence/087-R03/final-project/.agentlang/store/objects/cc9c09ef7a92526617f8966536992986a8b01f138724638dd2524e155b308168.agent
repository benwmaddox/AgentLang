test store.payment-fold-step/no-match {
    let key = PaymentId::new("00000000-0000-0000-0000-000000000001");
    let other = payment::new(
        id = PaymentId::new("00000000-0000-0000-0000-000000000002"),
        invoice-id = InvoiceId::new("00000000-0000-0000-0000-000000000003"),
        amount = Money::new(10),
        provider-reference = "other-ref",
        paid-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let initial = paymentLookup::new(target = key, found = option::none<Payment>());
    match store::payment-fold-step(initial, other).found() {
        some selected => { false }
        none => { true }
    }
    => true
}