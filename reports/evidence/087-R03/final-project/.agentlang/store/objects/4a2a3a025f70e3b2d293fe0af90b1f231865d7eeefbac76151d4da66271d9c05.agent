test store.payment/first-match-in-list-order {
    let key = PaymentId::new("00000000-0000-0000-0000-000000000001");
    let first = payment::new(
        id = key,
        invoice-id = InvoiceId::new("00000000-0000-0000-0000-000000000003"),
        amount = Money::new(10),
        provider-reference = "first-ref",
        paid-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let later = payment::new(
        id = key,
        invoice-id = InvoiceId::new("00000000-0000-0000-0000-000000000003"),
        amount = Money::new(20),
        provider-reference = "later-ref",
        paid-at = Instant::new("2024-01-02T00:00:00.0000000+00:00"));
    let blank = store::empty(unit);
    let input = store::new(
        customers = blank.customers(),
        products = blank.products(),
        subscriptions = blank.subscriptions(),
        invoices = blank.invoices(),
        payments = list::append(list::singleton<Payment>(first), later),
        email-outbox = blank.email-outbox(),
        sent-emails = blank.sent-emails());
    match store::payment(key, input) {
        some selected => { equals(selected.provider-reference(), "first-ref") }
        none => { false }
    }
    => true
}