test store.subscription-fold-step/preserves-first {
    let key = SubscriptionId::new("00000000-0000-0000-0000-000000000001");
    let first = subscription::new(
        id = key,
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        product-id = ProductId::new("00000000-0000-0000-0000-000000000004"),
        term = "first",
        started-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        expires-at = Instant::new("2024-02-01T00:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let later = subscription::new(
        id = key,
        customer-id = CustomerId::new("00000000-0000-0000-0000-000000000003"),
        product-id = ProductId::new("00000000-0000-0000-0000-000000000004"),
        term = "later",
        started-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"),
        expires-at = Instant::new("2024-02-01T00:00:00.0000000+00:00"),
        status = SubscriptionStatus::new("active"),
        cancelled-at = option::none<Instant>());
    let initial = subscriptionLookup::new(target = key, found = option::some<Subscription>(first));
    match store::subscription-fold-step(initial, later).found() {
        some selected => { equals(selected.term(), "first") }
        none => { false }
    }
    => true
}