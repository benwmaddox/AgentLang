test store.customer-fold-step/match {
    let key = CustomerId::new("00000000-0000-0000-0000-000000000001");
    let person = customer::new(
        id = key,
        email = Email::new("first@example.com"),
        kind = "first",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let initial = customerLookup::new(target = key, found = option::none<Customer>());
    match store::customer-fold-step(initial, person).found() {
        some selected => { equals(selected.kind(), "first") }
        none => { false }
    }
    => true
}