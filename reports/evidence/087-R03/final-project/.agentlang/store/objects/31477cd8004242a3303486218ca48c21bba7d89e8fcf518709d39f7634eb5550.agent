test invoice.line/checked-multiplication-overflow {
    let blank = store::empty(unit);
    let product-id = ProductId::new("90000000-0000-0000-0000-000000000001");
    let item = product::new(
        id = product-id,
        name = "expensive",
        unit-price = Money::new(9223372036854775807));
    let initial = store::new(
        customers = blank.customers(),
        products = list::singleton<Product>(item),
        subscriptions = blank.subscriptions(),
        invoices = blank.invoices(),
        payments = blank.payments(),
        email-outbox = blank.email-outbox(),
        sent-emails = blank.sent-emails());
    let cart = cartLine::new(product-id = product-id, quantity = 2);
    match invoice::line(initial, cart) {
        ok line => { false }
        error problem => { equals(problem.code(), "MONEY_OVERFLOW") }
    }
    => true
}