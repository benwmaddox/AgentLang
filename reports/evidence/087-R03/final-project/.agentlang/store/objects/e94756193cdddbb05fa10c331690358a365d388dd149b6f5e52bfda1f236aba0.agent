test store.add-customer/duplicate-code-and-input-unchanged {
    let existing = customer::new(
        id = CustomerId::new("00000000-0000-0000-0000-000000000001"),
        email = Email::new("same@example.com"),
        kind = "existing",
        balance = Money::new(0),
        created-at = Instant::new("2024-01-01T00:00:00.0000000+00:00"));
    let blank = store::empty(unit);
    let initial = store::new(
        customers = list::singleton<Customer>(existing),
        products = blank.products(),
        subscriptions = blank.subscriptions(),
        invoices = blank.invoices(),
        payments = blank.payments(),
        email-outbox = blank.email-outbox(),
        sent-emails = blank.sent-emails());
    match store::add-customer(existing, initial) {
        ok updated => { false }
        error problem => {
            bool::and(
                equals(problem.code(), "DUPLICATE_CUSTOMER"),
                equals(initial.customers().count(), 1))
        }
    }
    => true
}