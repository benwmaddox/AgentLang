test store.product-fold-step/no-match {
    let key = ProductId::new("00000000-0000-0000-0000-000000000001");
    let other = product::new(
        id = ProductId::new("00000000-0000-0000-0000-000000000002"),
        name = "other",
        unit-price = Money::new(10));
    let initial = productLookup::new(target = key, found = option::none<Product>());
    match store::product-fold-step(initial, other).found() {
        some selected => { false }
        none => { true }
    }
    => true
}